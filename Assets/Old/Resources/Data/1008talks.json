  "charactorName":"一般兵",
  "charactorEnglishName":"Solider",
  "charactorIcon":"5",
  "charactorId":0,
  "displayStyle":1,
  "isClearForward":true,
  "nexTalkId":109125,
  "text":"好！",
  "EnglishText":"Good!" },
{ 
