[{"talkId":4001,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"唔......到此为止了吗......"},{"talkId":4002,"charactorName":"海恩","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"已经不行了......艾尔文，以后就靠你了！"},{"talkId":4003,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"不，不可能！！作为青龙骑士团队长的我竟然会战败......"},{"talkId":101001,"charactorName":"海因","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101002,"text":"不，不好了，艾尔文"},{"talkId":101002,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101003,"text":"怎么了，海因？"},{"talkId":101003,"charactorName":"海因","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101004,"text":"雷尔卡特帝国的骑士团从村外打进来了！"},{"talkId":101004,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101005,"text":"村外？海因你从小一起长大的好朋友不是住在那附近吗？"},{"talkId":101005,"charactorName":"海因","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101006,"text":"就是啊！所以不快点去救他的话她就危险了！"},{"talkId":101006,"charactorName":"海因","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101007,"text":"艾尔文你的剑术很好吧？所以求你帮帮我吧！"},{"talkId":101007,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"知道了。马上就去！"},{"talkId":101008,"charactorName":"村人","charactorIcon":"11","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"救命啊！"},{"talkId":101009,"charactorName":"帝国指挥官","charactorIcon":"22","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"利昂大人！村民怎么处置？我们的行动暴露了吗！"},{"talkId":101010,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"不要作无益的杀戮。我们的任务不是杀人。"},{"talkId":101011,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"你只要确保巴尔特的退路即可！"},{"talkId":101012,"charactorName":"帝国指挥官","charactorIcon":"22","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"遵命！"},{"talkId":101013,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101014,"text":"利昂大人，发现要找的那个小姑娘了！"},{"talkId":101014,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"！？"},{"talkId":101015,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"唔，快点。"},{"talkId":101016,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101017,"text":"你就是莉娅娜吧。要命就乖乖地跟我们去帝国一趟。"},{"talkId":101017,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"我...，找我有什么事....？"},{"talkId":101018,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101019,"text":"使出突然非常抱歉。"},{"talkId":101019,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"我是统领雷尔卡特帝国青龙骑士团的利昂。奉命行事，特此前来迎接你去帝国。"},{"talkId":101020,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"我......?"},{"talkId":101021,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"贝伦哈尔特陛下正在等你。你能不能前往帝都......"},{"talkId":101022,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"......如果我跟你们走，你能向我保证不袭击村里的人吗？"},{"talkId":101023,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101024,"text":"当然，在不光彩的挟持女性后，若再杀害手无寸铁的村民，这种令自己蒙羞的事我绝不会干。"},{"talkId":101024,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"只是......，胆敢反抗我们的人一律格杀勿论。"},{"talkId":101025,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"我明白了......那么我和你们一起走吧。"},{"talkId":101026,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"......谢谢.请让我表示感谢。"},{"talkId":101027,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101028,"text":"喂，乖乖的跟我来！"},{"talkId":101028,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":2,"isClearForward":false,"nexTalkId":101029,"text":"好痛！不用你这么使劲来，我也会跟你走的。"},{"talkId":101029,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":false,"nexTalkId":0,"text":"哼！都成了俘虏了小丫头还那么横！"},{"talkId":101030,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"好！带她回帝国吧。但是要注意你的举止。"},{"talkId":101031,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"是......一号我会注意的。"},{"talkId":101032,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"住手！！我不会让你们在这村子里胡作非为的！"},{"talkId":101033,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"利昂大人。村里的自卫队来了！"},{"talkId":101034,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"很快啊......但是不用在意什么自卫队。继续执行作战任务！"},{"talkId":101035,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"说什么！！我会让你们后悔只带了这么点人马来！"},{"talkId":101036,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"哼，有意思。"},{"talkId":101037,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"利亚特跟我上！将敌人一扫而光！！"},{"talkId":101038,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"是！"},{"talkId":101039,"charactorName":"帝国指挥官","charactorIcon":"22","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"那么，我在这里掩护巴尔特大人撤退！"},{"talkId":101040,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"......你这是头一次上战场吧而且还是这种挟持女性的战斗，抱歉了。"},{"talkId":101041,"charactorName":"帝国指挥官","charactorIcon":"22","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"请大人不必放在心上，我能和利昂大人共同战斗已经感到很荣幸了。"},{"talkId":101042,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"谢谢，但是不要勉强。"},{"talkId":101043,"charactorName":"海因","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"大事不妙啊艾尔文。帝国那帮人，想要将莉娅娜带走啊！"},{"talkId":101044,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101045,"text":"究竟怎么回事？"},{"talkId":101045,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"算了，待会再想吧。总之要赶快！"},{"talkId":101046,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"这个村庄由我们来保护！"},{"talkId":101047,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101048,"text":"哼，太无聊了。练剑都不让用的作者真没意思！"},{"talkId":101048,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101049,"text":"机会难得，吓唬一下那边的小丫头们！"},{"talkId":101049,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101050,"text":"不要！你为何不遵守约定！"},{"talkId":101050,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"吵死了！抓到你后，我可就用不着管那些鸟事了！"},{"talkId":101051,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101052,"text":"喂！闪开！别挡道！"},{"talkId":101052,"charactorName":"村民","charactorIcon":"11","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"呀！救命啊！"},{"talkId":101053,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"住手，巴尔特！不要擅自行动！"},{"talkId":101054,"charactorName":"村民","charactorIcon":"11","displayStyle":1,"isClearForward":true,"nexTalkId":101055,"text":"呀～！"},{"talkId":101055,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101056,"text":"太过分了！为什么要做那样的事......"},{"talkId":101056,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101057,"text":"住嘴，小丫头！不给你点苦头吃就不知道老实吗？"},{"talkId":101057,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101058,"text":"还不住手！！混帐！我说过不可滥杀无个辜的！"},{"talkId":101058,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101059,"text":"绝不允许你再用这样的举动！无视军规的人，我的部队不需要！"},{"talkId":101059,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"......是！非，非常的抱歉。"},{"talkId":101060,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":101061,"text":"跟上利昂大人！冲啊！"},{"talkId":101061,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101062,"text":"要小心，利亚特。对方部队的编制是枪兵。"},{"talkId":101062,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":101063,"text":"我用波状攻击打开突破口直接攻击敌人的指挥官。"},{"talkId":101063,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"唔。"},{"talkId":101064,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":101065,"text":"就算你带枪兵我们青龙其实团也不会怯阵的！"},{"talkId":101065,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"有趣！那你来试试！"},{"talkId":101066,"charactorName":"司祭","charactorIcon":"24","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"对手果然很强啊！在领主到来之前，只能一边回复体力一边战斗了！"},{"talkId":101067,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"是啊。连枪兵都抵挡不住，看来传说中最强的骑士团果然名不虚传。"},{"talkId":101068,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101069,"text":"我不会让你们在这里为所欲为的！"},{"talkId":101069,"charactorName":"帝国指挥官","charactorIcon":"22","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"我可不会输！"},{"talkId":101070,"charactorName":"海恩","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"帝国兵！快点滚回你们的国家去！"},{"talkId":101071,"charactorName":"帝国指挥官","charactorIcon":"22","displayStyle":1,"isClearForward":true,"nexTalkId":101072,"text":"利，利昂大人请原谅......"},{"talkId":101072,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"唉！竟然让他死了......"},{"talkId":101073,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"竟敢小瞧我们！"},{"talkId":101074,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"走啊，小丫头！快点跟上！"},{"talkId":101075,"charactorName":"警卫团","charactorIcon":"19","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"哇！"},{"talkId":101076,"charactorName":"海恩","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101078,"text":"莉娅娜，我来救你了！"},{"talkId":101078,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101079,"text":"啊，海恩！危险啊，快逃！"},{"talkId":101079,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"你这家伙想怎样！不想死的话，快滚！"},{"talkId":101080,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"哼！可恶，自作聪明的家伙！"},{"talkId":101081,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"竟敢阻拦我巴尔特大人，愚蠢的家伙！来的正好，我正感觉不够刺激呢，让我好好的陪你玩玩！！"},{"talkId":101082,"charactorName":"司祭","charactorIcon":"24","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"哇~~！"},{"talkId":101083,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101084,"text":"好，现在我们去掩护巴尔特！"},{"talkId":101084,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"是！"},{"talkId":101085,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":101086,"text":"利昂大人！"},{"talkId":101086,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"别勉强！下面的事就交给我了！！"},{"talkId":101087,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":101088,"text":"好，作战结束。返回大部队。"},{"talkId":101088,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101089,"text":"你叫艾尔文吧，小子！虽然气势不小，却是个什么都干不了的家伙！"},{"talkId":101089,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":101090,"text":"哈～哈～哈～哈～......"},{"talkId":101090,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"呃,怎么会这样呢......"},{"talkId":101091,"charactorName":"巴尔特","charactorIcon":"23","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"混蛋......利昂大人！"},{"talkId":101092,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"什么！？失败了......"},{"talkId":101093,"charactorName":"罗伦","charactorIcon":"26","displayStyle":1,"isClearForward":true,"nexTalkId":101094,"text":"竟敢在我的领地内为所欲为，不可饶恕。"},{"talkId":101094,"charactorName":"斯科特","charactorIcon":"25","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"把他们赶出村子！"},{"talkId":101095,"charactorName":"海恩","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101096,"text":"是领主大人的部队！"},{"talkId":101096,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":101097,"text":"敌人的援军来了！"},{"talkId":101097,"charactorName":"利昂","charactorIcon":"13","displayStyle":1,"isClearForward":true,"nexTalkId":0,"text":"情况不妙......没办法，撤退！"},{"talkId":101097,"charactorName":"利亚特","charactorIcon":"17","displayStyle":1,"isClearForward":true,"nexTalkId":101098,"text":"是！"},{"talkId":101099,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101100,"text":"好像已经没事了。"},{"talkId":101100,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101101,"text":"非常感谢你的帮，剑士先生。"},{"talkId":101101,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101102,"text":"我是光之神殿的巫女，名叫莉娅娜。可以告诉我您的姓名吗？"},{"talkId":101102,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101103,"text":"我叫艾尔文。正在四处旅行......"},{"talkId":101103,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101104,"text":"艾尔文显示。真的非常感谢你的帮助。我简直不知道该如何感谢你才好......"},{"talkId":101104,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101105,"text":"不，别客气。你有没有受伤？"},{"talkId":101105,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101106,"text":"不要紧的。艾尔文先生您......"},{"talkId":101106,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101107,"text":"不，别客气。你有没有受伤？"},{"talkId":101107,"charactorName":"艾尔文","charactorIcon":"0","displayStyle":1,"isClearForward":true,"nexTalkId":101108,"text":"别那么称呼。就叫我艾尔文好了。"},{"talkId":101108,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101109,"text":"那么，也请你叫我莉娅娜吧。"},{"talkId":101109,"charactorName":"海因","charactorIcon":"3","displayStyle":1,"isClearForward":true,"nexTalkId":101110,"text":"不愧是艾尔文！真是太厉害了！帅呆了！"},{"talkId":101110,"charactorName":"莉娅娜","charactorIcon":"7","displayStyle":1,"isClearForward":true,"nexTalkId":101111,"text":"海因，也谢谢你来救我。"},{"talkId":101111,"charactorName":"罗伦","charactorIcon":"26","displayStyle":1,"isClearForward":true,"nexTalkId":101112,"text":"喂，诸位，大家都没事吧。待在这