      pl: "Po\u0142\u0105czenie dw\xF3ch jagodowych smak\xF3w"
      nl: Combinatie van twee bessen
      el: "\u03A3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CC\u03C2 \u03B4\u03CD\u03BF
        \u03BC\u03BF\u03CD\u03C1\u03C9\u03BD"
      ar: "\u0645\u0632\u064A\u062C \u0645\u0646 \u0646\u0648\u0639\u064A\u0646 \u0645\u0646
