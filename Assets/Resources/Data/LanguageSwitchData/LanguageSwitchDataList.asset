        \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03AE \u03B6\u03CD\u03BC\u03C9\u03C3\u03B7"
      ar: "\u0645\u0633\u062D\u0648\u0642 \u0633\u062D\u0631\u064A \u064A\u0639\u0637\u064A
