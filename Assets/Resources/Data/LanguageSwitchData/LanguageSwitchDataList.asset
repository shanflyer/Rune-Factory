      cs: "V\xEDcevrstevn\xE9, pln\u011Bn\xE9 r\u016Fzn\xFDmi p\u0159\xEDsadami,
        rychl\xE9 a chutn\xE9"
      uk: "\u0411\u0430\u0433\u0430\u0442\u043E\u0448\u0430\u0440\u043E\u0432\u0438\u0439,
        \u0437 \u0440\u0456\u0437\u043D\u0438\u043C\u0438 \u043D\u0430\u0447\u0438\u043D\u043A\u0430\u043C\u0438,
        \u0448\u0432\u0438\u0434\u043A\u0438\u0439 \u0456 \u0441\u043C\u0430\u0447\u043D\u0438\u0439"
      ro: "Straturi bogate, umplute, mas\u0103 rapid\u0103"
      no: "Lag p\xE5 lag, fylt med ingredienser, rask og velsmakende"
