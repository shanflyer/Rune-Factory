    - cn: "\u5473\u9053\u5FAE\u82E6\u56DE\u7518\uFF0C\u6E05\u70ED\u53BB\u706B\uFF0C\u662F\u4F20\u7EDF\u7684\u5065\u5EB7\u996E\u54C1\u3002"
      en: Slight bitterness with a sweet aftertaste, a traditional healthy drink.
      tw: "\u5473\u9053\u5FAE\u82E6\u56DE\u7518\uFF0C\u6E05\u71B1\u53BB\u706B\uFF0C\u662F\u50B3\u7D71\u7684\u5065\u5EB7\u98F2\u54C1"
      ja: "\u307B\u308D\u82E6\u304F\u5F8C\u5473\u723D\u3084\u304B\u306A\u4F1D\u7D71\u7684\u5065\u5EB7\u98F2\u6599"
      ko: "\uC57D\uAC04\uC758 \uC4F4\uB9DB\uACFC \uB2EC\uCF64\uD55C \uB4B7\uB9DB\uC758
        \uC804\uD1B5 \uAC74\uAC15 \uC74C\uB8CC"
      fr: Boisson traditionnelle apaisante
      de: "Bitter-s\xFC\xDFes Traditionsgetr\xE4nk"
      ru: "\u0422\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0439
        \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0441 \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u043C
        \u043F\u043E\u0441\u043B\u0435\u0432\u043A\u0443\u0441\u0438\u0435\u043C"
      es: Bebida tradicional amarga-dulce
      pt: Bebida tradicional amargo-doce
      it: Bevanda tradizionale amaro-dolce
      tr: "Hafif ac\u0131l\u0131 geleneksel i\xE7ecek"
      vi: "V\u1ECB \u0111\u1EAFng nh\u1EB9 h\u1EADu ng\u1ECDt, gi\u1EA3i nhi\u1EC7t"
      th: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E14\u0E37\u0E48\u0E21\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E23\u0E2A\u0E02\u0E21\u0E2B\u0E27\u0E32\u0E19"
      pl: "Tradycyjny gorzko-s\u0142odki nap\xF3j"
      nl: Traditionele bitterzoete drank
      el: "\u03A0\u03B1\u03C1\u03B1\u03B4\u03BF\u03C3\u03B9\u03B1\u03BA\u03CC \u03C0\u03B9\u03BA\u03C1\u03CC\u03B3\u03BB\u03C5\u03BA\u03BF
        \u03C0\u03BF\u03C4\u03CC"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u062A\u0642\u0644\u064A\u062F\u064A \u0645\u0631\u064A\u0631
        \u0648\u062D\u0644\u0648"
      hi: "\u0939\u0932\u094D\u0915\u0940 \u0915\u0921\u093C\u0935\u093E\u0939\u091F
        \u0914\u0930 \u092E\u0940\u0920\u093E \u0905\u092B\u094D\u091F\u0930\u091F\u0947\u0938\u094D\u091F,
        \u092A\u093E\u0930\u0902\u092A\u0930\u093F\u0915 \u0938\u094D\u0935\u093E\u0938\u094D\u0925\u094D\u092F\u0935\u0930\u094D\u0927\u0915
        \u092A\u0947\u092F"
      ur: "\u06C1\u0644\u06A9\u06CC \u06A9\u0691\u0648\u0627\u06C1\u0679 \u0627\u0648\u0631
        \u0645\u06CC\u0679\u06BE\u0627 \u0627\u0641\u0679\u0631 \u0679\u06CC\u0633\u0679\u060C
        \u0631\u0648\u0627\u06CC\u062A\u06CC \u0635\u062D\u062A \u0628\u062E\u0634
        \u0645\u0634\u0631\u0648\u0628\u06D4"
      ms: Sedikit pahit dengan aftertaste manis, minuman sihat tradisional.
      id: Sedikit pahit dengan aftertaste manis, minuman sehat tradisional.
      he: "\u05DE\u05E8\u05D9\u05E8 \u05E2\u05DD \u05DE\u05EA\u05D9\u05E7\u05D5\u05EA,
        \u05D1\u05E8\u05D9\u05D0"
      sv: "Bitter med s\xF6tma, h\xE4lsosamt"
      cs: "Ho\u0159k\xE9 se sladkost\xED, zdrav\xE9"
      uk: "\u0413\u0456\u0440\u043A\u0435 \u0437 \u0441\u043E\u043B\u043E\u0434\u043A\u0456\u0441\u0442\u044E,
        \u0437\u0434\u043E\u0440\u043E\u0432\u0435"
      ro: "Amar cu dulcea\u021B\u0103, s\u0103n\u0103tos"
      no: "Bitter med s\xF8thet, sunt"
      hu: "Gy\xF3gytea"
      sw: Chai ya baridi
      sr: "Biljni \u010Daj"
      fi: Bitter og forfriskende
      da: Katkera ja raikas
    - cn: "\u666E\u901A\u7684\u79BD\u7C7B\uFF0C\u53EF\u4EE5\u4EA7\u51FA[\u9E21\u86CB]"
