    - cn: "\u4F53\u529B\u4E0D\u8DB3\uFF0C\u65E0\u6CD5\u8FDB\u884C\u63A2\u7D22\uFF01"
      en: Not enough stamina to explore!
      tw: "\u9AD4\u529B\u4E0D\u8DB3\uFF0C\u7121\u6CD5\u9032\u884C\u63A2\u7D22\uFF01"
      ja: "\u4F53\u529B\u4E0D\u8DB3\u3067\u63A2\u7D22\u3067\u304D\u307E\u305B\u3093\uFF01"
      ko: "\uCCB4\uB825 \uBD80\uC871\uC73C\uB85C \uD0D0\uD5D8 \uBD88\uAC00!"
      fr: Pas assez d'endurance pour explorer!
      de: Nicht genug Ausdauer zum Erkunden!
      ru: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
        \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438
        \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F!"
      es: "\xA1No hay suficiente resistencia para explorar!"
      pt: "Resist\xEAncia insuficiente para explorar!"
      it: Resistenza insufficiente per esplorare!
      tr: "Ke\u015Ffetmek i\xE7in yeterli dayan\u0131kl\u0131l\u0131k yok!"
      vi: "Kh\xF4ng \u0111\u1EE7 th\u1EC3 l\u1EF1c \u0111\u1EC3 kh\xE1m ph\xE1!"
      th: "\u0E44\u0E21\u0E48\u0E21\u0E35\u0E1E\u0E25\u0E31\u0E07\u0E1E\u0E2D\u0E2A\u0E33\u0E23\u0E27\u0E08!"
      pl: "Za ma\u0142o wytrzyma\u0142o\u015Bci do eksploracji!"
      nl: Niet genoeg uithoudingsvermogen om te verkennen!
      el: "\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B1\u03C1\u03BA\u03B5\u03C4\u03AE
        \u03B1\u03BD\u03C4\u03BF\u03C7\u03AE \u03B3\u03B9\u03B1 \u03B5\u03BE\u03B5\u03C1\u03B5\u03CD\u03BD\u03B7\u03C3\u03B7!"
      ar: "\u0639\u062F\u0645 \u0648\u062C\u0648\u062F \u0642\u062F\u0631\u0629 \u062A\u062D\u0645\u0644
        \u0643\u0627\u0641\u064A\u0629 \u0644\u0644\u0627\u0633\u062A\u0643\u0634\u0627\u0641!"
      hi: "\u0938\u094D\u091F\u0948\u092E\u093F\u0928\u093E \u0915\u092E, \u0905\u0928\u094D\u0935\u0947\u0937\u0923
        \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947"
      ur: "\u0637\u0627\u0642\u062A \u0646\u0627\u06A9\u0627\u0641\u06CC\u060C \u062A\u0644\u0627\u0634
        \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u062A\u06D2"
      ms: Stamina tak cukup untuk meneroka!
      id: Stamina tidak cukup untuk eksplorasi!
      he: "\u05D0\u05D9\u05DF \u05DE\u05E1\u05E4\u05D9\u05E7 \u05E1\u05D9\u05D1\u05D5\u05DC\u05EA
        \u05DC\u05D7\u05E7\u05D9\u05E8\u05D4!"
      sv: "Inte tillr\xE4ckligt med uth\xE5llighet f\xF6r att utforska!"
      cs: "Nedostatek v\xFDdr\u017Ee pro pr\u016Fzkum!"
      uk: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456
        \u0434\u043B\u044F \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F!"
      ro: "Nu ai suficient\u0103 rezisten\u021B\u0103 pentru a explora!"
      no: "Ikke nok utholdenhet til \xE5 utforske!"
      hu: "Nincs el\xE9g energia a felfedez\xE9shez!"
      sw: Nguvu hazitoshi kwa uchunguzi!
      sr: "Nedovoljno energije za istra\u017Eivanje!"
      fi: "Ei tarpeeksi kest\xE4vyysvoimaa tutkimiseen!"
      da: "Utilstr\xE6kkelig udholdenhed til at udforske!"
