      vi: "C\xE1 l\u1EA5p l\xE1nh n\u01B0\u1EDBng mu\u1ED1i \u0111\u1EADm v\u1ECB"
      th: "\u0E1B\u0E25\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E1B\u0E23\u0E30\u0E01\u0E32\u0E22\u0E23\u0E2A\u0E40\u0E04\u0E47\u0E21\u0E2A\u0E14"
