        \u0938\u092E\u092F \u0938\u0947 \u092A\u0930\u093F\u092A\u0915\u094D\u0935
        \u0938\u0941\u0917\u0902\u0927 \u0915\u093E \u0906\u0928\u0902\u0926 \u0932\u0947\u0902"
      ur: "\u067E\u06BE\u0644\u0648\u06BA \u0627\u0648\u0631 \u0634\u0631\u0627\u0628
