      nl: Gouden korrels met geroosterde geur
      el: "\u03A7\u03C1\u03C5\u03C3\u03AC \u03C3\u03C0\u03CC\u03C1\u03B9\u03B1 \u03BC\u03B5
        \u03BA\u03B1\u03C0\u03BD\u03B9\u03C3\u03C4\u03AE \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u062D\u0628\u0648\u0628 \u0630\u0647\u0628\u064A\u0629 \u0628\u0631\u0627\u0626\u062D\u0629
        \u0645\u062D\u0645\u0635\u0629 \u0648\u062D\u0644\u0648\u0629"
