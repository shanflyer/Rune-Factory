      de: Pferdeschweifhaar, langlebig und vielseitig
      ru: "\u041A\u043E\u043D\u0441\u043A\u0438\u0439 \u0445\u0432\u043E\u0441\u0442:
        \u043F\u0440\u043E\u0447\u043D\u044B\u0435 \u0434\u043B\u0438\u043D\u043D\u044B\u0435
        \u0432\u043E\u043B\u043E\u0441\u044B \u0441 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E\u043C
        \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0439"
      es: "Pelos de cola de caballo, largos y duraderos, m\xFAltiples usos"
      pt: "P\xEAlo de cauda equina, dur\xE1vel e vers\xE1til"
      it: Crine di cavallo, resistente e multiuso
      tr: "At kuyru\u011Fu t\xFCy\xFC: dayan\u0131kl\u0131 ve \xE7ok ama\xE7l\u0131"
      vi: "L\xF4ng \u0111u\xF4i ng\u1EF1a, b\u1EC1n v\xE0 \u0111a d\u1EE5ng"
      th: "\u0E02\u0E19\u0E2B\u0E32\u0E07\u0E21\u0E49\u0E32 \u0E17\u0E19\u0E17\u0E32\u0E19\u0E41\u0E25\u0E30\u0E43\u0E0A\u0E49\u0E01\u0E32\u0E23\u0E44\u0E14\u0E49\u0E2B\u0E25\u0E32\u0E01\u0E2B\u0E25\u0E32\u0E22"
      pl: "Ko\u0144ski w\u0142os ogonowy: wytrzyma\u0142y i uniwersalny"
      nl: 'Paardenstaarthaar: duurzaam en veelzijdig'
      el: "\u0391\u03BB\u03BF\u03B3\u03CC\u03BF\u03C5\u03C1\u03B5\u03C2: \u03B1\u03BD\u03B8\u03B5\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2
        \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03C5\u03C7\u03C1\u03B7\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2"
      ar: "\u0634\u0639\u0631 \u0630\u064A\u0644 \u0627\u0644\u062D\u0635\u0627\u0646:
        \u0645\u062A\u064A\u0646 \u0648\u0645\u062A\u0639\u062F\u062F \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0627\u062A"
      hi: "\u0918\u094B\u0921\u093C\u0947 \u0915\u0940 \u092A\u0942\u0901\u091B \u0915\u0947
        \u092C\u093E\u0932, \u0932\u0902\u092C\u0947 \u0914\u0930 \u092E\u091C\u092C\u0942\u0924,
        \u0905\u0928\u0947\u0915 \u0909\u092A\u092F\u094B\u0917"
      ur: "\u06AF\u06BE\u0648\u0691\u06D2 \u06A9\u06CC \u062F\u0645 \u06A9\u06D2
        \u0628\u0627\u0644\u060C \u0644\u0645\u0628\u06D2 \u0627\u0648\u0631 \u0645\u0636\u0628\u0648\u0637\u060C
        \u06A9\u0626\u06CC \u0627\u0633\u062A\u0639\u0645\u0627\u0644"
      ms: Bulu ekor kuda yang panjang dan tahan lama
      id: Bulu ekor kuda yang panjang dan tahan lama
      he: "\u05E9\u05D9\u05E2\u05E8 \u05D6\u05E0\u05D1 \u05E1\u05D5\u05E1, \u05D0\u05E8\u05D5\u05DA
        \u05D5\u05D7\u05D6\u05E7, \u05E9\u05D9\u05DE\u05D5\u05E9\u05D9\u05DD \u05E8\u05D1\u05D9\u05DD"
      sv: "H\xE4stsvansh\xE5r, l\xE5ngt och t\xE5ligt"
      cs: "\u017D\xEDn\u011B z ko\u0148sk\xE9ho ocasu, dlouh\xE9 a pevn\xE9"
      uk: "\u041A\u0456\u043D\u0441\u044C\u043A\u0438\u0439 \u0445\u0432\u0456\u0441\u0442,
        \u0434\u043E\u0432\u0433\u0438\u0439 \u0456 \u043C\u0456\u0446\u043D\u0438\u0439"
      ro: "P\u0103r de coad\u0103 de cal, lung \u0219i rezistent"
      no: "Hestehaleh\xE5r, langt og sterkt"
      hu: "L\xF3farok, sokf\xE9lek\xE9ppen haszn\xE1lhat\xF3"
      sw: Nywele za mkia wa farasi
      sr: Konjska dlaka sa mnogo primena
      fi: "Hestehaleh\xE5r, lange og seje, med mange anvendelser."
      da: "Hevosen h\xE4nt\xE4karvat, pitk\xE4t ja sitke\xE4t, monik\xE4ytt\xF6iset."
    - cn: "\u5236\u4F5C\u8863\u7269\u7684\u57FA\u7840\u6750\u6599"
      en: Basic material for making clothing
      tw: "\u88FD\u4F5C\u8863\u7269\u7684\u57FA\u790E\u6750\u6599"
