      tw: "\u5916\u8868\u91D1\u9EC3\uFF0C\u9846\u7C92\u98FD\u6EFF\uFF0C\u6563\u767C\u7126\u9999\u8207\u751C\u9999"
      ja: "\u9EC4\u91D1\u8272\u306B\u8F1D\u304D\u3001\u9999\u3070\u3057\u3044\u7518\u3044\u9999\u308A"
