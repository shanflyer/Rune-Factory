        \u062A\u0646\u062A\u062C [\u0635\u0648\u0641]"
      hi: "\u0938\u093E\u092E\u093E\u0928\u094D\u092F \u091C\u093E\u0928\u0935\u0930
        \u091C\u094B [\u090A\u0928] \u0926\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902"
