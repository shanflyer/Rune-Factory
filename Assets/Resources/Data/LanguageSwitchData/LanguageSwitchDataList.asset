      sv: Saltad lax, rik smak
      cs: "Solen\xFD losos, bohat\xE1 chu\u0165"
      uk: "\u0421\u043E\u043B\u0435\u043D\u0438\u0439 \u043B\u043E\u0441\u043E\u0441\u044C,
        \u043D\u0430\u0441\u0438\u0447\u0435\u043D\u0438\u0439 \u0441\u043C\u0430\u043A"
      ro: "Somon s\u0103rat, arom\u0103 bogat\u0103"
      no: Saltet laks, rik smak
      hu: "S\xF3zott lazac"
      sw: Samaki wa salmon wa chumvi
      sr: "Slano pe\u010Deni losos"
      fi: Laksens fedt
      da: Lohen rasvaisuus
    - cn: "\u9C7C\u4E32\u7D27\u51D1\uFF0C\u70E4\u81F3\u91D1\u9EC4\uFF0C\u9C7C\u9999\u56DB\u6EA2\u3002"
