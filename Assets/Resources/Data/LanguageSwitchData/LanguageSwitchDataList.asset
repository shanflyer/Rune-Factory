      nl: Edelsteen met een vermeende vloek
      el: "\u03A0\u03BF\u03BB\u03CD\u03C4\u03B9\u03BC\u03BF\u03C2 \u03BB\u03AF\u03B8\u03BF\u03C2
        \u03BC\u03B5 \u03C5\u03C0\u03BF\u03C4\u03B9\u03B8\u03AD\u03BC\u03B5\u03BD\u03B7
        \u03BA\u03B1\u03C4\u03AC\u03C1\u03B1"
      ar: "\u062C\u0648\u0647\u0631\u0629 \u064A\u064F\u0642\u0627\u0644 \u0625\u0646\u0647\u0627
        \u062A\u062D\u0645\u0644 \u0644\u0639\u0646\u0629"
