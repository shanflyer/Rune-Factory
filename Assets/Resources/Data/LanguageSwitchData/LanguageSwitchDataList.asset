      pt: "Ess\xEAncia de uva encorpada"
      it: Essenza d'uva concentrata
      tr: "Zengin \xFCz\xFCm \xF6z\xFC"
      vi: "Tinh ch\u1EA5t nho \u0111\u1EADm \u0111\u1EB7c h\u01B0\u01A1ng v\u1ECB"
      th: "\u0E19\u0E49\u0E33\u0E1C\u0E25\u0E44\u0E21\u0E49\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19\u0E08\u0E32\u0E01\u0E2D\u0E07\u0E38\u0E48\u0E19"
      pl: Skoncentrowany sok winogronowy
      nl: Rijke druivensmaak
      el: "\u03A0\u03BB\u03BF\u03CD\u03C3\u03B9\u03B1 \u03B3\u03B5\u03CD\u03C3\u03B7
        \u03C3\u03C4\u03B1\u03C6\u03C5\u03BB\u03B9\u03BF\u03CD"
      ar: "\u0639\u0635\u064A\u0631 \u0639\u0646\u0628 \u0645\u0631\u0643\u0632 \u0628\u0646\u0643\u0647\u0629
        \u0642\u0648\u064A\u0629"
      hi: "\u0938\u092E\u0943\u0926\u094D\u0927 \u092B\u0932 \u0916\u0941\u0936\u092C\u0942,
        \u0917\u0939\u0930\u093E \u0938\u094D\u0935\u093E\u0926, \u0905\u0902\u0917\u0942\u0930
        \u0915\u093E \u0938\u093E\u0930"
      ur: "\u06AF\u06C1\u0631\u0627 \u067E\u06BE\u0644 \u062E\u0648\u0634\u0628\u0648\u060C
