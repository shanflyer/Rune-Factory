      no: "Mangfold av sj\xF8mat, rik smak"
      hu: "Tenger gy\xFCm\xF6lcsei rizses"
      sw: Wali ya samaki
      sr: "Pirina\u010D sa plodovima mora"
      fi: Havets gaver
      da: Meren antimet
    - cn: "\u5916\u8868\u91D1\u9EC4\uFF0C\u9897\u7C92\u9971\u6EE1\uFF0C\u6563\u53D1\u7740\u7126\u9999\u4E0E\u751C\u9999"
