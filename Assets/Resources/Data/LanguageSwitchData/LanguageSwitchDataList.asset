        \u0633\u0627\u062F\u06C1 \u0628\u06BE\u0648\u0646\u0646\u06D2 \u0633\u06D2
        \u0633\u0627\u0631\u0688\u06CC\u0646 \u06A9\u0627 \u0627\u0635\u0644 \u0630\u0627\u0626\u0642\u06C1
        \u0645\u062D\u0641\u0648\u0638\u06D4"
