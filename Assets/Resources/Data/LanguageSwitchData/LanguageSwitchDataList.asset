      pl: "Czerwony s\u0142odki nap\xF3j na lato"
      nl: Felrood zomerdrankje
      el: "\u03A6\u03C9\u03C4\u03B5\u03B9\u03BD\u03CC \u03BA\u03CC\u03BA\u03BA\u03B9\u03BD\u03BF
        \u03B1\u03BD\u03B1\u03C8\u03C5\u03BA\u03C4\u03B9\u03BA\u03CC"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u0623\u062D\u0645\u0631 \u062D\u0644\u0648
