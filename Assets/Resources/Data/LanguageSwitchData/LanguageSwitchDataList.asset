      ar: "\u0633\u0645\u0643 \u0645\u0634\u0648\u064A \u0645\u0645\u0644\u062D \u0637\u0631\u064A"
      hi: "\u0928\u092E\u0915\u0940\u0928 \u0938\u0924\u0939 \u0914\u0930 \u0928\u0930\u092E
