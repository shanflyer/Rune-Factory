      tw: "\u88FD\u4F5C\u5B8C\u6210\uFF01"
      ja: "\u88FD\u4F5C\u5B8C\u4E86\uFF01"
      ko: "\uC81C\uC791 \uC644\uB8CC!"
      fr: "Fabrication termin\xE9e !"
      de: Herstellung abgeschlossen!
      ru: "\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E!"
      es: "\xA1Fabricaci\xF3n completada!"
      pt: "Fabrica\xE7\xE3o conclu\xEDda!"
      it: Creazione completata!
      tr: "\xDCretim tamamland\u0131!"
      vi: "Ch\u1EBF t\u1EA1o ho\xE0n th\xE0nh!"
      th: "\u0E04\u0E23\u0E32\u0E1F\u0E15\u0E4C\u0E2A\u0E33\u0E40\u0E23\u0E47\u0E08!"
      pl: "Wytwarzanie zako\u0144czone!"
      nl: Productie voltooid!
      el: "\u0397 \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5!"
      ar: "\u0627\u0643\u062A\u0645\u0644 \u0627\u0644\u0635\u0646\u0639!"
      hi: "\u0928\u093F\u0930\u094D\u092E\u093E\u0923 \u092A\u0942\u0930\u093E!"
      ur: "\u062A\u06CC\u0627\u0631\u06CC \u0645\u06A9\u0645\u0644!"
      ms: Siap dibuat!
      id: Pembuatan selesai!
      he: "\u05D4\u05D9\u05D9\u05E6\u05D5\u05E8 \u05D4\u05D5\u05E9\u05DC\u05DD!"
      sv: Tillverkning klar!
      cs: "V\xFDroba dokon\u010Dena!"
      uk: "\u0412\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044F
        \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E!"
