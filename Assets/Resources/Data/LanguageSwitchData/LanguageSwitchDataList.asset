    - cn: "\u5206\u5E03\u6709\u98CE\u5C5E\u6027\u3001\u6C34\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u51B0\u5C5E\u6027\u3001\u571F\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Wind and Water attribute monsters. Recommended equipment:
        Ice and Earth attribute gear.'
      tw: "\u5206\u4F48\u6709\u98A8\u5C6C\u6027\u3001\u6C34\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u51B0\u5C6C\u6027\u3001\u571F\u5C6C\u6027\u88DD\u5099"
      ja: "\u98A8\u5C5E\u6027\u3068\u6C34\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u6C37\u5C5E\u6027\u30FB\u571F\u5C5E\u6027\u88C5\u5099"
      ko: "\uBC14\uB78C/\uBB3C \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C
        \uC7A5\uBE44: \uC5BC\uC74C/\uB545 \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Vent/Eau. \xC9quipement recommand\xE9
        : Glace/Terre"
      de: "Gebiet mit Wind/Wasser-Attribut-Monstern. Empfohlene Ausr\xFCstung: Eis/Erde"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u0412\u0435\u0442\u0440\u0430 \u0438
        \u0412\u043E\u0434\u044B. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u041B\u0451\u0434
        \u0438 \u0417\u0435\u043C\u043B\u044F"
      es: "\xC1rea habitada por monstruos de Viento/Agua. Equipo recomendado: Hielo/Tierra"
      pt: "\xC1rea habitada por monstros de Vento/\xC1gua. Equipamento recomendado:
        Gelo/Terra"
      it: 'Area abitata da mostri Vento/Acqua. Equipaggiamento consigliato: Ghiaccio/Terra'
      tr: "R\xFCzgar/ Su \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: Buz/ Toprak \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt Phong/Th\u1EE7y. Trang b\u1ECB \u0111\u1EC1
        xu\u1EA5t: B\u0103ng/Th\u1ED5"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E25\u0E21/\u0E19\u0E49\u0E33
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07/\u0E14\u0E34\u0E19"
      pl: "Obszar zamieszkany przez potwory Wiatru/Wody. Polecane wyposa\u017Cenie:
        L\xF3d/Ziemia"
      nl: 'Gebied met Wind/Water-attribuutmonsters. Aanbevolen uitrusting: IJs/Aarde'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u0391\u03BD\u03AD\u03BC\u03BF\u03C5/\u039D\u03B5\u03C1\u03BF\u03CD. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u03A0\u03AC\u03B3\u03BF\u03C2/\u0393\u03B7"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u0631\u064A\u0627\u062D/\u0627\u0644\u0645\u0627\u0621. \u064A\u064F\u0646\u0635\u062D
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0639\u062F\u0627\u062A
        \u0627\u0644\u062C\u0644\u064A\u062F/\u0627\u0644\u0623\u0631\u0636"
      hi: "\u0939\u0935\u093E \u0914\u0930 \u092A\u093E\u0928\u0940 \u0917\u0941\u0923
        \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u092C\u0930\u094D\u092B
        \u0914\u0930 \u092E\u093F\u091F\u094D\u091F\u0940 \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u06C1\u0648\u0627 \u0627\u0648\u0631 \u067E\u0627\u0646\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u0628\u0631\u0641 \u0627\u0648\u0631 \u0645\u0679\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa angin dan air. Disarankan peralatan ais dan tanah.
      id: Area dihuni monster angin dan air. Disarankan peralatan es dan tanah.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05E8\u05D5\u05D7 \u05D5\u05DE\u05D9\u05DD,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05E7\u05E8\u05D7 \u05D5\u05D0\u05D3\u05DE\u05D4\""
      sv: '"Monster med vind- och vattenattribut, rekommenderas is- och jordutrustning"'
      cs: "\"Monstra s v\u011Btrem a vodou, doporu\u010Duje se ledov\xE1 a zemn\xED
        v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u0432\u0456\u0442\u0440\u043E\u043C
        \u0456 \u0432\u043E\u0434\u043E\u044E, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u043B\u044C\u043E\u0434\u0443
        \u0442\u0430 \u0437\u0435\u043C\u043B\u0456\""
      ro: "\"Mon\u0219tri cu atributul v\xE2nt \u0219i ap\u0103, echipament recomandat
        ghea\u021B\u0103 \u0219i p\u0103m\xE2nt\""
      no: '"Monstre med vind- og vannattributter, anbefalt is- og jordutstyr"'
      hu: "Sz\xE9l \xE9s v\xEDz sz\xF6rnyek, j\xE9g \xE9s f\xF6ld felszerel\xE9s
        aj\xE1nlott"
      sw: Wanyama wa upepo na maji, vaa vifaa vya barafu na udongo
      sr: "Vetar i voda \u010Dudovi\u0161ta, nositi led i zemlju opremu"
      fi: "Alueella asustaa tuuli- ja vesiaiheisia hirvi\xF6it\xE4. Suositeltu varustus:
        j\xE4\xE4- ja maa-aiheiset varusteet."
      da: "Omr\xE5de med vind- og vand-attributmonstre. Anbefalet udstyr: is- og
        jord-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u51B0\u5C5E\u6027\u3001\u571F\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u706B\u5C5E\u6027\u3001\u98CE\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Ice and Earth attribute monsters. Recommended equipment:
        Fire and Wind attribute gear.'
      tw: "\u5206\u4F48\u6709\u51B0\u5C6C\u6027\u3001\u571F\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u706B\u5C6C\u6027\u3001\u98A8\u5C6C\u6027\u88DD\u5099"
      ja: "\u6C37\u5C5E\u6027\u3068\u571F\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u706B\u5C5E\u6027\u30FB\u98A8\u5C5E\u6027\u88C5\u5099"
      ko: "\uC5BC\uC74C/\uB545 \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C
        \uC7A5\uBE44: \uBD88/\uBC14\uB78C \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Glace/Terre. \xC9quipement recommand\xE9
        : Feu/Vent"
      de: "Gebiet mit Eis/Erde-Attribut-Monstern. Empfohlene Ausr\xFCstung: Feuer/Wind"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u041B\u044C\u0434\u0430 \u0438 \u0417\u0435\u043C\u043B\u0438.
        \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u041E\u0433\u043E\u043D\u044C
        \u0438 \u0412\u0435\u0442\u0435\u0440"
      es: "\xC1rea habitada por monstruos de Hielo/Tierra. Equipo recomendado: Fuego/Viento"
      pt: "\xC1rea habitada por monstros de Gelo/Terra. Equipamento recomendado:
        Fogo/Vento"
      it: 'Area abitata da mostri Ghiaccio/Terra. Equipaggiamento consigliato: Fuoco/Vento'
      tr: "Buz/ Toprak \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: Ate\u015F/ R\xFCzgar \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt B\u0103ng/Th\u1ED5. Trang b\u1ECB
        \u0111\u1EC1 xu\u1EA5t: H\u1ECFa/Phong"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07/\u0E14\u0E34\u0E19
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E44\u0E1F/\u0E25\u0E21"
      pl: "Obszar zamieszkany przez potwory Lodu/Ziemi. Polecane wyposa\u017Cenie:
        Ogie\u0144/Wiatr"
      nl: 'Gebied met IJs/Aarde-attribuutmonsters. Aanbevolen uitrusting: Vuur/Wind'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u03A0\u03AC\u03B3\u03BF\u03C5/\u0393\u03B7\u03C2. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u03A6\u03C9\u03C4\u03B9\u03AC/\u0386\u03BD\u03B5\u03BC\u03BF\u03C2"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u062C\u0644\u064A\u062F/\u0627\u0644\u0623\u0631\u0636. \u064A\u064F\u0646\u0635\u062D
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0639\u062F\u0627\u062A
        \u0627\u0644\u0646\u0627\u0631/\u0627\u0644\u0631\u064A\u0627\u062D"
      hi: "\u092C\u0930\u094D\u092B \u0914\u0930 \u092E\u093F\u091F\u094D\u091F\u0940
        \u0917\u0941\u0923 \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u0906\u0917
        \u0914\u0930 \u0939\u0935\u093E \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u0628\u0631\u0641 \u0627\u0648\u0631 \u0645\u0679\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u0622\u06AF \u0627\u0648\u0631 \u06C1\u0648\u0627 \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa ais dan tanah. Disarankan peralatan api dan angin.
      id: Area dihuni monster es dan tanah. Disarankan peralatan api dan angin.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05E7\u05E8\u05D7 \u05D5\u05D0\u05D3\u05DE\u05D4,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05D0\u05E9 \u05D5\u05E8\u05D5\u05D7\""
      sv: '"Monster med is- och jordattribut, rekommenderas eld- och vindutrustning"'
      cs: "\"Monstra s ledem a zem\xED, doporu\u010Duje se ohniv\xE1 a v\u011Btrn\xE1
        v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u043B\u044C\u043E\u0434\u043E\u043C
        \u0456 \u0437\u0435\u043C\u043B\u0435\u044E, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0432\u043E\u0433\u043D\u044E
        \u0442\u0430 \u0432\u0456\u0442\u0440\u0443\""
      ro: "\"Mon\u0219tri cu atributul ghea\u021B\u0103 \u0219i p\u0103m\xE2nt, echipament
        recomandat foc \u0219i v\xE2nt\""
      no: '"Monstre med is- og jordattributter, anbefalt ild- og vindutstyr"'
      hu: "J\xE9g \xE9s f\xF6ld sz\xF6rnyek, t\u0171z \xE9s sz\xE9l felszerel\xE9s
        aj\xE1nlott"
      sw: Wanyama wa barafu na udongo, vaa vifaa vya moto na upepo
      sr: "Led i zemlja \u010Dudovi\u0161ta, nositi vatru i vetar opremu"
      fi: "Alueella asustaa j\xE4\xE4- ja maa-aiheisia hirvi\xF6it\xE4. Suositeltu
        varustus: tuli- ja tuuli-aiheiset varusteet."
      da: "Omr\xE5de med is- og jord-attributmonstre. Anbefalet udstyr: ild- og vind-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u98CE\u5C5E\u6027\u3001\u6C34\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u51B0\u5C5E\u6027\u3001\u6C34\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Wind and Water attribute monsters. Recommended equipment:
        Ice and Water attribute gear.'
      tw: "\u5206\u4F48\u6709\u98A8\u5C6C\u6027\u3001\u6C34\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u51B0\u5C6C\u6027\u3001\u6C34\u5C6C\u6027\u88DD\u5099"
      ja: "\u98A8\u5C5E\u6027\u3068\u6C34\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u6C37\u5C5E\u6027\u30FB\u6C34\u5C5E\u6027\u88C5\u5099"
      ko: "\uBC14\uB78C/\uBB3C \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C
        \uC7A5\uBE44: \uC5BC\uC74C/\uBB3C \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Vent/Eau. \xC9quipement recommand\xE9
        : Glace/Eau"
      de: "Gebiet mit Wind/Wasser-Attribut-Monstern. Empfohlene Ausr\xFCstung: Eis/Wasser"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u0412\u0435\u0442\u0440\u0430 \u0438
        \u0412\u043E\u0434\u044B. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u041B\u0451\u0434
        \u0438 \u0412\u043E\u0434\u0430"
      es: "\xC1rea habitada por monstruos de Viento/Agua. Equipo recomendado: Hielo/Agua"
      pt: "\xC1rea habitada por monstros de Vento/\xC1gua. Equipamento recomendado:
        Gelo/\xC1gua"
      it: 'Area abitata da mostri Vento/Acqua. Equipaggiamento consigliato: Ghiaccio/Acqua'
      tr: "R\xFCzgar/ Su \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: Buz/ Su \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt Phong/Th\u1EE7y. Trang b\u1ECB \u0111\u1EC1
        xu\u1EA5t: B\u0103ng/Th\u1EE7y"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E25\u0E21/\u0E19\u0E49\u0E33
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07/\u0E19\u0E49\u0E33"
      pl: "Obszar zamieszkany przez potwory Wiatru/Wody. Polecane wyposa\u017Cenie:
        L\xF3d/Woda"
      nl: 'Gebied met Wind/Water-attribuutmonsters. Aanbevolen uitrusting: IJs/Water'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u0391\u03BD\u03AD\u03BC\u03BF\u03C5/\u039D\u03B5\u03C1\u03BF\u03CD. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u03A0\u03AC\u03B3\u03BF\u03C2/\u039D\u03B5\u03C1\u03CC"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u0631\u064A\u0627\u062D/\u0627\u0644\u0645\u0627\u0621. \u064A\u064F\u0646\u0635\u062D
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0639\u062F\u0627\u062A
        \u0627\u0644\u062C\u0644\u064A\u062F/\u0627\u0644\u0645\u0627\u0621"
      hi: "\u0939\u0935\u093E \u0914\u0930 \u092A\u093E\u0928\u0940 \u0917\u0941\u0923
        \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u092C\u0930\u094D\u092B
        \u0914\u0930 \u092A\u093E\u0928\u0940 \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u06C1\u0648\u0627 \u0627\u0648\u0631 \u067E\u0627\u0646\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u0628\u0631\u0641 \u0627\u0648\u0631 \u067E\u0627\u0646\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa angin dan air. Disarankan peralatan ais dan air.
      id: Area dihuni monster angin dan air. Disarankan peralatan es dan air.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05E8\u05D5\u05D7 \u05D5\u05DE\u05D9\u05DD,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05E7\u05E8\u05D7 \u05D5\u05DE\u05D9\u05DD\""
      sv: '"Monster med vind- och vattenattribut, rekommenderas is- och vattenutrustning"'
      cs: "\"Monstra s v\u011Btrem a vodou, doporu\u010Duje se ledov\xE1 a vodn\xED
        v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u0432\u0456\u0442\u0440\u043E\u043C
        \u0456 \u0432\u043E\u0434\u043E\u044E, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u043B\u044C\u043E\u0434\u0443
        \u0442\u0430 \u0432\u043E\u0434\u0438\""
      ro: "\"Mon\u0219tri cu atributul v\xE2nt \u0219i ap\u0103, echipament recomandat
        ghea\u021B\u0103 \u0219i ap\u0103\""
      no: '"Monstre med vind- og vannattributter, anbefalt is- og vannutstyr"'
      hu: "Sz\xE9l \xE9s v\xEDz sz\xF6rnyek, j\xE9g \xE9s v\xEDz felszerel\xE9s aj\xE1nlott"
      sw: Wanyama wa upepo na maji, vaa vifaa vya barafu na maji
      sr: "Vetar i voda \u010Dudovi\u0161ta, nositi led i vodu opremu"
      fi: "Alueella asustaa tuuli- ja vesiaiheisia hirvi\xF6it\xE4. Suositeltu varustus:
        j\xE4\xE4- ja vesi-aiheiset varusteet."
      da: "Omr\xE5de med vind- og vand-attributmonstre. Anbefalet udstyr: is- og
        vand-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u571F\u5C5E\u6027\u3001\u6C34\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u98CE\u5C5E\u6027\u3001\u571F\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Earth and Water attribute monsters. Recommended equipment:
        Wind and Earth attribute gear.'
      tw: "\u5206\u4F48\u6709\u571F\u5C6C\u6027\u3001\u6C34\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u98A8\u5C6C\u6027\u3001\u571F\u5C6C\u6027\u88DD\u5099"
      ja: "\u571F\u5C5E\u6027\u3068\u6C34\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u98A8\u5C5E\u6027\u30FB\u571F\u5C5E\u6027\u88C5\u5099"
      ko: "\uB545/\uBB3C \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C
        \uC7A5\uBE44: \uBC14\uB78C/\uB545 \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Terre/Eau. \xC9quipement recommand\xE9
        : Vent/Terre"
      de: "Gebiet mit Erde/Wasser-Attribut-Monstern. Empfohlene Ausr\xFCstung: Wind/Erde"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u0417\u0435\u043C\u043B\u0438 \u0438
        \u0412\u043E\u0434\u044B. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u0412\u0435\u0442\u0435\u0440
        \u0438 \u0417\u0435\u043C\u043B\u044F"
      es: "\xC1rea habitada por monstruos de Tierra/Agua. Equipo recomendado: Viento/Tierra"
      pt: "\xC1rea habitada por monstros de Terra/\xC1gua. Equipamento recomendado:
        Vento/Terra"
      it: 'Area abitata da mostri Terra/Acqua. Equipaggiamento consigliato: Vento/Terra'
      tr: "Toprak/ Su \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: R\xFCzgar/ Toprak \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt Th\u1ED5/Th\u1EE7y. Trang b\u1ECB
        \u0111\u1EC1 xu\u1EA5t: Phong/Th\u1ED5"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E14\u0E34\u0E19/\u0E19\u0E49\u0E33
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E25\u0E21/\u0E14\u0E34\u0E19"
      pl: "Obszar zamieszkany przez potwory Ziemi/Wody. Polecane wyposa\u017Cenie:
        Wiatr/Ziemia"
      nl: 'Gebied met Aarde/Water-attribuutmonsters. Aanbevolen uitrusting: Wind/Aarde'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u0393\u03B7\u03C2/\u039D\u03B5\u03C1\u03BF\u03CD. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u0386\u03BD\u03B5\u03BC\u03BF\u03C2/\u0393\u03B7"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u0623\u0631\u0636/\u0627\u0644\u0645\u0627\u0621. \u064A\u064F\u0646\u0635\u062D
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0639\u062F\u0627\u062A
        \u0627\u0644\u0631\u064A\u0627\u062D/\u0627\u0644\u0623\u0631\u0636"
      hi: "\u092E\u093F\u091F\u094D\u091F\u0940 \u0914\u0930 \u092A\u093E\u0928\u0940
        \u0917\u0941\u0923 \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u0939\u0935\u093E
        \u0914\u0930 \u092E\u093F\u091F\u094D\u091F\u0940 \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u0645\u0679\u06CC \u0627\u0648\u0631 \u067E\u0627\u0646\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u06C1\u0648\u0627 \u0627\u0648\u0631 \u0645\u0679\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa tanah dan air. Disarankan peralatan angin dan tanah.
      id: Area dihuni monster tanah dan air. Disarankan peralatan angin dan tanah.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05D0\u05D3\u05DE\u05D4 \u05D5\u05DE\u05D9\u05DD,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05E8\u05D5\u05D7 \u05D5\u05D0\u05D3\u05DE\u05D4\""
      sv: '"Monster med jord- och vattenattribut, rekommenderas vind- och jordutrustning"'
      cs: "\"Monstra se zem\xED a vodou, doporu\u010Duje se v\u011Btrn\xE1 a zemn\xED
        v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u0437\u0435\u043C\u043B\u0435\u044E
        \u0456 \u0432\u043E\u0434\u043E\u044E, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0432\u0456\u0442\u0440\u0443
        \u0442\u0430 \u0437\u0435\u043C\u043B\u0456\""
      ro: "\"Mon\u0219tri cu atributul p\u0103m\xE2nt \u0219i ap\u0103, echipament
        recomandat v\xE2nt \u0219i p\u0103m\xE2nt\""
      no: '"Monstre med jord- og vannattributter, anbefalt vind- og jordutstyr"'
      hu: "F\xF6ld \xE9s v\xEDz sz\xF6rnyek, sz\xE9l \xE9s f\xF6ld felszerel\xE9s
        aj\xE1nlott"
      sw: Wanyama wa udongo na maji, vaa vifaa vya upepo na udongo
      sr: "Zemlja i voda \u010Dudovi\u0161ta, nositi vetar i zemlju opremu"
      fi: "Alueella asustaa maa- ja vesiaiheisia hirvi\xF6it\xE4. Suositeltu varustus:
        tuuli- ja maa-aiheiset varusteet."
      da: "Omr\xE5de med jord- og vand-attributmonstre. Anbefalet udstyr: vind- og
        jord-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u706B\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u6C34\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Fire attribute monsters. Recommended equipment: Water
        attribute gear.'
      tw: "\u5206\u4F48\u6709\u706B\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u6C34\u5C6C\u6027\u88DD\u5099"
      ja: "\u706B\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u6C34\u5C5E\u6027\u88C5\u5099"
      ko: "\uBD88 \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C \uC7A5\uBE44:
        \uBB3C \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Feu. \xC9quipement recommand\xE9 : Eau"
      de: "Gebiet mit Feuer-Attribut-Monstern. Empfohlene Ausr\xFCstung: Wasser"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0438 \u041E\u0433\u043D\u044F. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u0412\u043E\u0434\u0430"
      es: "\xC1rea habitada por monstruos de Fuego. Equipo recomendado: Agua"
      pt: "\xC1rea habitada por monstros de Fogo. Equipamento recomendado: \xC1gua"
      it: 'Area abitata da mostri Fuoco. Equipaggiamento consigliato: Acqua'
      tr: "Ate\u015F \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: Su \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt H\u1ECFa. Trang b\u1ECB \u0111\u1EC1
        xu\u1EA5t: Th\u1EE7y"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E44\u0E1F
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E19\u0E49\u0E33"
      pl: "Obszar zamieszkany przez potwory Ognia. Polecane wyposa\u017Cenie: Woda"
      nl: 'Gebied met Vuur-attribuutmonsters. Aanbevolen uitrusting: Water'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u03A6\u03C9\u03C4\u03B9\u03AC\u03C2. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u039D\u03B5\u03C1\u03CC"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u0646\u0627\u0631. \u064A\u064F\u0646\u0635\u062D \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0645\u0639\u062F\u0627\u062A \u0627\u0644\u0645\u0627\u0621"
      hi: "\u0906\u0917 \u0917\u0941\u0923 \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u092A\u093E\u0928\u0940
        \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923 \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u0622\u06AF \u062E\u0635\u0648\u0635\u06CC\u062A \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA
        \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4 \u067E\u0627\u0646\u06CC
        \u062E\u0635\u0648\u0635\u06CC\u062A \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646
        \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa api. Disarankan peralatan air.
      id: Area dihuni monster api. Disarankan peralatan air.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05D0\u05E9, \u05DE\u05D5\u05DE\u05DC\u05E5
        \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3 \u05DE\u05D9\u05DD\""
      sv: '"Monster med eldattribut, rekommenderas vattenutrustning"'
      cs: "\"Monstra s ohn\u011Bm, doporu\u010Duje se vodn\xED v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u0432\u043E\u0433\u043D\u0435\u043C,
        \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0432\u043E\u0434\u0438\""
      ro: "\"Mon\u0219tri cu atributul foc, echipament recomandat ap\u0103\""
      no: '"Monstre med ildattributter, anbefalt vannutstyr"'
      hu: "T\u0171z sz\xF6rnyek, v\xEDz felszerel\xE9s aj\xE1nlott"
      sw: Wanyama wa moto, vaa vifaa vya maji
      sr: "Vatra \u010Dudovi\u0161ta, nositi vodu opremu"
      fi: "Alueella asustaa tuli-aiheisia hirvi\xF6it\xE4. Suositeltu varustus: vesi-aiheiset
        varusteet."
      da: "Omr\xE5de med ild-attributmonstre. Anbefalet udstyr: vand-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u706B\u5C5E\u6027\u3001\u571F\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u6C34\u5C5E\u6027\u3001\u98CE\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Fire and Earth attribute monsters. Recommended equipment:
        Water and Wind attribute gear.'
      tw: "\u5206\u4F48\u6709\u706B\u5C6C\u6027\u3001\u571F\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u6C34\u5C6C\u6027\u3001\u98A8\u5C6C\u6027\u88DD\u5099"
      ja: "\u706B\u5C5E\u6027\u3068\u571F\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u6C34\u5C5E\u6027\u30FB\u98A8\u5C5E\u6027\u88C5\u5099"
      ko: "\uBD88/\uB545 \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C
        \uC7A5\uBE44: \uBB3C/\uBC14\uB78C \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Feu/Terre. \xC9quipement recommand\xE9
        : Eau/Vent"
      de: "Gebiet mit Feuer/Erde-Attribut-Monstern. Empfohlene Ausr\xFCstung: Wasser/Wind"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u041E\u0433\u043D\u044F \u0438 \u0417\u0435\u043C\u043B\u0438.
        \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u0412\u043E\u0434\u0430
        \u0438 \u0412\u0435\u0442\u0435\u0440"
      es: "\xC1rea habitada por monstruos de Fuego/Tierra. Equipo recomendado: Agua/Viento"
      pt: "\xC1rea habitada por monstros de Fogo/Terra. Equipamento recomendado:
        \xC1gua/Vento"
      it: 'Area abitata da mostri Fuoco/Terra. Equipaggiamento consigliato: Acqua/Vento'
      tr: "Ate\u015F/ Toprak \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: Su/ R\xFCzgar \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt H\u1ECFa/Th\u1ED5. Trang b\u1ECB \u0111\u1EC1
        xu\u1EA5t: Th\u1EE7y/Phong"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E44\u0E1F/\u0E14\u0E34\u0E19
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E19\u0E49\u0E33/\u0E25\u0E21"
      pl: "Obszar zamieszkany przez potwory Ognia/Ziemi. Polecane wyposa\u017Cenie:
        Woda/Wiatr"
      nl: 'Gebied met Vuur/Aarde-attribuutmonsters. Aanbevolen uitrusting: Water/Wind'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u03A6\u03C9\u03C4\u03B9\u03AC\u03C2/\u0393\u03B7\u03C2. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u039D\u03B5\u03C1\u03CC/\u0386\u03BD\u03B5\u03BC\u03BF\u03C2"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u0646\u0627\u0631/\u0627\u0644\u0623\u0631\u0636. \u064A\u064F\u0646\u0635\u062D
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0639\u062F\u0627\u062A
        \u0627\u0644\u0645\u0627\u0621/\u0627\u0644\u0631\u064A\u0627\u062D"
      hi: "\u0906\u0917 \u0914\u0930 \u092E\u093F\u091F\u094D\u091F\u0940 \u0917\u0941\u0923
        \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u092A\u093E\u0928\u0940
        \u0914\u0930 \u0939\u0935\u093E \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u0622\u06AF \u0627\u0648\u0631 \u0645\u0679\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u067E\u0627\u0646\u06CC \u0627\u0648\u0631 \u06C1\u0648\u0627 \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa api dan tanah. Disarankan peralatan air dan angin.
      id: Area dihuni monster api dan tanah. Disarankan peralatan air dan angin.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05D0\u05E9 \u05D5\u05D0\u05D3\u05DE\u05D4,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05DE\u05D9\u05DD \u05D5\u05E8\u05D5\u05D7\""
      sv: '"Monster med eld- och jordattribut, rekommenderas vatten- och vindutrustning"'
      cs: "\"Monstra s ohn\u011Bm a zem\xED, doporu\u010Duje se vodn\xED a v\u011Btrn\xE1
        v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u0432\u043E\u0433\u043D\u0435\u043C
        \u0456 \u0437\u0435\u043C\u043B\u0435\u044E, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0432\u043E\u0434\u0438
        \u0442\u0430 \u0432\u0456\u0442\u0440\u0443\""
      ro: "\"Mon\u0219tri cu atributul foc \u0219i p\u0103m\xE2nt, echipament recomandat
        ap\u0103 \u0219i v\xE2nt\""
      no: '"Monstre med ild- og jordattributter, anbefalt vann- og vindutstyr"'
      hu: "T\u0171z \xE9s f\xF6ld sz\xF6rnyek, v\xEDz \xE9s sz\xE9l felszerel\xE9s
        aj\xE1nlott"
      sw: Wanyama wa moto na udongo, vaa vifaa vya maji na upepo
      sr: "Vatra i zemlja \u010Dudovi\u0161ta, nositi vodu i vetar opremu"
      fi: "Alueella asustaa tuli- ja maa-aiheisia hirvi\xF6it\xE4. Suositeltu varustus:
        vesi- ja tuuli-aiheiset varusteet."
      da: "Omr\xE5de med ild- og jord-attributmonstre. Anbefalet udstyr: vand- og
        vind-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u51B0\u5C5E\u6027\u3001\u6C34\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u706B\u5C5E\u6027\u3001\u571F\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Ice and Water attribute monsters. Recommended equipment:
        Fire and Earth attribute gear.'
      tw: "\u5206\u4F48\u6709\u51B0\u5C6C\u6027\u3001\u6C34\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u706B\u5C6C\u6027\u3001\u571F\u5C6C\u6027\u88DD\u5099"
      ja: "\u6C37\u5C5E\u6027\u3068\u6C34\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u706B\u5C5E\u6027\u30FB\u571F\u5C5E\u6027\u88C5\u5099"
      ko: "\uC5BC\uC74C/\uBB3C \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0. \uCD94\uCC9C
        \uC7A5\uBE44: \uBD88/\uB545 \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Glace/Eau. \xC9quipement recommand\xE9
        : Feu/Terre"
      de: "Gebiet mit Eis/Wasser-Attribut-Monstern. Empfohlene Ausr\xFCstung: Feuer/Erde"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u041B\u044C\u0434\u0430 \u0438 \u0412\u043E\u0434\u044B.
        \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u041E\u0433\u043E\u043D\u044C
        \u0438 \u0417\u0435\u043C\u043B\u044F"
      es: "\xC1rea habitada por monstruos de Hielo/Agua. Equipo recomendado: Fuego/Tierra"
      pt: "\xC1rea habitada por monstros de Gelo/\xC1gua. Equipamento recomendado:
        Fogo/Terra"
      it: 'Area abitata da mostri Ghiaccio/Acqua. Equipaggiamento consigliato: Fuoco/Terra'
      tr: "Buz/ Su \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131 b\xF6lge.
        \xD6nerilen ekipman: Ate\u015F/ Toprak \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt B\u0103ng/Th\u1EE7y. Trang b\u1ECB
        \u0111\u1EC1 xu\u1EA5t: H\u1ECFa/Th\u1ED5"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07/\u0E19\u0E49\u0E33
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E44\u0E1F/\u0E14\u0E34\u0E19"
      pl: "Obszar zamieszkany przez potwory Lodu/Wody. Polecane wyposa\u017Cenie:
        Ogie\u0144/Ziemia"
      nl: 'Gebied met IJs/Water-attribuutmonsters. Aanbevolen uitrusting: Vuur/Aarde'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u03A0\u03AC\u03B3\u03BF\u03C5/\u039D\u03B5\u03C1\u03BF\u03CD. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u03A6\u03C9\u03C4\u03B9\u03AC/\u0393\u03B7"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u062C\u0644\u064A\u062F/\u0627\u0644\u0645\u0627\u0621. \u064A\u064F\u0646\u0635\u062D
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0639\u062F\u0627\u062A
        \u0627\u0644\u0646\u0627\u0631/\u0627\u0644\u0623\u0631\u0636"
      hi: "\u092C\u0930\u094D\u092B \u0914\u0930 \u092A\u093E\u0928\u0940 \u0917\u0941\u0923
        \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u0906\u0917
        \u0914\u0930 \u092E\u093F\u091F\u094D\u091F\u0940 \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u0628\u0631\u0641 \u0627\u0648\u0631 \u067E\u0627\u0646\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u0622\u06AF \u0627\u0648\u0631 \u0645\u0679\u06CC \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa ais dan air. Disarankan peralatan api dan tanah.
      id: Area dihuni monster es dan air. Disarankan peralatan api dan tanah.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05E7\u05E8\u05D7 \u05D5\u05DE\u05D9\u05DD,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05D0\u05E9 \u05D5\u05D0\u05D3\u05DE\u05D4\""
      sv: '"Monster med is- och vattenattribut, rekommenderas eld- och jordutrustning"'
      cs: "\"Monstra s ledem a vodou, doporu\u010Duje se ohniv\xE1 a zemn\xED v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u043B\u044C\u043E\u0434\u043E\u043C
        \u0456 \u0432\u043E\u0434\u043E\u044E, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0432\u043E\u0433\u043D\u044E
        \u0442\u0430 \u0437\u0435\u043C\u043B\u0456\""
      ro: "\"Mon\u0219tri cu atributul ghea\u021B\u0103 \u0219i ap\u0103, echipament
        recomandat foc \u0219i p\u0103m\xE2nt\""
      no: '"Monstre med is- og vannattributter, anbefalt ild- og jordutstyr"'
      hu: "J\xE9g \xE9s v\xEDz sz\xF6rnyek, t\u0171z \xE9s f\xF6ld felszerel\xE9s
        aj\xE1nlott"
      sw: Wanyama wa barafu na maji, vaa vifaa vya moto na udongo
      sr: "Led i voda \u010Dudovi\u0161ta, nositi vatru i zemlju opremu"
      fi: "Alueella asustaa j\xE4\xE4- ja vesiaiheisia hirvi\xF6it\xE4. Suositeltu
        varustus: tuli- ja maa-aiheiset varusteet."
      da: "Omr\xE5de med is- og vand-attributmonstre. Anbefalet udstyr: ild- og jord-attributudstyr."
    - cn: "\u5206\u5E03\u6709\u98CE\u5C5E\u6027\u3001\u51B0\u5C5E\u6027\u602A\u7269,\u9002\u5408\u7A7F\u6234\u51B0\u5C5E\u6027\u3001\u706B\u5C5E\u6027\u88C5\u5907"
      en: 'Area inhabited by Wind and Ice attribute monsters. Recommended equipment:
        Ice and Fire attribute gear.'
      tw: "\u5206\u4F48\u6709\u98A8\u5C6C\u6027\u3001\u51B0\u5C6C\u6027\u602A\u7269\uFF0C\u9069\u5408\u7A7F\u6234\u51B0\u5C6C\u6027\u3001\u706B\u5C6C\u6027\u88DD\u5099"
      ja: "\u98A8\u5C5E\u6027\u3068\u6C37\u5C5E\u6027\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\u751F\u606F\u3002\u63A8\u5968\u88C5\u5099\uFF1A\u6C37\u5C5E\u6027\u30FB\u706B\u5C5E\u6027\u88C5\u5099"
      ko: "\uBC14\uB78C/\uC5BC\uC74C \uC18D\uC131 \uBAAC\uC2A4\uD130 \uCD9C\uBAB0.
        \uCD94\uCC9C \uC7A5\uBE44: \uC5BC\uC74C/\uBD88 \uC18D\uC131 \uC7A5\uBE44"
      fr: "Zone habit\xE9e par des monstres Vent/Glace. \xC9quipement recommand\xE9
        : Glace/Feu"
      de: "Gebiet mit Wind/Eis-Attribut-Monstern. Empfohlene Ausr\xFCstung: Eis/Feuer"
      ru: "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0441 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0445\u0438\u0439 \u0412\u0435\u0442\u0440\u0430 \u0438
        \u041B\u044C\u0434\u0430. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430: \u041B\u0451\u0434
        \u0438 \u041E\u0433\u043E\u043D\u044C"
      es: "\xC1rea habitada por monstruos de Viento/Hielo. Equipo recomendado: Hielo/Fuego"
      pt: "\xC1rea habitada por monstros de Vento/Gelo. Equipamento recomendado:
        Gelo/Fogo"
      it: 'Area abitata da mostri Vento/Ghiaccio. Equipaggiamento consigliato: Ghiaccio/Fuoco'
      tr: "R\xFCzgar/ Buz \xF6zellikli canavarlar\u0131n ya\u015Fad\u0131\u011F\u0131
        b\xF6lge. \xD6nerilen ekipman: Buz/ Ate\u015F \xF6zellikli"
      vi: "Khu v\u1EF1c c\xF3 qu\xE1i v\u1EADt Phong/B\u0103ng. Trang b\u1ECB \u0111\u1EC1
        xu\u1EA5t: B\u0103ng/H\u1ECFa"
      th: "\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E21\u0E35\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E25\u0E21/\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07
        \u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07/\u0E44\u0E1F"
      pl: "Obszar zamieszkany przez potwory Wiatru/Lodu. Polecane wyposa\u017Cenie:
        L\xF3d/Ogie\u0144"
      nl: 'Gebied met Wind/IJs-attribuutmonsters. Aanbevolen uitrusting: IJs/Vuur'
      el: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C4\u03AD\u03C1\u03B1\u03C4\u03B1
        \u0391\u03BD\u03AD\u03BC\u03BF\u03C5/\u03A0\u03AC\u03B3\u03BF\u03C5. \u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
        \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1: \u03A0\u03AC\u03B3\u03BF\u03C2/\u03A6\u03C9\u03C4\u03B9\u03AC"
      ar: "\u0645\u0646\u0637\u0642\u0629 \u062A\u0633\u0643\u0646\u0647\u0627 \u0648\u062D\u0648\u0634
        \u0627\u0644\u0631\u064A\u0627\u062D/\u0627\u0644\u062C\u0644\u064A\u062F.
        \u064A\u064F\u0646\u0635\u062D \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0645\u0639\u062F\u0627\u062A \u0627\u0644\u062C\u0644\u064A\u062F/\u0627\u0644\u0646\u0627\u0631"
      hi: "\u0939\u0935\u093E \u0914\u0930 \u092C\u0930\u094D\u092B \u0917\u0941\u0923
        \u0935\u093E\u0932\u0947 \u0930\u093E\u0915\u094D\u0937\u0938\u094B\u0902
        \u0915\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930\u0964 \u092C\u0930\u094D\u092B
        \u0914\u0930 \u0906\u0917 \u0917\u0941\u0923 \u0909\u092A\u0915\u0930\u0923
        \u092A\u0939\u0928\u0947\u0902\u0964"
      ur: "\u06C1\u0648\u0627 \u0627\u0648\u0631 \u0628\u0631\u0641 \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u06D2 \u0639\u0641\u0631\u06CC\u062A\u0648\u06BA \u06A9\u0627 \u0639\u0644\u0627\u0642\u06C1\u06D4
        \u0628\u0631\u0641 \u0627\u0648\u0631 \u0622\u06AF \u062E\u0635\u0648\u0635\u06CC\u062A
        \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646 \u067E\u06C1\u0646\u06CC\u06BA\u06D4"
      ms: Kawasan didiami raksasa angin dan ais. Disarankan peralatan ais dan api.
      id: Area dihuni monster angin dan es. Disarankan peralatan es dan api.
      he: "\"\u05DE\u05E4\u05DC\u05E6\u05D5\u05EA \u05E8\u05D5\u05D7 \u05D5\u05E7\u05E8\u05D7,
        \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05DC\u05D1\u05D5\u05E9 \u05E6\u05D9\u05D5\u05D3
        \u05E7\u05E8\u05D7 \u05D5\u05D0\u05E9\""
      sv: '"Monster med vind- och isattribut, rekommenderas is- och eldutrustning"'
      cs: "\"Monstra s v\u011Btrem a ledem, doporu\u010Duje se ledov\xE1 a ohniv\xE1
        v\xFDbava\""
      uk: "\"\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437 \u0432\u0456\u0442\u0440\u043E\u043C
        \u0456 \u043B\u044C\u043E\u0434\u043E\u043C, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u043B\u044C\u043E\u0434\u0443
        \u0442\u0430 \u0432\u043E\u0433\u043D\u044E\""
      ro: "\"Mon\u0219tri cu atributul v\xE2nt \u0219i ghea\u021B\u0103, echipament
        recomandat ghea\u021B\u0103 \u0219i foc\""
      no: '"Monstre med vind- og isattributter, anbefalt is- og ildutstyr"'
      hu: "Sz\xE9l \xE9s j\xE9g sz\xF6rnyek, j\xE9g \xE9s t\u0171z felszerel\xE9s
        aj\xE1nlott"
      sw: Wanyama wa upepo na barafu, vaa vifaa vya barafu na moto
      sr: "Vetar i led \u010Dudovi\u0161ta, nositi led i vatru opremu"
      fi: "Alueella asustaa tuuli- ja j\xE4\xE4aiheisia hirvi\xF6it\xE4. Suositeltu
        varustus: j\xE4\xE4- ja tuli-aiheiset varusteet."
      da: "Omr\xE5de med vind- og is-attributmonstre. Anbefalet udstyr: is- og ild-attributudstyr."
