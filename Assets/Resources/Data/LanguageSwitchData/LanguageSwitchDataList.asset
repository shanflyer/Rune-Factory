      tw: "\u5C64\u6B21\u8C50\u5BCC\uFF0C\u593E\u88F9\u591A\u7A2E\u98DF\u6750\uFF0C\u662F\u5FEB\u6377\u7F8E\u5473\u7684\u98FD\u8179\u4F73\u991A"
      ja: "\u591A\u5C64\u69CB\u9020\u3067\u5177\u6750\u305F\u3063\u3077\u308A\u306E\u624B\u8EFD\u306A\u6E80\u8DB3\u6599\u7406"
      ko: "\uB2E4\uC591\uD55C \uC7AC\uB8CC\uAC00 \uCE35\uCE35\uC774 \uC313\uC778
