      hi: "\u0924\u093E\u091C\u093C\u093E \u0915\u093E\u0930\u094D\u092A \u0914\u0930
        \u0915\u0941\u0930\u0915\u0941\u0930\u0940 \u0938\u092C\u094D\u091C\u093C\u093F\u092F\u094B\u0902
