      da: "Vihannesten yhdistelm\xE4"
    - cn: "\u9C9C\u7EA2\u6E05\u751C\uFF0C\u590F\u65E5\u6D88\u6691\u7684\u7EDD\u4F73\u996E\u54C1\u3002"
      en: Bright red, sweet, perfect for summer.
      tw: "\u9BAE\u7D05\u6E05\u751C\uFF0C\u590F\u65E5\u6D88\u6691\u7684\u7D55\u4F73\u98F2\u54C1"
      ja: "\u771F\u3063\u8D64\u3067\u7518\u304F\u590F\u306B\u3074\u3063\u305F\u308A\u306E\u30C9\u30EA\u30F3\u30AF"
