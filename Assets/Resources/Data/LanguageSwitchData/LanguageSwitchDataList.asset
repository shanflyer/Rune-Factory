      el: "\u0391\u03C6\u03C1\u03CE\u03B4\u03B5\u03C2 \u03BC\u03B5 \u03B3\u03B5\u03CD\u03C3\u03B7
        \u03B2\u03CD\u03BD\u03B7\u03C2"
      ar: "\u0631\u063A\u0648\u0629 \u063A\u0646\u064A\u0629 \u0628\u0646\u0643\u0647\u0629
        \u0627\u0644\u0634\u0639\u064A\u0631 \u0648\u0627\u0644\u062C\u0639\u0629"
      hi: "\u092E\u093E\u0932\u094D\u091F \u0914\u0930 \u0939\u0949\u092A\u094D\u0938
        \u0915\u0947 \u0938\u093E\u0925 \u0917\u093E\u0922\u093C\u093E \u091D\u093E\u0917,
        \u0924\u093E\u091C\u093C\u0917\u0940\u0926\u093E\u092F\u0915 \u0914\u0930
        \u092A\u094D\u092F\u093E\u0938 \u092C\u0941\u091D\u093E\u0928\u0947 \u0935\u093E\u0932\u093E"
      ur: "\u0645\u0627\u0644\u0679 \u0627\u0648\u0631 \u06C1\u0627\u067E\u0633 \u06A9\u06D2
        \u0633\u0627\u062A\u06BE \u06AF\u0627\u0691\u06BE\u0627 \u062C\u06BE\u0627\u06AF\u060C
        \u062A\u0627\u0632\u06AF\u06CC \u062F\u06CC\u0646\u06D2 \u0648\u0627\u0644\u0627
        \u0627\u0648\u0631 \u067E\u06CC\u0627\u0633 \u0628\u062C\u06BE\u0627\u0646\u06D2
        \u0648\u0627\u0644\u0627\u06D4"
      ms: Buih pekat dengan malt dan hop, menyegarkan dan menghilangkan dahaga.
      id: Busa kaya dengan malt dan hop, menyegarkan dan menghilangkan dahaga.
      he: "\u05E7\u05E6\u05E3 \u05E2\u05E9\u05D9\u05E8, \u05D8\u05E2\u05DD \u05DE\u05DC\u05EA
        \u05D5\u05E6\u05DE\u05D7\u05D9"
      sv: Rikt skum, malt och humle
      cs: "Bohat\xE1 p\u011Bna, slad a chmel"
      uk: "\u0411\u0430\u0433\u0430\u0442\u0430 \u043F\u0456\u043D\u0430, \u0441\u043E\u043B\u043E\u0434
