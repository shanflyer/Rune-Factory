        \u0938\u0902\u0924\u0941\u0932\u093F\u0924 \u092A\u094B\u0937\u0923"
      ur: "\u062A\u0627\u0632\u06C1 \u06A9\u0627\u0631\u067E \u0627\u0648\u0631 \u06A9\u0631\u06A9\u0631\u06D2
        \u0633\u0628\u0632\u06CC\u0648\u06BA \u06A9\u06D2 \u0633\u0627\u062A\u06BE
