      th: "\u0E01\u0E38\u0E49\u0E07\u0E41\u0E14\u0E07\u0E2A\u0E14\u0E0A\u0E37\u0E48\u0E19\u0E08\u0E32\u0E01\u0E17\u0E49\u0E2D\u0E07\u0E17\u0E30\u0E40\u0E25"
      pl: Czerwona krewetka w pancerzu
      nl: Rode garnalen met vers sappig vlees
      el: "\u039A\u03CC\u03BA\u03BA\u03B9\u03BD\u03B1 \u03B3\u03B1\u03C1\u03AF\u03B4\u03B5\u03C2
        \u03BC\u03B5 \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03CC \u03BA\u03C1\u03AD\u03B1\u03C2"
      ar: "\u062C\u0645\u0628\u0631\u064A \u0623\u062D\u0645\u0631 \u0637\u0627\u0632\u062C
        \u0628\u0642\u0634\u0631\u0629 \u0635\u0644\u0628\u0629"
      hi: "\u0932\u093E\u0932 \u0915\u0935\u091A \u0938\u0947 \u0922\u0915\u0947
        \u0924\u093E\u091C\u093C\u093E \u091D\u0940\u0902\u0917\u093E"
      ur: "\u0633\u0631\u062E \u062E\u0648\u0644 \u0633\u06D2 \u0688\u06BE\u06A9\u06D2
