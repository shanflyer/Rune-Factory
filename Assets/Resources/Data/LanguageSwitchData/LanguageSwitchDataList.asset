      nl: Mystieke rode drank
      el: "\u039C\u03C5\u03C3\u03C4\u03B7\u03C1\u03B9\u03CE\u03B4\u03B5\u03C2 \u03BA\u03CC\u03BA\u03BA\u03B9\u03BD\u03BF
        \u03C0\u03BF\u03C4\u03CC"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u0623\u062D\u0645\u0631 \u063A\u0627\u0645\u0636"
      hi: "\u091A\u092E\u0915\u0940\u0932\u093E \u0932\u093E\u0932 \u0930\u0902\u0917,
        \u0935\u093F\u0936\u093F\u0937\u094D\u091F \u0938\u094D\u0935\u093E\u0926,
        \u0930\u0939\u0938\u094D\u092F \u0914\u0930 \u0906\u0915\u0930\u094D\u0937\u0923
        \u092A\u094D\u0930\u0926\u093E\u0928 \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0686\u0645\u06A9\u06CC\u0644\u0627\u0644\u0627\u0644 \u0631\u0646\u06AF\u060C
        \u0645\u062E\u0635\u0648\u0635 \u0630\u0627\u0626\u0642\u06C1\u060C \u067E\u0631\u0627\u0633\u0631\u0627\u0631
        \u0627\u0648\u0631 \u062F\u0644\u06A9\u0634\u06CC \u067E\u06BE\u06CC\u0644\u0627\u062A\u0627
        \u06C1\u06D2\u06D4"
      ms: Warna merah terang dengan rasa unik, memancarkan misteri dan daya tarikan.
      id: Warna merah terang dengan rasa khas, memancarkan misteri dan daya tarik.
