        \u092E\u091B\u0932\u0940, \u0909\u0937\u094D\u0923\u0915\u091F\u093F\u092C\u0902\u0927\u0940\u092F
        \u0927\u0942\u092A \u091C\u0948\u0938\u093E \u092E\u093E\u0902\u0938"
      ur: "\u0631\u0646\u06AF\u06CC\u0646 \u0627\u0648\u0631 \u0627\u0633\u0679\u0627\u0626\u0644\u0634
        \u0645\u0686\u06BE\u0644\u06CC\u060C \u06AF\u0631\u0645 \u062E\u0637\u06D2
        \u06A9\u06CC \u062F\u06BE\u0648\u067E \u062C\u06CC\u0633\u0627 \u06AF\u0648\u0634\u062A"
      ms: Gurita di pasir atau karang dasar laut
      id: Gurita di pasir atau karang dasar laut
      he: "\u05EA\u05DE\u05E0\u05D5\u05DF \u05E2\u05DC \u05E7\u05E8\u05E7\u05E2\u05D9\u05EA
        \u05D4\u05D9\u05DD, \u05D6\u05E8\u05D5\u05E2\u05D5\u05EA\u05D9\u05D5 \u05E0\u05E2\u05D5\u05EA
