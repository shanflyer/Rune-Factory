      ar: "\u064A\u062E\u0646\u0629 \u0643\u0627\u0628\u0648\u0631\u064A\u0627 \u063A\u0646\u064A\u0629"
      hi: "\u0935\u093F\u092D\u093F\u0928\u094D\u0928 \u0938\u093E\u092E\u0917\u094D\u0930\u093F\u092F\u094B\u0902
        \u0915\u0947 \u0938\u093E\u0925 \u0938\u094D\u091F\u094D\u092F\u0942 \u0915\u0930\u0928\u0947
        \u092A\u0930, \u0938\u092E\u0943\u0926\u094D\u0927 \u0915\u0947\u0915\u0921\u093C\u093E
        \u0938\u094D\u0935\u093E\u0926 \u0914\u0930 \u0917\u093E\u0922\u093C\u093E
        \u0936\u094B\u0930\u092C\u093E"
      ur: "\u0645\u062E\u062A\u0644\u0641 \u0627\u062C\u0632\u0627\u0621 \u06A9\u06D2
