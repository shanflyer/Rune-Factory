      ur: "\u0686\u0645\u06A9\u06CC\u0644\u0627\u0644\u0627\u0644\u060C \u0645\u06CC\u0679\u06BE\u0627\u060C
        \u06AF\u0631\u0645\u06CC\u0648\u06BA \u06A9\u06D2 \u0644\u06CC\u06D2 \u0628\u06C1\u062A\u0631\u06CC\u0646\u06D4"
