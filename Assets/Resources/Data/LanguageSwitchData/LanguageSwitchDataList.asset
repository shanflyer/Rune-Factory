      ar: "\u0627\u0644\u0646\u0648\u0645 \u0644\u0645\u062F\u0629 \u0633\u0627\u0639\u062A\u064A\u0646"
      hi: "2 \u0918\u0902\u091F\u0947 \u0938\u094B\u090F\u0901\u06D4"
