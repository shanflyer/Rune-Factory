      id: Menggabungkan dua rasa beri, aroma buah pekat.
      he: "\u05E9\u05D9\u05DC\u05D5\u05D1 \u05E9\u05E0\u05D9 \u05E4\u05D9\u05E8\u05D5\u05EA
        \u05D9\u05E2\u05E8, \u05D0\u05E8\u05D5\u05DE\u05D4 \u05E2\u05E9\u05D9\u05E8\u05D4"
      sv: "Blandning av tv\xE5 b\xE4r, fruktig smak"
      cs: "Kombinace dvou lesn\xEDch plod\u016F, ovocn\xE1 chu\u0165"
