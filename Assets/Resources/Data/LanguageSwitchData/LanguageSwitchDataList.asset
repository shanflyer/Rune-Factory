        [\u0636\u0631\u0628\u0629 \u0627\u0644\u0645\u0639\u062C\u0632\u0629]"
      hi: "[\u091A\u092E\u0924\u094D\u0915\u093E\u0930\u0940 \u092A\u094D\u0930\u0939\u093E\u0930]
        \u0915\u094C\u0936\u0932 \u0938\u0915\u094D\u0930\u093F\u092F \u0915\u0930\u0928\u0947
        \u0935\u093E\u0932\u0940 \u092E\u093F\u0925\u094D\u0930\u093F\u0932 \u0924\u0932\u0935\u093E\u0930"
      ur: "[\u0645\u0639\u062C\u0632\u06C1 \u0648\u0627\u0631] \u0645\u06C1\u0627\u0631\u062A
