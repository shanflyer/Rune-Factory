      uk: "\u0413\u0435\u0440\u0431 \u0434\u0430\u0432\u043D\u044C\u043E\u0433\u043E
        \u043B\u0438\u0446\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0443"
