      ar: "\u0637\u0628\u0642 \u0645\u0646\u0632\u0644\u064A \u062F\u0627\u0641\u0626
        \u0645\u0639 \u0645\u0631\u0642 \u063A\u0646\u064A"
      hi: "\u0938\u092E\u0943\u0926\u094D\u0927 \u0914\u0930 \u0938\u093E\u092E\u0902\u091C\u0938\u094D\u092F\u092A\u0942\u0930\u094D\u0923
        \u0936\u094B\u0930\u092C\u093E, \u0917\u0930\u094D\u092E\u091C\u094B\u0936\u0940
        \u0914\u0930 \u0938\u0902\u0924\u094B\u0937\u091C\u0928\u0915 \u0918\u0930
        \u0915\u093E \u092C\u0928\u093E \u0935\u094D\u092F\u0902\u091C\u0928"
      ur: "\u06AF\u0627\u0691\u06BE\u0627 \u0627\u0648\u0631 \u06C1\u0645 \u0622\u06C1\u0646\u06AF
        \u0634\u0648\u0631\u0628\u06C1\u060C \u06AF\u0631\u0645\u062C\u0648\u0634\u06CC
        \u0627\u0648\u0631 \u0627\u0637\u0645\u06CC\u0646\u0627\u0646 \u0628\u062E\u0634
