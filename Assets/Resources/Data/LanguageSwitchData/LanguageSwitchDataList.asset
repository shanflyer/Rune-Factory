      he: "\u05DE\u05DC\u05D5\u05D7 \u05D5\u05D7\u05DE\u05D5\u05E5 \u05D1\u05DE\u05D9\u05D3\u05D4,
        \u05D8\u05E8\u05D9 \u05D5\u05DE\u05D2\u05E8\u05D4"
      sv: "Balanserad salt och syra, fr\xE4sch och aptitretande"
      cs: "Vyv\xE1\u017Een\u011B slan\xE1 a kysel\xE1, sv\u011B\u017E\xED a povzbuzuj\xEDc\xED"
      uk: "\u0417\u0431\u0430\u043B\u0430\u043D\u0441\u043E\u0432\u0430\u043D\u0438\u0439
