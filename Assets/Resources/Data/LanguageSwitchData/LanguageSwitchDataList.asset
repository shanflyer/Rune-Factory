      nl: Mals vis met knapperige huid
      el: "\u03A4\u03C1\u03C5\u03C6\u03B5\u03C1\u03CC \u03C8\u03AC\u03C1\u03B9 \u03BC\u03B5
        \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03CC \u03B4\u03AD\u03C1\u03BC\u03B1"
      ar: "\u0633\u0645\u0643 \u0642\u0627\u0631\u0648\u0635 \u0637\u0631\u064A \u0628\u0642\u0634\u0631\u0629
        \u0645\u0642\u0631\u0645\u0634\u0629"
      hi: "\u0928\u0930\u092E \u092E\u091B\u0932\u0940, \u0915\u0930\u093E\u0930\u093E
        \u092C\u093E\u0939\u0930\u0940 \u092A\u0930\u0924 \u0914\u0930 \u0928\u0930\u092E
        \u0905\u0902\u0926\u0930, \u0938\u0940 \u092C\u093E\u0938 \u0915\u0940 \u0936\u0948\u0932\u0940
        \u0915\u094B \u092C\u0930\u0915\u0930\u093E\u0930"
      ur: "\u0646\u0631\u0645 \u0645\u0686\u06BE\u0644\u06CC\u060C \u06A9\u0631\u06A9\u0631\u0627
        \u0628\u06CC\u0631\u0648\u0646\u06CC \u067E\u0631\u062A \u0627\u0648\u0631
        \u0646\u0631\u0645 \u0627\u0646\u062F\u0631\u060C \u0633\u06CC \u0628\u0627\u0633
        \u06A9\u06CC \u0634\u0627\u0646 \u0645\u062D\u0641\u0648\u0638\u06D4"
