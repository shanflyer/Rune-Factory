      de: Goldforelle mit Salzhauch
      ru: "\u0417\u043E\u043B\u043E\u0442\u0430\u044F \u0444\u043E\u0440\u0435\u043B\u044C
        \u0441 \u043B\u0435\u0433\u043A\u043E\u0439 \u0441\u043E\u043B\u044C\u044E"
