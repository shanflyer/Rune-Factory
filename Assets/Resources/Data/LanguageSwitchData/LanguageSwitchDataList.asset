      ja: "\u65B0\u9BAE\u3067\u30B7\u30E3\u30AD\u30B7\u30E3\u30AD\u3001\u91CE\u83DC\u306E\u5065\u5EB7\u3068\u7F8E\u5473\u306E\u5171\u6F14"
