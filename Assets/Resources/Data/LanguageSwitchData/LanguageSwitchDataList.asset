    - cn: "\u9A6C\u7684\u5C3E\u6BDB\uFF0C\u957F\u800C\u575A\u97E7\uFF0C\u6709\u5F88\u591A\u7528\u9014\u3002"
      en: Horse tail hair, long and durable, has many uses
      tw: "\u99AC\u7684\u5C3E\u6BDB\uFF0C\u9577\u800C\u5805\u97CC\uFF0C\u6709\u5F88\u591A\u7528\u9014"
      ja: "\u99AC\u306E\u5C3E\u6BDB\u3001\u9577\u304F\u9811\u4E08\u3067\u591A\u7528\u9014\u306B\u4F7F\u7528\u53EF\u80FD"
      ko: "\uB9D0 \uAF2C\uB9AC\uD138, \uAE38\uACE0 \uD2BC\uD2BC\uD558\uBA70 \uB2E4\uC6A9\uB3C4"
