      vi: "V\u1EADt li\u1EC7u c\u01A1 b\u1EA3n may qu\u1EA7n \xE1o"
      th: "\u0E27\u0E31\u0E2A\u0E14\u0E38\u0E1E\u0E37\u0E49\u0E19\u0E10\u0E32\u0E19\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E15\u0E31\u0E14\u0E40\u0E22\u0E47\u0E1A\u0E40\u0E2A\u0E37\u0E49\u0E2D\u0E1C\u0E49\u0E32"
      pl: "Podstawowy Materia\u0142 do Odzie\u017Cy"
      nl: Basismateriaal voor Kleding
      el: "\u0392\u03B1\u03C3\u03B9\u03BA\u03CC \u03C5\u03BB\u03B9\u03BA\u03CC \u03B3\u03B9\u03B1
        \u03C1\u03BF\u03CD\u03C7\u03B1"
      ar: "\u0645\u0648\u0627\u062F \u0623\u0633\u0627\u0633\u064A\u0629 \u0644\u0635\u0646\u0639
        \u0627\u0644\u0645\u0644\u0627\u0628\u0633"
      hi: "\u0935\u0938\u094D\u0924\u094D\u0930 \u0928\u093F\u0930\u094D\u092E\u093E\u0923
