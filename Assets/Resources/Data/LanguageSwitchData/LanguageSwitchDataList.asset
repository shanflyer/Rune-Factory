      ru: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0437\u0432\u0435\u0440\u044C,
        \u0434\u0430\u0451\u0442 [\u0417\u0432\u0435\u0440\u0438\u043D\u044B\u0439
        \u0440\u043E\u0433]"
      es: "Bestia com\xFAn, produce [Cuerno de bestia]"
      pt: 'Fera comum, produz [Chifre de fera]'
      it: 'Bestia comune, produce [Corno di bestia]'
      tr: "S\u0131radan canavar, [Canavar Boynuzu] \xFCretir"
      vi: "Th\xFA th\u01B0\u1EDDng, s\u1EA3n xu\u1EA5t [S\u1EEBng th\xFA]"
      th: "\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B \u0E1C\u0E25\u0E34\u0E15
        [\u0E40\u0E02\u0E32\u0E2A\u0E31\u0E15\u0E27\u0E4C]"
      pl: "Zwyk\u0142a bestia, wytwarza [Bestiarski r\xF3g]"
      nl: 'Gewoon beest, produceert [Beestenhoren]'
      el: "\u03A3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03B8\u03B7\u03C1\u03AF\u03BF,
        \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9 [\u03A6\u03C9\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC
        \u03BA\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\u03BF]"
      ar: "\u0648\u062D\u0634 \u0639\u0627\u062F\u064A\u060C \u064A\u0646\u062A\u062C
        [\u0642\u0631\u0646 \u0627\u0644\u0648\u062D\u0634]"
      hi: "\u0938\u093E\u0927\u093E\u0930\u0923 \u091C\u093E\u0928\u0935\u0930, [\u091C\u093E\u0928\u0935\u0930
        \u0915\u093E \u0938\u0940\u0902\u0917] \u0909\u0924\u094D\u092A\u0928\u094D\u0928
        \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0639\u0627\u0645 \u062C\u0627\u0646\u0648\u0631\u060C [\u062C\u0627\u0646\u0648\u0631
        \u06A9\u0627 \u0633\u06CC\u0646\u06AF] \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062A\u0627
        \u06C1\u06D2"
      ms: 'Binatang biasa, hasilkan [Tanduk binatang]'
      id: 'Hewan biasa, menghasilkan [Tanduk hewan]'
    - cn: "\u666E\u901A\u7684\u517D\u7C7B\uFF0C\u53EF\u4EE5\u4EA7\u51FA[\u706B\u6676\u77F3]"
      en: 'Common beast, produces [Fire Crystal]'
