        \u0914\u0930 \u0939\u0932\u094D\u0915\u093E, \u090F\u0915 \u0938\u094D\u0935\u0938\u094D\u0925
        \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F \u0938\u093E\u0907\u0921
        \u0921\u093F\u0936"
      ur: "\u0628\u0627\u06C1\u0631 \u0633\u06D2 \u06C1\u0644\u06A9\u0627 \u062C\u0644\u0627
        \u0627\u0648\u0631 \u06A9\u0631\u06A9\u0631\u0627\u060C \u062A\u0627\u0632\u06C1
        \u0627\u0648\u0631 \u06C1\u0644\u06A9\u0627\u060C \u0627\u06CC\u06A9 \u0635\u062D\u062A
        \u0645\u0646\u062F \u0627\u0648\u0631 \u0644\u0630\u06CC\u0630 \u0633\u0627\u0626\u06CC\u0688
