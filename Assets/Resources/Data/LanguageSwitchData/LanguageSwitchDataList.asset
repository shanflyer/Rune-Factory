      ja: "\u5916\u5074\u306F\u9999\u3070\u3057\u304F\u30B5\u30AF\u30B5\u30AF\u3001\u4E2D\u306F\u67D4\u3089\u304B\u3067\u72EC\u7279\u306A\u5F8C\u5473"
