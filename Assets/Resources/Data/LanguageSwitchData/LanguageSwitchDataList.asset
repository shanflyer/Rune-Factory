      vi: "H\u1ED7n h\u1EE3p h\u1EA3i s\u1EA3n t\u01B0\u01A1i ngon \u0111\u1EADm
        v\u1ECB"
      th: "\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E23\u0E27\u0E21\u0E17\u0E30\u0E40\u0E25\u0E23\u0E2A\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19"
