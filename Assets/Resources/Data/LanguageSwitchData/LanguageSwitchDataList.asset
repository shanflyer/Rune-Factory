        \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u0642\u0634\u0631\u0629 \u0645\u0642\u0631\u0645\u0634\u0629 \u0648\u062F\u0627\u062E\u0644
        \u0637\u0631\u064A \u0645\u0639 \u0646\u0643\u0647\u0629 \u0641\u0631\u064A\u062F\u0629"
      hi: "\u092C\u093E\u0939\u0930 \u0915\u0930\u093E\u0930\u093E, \u0905\u0902\u0926\u0930
        \u0928\u0930\u092E, \u0935\u093F\u0936\u093F\u0937\u094D\u091F \u0914\u0930
