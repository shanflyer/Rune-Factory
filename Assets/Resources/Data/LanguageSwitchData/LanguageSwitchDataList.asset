      tw: "\u672A\u6210\u719F\u7684\u690D\u7269\u88FD\u6210\u7684\u9BAE\u5AE9\u53EF\u53E3\u7684\u98FC\u6599"
      ja: "\u672A\u6210\u719F\u306E\u690D\u7269\u304B\u3089\u4F5C\u3089\u308C\u305F\u65B0\u9BAE\u3067\u67D4\u3089\u304B\u3044\u98FC\u6599"
