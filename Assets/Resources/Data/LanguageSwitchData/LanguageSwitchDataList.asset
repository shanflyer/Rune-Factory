      tw: "\u751C\u9999\u6FC3\u90C1\uFF0C\u53E3\u611F\u6E05\u65B0\uFF0C\u5145\u6EFF\u5C11\u5973\u5FC3\u7684\u751C\u871C\u6ECB\u5473"
      ja: "\u7518\u3044\u9999\u308A\u3068\u3055\u308F\u3084\u304B\u3055\u304C\u5C11\u5973\u5FC3\u3092\u304F\u3059\u3050\u308B"
