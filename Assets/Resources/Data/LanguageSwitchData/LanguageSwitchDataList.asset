        \u092D\u0942\u0928\u0928\u0947 \u0938\u0947 \u0938\u093E\u0930\u094D\u0921\u093F\u0928
        \u0915\u093E \u092E\u0942\u0932 \u0938\u094D\u0935\u093E\u0926 \u092C\u0930\u0915\u0930\u093E\u0930"
      ur: "\u0646\u0645\u06A9\u06CC\u0646 \u0633\u0637\u062D \u0627\u0648\u0631 \u0646\u0631\u0645
