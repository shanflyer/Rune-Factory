      hi: "\u091A\u092E\u0915\u0940\u0932\u093E \u0932\u093E\u0932, \u092E\u0940\u0920\u093E,
        \u0917\u0930\u094D\u092E\u093F\u092F\u094B\u0902 \u0915\u0947 \u0932\u093F\u090F
