      ko: "\uD478\uB987\uD478\uB987\uD55C \uC7A5\uC2DD\uD488"
      fr: "D\xE9coration v\xE9g\xE9tale"
      de: "Gr\xFCne Dekoration"
      ru: "\u0417\u0435\u043B\u0451\u043D\u044B\u0439 \u0434\u0435\u043A\u043E\u0440"
      es: "Decoraci\xF3n Verde"
      pt: "Decora\xE7\xE3o com Vegeta\xE7\xE3o"
      it: Decorazione Verdeggiante
      tr: "Ye\u015Fillik Dekorasyonu"
      vi: "\u0110\u1ED3 trang tr\xED xanh t\u01B0\u01A1i"
      th: "\u0E02\u0E2D\u0E07\u0E1B\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E2A\u0E35\u0E40\u0E02\u0E35\u0E22\u0E27\u0E0A\u0E2D\u0E38\u0E48\u0E21"
      pl: Dekoracja Zieleni
      nl: Groene Decoratie
      el: "\u0394\u03B9\u03B1\u03BA\u03CC\u03C3\u03BC\u03B7\u03C3\u03B7 \u03BC\u03B5
        \u03C0\u03C1\u03AC\u03C3\u03B9\u03BD\u03BF"
      ar: "\u062F\u064A\u0643\u0648\u0631\u0627\u062A \u062E\u0636\u0631\u0627\u0621
        \u0645\u0648\u0631\u0642\u0629"
      hi: "\u0939\u0930\u093F\u092F\u093E\u0932\u0940 \u0938\u0947 \u092D\u0930\u093E
        \u0938\u091C\u093E\u0935\u091F\u0940 \u0938\u093E\u092E\u093E\u0928"
      ur: "\u0633\u0628\u0632\u06C1 \u0633\u06D2 \u0628\u06BE\u0631\u0627 \u0633\u062C\u0627\u0648\u0679\u06CC
        \u0633\u0627\u0645\u0627\u0646"
      ms: Hiasan tumbuhan
      id: Dekorasi tanaman
    - cn: "\u5728\u5BD2\u51B7\u7684\u5B63\u8282\u91CC\u611F\u53D7\u6E29\u6696"
      en: Feel the warmth during cold seasons
      tw: "\u5728\u5BD2\u51B7\u7684\u5B63\u7BC0\u88E1\u611F\u53D7\u6EAB\u6696"
      ja: "\u5BD2\u3044\u5B63\u7BC0\u306B\u6E29\u3082\u308A\u3092\u611F\u3058\u308B"
      ko: "\uCD94\uC6B4 \uACC4\uC808\uC5D0 \uB530\uB73B\uD568\uC744 \uB290\uB07C\uAE30"
      fr: Profitez de la chaleur en hiver
      de: "W\xE4rme in kalten Jahreszeiten"
      ru: "\u0421\u043E\u0433\u0440\u0435\u0439\u0442\u0435\u0441\u044C \u0432 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0435
        \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430"
      es: "Siente el Calor en \xC9pocas Fr\xEDas"
      pt: "Sinta o Calor nas Esta\xE7\xF5es Frias"
      it: Sentire il Calore nella Stagione Fredda
      tr: "So\u011Fuk Mevsimlerde S\u0131cakl\u0131\u011F\u0131 Hisset"
      vi: "C\u1EA3m nh\u1EADn h\u01A1i \u1EA5m trong m\xF9a l\u1EA1nh"
      th: "\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E2D\u0E1A\u0E2D\u0E38\u0E48\u0E19\u0E43\u0E19\u0E24\u0E14\u0E39\u0E2B\u0E19\u0E32\u0E27"
      pl: "Poczuj Ciep\u0142o w Zimnych Porach Roku"
      nl: Voel de Warmte in Koude Seizoenen
      el: "\u039D\u03B9\u03CE\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03B6\u03AD\u03C3\u03C4\u03B7
        \u03BA\u03B1\u03C4\u03AC \u03C4\u03B9\u03C2 \u03BA\u03C1\u03CD\u03B5\u03C2
        \u03B5\u03C0\u03BF\u03C7\u03AD\u03C2"
      ar: "\u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u062F\u0641\u0621
        \u0641\u064A \u0627\u0644\u0645\u0648\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0631\u062F\u0629"
      hi: "\u0920\u0902\u0921 \u0915\u0947 \u092E\u094C\u0938\u092E \u092E\u0947\u0902
        \u0917\u0930\u094D\u092E\u093E\u0939\u091F \u092E\u0939\u0938\u0942\u0938
        \u0915\u0930\u0947\u0902"
      ur: "\u0679\u06BE\u0646\u0688\u06D2 \u0645\u0648\u0633\u0645 \u0645\u06CC\u06BA
        \u06AF\u0631\u0645\u06CC \u0645\u062D\u0633\u0648\u0633 \u06A9\u0631\u06CC\u06BA"
      ms: Rasakan kehangatan di musim sejuk
      id: Rasakan kehangatan di musim dingin
    - cn: "\u4E00\u79CD\u5E38\u89C1\u7684\u6DE1\u6C34\u9C7C\u7C7B\uFF0C\u5F88\u9002\u5408\u7528\u6765\u716E\u6C64"
      en: A common freshwater fish, perfect for soups
      tw: "\u4E00\u7A2E\u5E38\u898B\u7684\u6DE1\u6C34\u9B5A\u985E\uFF0C\u5F88\u9069\u5408\u7528\u4F86\u716E\u6E6F"
      ja: "\u4E00\u822C\u7684\u306A\u6DE1\u6C34\u9B5A\u3001\u30B9\u30FC\u30D7\u306B\u6700\u9069"
      ko: "\uD754\uD55C \uB2F4\uC218\uC5B4, \uC218\uD504\uC5D0 \uC801\uD569"
      fr: "Poisson d'eau douce commun, id\xE9al pour les soupes"
      de: "H\xE4ufiger S\xFC\xDFwasserfisch, perfekt f\xFCr Suppen"
      ru: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u0430\u044F
        \u0440\u044B\u0431\u0430 \u0434\u043B\u044F \u0441\u0443\u043F\u0430"
      es: "Pez de Agua Dulce Com\xFAn, Ideal para Sopas"
      pt: "Peixe de \xC1gua Doce Comum, Perfeito para Sopas"
      it: Pesce d'Acqua Dolce Comune, Perfetto per Zuppe
      tr: "Yayg\u0131n Tatl\u0131 Su Bal\u0131\u011F\u0131, \xC7orba i\xE7in M\xFCkemmel"
      vi: "C\xE1 n\u01B0\u1EDBc ng\u1ECDt ph\u1ED5 bi\u1EBFn, th\xEDch h\u1EE3p n\u1EA5u
        canh"
      th: "\u0E1B\u0E25\u0E32\u0E19\u0E49\u0E33\u0E08\u0E37\u0E14\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B\u0E40\u0E2B\u0E21\u0E32\u0E30\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E17\u0E33\u0E0B\u0E38\u0E1B"
      pl: "Pospolita Ryba S\u0142odkowodna, Idealna do Zup"
      nl: Een Veel Voorkomende Zoetwatervis, Perfect voor Soep
      el: "\u03A3\u03C5\u03C7\u03BD\u03CC \u03C8\u03AC\u03C1\u03B9 \u03B3\u03BB\u03C5\u03BA\u03BF\u03CD
        \u03BD\u03B5\u03C1\u03BF\u03CD, \u03B9\u03B4\u03B1\u03BD\u03B9\u03BA\u03CC
        \u03B3\u03B9\u03B1 \u03C3\u03BF\u03CD\u03C0\u03B5\u03C2"
      ar: "\u0633\u0645\u0643\u0629 \u0645\u064A\u0627\u0647 \u0639\u0630\u0628\u0629
        \u0634\u0627\u0626\u0639\u0629\u060C \u0645\u062B\u0627\u0644\u064A\u0629
        \u0644\u0644\u062D\u0633\u0627\u0621"
      hi: "\u0938\u0942\u092A \u0915\u0947 \u0932\u093F\u090F \u0909\u092A\u092F\u0941\u0915\u094D\u0924
        \u0906\u092E \u092E\u0940\u0920\u0947 \u092A\u093E\u0928\u0940 \u0915\u0940
        \u092E\u091B\u0932\u0940"
      ur: "\u0633\u0648\u067E \u06A9\u06D2 \u0644\u06CC\u06D2 \u0645\u0648\u0632\u0648\u06BA
        \u0639\u0627\u0645 \u0645\u06CC\u0679\u06BE\u06D2 \u067E\u0627\u0646\u06CC
        \u06A9\u06CC \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan air tawar biasa sesuai untuk sup
      id: Ikan air tawar umum cocok untuk sup
    - cn: "\u751F\u6D3B\u4E8E\u6CB3\u6C9F\u6CE5\u6CBC\u95F4\uFF0C\u867E\u8089\u9C9C\u5F39\uFF0C\u5FAE\u5FAE\u751C\u610F\u4F34\u6E05\u9999\u3002"
      en: Lives in muddy riverbeds, shrimp are fresh and slightly sweet
      tw: "\u751F\u6D3B\u65BC\u6CB3\u6E9D\u6CE5\u6CBC\u9593\uFF0C\u8766\u8089\u9BAE\u5F48\uFF0C\u5FAE\u5FAE\u751C\u610F\u4F34\u6E05\u9999"
      ja: "\u6CB3\u5DDD\u306E\u6CE5\u5E95\u306B\u751F\u606F\u3001\u30A8\u30D3\u306F\u65B0\u9BAE\u3067\u307B\u306E\u304B\u306A\u7518\u307F"
      ko: "\uAC15\uC758 \uC9C4\uD759 \uBC14\uB2E5\uC5D0 \uC11C\uC2DD, \uC2E0\uC120\uD558\uACE0
        \uC57D\uAC04 \uB2EC\uCF64\uD55C \uC0C8\uC6B0"
      fr: "Vit dans les fonds vaseux, crevettes fra\xEEches et l\xE9g\xE8rement sucr\xE9es"
      de: "Lebt in schlammigen Flussbetten, Garnelen sind frisch und leicht s\xFC\xDF"
      ru: "\u041E\u0431\u0438\u0442\u0430\u0435\u0442 \u0432 \u0438\u043B\u0438\u0441\u0442\u044B\u0445
        \u0440\u0435\u043A\u0430\u0445, \u043A\u0440\u0435\u0432\u0435\u0442\u043A\u0438
        \u0441\u0432\u0435\u0436\u0438\u0435 \u0438 \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u044B\u0435"
      es: Vive en fondos fangosos, camarones frescos y ligeramente dulces
      pt: "Vive em leitos lamacentos, camar\xF5es frescos e levemente doces"
      it: Vive in fondali fangosi, gamberi freschi e leggermente dolci
      tr: "\xC7amurlu Nehir Yataklar\u0131nda Ya\u015Far, Karidesler Taze ve Hafif
        Tatl\u0131"
      vi: "S\u1ED1ng \u1EDF b\xF9n l\u1EA7y s\xF4ng ng\xF2i, t\xF4m t\u01B0\u01A1i
        v\xE0 ng\u1ECDt nh\u1EB9"
      th: "\u0E2D\u0E32\u0E28\u0E31\u0E22\u0E43\u0E19\u0E42\u0E04\u0E25\u0E19\u0E15\u0E21
        \u0E41\u0E01\u0E48\u0E19\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E01\u0E38\u0E49\u0E07\u0E2A\u0E14\u0E01\u0E23\u0E2D\u0E1A\u0E2B\u0E27\u0E32\u0E19\u0E19\u0E34\u0E14
        \u0E46"
      pl: "\u017Byje w mulistych rzekach, krewetki \u015Bwie\u017Ce i lekko s\u0142odkie"
      nl: Leeft in modderige rivierbeddingen, garnalen zijn vers en licht zoet
      el: "\u0396\u03B5\u03B9 \u03C3\u03B5 \u03BB\u03B1\u03C3\u03C0\u03CE\u03B4\u03B5\u03B9\u03C2
        \u03C0\u03BF\u03C4\u03B1\u03BC\u03BF\u03CD\u03C2, \u03B3\u03B1\u03C1\u03AF\u03B4\u03B5\u03C2
        \u03C6\u03C1\u03AD\u03C3\u03BA\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03AF\u03B3\u03BF
        \u03B3\u03BB\u03C5\u03BA\u03AD\u03C2"
      ar: "\u064A\u0639\u064A\u0634 \u0641\u064A \u0642\u064A\u0639\u0627\u0646 \u0627\u0644\u0623\u0646\u0647\u0627\u0631
        \u0627\u0644\u0645\u0648\u062D\u0644\u0629\u060C \u0644\u062D\u0645 \u0627\u0644\u062C\u0645\u0628\u0631\u064A
        \u0637\u0627\u0632\u062C \u0648\u062D\u0644\u0648 \u0642\u0644\u064A\u0644\u0627\u064B"
      hi: "\u0915\u0940\u091A\u0921\u093C \u092D\u0930\u0940 \u0928\u0926\u093F\u092F\u094B\u0902
        \u092E\u0947\u0902 \u0930\u0939\u0928\u0947 \u0935\u093E\u0932\u0940 \u0924\u093E\u091C\u093C\u093E
        \u091D\u0940\u0902\u0917\u093E"
      ur: "\u06A9\u06CC\u0686\u0691 \u0628\u06BE\u0631\u06CC \u0646\u062F\u06CC\u0648\u06BA
        \u0645\u06CC\u06BA \u0631\u06C1\u0646\u06D2 \u0648\u0627\u0644\u06CC \u062A\u0627\u0632\u06C1
        \u062C\u06BE\u06CC\u0646\u06AF\u0627"
      ms: Udang segar dengan rasa manis di lumpur
      id: Udang segar dengan rasa manis di lumpur
    - cn: "\u6D3B\u8DC3\u4E8E\u6E56\u6CCA\u6C60\u5858\uFF0C\u5176\u8089\u53E3\u611F\u7B4B\u9053\uFF0C\u6709\u6DE1\u6DE1\u6C34\u8349\u9999\u3002"
      en: Lives in lakes and ponds, meat is firm and has a light water plant aroma
      tw: "\u6D3B\u8E8D\u65BC\u6E56\u6CCA\u6C60\u5858\uFF0C\u5176\u8089\u53E3\u611F\u7B4B\u9053\uFF0C\u6709\u6DE1\u6DE1\u6C34\u8349\u9999"
      ja: "\u6E56\u3084\u6C60\u306B\u751F\u606F\u3001\u8089\u306F\u6B6F\u3054\u305F\u3048\u304C\u3042\u308A\u6C34\u8349\u306E\u9999\u308A"
      ko: "\uD638\uC218\uC640 \uC5F0\uBABB\uC5D0 \uC11C\uC2DD, \uACE0\uAE30 \uD0F1\uD0F1\uD558\uACE0
        \uBB3C\uD480 \uD5A5\uAE30"
      fr: "Vit dans les lacs et \xE9tangs, chair ferme avec un l\xE9ger ar\xF4me
        de plantes aquatiques"
      de: Lebt in Seen und Teichen, festes Fleisch mit leichtem Wasserpflanzenduft
      ru: "\u041E\u0431\u0438\u0442\u0430\u0435\u0442 \u0432 \u043E\u0437\u0451\u0440\u0430\u0445
        \u0438 \u043F\u0440\u0443\u0434\u0430\u0445, \u043C\u044F\u0441\u043E \u043F\u043B\u043E\u0442\u043D\u043E\u0435
        \u0441 \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u0435\u0439"
      es: "Vive en lagos y estanques, carne firme con aroma a plantas acu\xE1ticas"
      pt: "Vive em lagos e lagoas, carne firme com aroma leve de plantas aqu\xE1ticas"
      it: Vive in laghi e stagni, carne soda con aroma di piante acquatiche
      tr: "G\xF6l ve G\xF6letlerde Ya\u015Far, Eti S\u0131k\u0131 ve Hafif Su Bitkisi
        Kokulu"
      vi: "S\u1ED1ng \u1EDF h\u1ED3 v\xE0 ao, th\u1ECBt dai v\xE0 c\xF3 m\xF9i c\u1ECF
        n\u01B0\u1EDBc nh\u1EB9"
      th: "\u0E2D\u0E32\u0E28\u0E31\u0E22\u0E43\u0E19\u0E17\u0E30\u0E40\u0E25\u0E2A\u0E32\u0E1A\u0E41\u0E25\u0E30\u0E1A\u0E48\u0E2D
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E40\u0E2B\u0E19\u0E35\u0E22\u0E27\u0E19\u0E38\u0E48\u0E21\u0E21\u0E35\u0E01\u0E25\u0E34\u0E48\u0E19\u0E2B\u0E0D\u0E49\u0E32\u0E19\u0E49\u0E33"
      pl: "\u017Byje w jeziorach i stawach, mi\u0119so j\u0119drne z lekkim zapachem
        ro\u015Blin wodnych"
      nl: Leeft in meren en vijvers, stevig vlees met licht aroma van waterplanten
      el: "\u0396\u03B5\u03B9 \u03C3\u03B5 \u03BB\u03AF\u03BC\u03BD\u03B5\u03C2 \u03BA\u03B1\u03B9
        \u03BB\u03B9\u03BC\u03BD\u03BF\u03CD\u03BB\u03B5\u03C2, \u03C3\u03C6\u03B9\u03C7\u03C4\u03CC
        \u03BA\u03C1\u03AD\u03B1\u03C2 \u03BC\u03B5 \u03AC\u03C1\u03C9\u03BC\u03B1
        \u03C5\u03B4\u03C1\u03CC\u03B2\u03B9\u03C9\u03BD \u03C6\u03C5\u03C4\u03CE\u03BD"
      ar: "\u064A\u0639\u064A\u0634 \u0641\u064A \u0627\u0644\u0628\u062D\u064A\u0631\u0627\u062A
        \u0648\u0627\u0644\u0628\u0631\u0643\u060C \u0644\u062D\u0645\u0647 \u0645\u062A\u0645\u0627\u0633\u0643
        \u0648\u0644\u0647 \u0631\u0627\u0626\u062D\u0629 \u0639\u0634\u0628 \u0645\u0627\u0626\u064A
        \u062E\u0641\u064A\u0641\u0629"
      hi: "\u091D\u0940\u0932\u094B\u0902 \u0914\u0930 \u0924\u093E\u0932\u093E\u092C\u094B\u0902
        \u092E\u0947\u0902 \u092A\u093E\u0908 \u091C\u093E\u0928\u0947 \u0935\u093E\u0932\u0940
        \u092E\u091B\u0932\u0940, \u092E\u093E\u0902\u0938 \u0926\u0943\u0922\u093C
        \u0914\u0930 \u0939\u0932\u094D\u0915\u0940 \u091C\u0932\u0915\u0941\u0902\u092D\u0940
        \u0938\u0941\u0917\u0902\u0927"
      ur: "\u062C\u06BE\u06CC\u0644\u0648\u06BA \u0627\u0648\u0631 \u062A\u0627\u0644\u0627\u0628\u0648\u06BA
        \u0645\u06CC\u06BA \u067E\u0627\u0626\u06CC \u062C\u0627\u0646\u06D2 \u0648\u0627\u0644\u06CC
        \u0645\u0686\u06BE\u0644\u06CC\u060C \u0645\u0636\u0628\u0648\u0637 \u06AF\u0648\u0634\u062A
        \u0627\u0648\u0631 \u06C1\u0644\u06A9\u06CC \u067E\u0627\u0646\u06CC \u06A9\u06D2
        \u067E\u0648\u062F\u0648\u06BA \u06A9\u06CC \u062E\u0648\u0634\u0628\u0648"
      ms: Ikan kolam bertekstur kenyal
      id: Ikan kolam beraroma tumbuhan air
    - cn: "\u5728\u5357\u65B9\u6C34\u57DF\u81EA\u5728\u6E38\uFF0C\u8089\u5AE9\u4E14\u5473\u9187\uFF0C\u7EAF\u51C0\u800C\u60A0\u957F\u3002"
      en: Found in southern waters, meat is tender and flavorful
      tw: "\u5728\u5357\u65B9\u6C34\u57DF\u81EA\u5728\u6E38\uFF0C\u8089\u5AE9\u4E14\u5473\u9187\uFF0C\u7D14\u6DE8\u800C\u60A0\u9577"
      ja: "\u5357\u65B9\u306E\u6C34\u57DF\u306B\u751F\u606F\u3001\u8089\u306F\u67D4\u3089\u304B\u304F\u98A8\u5473\u8C4A\u304B"
      ko: "\uB0A8\uCABD \uBB3C\uC5D0\uC11C \uD5E4\uC5C4\uCE58\uBA70, \uBD80\uB4DC\uB7FD\uACE0
        \uD48D\uBBF8 \uC788\uB294 \uACE0\uAE30"
      fr: "Trouv\xE9 dans les eaux du sud, viande tendre et savoureuse"
      de: "In s\xFCdlichen Gew\xE4ssern, zartes und aromatisches Fleisch"
      ru: "\u041E\u0431\u0438\u0442\u0430\u0435\u0442 \u0432 \u044E\u0436\u043D\u044B\u0445
        \u0432\u043E\u0434\u0430\u0445, \u043C\u044F\u0441\u043E \u043D\u0435\u0436\u043D\u043E\u0435
        \u0438 \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u043E\u0435"
      es: Encontrado en aguas del sur, carne tierna y sabrosa
      pt: "Encontrado em \xE1guas do sul, carne macia e saborosa"
      it: Trovato nelle acque meridionali, carne tenera e saporita
      tr: "G\xFCney Sular\u0131nda Bulunur, Eti Yumu\u015Fak ve Lezzetli"
      vi: "S\u1ED1ng \u1EDF v\xF9ng n\u01B0\u1EDBc ph\xEDa nam, th\u1ECBt m\u1EC1m
        v\xE0 \u0111\u1EADm \u0111\xE0"
      th: "\u0E2D\u0E32\u0E28\u0E31\u0E22\u0E43\u0E19\u0E19\u0E48\u0E32\u0E19\u0E19\u0E49\u0E33\u0E17\u0E32\u0E07\u0E43\u0E15\u0E49
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E19\u0E38\u0E48\u0E21\u0E41\u0E25\u0E30\u0E23\u0E2A\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19"
      pl: "Wyst\u0119puje w po\u0142udniowych wodach, mi\u0119so delikatne i aromatyczne"
      nl: Gevonden in zuidelijke wateren, mals en smaakvol vlees
      el: "\u0392\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03BD\u03CC\u03C4\u03B9\u03B1
        \u03CD\u03B4\u03B1\u03C4\u03B1, \u03C4\u03C1\u03C5\u03C6\u03B5\u03C1\u03CC
        \u03BA\u03B1\u03B9 \u03B3\u03B5\u03C5\u03C3\u03C4\u03B9\u03BA\u03CC \u03BA\u03C1\u03AD\u03B1\u03C2"
      ar: "\u064A\u0648\u062C\u062F \u0641\u064A \u0627\u0644\u0645\u064A\u0627\u0647
        \u0627\u0644\u062C\u0646\u0648\u0628\u064A\u0629\u060C \u0644\u062D\u0645\u0647
        \u0637\u0631\u064A \u0648\u0645\u0644\u064A\u0621 \u0628\u0627\u0644\u0646\u0643\u0647\u0629"
      hi: "\u0926\u0915\u094D\u0937\u093F\u0923\u0940 \u091C\u0932 \u092E\u0947\u0902
        \u0924\u0948\u0930\u0928\u0947 \u0935\u093E\u0932\u0940 \u0928\u0930\u092E
        \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F \u092E\u091B\u0932\u0940"
      ur: "\u062C\u0646\u0648\u0628\u06CC \u067E\u0627\u0646\u06CC\u0648\u06BA \u0645\u06CC\u06BA
        \u062A\u06CC\u0631\u0646\u06D2 \u0648\u0627\u0644\u06CC \u0646\u0631\u0645
        \u0627\u0648\u0631 \u0645\u0632\u06CC\u062F\u0627\u0631 \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan selatan lembut dan berperisa
      id: Ikan selatan lembut dan beraroma
    - cn: "\u9690\u533F\u4E8E\u6DE1\u6C34\u4E2D\uFF0C\u87F9\u8089\u9C9C\u751C\uFF0C\u5982\u98CE\u8F7B\u62C2\u5473\u857E\u3002"
      en: Lives in riverbeds, crab meat is sweet and fresh
      tw: "\u96B1\u533F\u65BC\u6DE1\u6C34\u4E2D\uFF0C\u87F9\u8089\u9BAE\u751C\uFF0C\u5982\u98A8\u8F15\u62C2\u5473\u857E"
      ja: "\u6DE1\u6C34\u306B\u6F5C\u307F\u3001\u30AB\u30CB\u306E\u8EAB\u306F\u7518\u304F\u65B0\u9BAE"
      ko: "\uB2F4\uC218\uC5D0 \uC11C\uC2DD, \uAC8C\uC0B4\uC774 \uB2EC\uCF64\uD558\uACE0
        \uC2E0\uC120"
      fr: "Se cache en eau douce, chair de crabe douce et fra\xEEche"
      de: "Lebt in Flussbetten, s\xFC\xDFes und frisches Krabbenfleisch"
      ru: "\u041F\u0440\u044F\u0447\u0435\u0442\u0441\u044F \u0432 \u043F\u0440\u0435\u0441\u043D\u043E\u0439
        \u0432\u043E\u0434\u0435, \u043C\u044F\u0441\u043E \u043A\u0440\u0430\u0431\u0430
        \u0441\u043B\u0430\u0434\u043A\u043E\u0435 \u0438 \u0441\u0432\u0435\u0436\u0435\u0435"
      es: Se esconde en agua dulce, carne de cangrejo dulce y fresca
      pt: "Esconde-se em \xE1gua doce, carne de caranguejo doce e fresca"
      it: Si nasconde in acqua dolce, carne di granchio dolce e fresca
      tr: "Tatl\u0131 Suda Gizlenir, Yenge\xE7 Eti Tatl\u0131 ve Taze"
      vi: "\u1EA8n m\xECnh trong n\u01B0\u1EDBc ng\u1ECDt, th\u1ECBt cua ng\u1ECDt
        v\xE0 t\u01B0\u01A1i"
      th: "\u0E0B\u0E48\u0E2D\u0E19\u0E15\u0E31\u0E27\u0E43\u0E19\u0E19\u0E49\u0E33\u0E08\u0E37\u0E14
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E1B\u0E39\u0E2B\u0E27\u0E32\u0E19\u0E41\u0E25\u0E30\u0E2A\u0E14"
      pl: "Ukrywa si\u0119 w s\u0142odkiej wodzie, mi\u0119so kraba s\u0142odkie
        i \u015Bwie\u017Ce"
      nl: Verbergt zich in zoet water, zoet en vers krabbenvlees
      el: "\u039A\u03C1\u03CD\u03B2\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03B3\u03BB\u03C5\u03BA\u03AC
        \u03BD\u03B5\u03C1\u03AC, \u03B3\u03BB\u03C5\u03BA\u03CC \u03BA\u03B1\u03B9
        \u03C6\u03C1\u03AD\u03C3\u03BA\u03BF \u03BA\u03C1\u03AD\u03B1\u03C2 \u03BA\u03B1\u03B2\u03BF\u03C5\u03C1\u03B9\u03BF\u03CD"
      ar: "\u064A\u062E\u062A\u0628\u0626 \u0641\u064A \u0627\u0644\u0645\u064A\u0627\u0647
        \u0627\u0644\u0639\u0630\u0628\u0629\u060C \u0644\u062D\u0645 \u0627\u0644\u0633\u0644\u0637\u0639\u0648\u0646
        \u062D\u0644\u0648 \u0648\u0637\u0627\u0632\u062C"
      hi: "\u092E\u0940\u0920\u0947 \u092A\u093E\u0928\u0940 \u092E\u0947\u0902 \u091B\u093F\u092A\u0947
        \u092E\u0940\u0920\u0947 \u0915\u0947\u0915\u0921\u093C\u0947 \u0915\u093E
        \u092E\u093E\u0902\u0938"
      ur: "\u0645\u06CC\u0679\u06BE\u06D2 \u067E\u0627\u0646\u06CC \u0645\u06CC\u06BA
        \u0686\u06BE\u067E\u06D2 \u0645\u06CC\u0679\u06BE\u06D2 \u06A9\u06CC\u06A9\u0691\u06D2
        \u06A9\u0627 \u06AF\u0648\u0634\u062A"
      ms: Ketam air tawar manis dan segar
      id: Kepiting air tawar manis dan segar
    - cn: "\u6816\u606F\u5728\u6C34\u5E95\u6697\u5904\uFF0C\u4F53\u8868\u9ECF\u6ED1\uFF0C\u5473\u9053\u6D53\u90C1\u539A\u91CD\u3002"
      en: Lives in the depths of rivers, meat is rich and smooth
      tw: "\u68F2\u606F\u5728\u6C34\u5E95\u6697\u8655\uFF0C\u9AD4\u8868\u9ECF\u6ED1\uFF0C\u5473\u9053\u6FC3\u90C1\u539A\u91CD"
      ja: "\u6C34\u5E95\u306E\u6697\u304C\u308A\u306B\u751F\u606F\u3001\u8EAB\u306F\u6FC3\u539A\u3067\u6ED1\u3089\u304B"
      ko: "\uAC15 \uAE4A\uC740 \uACF3\uC5D0 \uC11C\uC2DD, \uACE0\uAE30 \uC9C4\uD558\uACE0
        \uBD80\uB4DC\uB7EC\uC6C0"
      fr: "Vit dans les profondeurs des rivi\xE8res, chair riche et lisse"
      de: Lebt in Flusstiefen, reiches und glattes Fleisch
      ru: "\u041E\u0431\u0438\u0442\u0430\u0435\u0442 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0430\u0445
        \u0440\u0435\u043A, \u043C\u044F\u0441\u043E \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u043E\u0435
        \u0438 \u0433\u043B\u0430\u0434\u043A\u043E\u0435"
      es: "Vive en las profundidades de los r\xEDos, carne rica y suave"
      pt: Vive nas profundezas dos rios, carne rica e suave
      it: "Vive nelle profondit\xE0 dei fiumi, carne ricca e liscia"
      tr: "Nehir Derinliklerinde Ya\u015Far, Eti Zengin ve P\xFCr\xFCzs\xFCz"
      vi: "S\u1ED1ng \u1EDF \u0111\xE1y s\xF4ng t\u1ED1i, th\u1ECBt \u0111\u1EADm
        \u0111\xE0 v\xE0 m\u1ECBn"
      th: "\u0E2D\u0E32\u0E28\u0E31\u0E22\u0E43\u0E15\u0E49\u0E17\u0E49\u0E2D\u0E07\u0E19\u0E49\u0E33\u0E25\u0E36\u0E01
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19\u0E41\u0E25\u0E30\u0E25\u0E37\u0E48\u0E19"
      pl: "\u017Byje w g\u0142\u0119binach rzek, mi\u0119so bogate i g\u0142adkie"
      nl: Leeft in de diepten van rivieren, rijk en glad vlees
      el: "\u0396\u03B5\u03B9 \u03C3\u03C4\u03B1 \u03B2\u03AC\u03B8\u03B7 \u03C4\u03C9\u03BD
        \u03C0\u03BF\u03C4\u03B1\u03BC\u03CE\u03BD, \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF
        \u03BA\u03B1\u03B9 \u03BB\u03B5\u03AF\u03BF \u03BA\u03C1\u03AD\u03B1\u03C2"
      ar: "\u064A\u0639\u064A\u0634 \u0641\u064A \u0623\u0639\u0645\u0627\u0642 \u0627\u0644\u0623\u0646\u0647\u0627\u0631\u060C
        \u0644\u062D\u0645\u0647 \u063A\u0646\u064A \u0648\u0646\u0627\u0639\u0645"
      hi: "\u0928\u0926\u093F\u092F\u094B\u0902 \u0915\u0940 \u0917\u0939\u0930\u093E\u0908
        \u092E\u0947\u0902 \u0930\u0939\u0928\u0947 \u0935\u093E\u0932\u0940 \u092E\u091B\u0932\u0940,
        \u091A\u093F\u0915\u0928\u093E \u0914\u0930 \u0938\u092E\u0943\u0926\u094D\u0927
        \u0938\u094D\u0935\u093E\u0926"
      ur: "\u0646\u062F\u06CC\u0627\u06BA \u06A9\u06CC \u06AF\u06C1\u0631\u0627\u0626\u06CC
        \u0645\u06CC\u06BA \u0631\u06C1\u0646\u06D2 \u0648\u0627\u0644\u06CC \u0645\u0686\u06BE\u0644\u06CC\u060C
        \u06C1\u0645\u0648\u0627\u0631 \u0627\u0648\u0631 \u0628\u06BE\u0631\u067E\u0648\u0631
        \u0630\u0627\u0626\u0642\u06C1"
      ms: Ikan dasar sungai berkrim
      id: Ikan dasar sungai kaya rasa
    - cn: "\u68AD\u4E8E\u6EAA\u6D41\u6CB3\u6E7E\uFF0C\u50CF\u6EAA\u6D41\u4E2D\u7684\u7075\u52A8\u97F3\u7B26\u3002"
      en: Slender, fresh and flavorful fish, like a melody in a creek
      tw: "\u68AD\u65BC\u6EAA\u6D41\u6CB3\u7063\uFF0C\u50CF\u6EAA\u6D41\u4E2D\u7684\u9748\u52D5\u97F3\u7B26"
      ja: "\u5C0F\u5DDD\u306E\u6D41\u308C\u306B\u6CF3\u304E\u3001\u3055\u308F\u3084\u304B\u3067\u98A8\u5473\u8C4A\u304B\u306A\u9B5A"
      ko: "\uC2DC\uB0C7\uAC00\uB97C \uB204\uBE44\uB294 \uC0C1\uD07C\uD558\uACE0 \uD48D\uBBF8
        \uC788\uB294 \uBB3C\uACE0\uAE30"
      fr: "Poisson mince et savoureux, comme une m\xE9lodie dans un ruisseau"
      de: Schlanker, frischer und geschmackvoller Fisch wie eine Melodie in einem
        Bach
      ru: "\u0421\u0442\u0440\u043E\u0439\u043D\u0430\u044F \u0438 \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u0430\u044F
        \u0440\u044B\u0431\u0430, \u043A\u0430\u043A \u043C\u0435\u043B\u043E\u0434\u0438\u044F
        \u0432 \u0440\u0443\u0447\u044C\u0435"
      es: "Pez esbelto y sabroso, como una melod\xEDa en un arroyo"
      pt: Peixe esguio e saboroso, como uma melodia em um riacho
      it: Pesce snello e saporito, come una melodia in un ruscello
      tr: "\u0130nce, Taze ve Lezzetli Bal\u0131k, Bir Dere Melodisi Gibi"
      vi: "C\xE1 thon t\u01B0\u01A1i ngon, nh\u01B0 giai \u0111i\u1EC7u trong su\u1ED1i"
      th: "\u0E27\u0E48\u0E32\u0E22\u0E43\u0E19\u0E25\u0E33\u0E18\u0E32\u0E23\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E42\u0E19\u0E49\u0E15\u0E40\u0E1E\u0E25\u0E07"
      pl: "Smuk\u0142a, \u015Awie\u017Ca i Aromatyczna Ryba jak Melodia w Strumieniu"
      nl: Slanke, Verse en Smaakvolle Vis als een Melodie in een Beekje
      el: "\u039B\u03B5\u03C0\u03C4\u03CC, \u03C6\u03C1\u03AD\u03C3\u03BA\u03BF \u03BA\u03B1\u03B9
        \u03B3\u03B5\u03C5\u03C3\u03C4\u03B9\u03BA\u03CC \u03C8\u03AC\u03C1\u03B9
        \u03C3\u03B1\u03BD \u03BC\u03B5\u03BB\u03C9\u03B4\u03AF\u03B1 \u03C3\u03B5
        \u03C1\u03C5\u03AC\u03BA\u03B9"
      ar: "\u0633\u0645\u0643\u0629 \u0631\u0634\u064A\u0642\u0629 \u0637\u0627\u0632\u062C\u0629
        \u0645\u0644\u064A\u0626\u0629 \u0628\u0627\u0644\u0646\u0643\u0647\u0629\u060C
        \u0643\u0623\u0646\u0647\u0627 \u0646\u063A\u0645\u0629 \u0641\u064A \u062C\u062F\u0648\u0644"
      hi: "\u0928\u0926\u0940 \u0915\u0940 \u0927\u093E\u0930\u093E \u092E\u0947\u0902
        \u0924\u0948\u0930\u0924\u0940 \u092A\u0924\u0932\u0940 \u0914\u0930 \u0924\u093E\u091C\u093C\u093E
        \u092E\u091B\u0932\u0940"
      ur: "\u0646\u062F\u06CC \u06A9\u06CC \u062F\u06BE\u0627\u0631\u0627 \u0645\u06CC\u06BA
        \u062A\u06CC\u0631\u062A\u06CC \u067E\u062A\u0644\u06CC \u0627\u0648\u0631
        \u062A\u0627\u0632\u06C1 \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan sungai lincah seperti muzik
      id: Ikan sungai lincah seperti melodi
    - cn: "\u5728\u6C60\u6C34\u4E2D\u5B09\u620F\uFF0C\u8272\u5F69\u7F24\u7EB7\uFF0C\u6E38\u65F6\u5982\u5F69\u9526\u6D41\u52A8\u3002"
      en: Brightly colored fish, moves like flowing silk
      tw: "\u5728\u6C60\u6C34\u4E2D\u5B09\u6232\uFF0C\u8272\u5F69\u7E7D\u7D1B\uFF0C\u6E38\u6642\u5982\u5F69\u9326\u6D41\u52D5"
      ja: "\u6C60\u3067\u622F\u308C\u308B\u9BAE\u3084\u304B\u306A\u9B5A\u3001\u52D5\u304D\u306F\u7D79\u306E\u3088\u3046"
      ko: "\uC5F0\uBABB\uC5D0\uC11C \uB180\uBA70 \uD654\uB824\uD55C \uC0C9\uC0C1,
        \uC720\uC601\uC740 \uBE44\uB2E8\uCC98\uB7FC"
      fr: "Poisson color\xE9, se d\xE9place comme de la soie"
      de: "Bunt gef\xE4rbter Fisch, bewegt sich wie flie\xDFende Seide"
      ru: "\u042F\u0440\u043A\u0430\u044F \u0440\u044B\u0431\u0430, \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
        \u043A\u0430\u043A \u0448\u0451\u043B\u043A"
      es: Pez de colores brillantes, se mueve como seda fluida
      pt: Peixe colorido, move-se como seda fluente
      it: Pesce colorato, si muove come seta che scorre
      tr: "Parlak Renkli Bal\u0131k, Hareketi \u0130pek Gibi"
      vi: "C\xE1 m\xE0u s\u1EAFc r\u1EF1c r\u1EE1, b\u01A1i nh\u01B0 l\u1EE5a tr\xF4i"
      th: "\u0E27\u0E48\u0E32\u0E22\u0E43\u0E19\u0E2A\u0E23\u0E30\u0E2A\u0E35\u0E2A\u0E31\u0E19\u0E2A\u0E14\u0E43\u0E2A\u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E2B\u0E27\u0E23\u0E32\u0E27\u0E1C\u0E49\u0E32\u0E44\u0E2B\u0E21"
      pl: "Kolorowa Ryba poruszaj\u0105ca si\u0119 jak P\u0142yn\u0105cy Jedwab"
      nl: Felgekleurde Vis, Beweegt als Stromende Zijde
      el: "\u0388\u03BD\u03C4\u03BF\u03BD\u03B1 \u03C7\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
        \u03C8\u03AC\u03C1\u03B9, \u03BA\u03B9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9
        \u03C3\u03B1\u03BD \u03BC\u03B5\u03C4\u03B1\u03BA\u03B9\u03BD\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF
        \u03BC\u03B5\u03C4\u03AC\u03BE\u03B9"
      ar: "\u0633\u0645\u0643\u0629 \u0645\u0644\u0648\u0646\u0629 \u0632\u0627\u0647\u064A\u0629
        \u062A\u062A\u062D\u0631\u0643 \u0643\u0627\u0644\u062D\u0631\u064A\u0631
        \u0627\u0644\u0645\u062A\u062F\u0641\u0642"
      hi: "\u0930\u0902\u0917\u0940\u0928 \u092E\u091B\u0932\u0940, \u0930\u0947\u0936\u092E
        \u0915\u0940 \u0924\u0930\u0939 \u092C\u0939\u0924\u0940 \u0939\u0948"
      ur: "\u0631\u0646\u06AF\u06CC\u0646 \u0645\u0686\u06BE\u0644\u06CC\u060C \u0631\u06CC\u0634\u0645
        \u06A9\u06CC \u0637\u0631\u062D \u0628\u06C1\u062A\u06CC \u06C1\u06D2"
      ms: Ikan berwarna-warni bergerak seperti sutera
      id: Ikan berwarna-warni bergerak seperti sutera
    - cn: "\u4E8E\u6E05\u6F88\u6EAA\u6D41\u75BE\u884C\uFF0C\u8EAB\u5F62\u7EA4\u7EC6\uFF0C\u6E38\u59FF\u7075\u52A8\u5982\u7BAD\u3002"
      en: Swims fast in clear streams, graceful and arrow-like
      tw: "\u65BC\u6E05\u6F88\u6EAA\u6D41\u75BE\u884C\uFF0C\u8EAB\u5F62\u7E96\u7D30\uFF0C\u6E38\u59FF\u9748\u52D5\u5982\u7BAD"
      ja: "\u6F84\u3093\u3060\u5C0F\u5DDD\u3092\u901F\u304F\u6CF3\u3050\u3001\u7D30\u8EAB\u3067\u77E2\u306E\u3088\u3046\u306B"
      ko: "\uB9D1\uC740 \uC2DC\uB0C7\uBB3C\uC744 \uBE60\uB974\uAC8C \uD5E4\uC5C4\uCE58\uB294
        \uAC00\uB294 \uBAB8\uB9E4, \uD654\uC0B4\uCC98\uB7FC"
      fr: Nage rapidement dans les ruisseaux clairs, gracieux et rapide
      de: "Schwimmt schnell in klaren B\xE4chen, schlank und pfeilschnell"
      ru: "\u0411\u044B\u0441\u0442\u0440\u043E \u043F\u043B\u0430\u0432\u0430\u0435\u0442
        \u0432 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0445 \u0440\u0443\u0447\u044C\u044F\u0445,
        \u0438\u0437\u044F\u0449\u043D\u044B\u0439 \u0438 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439"
      es: "Nada r\xE1pido en arroyos claros, gr\xE1cil y veloz"
      pt: "Nada r\xE1pido em riachos claros, gracioso e r\xE1pido"
      it: Nuota veloce in ruscelli limpidi, snello e freccia
      tr: "Berrak Derelerde H\u0131zl\u0131 Y\xFCzer, Zarif ve Ok Gibi"
      vi: "B\u01A1i nhanh trong su\u1ED1i trong, m\u1EA3nh mai v\xE0 nhanh nh\u01B0
        t\xEAn"
      th: "\u0E27\u0E48\u0E32\u0E22\u0E40\u0E23\u0E47\u0E27\u0E43\u0E19\u0E25\u0E33\u0E18\u0E32\u0E23\u0E43\u0E2A
        \u0E23\u0E39\u0E1B\u0E23\u0E48\u0E32\u0E07\u0E40\u0E1E\u0E23\u0E35\u0E22\u0E27\u0E04\u0E25\u0E49\u0E32\u0E22\u0E25\u0E39\u0E01\u0E18\u0E19\u0E39"
      pl: "P\u0142ywa Szybko w Przejrzystych Strumieniach, Smuk\u0142a i Zwinna jak
        Strza\u0142a"
      nl: Zwemt Snel in Heldere Beekjes, Sierlijk en Pijlsnel
      el: "\u039A\u03BF\u03BB\u03C5\u03BC\u03C0\u03AC \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1
        \u03C3\u03B5 \u03BA\u03B1\u03B8\u03B1\u03C1\u03AC \u03C1\u03C5\u03AC\u03BA\u03B9\u03B1,
        \u03BB\u03B5\u03C0\u03C4\u03CC \u03BA\u03B1\u03B9 \u03B2\u03AD\u03BB\u03BF\u03C2"
      ar: "\u062A\u0633\u0628\u062D \u0628\u0633\u0631\u0639\u0629 \u0641\u064A \u0627\u0644\u062C\u062F\u0627\u0648\u0644
        \u0627\u0644\u0635\u0627\u0641\u064A\u0629\u060C \u0631\u0634\u064A\u0642\u0629
        \u0643\u0627\u0644\u0633\u0647\u0645"
      hi: "\u0938\u093E\u092B\u093C \u0928\u0926\u093F\u092F\u094B\u0902 \u092E\u0947\u0902
        \u0924\u0947\u091C\u093C \u0924\u0948\u0930\u0928\u0947 \u0935\u093E\u0932\u0940
        \u092A\u0924\u0932\u0940 \u092E\u091B\u0932\u0940"
      ur: "\u0635\u0627\u0641 \u0646\u062F\u06CC\u0648\u06BA \u0645\u06CC\u06BA \u062A\u06CC\u0632
        \u062A\u06CC\u0631\u0646\u06D2 \u0648\u0627\u0644\u06CC \u067E\u062A\u0644\u06CC
        \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan laju di sungai jernih
      id: Ikan cepat di sungai jernih
    - cn: "\u79F0\u9738\u4E8E\u8F83\u6DF1\u6DE1\u6C34\uFF0C\u6E38\u65F6\u864E\u864E\u751F\u5A01\uFF0C\u9C7C\u8089\u975E\u5E38\u9C9C\u5AE9\u3002"
      en: Majestic fish found in deep freshwater, fresh and firm
      tw: "\u7A31\u9738\u65BC\u8F03\u6DF1\u6DE1\u6C34\uFF0C\u6E38\u6642\u864E\u864E\u751F\u5A01\uFF0C\u9B5A\u8089\u975E\u5E38\u9BAE\u5AE9"
      ja: "\u6DF1\u3044\u6DE1\u6C34\u306B\u751F\u606F\u3001\u5802\u3005\u3068\u3057\u305F\u6CF3\u304E\u3067\u8EAB\u306F\u9BAE\u70C8"
      ko: "\uAE4A\uC740 \uB2F4\uC218\uC5D0 \uC11C\uC2DD, \uC704\uC5C4 \uC788\uB294
        \uD5E4\uC5C4\uACFC \uC2E0\uC120\uD55C \uC0B4"
      fr: Poisson majestueux en eau douce profonde, frais et ferme
      de: "Majest\xE4tischer Fisch in tiefem S\xFC\xDFwasser, frisch und fest"
      ru: "\u0412\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
        \u0440\u044B\u0431\u0430 \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445
        \u0432\u043E\u0434\u0430\u0445, \u0441\u0432\u0435\u0436\u0430\u044F \u0438
        \u0443\u043F\u0440\u0443\u0433\u0430\u044F"
      es: Pez majestuoso en aguas profundas, fresco y firme
      pt: "Peixe majestoso encontrado em \xE1guas doces profundas, fresco e firme"
      it: Pesce maestoso in acque dolci profonde, fresco e sodo
      tr: "Derin Tatl\u0131 Suda Bulunan G\xF6rkemli Bal\u0131k, Taze ve S\u0131k\u0131"
      vi: "C\xE1 oai v\u1EC7 \u1EDF v\xF9ng n\u01B0\u1EDBc s\xE2u, th\u1ECBt t\u01B0\u01A1i
        v\xE0 ch\u1EAFc"
      th: "\u0E2D\u0E32\u0E28\u0E31\u0E22\u0E43\u0E19\u0E19\u0E49\u0E33\u0E25\u0E36\u0E01
        \u0E27\u0E48\u0E32\u0E22\u0E19\u0E49\u0E33\u0E2D\u0E07\u0E2D\u0E32\u0E08
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E2A\u0E14\u0E19\u0E38\u0E48\u0E21"
      pl: "Majestatyczna Ryba w G\u0142\u0119bokich Wodach, \u015Awie\u017Ca i Spr\u0119\u017Cysta"
      nl: Majestueuze Vis in Diep Zoet Water, Vers en Stevig
      el: "\u039C\u03B5\u03B3\u03B1\u03BB\u03B5\u03B9\u03CE\u03B4\u03B5\u03C2 \u03C8\u03AC\u03C1\u03B9
        \u03C3\u03B5 \u03B2\u03B1\u03B8\u03B9\u03AC \u03B3\u03BB\u03C5\u03BA\u03AC
        \u03BD\u03B5\u03C1\u03AC, \u03C6\u03C1\u03AD\u03C3\u03BA\u03BF \u03BA\u03B1\u03B9
        \u03C3\u03C6\u03B9\u03C7\u03C4\u03CC"
      ar: "\u0633\u0645\u0643\u0629 \u0645\u0647\u064A\u0628\u0629 \u0641\u064A \u0627\u0644\u0645\u064A\u0627\u0647
        \u0627\u0644\u0639\u0630\u0628\u0629 \u0627\u0644\u0639\u0645\u064A\u0642\u0629\u060C
        \u0644\u062D\u0645\u0647\u0627 \u0637\u0631\u064A \u0648\u0637\u0627\u0632\u062C"
      hi: "\u0917\u0939\u0930\u0947 \u092E\u0940\u0920\u0947 \u092A\u093E\u0928\u0940
        \u0915\u0940 \u0924\u093E\u091C\u093C\u093E \u0914\u0930 \u0926\u0943\u0922\u093C
        \u092E\u091B\u0932\u0940"
      ur: "\u06AF\u06C1\u0631\u06D2 \u0645\u06CC\u0679\u06BE\u06D2 \u067E\u0627\u0646\u06CC
        \u06A9\u06CC \u062A\u0627\u0632\u06C1 \u0627\u0648\u0631 \u0645\u0636\u0628\u0648\u0637
        \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan air tawar dalam segar
      id: Ikan air tawar dalam segar
    - cn: "\u4F53\u6001\u5706\u6DA6\uFF0C\u884C\u52A8\u8FDF\u7F13\u5446\u840C\uFF0C\u5982\u6C34\u4E2D\u6EDA\u52A8\u7684\u53EF\u7231\u8089\u7403\u3002"
      en: Round and slow-moving, a cute ball of meat
      tw: "\u9AD4\u614B\u5713\u6F64\uFF0C\u884C\u52D5\u9072\u7DE9\u5446\u840C\uFF0C\u5982\u6C34\u4E2D\u6EFE\u52D5\u7684\u53EF\u611B\u8089\u7403"
      ja: "\u4E38\u3005\u3068\u3057\u305F\u4F53\u3067\u52D5\u304D\u304C\u920D\u304F\u3001\u6C34\u4E2D\u3067\u8EE2\u304C\u308B\u304B\u308F\u3044\u3044\u8089\u306E\u7389"
      ko: "\uB3D9\uAE00\uB3D9\uAE00\uD558\uACE0 \uB290\uB9AC\uAC8C \uC6C0\uC9C1\uC774\uB294
        \uADC0\uC5EC\uC6B4 \uACE0\uAE30 \uB369\uC5B4\uB9AC"
      fr: Poisson rond et lent, mignon comme une boule de viande
      de: "Rund und langsam, ein s\xFC\xDFer Fleischball im Wasser"
      ru: "\u041A\u0440\u0443\u0433\u043B\u0430\u044F \u0438 \u043C\u0435\u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u0440\u044B\u0431\u0430, \u043A\u0430\u043A \u043C\u0438\u043B\u044B\u0439
        \u043C\u044F\u0441\u043D\u043E\u0439 \u0448\u0430\u0440"
      es: Pez redondo y lento, una bola de carne adorable
      pt: Peixe redondo e lento, uma bola de carne fofa
      it: Pesce rotondo e lento, una palla di carne carina
      tr: "Yuvarlak ve Yava\u015F Hareketli, Sevimli Bir Et Topu"
      vi: "C\xE1 tr\xF2n tr\u1ECBa, di chuy\u1EC3n ch\u1EADm, nh\u01B0 c\u1EE5c th\u1ECBt
        l\u0103n trong n\u01B0\u1EDBc"
      th: "\u0E15\u0E31\u0E27\u0E01\u0E25\u0E21 \u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E2B\u0E27\u0E0A\u0E49\u0E32
        \u0E19\u0E48\u0E32\u0E23\u0E31\u0E01\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E49\u0E2D\u0E19\u0E40\u0E19\u0E37\u0E49\u0E2D"
      pl: "Okr\u0105g\u0142a i Powolna Ryba jak Urocza Kulka Mi\u0119sa"
      nl: Ronde en Langzaam Bewegend, Schattig Vleesballetje
      el: "\u03A3\u03C4\u03C1\u03BF\u03B3\u03B3\u03C5\u03BB\u03CC \u03BA\u03B1\u03B9
        \u03B1\u03C1\u03B3\u03CC\u03BA\u03AF\u03BD\u03B7\u03C4\u03BF, \u03C7\u03B1\u03C1\u03B9\u03C4\u03C9\u03BC\u03AD\u03BD\u03B7
        \u03BC\u03C0\u03AC\u03BB\u03B1 \u03BA\u03C1\u03AD\u03B1\u03C2"
      ar: "\u0633\u0645\u0643\u0629 \u0645\u0633\u062A\u062F\u064A\u0631\u0629 \u062A\u062A\u062D\u0631\u0643
        \u0628\u0628\u0637\u0621\u060C \u0643\u0643\u0631\u0629 \u0644\u062D\u0645
        \u0644\u0637\u064A\u0641\u0629 \u0641\u064A \u0627\u0644\u0645\u0627\u0621"
      hi: "\u0917\u094B\u0932 \u0914\u0930 \u0927\u0940\u092E\u0940 \u0917\u0924\u093F
        \u0935\u093E\u0932\u0940 \u092A\u094D\u092F\u093E\u0930\u0940 \u092E\u091B\u0932\u0940"
      ur: "\u06AF\u0648\u0644 \u0627\u0648\u0631 \u0633\u0633\u062A \u0631\u0641\u062A\u0627\u0631
        \u067E\u06CC\u0627\u0631\u06CC \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan bulat comel bergerak perlahan
      id: Ikan bulat lucu bergerak lambat
    - cn: "\u751F\u6D3B\u4E8E\u6EAA\u6D41\uFF0C\u5473\u9053\u50CF\u6625\u65E5\u6A31\u843D\u6EAA\u6D41\u7684\u4E00\u62B9\u751C\u9999\u3002"
      en: Fresh fish from clear streams, tastes like spring flowers
      tw: "\u68F2\u606F\u65BC\u6EAA\u6D41\uFF0C\u6ECB\u5473\u5982\u6625\u65E5\u6AFB\u74E3\u98C4\u843D\u6EAA\u6C34\u7684\u6E05\u751C\u9999\u6C23"
      ja: "\u6E05\u6D41\u306B\u68F2\u307F\u3001\u6625\u306E\u685C\u304C\u5C0F\u5DDD\u306B\u821E\u3044\u843D\u3061\u308B\u3088\u3046\u306A\u7518\u3044\u9999\u308A"
      ko: "\uB9D1\uC740 \uC2DC\uB0C7\uBB3C\uC5D0 \uC11C\uC2DD\uD558\uBA70 \uBD04\uB0A0
        \uBC9A\uAF43\uC774 \uD750\uB974\uB294 \uC2DC\uB0B4\uC5D0 \uB5A8\uC5B4\uC9C4
        \uB4EF \uB2EC\uCF64\uD55C \uD5A5\uAE30"
      fr: "Poisson frais des ruisseaux clairs, au go\xFBt floral printanier"
      de: "Frischer Fisch aus klaren B\xE4chen, schmeckt nach Fr\xFChlingsbl\xFCten"
      ru: "\u0421\u0432\u0435\u0436\u0430\u044F \u0440\u044B\u0431\u0430 \u0438\u0437
        \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0445 \u0440\u0443\u0447\u044C\u0435\u0432,
        \u0432\u043A\u0443\u0441 \u0432\u0435\u0441\u0435\u043D\u043D\u0438\u0445
        \u0446\u0432\u0435\u0442\u043E\u0432"
      es: Pez fresco de arroyos cristalinos, con sabor a flores primaverales
      pt: "Peixe fresco de riachos l\xEDmpidos, sabor a flores da primavera"
      it: Pesce fresco di ruscelli limpidi, dal sapore floreale primaverile
      tr: "Berrak derelerden taze bal\u0131k, ilkbahar \xE7i\xE7ekleri tad\u0131nda"
      vi: "C\xE1 t\u01B0\u01A1i t\u1EEB su\u1ED1i trong, v\u1ECB nh\u01B0 hoa xu\xE2n"
      th: "\u0E1B\u0E25\u0E32\u0E2A\u0E14\u0E08\u0E32\u0E01\u0E25\u0E33\u0E18\u0E32\u0E23\u0E43\u0E2A
        \u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E34\u0E14\u0E31\u0E48\u0E07\u0E14\u0E2D\u0E01\u0E44\u0E21\u0E49\u0E24\u0E14\u0E39\u0E43\u0E1A\u0E44\u0E21\u0E49\u0E1C\u0E25\u0E34"
      pl: "\u015Awie\u017Ce ryby z przejrzystych strumieni, smakuj\u0105 jak wiosenne
        kwiaty"
      nl: Verse vis uit heldere beken, smaakt naar voorjaarsbloemen
      el: "\u03A4\u03B1\u03B6\u03AD\u03BD \u03C8\u03AC\u03C1\u03B9 \u03B1\u03C0\u03CC
        \u03BA\u03B1\u03B8\u03B1\u03C1\u03AC \u03C1\u03C5\u03AC\u03BA\u03B9\u03B1,
        \u03B3\u03B5\u03CD\u03C3\u03B7 \u03C3\u03B1\u03BD \u03B1\u03BD\u03BF\u03B9\u03BE\u03B9\u03AC\u03C4\u03B9\u03BA\u03B1
        \u03BB\u03BF\u03C5\u03BB\u03BF\u03CD\u03B4\u03B9\u03B1"
      ar: "\u0633\u0645\u0643 \u0637\u0627\u0632\u062C \u0645\u0646 \u0627\u0644\u062C\u062F\u0627\u0648\u0644
        \u0627\u0644\u0635\u0627\u0641\u064A\u0629\u060C \u0637\u0639\u0645\u0647
        \u0643\u0623\u0632\u0647\u0627\u0631 \u0627\u0644\u0631\u0628\u064A\u0639"
      hi: "\u0938\u093E\u092B\u093C \u0928\u0926\u093F\u092F\u094B\u0902 \u0915\u0940
        \u092E\u091B\u0932\u0940, \u092C\u0938\u0902\u0924 \u0915\u0947 \u092B\u0942\u0932\u094B\u0902
        \u091C\u0948\u0938\u093E \u0938\u094D\u0935\u093E\u0926"
      ur: "\u0635\u0627\u0641 \u0646\u062F\u06CC\u0648\u06BA \u06A9\u06CC \u0645\u0686\u06BE\u0644\u06CC\u060C
        \u0628\u06C1\u0627\u0631 \u06A9\u06D2 \u067E\u06BE\u0648\u0644\u0648\u06BA
        \u062C\u06CC\u0633\u0627 \u0630\u0627\u0626\u0642\u06C1"
      ms: Ikan sungai beraroma bunga musim bunga
      id: Ikan sungai beraroma bunga musim semi
    - cn: "\u5728\u6E05\u6F88\u5C71\u6DA7\u6D3B\u8DC3\uFF0C\u4F3C\u5C71\u6DA7\u6E05\u6CC9\u6D41\u6DCC\u7684\u9C9C\u6D3B\u6ECB\u5473\u3002"
      en: Found in clear mountain streams, crisp and fresh
      tw: "\u6D3B\u8E8D\u65BC\u6E05\u6F88\u5C71\u6F97\uFF0C\u5982\u5C71\u6CC9\u6D41\u6DCC\u7684\u9BAE\u6D3B\u6ECB\u5473"
      ja: "\u6F84\u3093\u3060\u5C71\u9593\u306E\u6E13\u6D41\u306B\u751F\u606F\u3057\u3001\u6E05\u6D41\u305D\u306E\u3082\u306E\u306E\u9BAE\u70C8\u306A\u5473\u308F\u3044"
      ko: "\uB9D1\uC740 \uC0B0\uACE8\uC9DC\uAE30 \uC2DC\uB0C7\uBB3C\uC5D0\uC11C \uD65C\uBC1C\uD788
        \uC6C0\uC9C1\uC774\uBA70 \uC0B0\uCC9C \uCCAD\uB958\uAC00 \uD750\uB974\uB294
        \uC0DD\uC0DD\uD55C \uB9DB"
      fr: "Poisson vif des torrents montagneux, fra\xEEcheur cristalline"
      de: "Lebhafte Fische in klaren Gebirgsb\xE4chen, knackig frisch"
      ru: "\u0416\u0438\u0432\u0430\u044F \u0440\u044B\u0431\u0430 \u0438\u0437 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0445
        \u0433\u043E\u0440\u043D\u044B\u0445 \u0440\u0443\u0447\u044C\u0435\u0432,
        \u0445\u0440\u0443\u0441\u0442\u044F\u0449\u0430\u044F \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044C"
      es: "Pez activo en arroyos monta\xF1osos cristalinos, fresco y crujiente"
      pt: "Peixe vigoroso em riachos montanhosos l\xEDmpidos, fresco e crocante"
      it: Pesce vivace in ruscelli montani limpidi, croccante e fresco
      tr: "Berrak da\u011F derelerinde aktif, taze ve gevrek lezzet"
      vi: "C\xE1 s\u1ED1ng \u0111\u1ED9ng \u1EDF su\u1ED1i n\xFAi trong, v\u1ECB
        t\u01B0\u01A1i m\xE1t nh\u01B0 su\u1ED1i ch\u1EA3y"
      th: "\u0E1B\u0E25\u0E32\u0E43\u0E19\u0E25\u0E33\u0E18\u0E32\u0E23\u0E20\u0E39\u0E40\u0E02\u0E32\u0E2A\u0E30\u0E2D\u0E32\u0E14
        \u0E21\u0E35\u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E34\u0E2A\u0E14\u0E0A\u0E37\u0E48\u0E19\u0E23\u0E32\u0E27\u0E01\u0E31\u0E1A\u0E19\u0E49\u0E33\u0E43\u0E2A\u0E44\u0E2B\u0E25\u0E40\u0E22\u0E47\u0E19"
      pl: "Ryby z g\xF3rskich strumieni, chrupi\u0105ce i \u015Bwie\u017Ce"
      nl: Levendige vis in heldere bergbeken, knapperig vers
      el: "\u0396\u03C9\u03BD\u03C4\u03B1\u03BD\u03AC \u03C8\u03AC\u03C1\u03B9\u03B1
        \u03C3\u03B5 \u03BA\u03B1\u03B8\u03B1\u03C1\u03AC \u03B2\u03BF\u03C5\u03BD\u03AC
        \u03C0\u03BF\u03C4\u03AC\u03BC\u03B9\u03B1, \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03AC
        \u03BA\u03B1\u03B9 \u03C6\u03C1\u03AD\u03C3\u03BA\u03B1"
      ar: "\u0623\u0633\u0645\u0627\u0643 \u0646\u0634\u0637\u0629 \u0641\u064A \u062C\u062F\u0627\u0648\u0644
        \u0627\u0644\u062C\u0628\u0644 \u0627\u0644\u0635\u0627\u0641\u064A\u0629\u060C
        \u0637\u0639\u0645\u0647\u0627 \u0645\u0646\u0639\u0634 \u0648\u0642\u0648\u064A"
      hi: "\u0938\u093E\u092B\u093C \u092A\u0939\u093E\u0921\u093C\u0940 \u0928\u0926\u093F\u092F\u094B\u0902
        \u092E\u0947\u0902 \u0938\u0915\u094D\u0930\u093F\u092F, \u0924\u093E\u091C\u093C\u093E
        \u0914\u0930 \u0915\u0941\u0930\u0915\u0941\u0930\u0940 \u092E\u091B\u0932\u0940"
      ur: "\u0635\u0627\u0641 \u067E\u06C1\u0627\u0691\u06CC \u0646\u062F\u06CC\u0627\u06BA
        \u0645\u06CC\u06BA \u0633\u0631\u06AF\u0631\u0645\u060C \u062A\u0627\u0632\u06C1
        \u0627\u0648\u0631 \u06A9\u0631\u06A9\u0631\u0627 \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan segar yang hidup di anak sungai gunung jernih
      id: Ikan segar yang hidup di aliran pegunungan jernih
    - cn: "\u5728\u8FD1\u6D77\u5CA9\u7901\u9644\u8FD1\u5DE1\u6E38\uFF0C\u9C7C\u8089\u751C\u7F8E\u4EFF\u4F5B\u5927\u6D77\u6E29\u67D4\u7684\u629A\u6478\u3002"
      en: Lives near coastal reefs, sweet and tender fish meat
      tw: "\u5DE1\u904A\u8FD1\u6D77\u5CA9\u7901\uFF0C\u9B5A\u8089\u751C\u7F8E\u5982\u5927\u6D77\u6EAB\u67D4\u64AB\u89F8"
      ja: "\u6CBF\u5CB8\u306E\u5CA9\u7901\u8FD1\u304F\u306B\u751F\u606F\u3001\u6D77\u306E\u512A\u3057\u3044\u89E6\u308C\u5408\u3044\u306E\u3088\u3046\u306A\u7518\u304F\u67D4\u3089\u304B\u3044\u8EAB"
      ko: "\uC5F0\uC548 \uC554\uCD08 \uADFC\uCC98\uB97C \uB3CC\uC544\uB2E4\uB2C8\uBA70
        \uBC14\uB2E4\uC758 \uC628\uD654\uD55C \uC190\uAE38 \uAC19\uC740 \uB2EC\uCF64\uD558\uACE0
        \uBD80\uB4DC\uB7EC\uC6B4 \uC0B4\uCF54\uAE30"
      fr: "Poisson des r\xE9cifs c\xF4tiers, chair douce et tendre comme une caresse
        marine"
      de: "Lebt in K\xFCstenriffen, s\xFC\xDFes und zartes Fischfleisch"
      ru: "\u041E\u0431\u0438\u0442\u0430\u0435\u0442 \u0432\u043E\u0437\u043B\u0435
        \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445 \u0440\u0438\u0444\u043E\u0432,
        \u0441\u043B\u0430\u0434\u043A\u0430\u044F \u0438 \u043D\u0435\u0436\u043D\u0430\u044F
        \u043C\u044F\u043A\u043E\u0442\u044C"
      es: Pez que vive cerca de arrecifes costeros, carne dulce y tierna
      pt: Peixe que vive perto de recifes costeiros, carne doce e macia
      it: Pesce che vive vicino alle scogliere costiere, carne dolce e tenera
      tr: "K\u0131y\u0131 resifleri yak\u0131n\u0131nda ya\u015Far, denizin nazik
        dokunu\u015Fu gibi tatl\u0131 ve yumu\u015Fak et"
      vi: "C\xE1 s\u1ED1ng g\u1EA7n r\u1EA1n san h\xF4, th\u1ECBt ng\u1ECDt d\u1ECBu
        nh\u01B0 bi\u1EC3n \xEAm"
      th: "\u0E1B\u0E25\u0E32\u0E43\u0E01\u0E25\u0E49\u0E41\u0E19\u0E27\u0E2B\u0E34\u0E19\u0E0A\u0E32\u0E22\u0E1D\u0E31\u0E48\u0E07
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E2B\u0E27\u0E32\u0E19\u0E19\u0E38\u0E48\u0E21\u0E14\u0E31\u0E48\u0E07\u0E17\u0E30\u0E40\u0E25\u0E25\u0E39\u0E1A\u0E44\u0E25\u0E49"
      pl: "Ryby \u017Cyj\u0105ce przy rafach przybrze\u017Cnych, s\u0142odkie i delikatne
        mi\u0119so"
      nl: Leeft bij kustriffen, zoet en mals visvlees
      el: "\u03A8\u03AC\u03C1\u03B9\u03B1 \u03BA\u03BF\u03BD\u03C4\u03AC \u03C3\u03B5
        \u03C0\u03B1\u03C1\u03AC\u03BA\u03C4\u03B9\u03BF\u03C5\u03C2 \u03C5\u03C6\u03AC\u03BB\u03BF\u03C5\u03C2,
        \u03B3\u03BB\u03C5\u03BA\u03CC\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03C1\u03C5\u03C6\u03B5\u03C1\u03CC\u03C2"
      ar: "\u064A\u0639\u064A\u0634 \u0628\u0627\u0644\u0642\u0631\u0628 \u0645\u0646
        \u0627\u0644\u0634\u0639\u0627\u0628 \u0627\u0644\u0633\u0627\u062D\u0644\u064A\u0629\u060C
        \u0644\u062D\u0645 \u0633\u0645\u0643 \u062D\u0644\u0648 \u0648\u0644\u0637\u064A\u0641
        \u0643\u0644\u0645\u0633\u0629 \u0627\u0644\u0628\u062D\u0631"
      hi: "\u0924\u091F\u0940\u092F \u091A\u091F\u094D\u091F\u093E\u0928\u094B\u0902
        \u0915\u0947 \u092A\u093E\u0938 \u0918\u0942\u092E\u0928\u0947 \u0935\u093E\u0932\u0940
        \u092E\u091B\u0932\u0940, \u092E\u093E\u0902\u0938 \u092E\u0940\u0920\u093E
        \u0914\u0930 \u0915\u094B\u092E\u0932"
      ur: "\u0633\u0627\u062D\u0644\u06CC \u0686\u0679\u0627\u0646\u0648\u06BA \u06A9\u06D2
        \u0642\u0631\u06CC\u0628 \u062A\u06CC\u0631\u0646\u06D2 \u0648\u0627\u0644\u06CC
        \u0645\u0686\u06BE\u0644\u06CC\u060C \u0645\u06CC\u0679\u06BE\u0627 \u0627\u0648\u0631
        \u0646\u0631\u0645 \u06AF\u0648\u0634\u062A"
      ms: Ikan berenang dekat terumbu pantai, daging manis dan lembut
      id: Ikan berenang di dekat terumbu pantai, daging manis dan lembut
    - cn: "\u5728\u51B7\u6C34\u6C34\u57DF\u95EA\u4EAE\uFF0C\u4F3C\u91D1\u8272\u9633\u5149\u878D\u5165\u6C34\u4E2D\u7684\u7CBE\u534E\u3002"
      en: Shimmers in cold waters, gold-colored fish, pure and refined
      tw: "\u5728\u51B7\u6C34\u57DF\u9583\u8000\uFF0C\u5982\u91D1\u9EC3\u967D\u5149\u878D\u5165\u6C34\u4E2D\u7684\u7D14\u7CB9\u7CBE\u83EF"
      ja: "\u51B7\u305F\u3044\u6C34\u57DF\u3067\u8F1D\u304F\u3001\u91D1\u8272\u306E\u967D\u5149\u304C\u6C34\u306B\u6EB6\u3051\u8FBC\u3093\u3060\u3088\u3046\u306A\u7D14\u7C8B\u306A\u9B5A"
      ko: "\uCC28\uAC00\uC6B4 \uBB3C\uC18D\uC5D0\uC11C \uBC18\uC9DD\uC774\uBA70 \uAE08\uBE5B
        \uD587\uC0B4\uC774 \uBB3C\uC5D0 \uC2A4\uBA70\uB4E0 \uC815\uC218 \uAC19\uC740
        \uBAA8\uC2B5"
      fr: "Poisson dor\xE9 des eaux froides, puret\xE9 cristalline"
      de: "Gl\xE4nzt in kaltem Wasser, goldener Fisch von reiner Raffinesse"
      ru: "\u041C\u0435\u0440\u0446\u0430\u0435\u0442 \u0432 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445
        \u0432\u043E\u0434\u0430\u0445, \u0437\u043E\u043B\u043E\u0442\u0430\u044F
        \u0440\u044B\u0431\u0430 \u0447\u0438\u0441\u0442\u0435\u0439\u0448\u0435\u0433\u043E
        \u0432\u0438\u0434\u0430"
      es: "Pez dorado en aguas fr\xEDas, puro y refinado"
      pt: "Peixe dourado em \xE1guas frias, puro e refinado"
      it: Pesce dorato in acque fredde, puro e raffinato
      tr: "So\u011Fuk sularda par\u0131ldayan, suya kar\u0131\u015Fm\u0131\u015F
        alt\u0131n g\xFCne\u015F \u0131\u015F\u0131\u011F\u0131 gibi saf"
      vi: "C\xE1 l\u1EA5p l\xE1nh trong v\xF9ng n\u01B0\u1EDBc l\u1EA1nh, tinh khi\u1EBFt
        nh\u01B0 \xE1nh n\u1EAFng v\xE0ng"
      th: "\u0E1B\u0E25\u0E32\u0E41\u0E27\u0E27\u0E27\u0E32\u0E27\u0E43\u0E19\u0E19\u0E4D\u0E49\u0E32\u0E40\u0E22\u0E47\u0E19
        \u0E2A\u0E38\u0E01\u0E43\u0E2A\u0E14\u0E31\u0E48\u0E07\u0E41\u0E2A\u0E07\u0E17\u0E2D\u0E07\u0E43\u0E19\u0E19\u0E4D\u0E49\u0E32"
      pl: "Z\u0142ota ryba w zimnych wodach, czysta i szlachetna"
      nl: Goudkleurige vis in koud water, puur en verfijnd
      el: "\u03A7\u03C1\u03C5\u03C3\u03CC\u03C8\u03B1\u03C1\u03BF \u03C3\u03B5 \u03BA\u03C1\u03CD\u03B1
        \u03BD\u03B5\u03C1\u03AC, \u03BA\u03B1\u03B8\u03B1\u03C1\u03CC \u03BA\u03B1\u03B9
        \u03B5\u03BA\u03BB\u03B5\u03C0\u03C4\u03C5\u03C3\u03BC\u03AD\u03BD\u03BF"
      ar: "\u064A\u0644\u0645\u0639 \u0641\u064A \u0627\u0644\u0645\u064A\u0627\u0647
        \u0627\u0644\u0628\u0627\u0631\u062F\u0629\u060C \u0633\u0645\u0643 \u0630\u0647\u0628\u064A
        \u0627\u0644\u0644\u0648\u0646 \u0646\u0642\u064A \u0648\u0645\u0643\u0631\u0631"
      hi: "\u0920\u0902\u0921\u0947 \u092A\u093E\u0928\u0940 \u092E\u0947\u0902 \u091A\u092E\u0915\u0924\u0940
        \u0938\u0941\u0928\u0939\u0930\u0940 \u092E\u091B\u0932\u0940, \u0936\u0941\u0926\u094D\u0927
        \u0914\u0930 \u092A\u0930\u093F\u0937\u094D\u0915\u0943\u0924"
      ur: "\u0679\u06BE\u0646\u0688\u06D2 \u067E\u0627\u0646\u06CC \u0645\u06CC\u06BA
        \u0686\u0645\u06A9\u062A\u06CC \u0633\u0646\u06C1\u0631\u06CC \u0645\u0686\u06BE\u0644\u06CC\u060C
        \u062E\u0627\u0644\u0635 \u0627\u0648\u0631 \u0635\u0627\u0641"
      ms: Ikan berkilau di perairan sejuk, warna emas murni
      id: Ikan berkilau di air dingin, warna emas murni
    - cn: "\u8272\u5F69\u7EDA\u4E3D\uFF0C\u7FA4\u6E38\u5982\u661F\u8292\u95EA\u70C1\uFF0C\u662F\u6C34\u4E2D\u68A6\u5E7B\u7684\u9713\u8679\u6D3E\u5BF9\u3002"
      en: Colorful fish, like a neon dream under the sea
      tw: "\u8272\u5F69\u7D62\u9E97\uFF0C\u7FA4\u6E38\u5982\u661F\u8292\u9583\u720D\uFF0C\u5B9B\u5982\u6C34\u4E2D\u9713\u8679\u5922\u5E7B\u6D3E\u5C0D"
      ja: "\u30AB\u30E9\u30D5\u30EB\u306A\u9B5A\u306E\u7FA4\u308C\u306F\u6D77\u4E2D\u306E\u30CD\u30AA\u30F3\u30C9\u30EA\u30FC\u30E0"
      ko: "\uD654\uB824\uD55C \uC0C9\uC0C1\uC758 \uBB3C\uACE0\uAE30 \uB5BC\uAC00
        \uBCC4\uBE5B\uCC98\uB7FC \uBC18\uC9DD\uC774\uBA70 \uC218\uC911 \uB124\uC628
        \uD30C\uD2F0\uB97C \uC5F0\uCD9C"
      fr: "Poisson multicolore, r\xEAve n\xE9on sous-marin"
      de: Bunte Fische, wie ein Neon-Traum unter dem Meer
      ru: "\u041A\u0440\u0430\u0441\u043E\u0447\u043D\u044B\u0435 \u0440\u044B\u0431\u044B,
        \u043F\u043E\u0434\u0432\u043E\u0434\u043D\u044B\u0439 \u043D\u0435\u043E\u043D\u043E\u0432\u044B\u0439
        \u0441\u043E\u043D"
      es: "Peces coloridos, sue\xF1o ne\xF3n bajo el mar"
      pt: "Peixe colorido, como um sonho neon subaqu\xE1tico"
      it: Pesci colorati, come un sogno neon sottomarino
      tr: "Renkli bal\u0131klar, deniz alt\u0131nda neon r\xFCyas\u0131 gibi"
      vi: "C\xE1 nhi\u1EC1u m\xE0u s\u1EAFc nh\u01B0 gi\u1EA5c m\u01A1 neon d\u01B0\u1EDBi
        bi\u1EC3n"
      th: "\u0E1B\u0E25\u0E32\u0E2A\u0E35\u0E2A\u0E31\u0E19\u0E2A\u0E14\u0E43\u0E2A
        \u0E27\u0E48\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E01\u0E25\u0E38\u0E48\u0E21\u0E14\u0E31\u0E48\u0E07\u0E14\u0E27\u0E07\u0E14\u0E32\u0E27
        \u0E40\u0E1B\u0E47\u0E19\u0E07\u0E32\u0E19\u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49\u0E43\u0E15\u0E49\u0E19\u0E4D\u0E49\u0E32"
      pl: "T\u0119czowe ryby, podwodne neonowe marzenie"
      nl: Kleurrijke vissen, als een neonfeest onder water
      el: "\u0388\u03B3\u03C7\u03C1\u03C9\u03BC\u03B1 \u03C8\u03AC\u03C1\u03B9\u03B1,
        \u03C3\u03B1\u03BD \u03BF\u03BD\u03B5\u03B9\u03C1\u03B9\u03BA\u03CC \u03BD\u03AD\u03BF\u03BD
        \u03BA\u03AC\u03C4\u03C9 \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1"
      ar: "\u0623\u0633\u0645\u0627\u0643 \u0645\u0644\u0648\u0646\u0629\u060C \u0643\u062D\u0644\u0645
        \u0646\u064A\u0648\u0646 \u062A\u062D\u062A \u0627\u0644\u0628\u062D\u0631"
      hi: "\u0930\u0902\u0917\u0940\u0928 \u092E\u091B\u0932\u0940, \u0938\u092E\u0941\u0926\u094D\u0930
        \u0915\u0947 \u0928\u0940\u091A\u0947 \u0928\u093F\u092F\u0949\u0928 \u0938\u092A\u0928\u093E"
      ur: "\u0631\u0646\u06AF\u06CC\u0646 \u0645\u0686\u06BE\u0644\u06CC\u060C \u0633\u0645\u0646\u062F\u0631
        \u06A9\u06D2 \u0646\u06CC\u0686\u06D2 \u0646\u06CC\u0648\u0646 \u062E\u0648\u0627\u0628"
      ms: Ikan berwarna-warni seperti mimpi neon di laut
      id: Ikan berwarna-warni seperti mimpi neon di bawah laut
    - cn: "\u5728\u6E05\u6F88\u6EAA\u6D41\u4E2D\u6B22\u7545\uFF0C\u6E38\u6001\u5B9B\u5982\u6EAA\u8FB9\u6843\u82B1\u98D8\u843D\u7684\u7CBE\u7075\u3002"
      en: Found in clear streams, peach-colored and graceful
      tw: "\u5728\u6E05\u6F88\u6EAA\u6D41\u6B61\u66A2\u6E38\u52D5\uFF0C\u59FF\u614B\u5982\u6EAA\u7554\u6843\u82B1\u98C4\u843D\u7684\u7CBE\u9748"
      ja: "\u6F84\u3093\u3060\u5C0F\u5DDD\u3067\u512A\u96C5\u306B\u6CF3\u3050\u3001\u6843\u8272\u306E\u7CBE\u970A\u306E\u3088\u3046\u306A\u9B5A"
      ko: "\uB9D1\uC740 \uC2DC\uB0C7\uBB3C\uC5D0\uC11C \uC720\uC601\uD558\uB294 \uBCF5\uC22D\uC544\uBE5B\uC758
        \uC6B0\uC544\uD55C \uBB3C\uACE0\uAE30"
      fr: "Poisson gracieux couleur p\xEAche dans les ruisseaux clairs"
      de: Pfirsichfarbener Fisch mit anmutigen Bewegungen
      ru: "\u041F\u0435\u0440\u0441\u0438\u043A\u043E\u0432\u0430\u044F \u0440\u044B\u0431\u0430
        \u0441 \u0438\u0437\u044F\u0449\u043D\u044B\u043C\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438
        \u0432 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0445 \u0440\u0443\u0447\u044C\u044F\u0445"
      es: "Pez melocot\xF3n de movimientos gr\xE1ciles en arroyos"
      pt: "Peixe p\xEAssego com movimentos graciosos em riachos"
      it: Pesce color pesca dai movimenti aggraziati
      tr: "Berrak derelerde \u015Feftali rengi zarif bal\u0131k"
      vi: "C\xE1 m\xE0u \u0111\xE0o b\u01A1i duy\xEAn d\xE1ng trong su\u1ED1i trong"
      th: "\u0E1B\u0E25\u0E32\u0E43\u0E19\u0E25\u0E33\u0E18\u0E32\u0E23\u0E43\u0E2A
        \u0E27\u0E48\u0E32\u0E22\u0E23\u0E32\u0E27\u0E01\u0E31\u0E1A\u0E40\u0E17\u0E1E\u0E18\u0E34\u0E14\u0E32\u0E14\u0E2D\u0E01\u0E17\u0E49\u0E2D"
      pl: "Brzoskwiniowe ryby o wdzi\u0119cznych ruchach"
      nl: Perzikkleurige vis met sierlijke bewegingen
      el: "\u03A1\u03BF\u03B4\u03AC\u03BA\u03B9\u03BD\u03B1 \u03C8\u03AC\u03C1\u03B9\u03B1
        \u03BC\u03B5 \u03BA\u03BF\u03BC\u03C8\u03AD\u03C2 \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9\u03C2"
      ar: "\u0623\u0633\u0645\u0627\u0643 \u062E\u0648\u062E\u064A\u0629 \u0627\u0644\u0644\u0648\u0646
        \u062A\u0633\u0628\u062D \u0628\u0631\u0634\u0627\u0642\u0629 \u0641\u064A
        \u0627\u0644\u062C\u062F\u0627\u0648\u0644"
      hi: "\u0938\u093E\u092B\u093C \u0928\u0926\u093F\u092F\u094B\u0902 \u092E\u0947\u0902
        \u0924\u0948\u0930\u0924\u0940 \u0906\u0921\u093C\u0942 \u0930\u0902\u0917
        \u0915\u0940 \u0938\u0941\u0902\u0926\u0930 \u092E\u091B\u0932\u0940"
      ur: "\u0635\u0627\u0641 \u0646\u062F\u06CC\u0648\u06BA \u0645\u06CC\u06BA \u062A\u06CC\u0631\u062A\u06CC
        \u067E\u06CC\u0686 \u0631\u0646\u06AF \u06A9\u06CC \u062E\u0648\u0628\u0635\u0648\u0631\u062A
        \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan berwarna peach di sungai jernih
      id: Ikan berwarna peach di sungai jernih
    - cn: "\u5728\u6D77\u6D0B\u4E2D\u594B\u529B\u6D04\u6E38\uFF0C\u8EAB\u59FF\u5F3A\u58EE\uFF0C\u5176\u5473\u9C9C\u7F8E\u6D53\u90C1\u3002"
      en: Lives in the ocean, powerful and rich-tasting meat
      tw: "\u5728\u6D77\u6D0B\u4E2D\u596E\u529B\u6D04\u6E38\uFF0C\u8089\u8CEA\u5F37\u58EF\u4E14\u9BAE\u7F8E\u6FC3\u90C1"
      ja: "\u5927\u6D77\u3092\u529B\u5F37\u304F\u56DE\u904A\u3057\u3001\u6FC3\u539A\u306A\u5473\u308F\u3044"
      ko: "\uBC14\uB2E4\uB97C \uD798\uCC28\uAC8C \uD5E4\uC5C4\uCE58\uB294 \uAC15\uD55C
        \uBAB8\uC9D1\uACFC \uD48D\uBBF8 \uAC00\uB4DD\uD55C \uC0B4\uCF54\uAE30"
      fr: "Poisson oc\xE9anique puissant au go\xFBt riche"
      de: "Starker Ozeanfisch mit kr\xE4ftigem Geschmack"
      ru: "\u041C\u043E\u0449\u043D\u0430\u044F \u043E\u043A\u0435\u0430\u043D\u0441\u043A\u0430\u044F
        \u0440\u044B\u0431\u0430 \u0441 \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u044B\u043C
        \u0432\u043A\u0443\u0441\u043E\u043C"
      es: "Pez oce\xE1nico de carne potente y sabrosa"
      pt: "Peixe oce\xE2nico de sabor forte e rico"
      it: Pesce oceanico dal sapore intenso
      tr: "Okyanusta g\xFC\xE7l\xFC \u015Fekilde y\xFCzen, lezzetli et"
      vi: "C\xE1 m\u1EA1nh m\u1EBD s\u1ED1ng \u1EDF \u0111\u1EA1i d\u01B0\u01A1ng,
        th\u1ECBt \u0111\u1EADm v\u1ECB"
      th: "\u0E1B\u0E25\u0E32\u0E17\u0E30\u0E40\u0E25\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E41\u0E19\u0E48\u0E19
        \u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19"
      pl: Mocna ryba oceaniczna o bogatym smaku
      nl: Krachtige oceaanvis met rijke smaak
      el: "\u0399\u03C3\u03C7\u03C5\u03C1\u03CC \u03C9\u03BA\u03B5\u03AC\u03BD\u03B9\u03BF
        \u03C8\u03AC\u03C1\u03B9 \u03BC\u03B5 \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03B1
        \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u0633\u0645\u0643 \u0645\u062D\u064A\u0637\u064A \u0642\u0648\u064A \u0628\u0644\u062D\u0645
        \u063A\u0646\u064A \u0627\u0644\u0637\u0639\u0645"
      hi: "\u0938\u092E\u0941\u0926\u094D\u0930 \u092E\u0947\u0902 \u0924\u0948\u0930\u0924\u0940
        \u0936\u0915\u094D\u0924\u093F\u0936\u093E\u0932\u0940 \u092E\u091B\u0932\u0940,
        \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F \u0914\u0930 \u0938\u092E\u0943\u0926\u094D\u0927
        \u092E\u093E\u0902\u0938"
      ur: "\u0633\u0645\u0646\u062F\u0631 \u0645\u06CC\u06BA \u062A\u06CC\u0631\u0646\u06D2
        \u0648\u0627\u0644\u06CC \u0637\u0627\u0642\u062A\u0648\u0631 \u0645\u0686\u06BE\u0644\u06CC\u060C
        \u0645\u0632\u06CC\u062F\u0627\u0631 \u0627\u0648\u0631 \u0628\u06BE\u0631\u067E\u0648\u0631
        \u06AF\u0648\u0634\u062A"
      ms: Ikan laut berkuasa dengan daging kaya
      id: Ikan laut kuat dengan daging kaya rasa
    - cn: "\u5C3E\u5DF4\u4F3C\u6247\uFF0C\u6E38\u59FF\u5A40\u5A1C\u591A\u59FF\uFF0C\u5982\u7A7F\u7740\u534E\u670D\u8D70\u79C0\u7684\u6A21\u7279\u3002"
      en: With a fan-like tail, elegant swimming like a model in a show
      tw: "\u5C3E\u5982\u647A\u6247\uFF0C\u6E38\u59FF\u512A\u96C5\u5982\u83EF\u670D\u6A21\u7279"
      ja: "\u6247\u306E\u3088\u3046\u306A\u5C3E\u3073\u308C\u3067\u512A\u96C5\u306B\u6CF3\u3050\u30B7\u30E7\u30FC\u30E2\u30C7\u30EB\u306E\u3088\u3046\u306A\u9B5A"
      ko: "\uBD80\uCC44 \uAF2C\uB9AC\uB85C \uC6B0\uC544\uD558\uAC8C \uC218\uC601\uD558\uB294
        \uC1FC \uBAA8\uB378 \uAC19\uC740 \uBB3C\uACE0\uAE30"
      fr: "Poisson \xE0 queue en \xE9ventail, nage \xE9l\xE9gante comme un mannequin"
      de: "Fisch mit f\xE4cherartiger Schwanzflosse, elegant wie ein Model"
      ru: "\u0420\u044B\u0431\u0430 \u0441 \u0432\u0435\u0435\u0440\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C
        \u0445\u0432\u043E\u0441\u0442\u043E\u043C, \u0438\u0437\u044F\u0449\u043D\u043E
        \u043F\u043B\u0430\u0432\u0430\u0435\u0442 \u043A\u0430\u043A \u043C\u043E\u0434\u0435\u043B\u044C"
      es: Pez con cola de abanico, elegante como modelo
      pt: Peixe com cauda em leque, elegante como modelo
      it: Pesce con coda a ventaglio, elegante come una modella
      tr: "Yelpaze kuyruklu, \u015Fovdaki model gibi zarif y\xFCz\xFC\u015F"
      vi: "C\xE1 \u0111u\xF4i qu\u1EA1t b\u01A1i duy\xEAn d\xE1ng nh\u01B0 ng\u01B0\u1EDDi
        m\u1EABu"
      th: "\u0E1B\u0E25\u0E32\u0E2B\u0E32\u0E07\u0E1E\u0E31\u0E14 \u0E27\u0E48\u0E32\u0E22\u0E19\u0E49\u0E33\u0E07\u0E14\u0E07\u0E32\u0E21\u0E14\u0E31\u0E48\u0E07\u0E19\u0E32\u0E07\u0E41\u0E1A\u0E1A"
      pl: Ryba z wachlarzowatym ogonem, elegancka jak modelka
      nl: Vis met waaiervormige staart, elegant als model
      el: "\u03A8\u03AC\u03C1\u03B9 \u03BC\u03B5 \u03BF\u03C5\u03C1\u03AC \u03C3\u03B1\u03BD
        \u03B2\u03B5\u03BD\u03C4\u03AC\u03BB\u03B9\u03B1, \u03BA\u03BF\u03BC\u03C8\u03CC
        \u03C3\u03B1\u03BD \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF"
      ar: "\u0633\u0645\u0643 \u0630\u0648 \u0630\u064A\u0644 \u0645\u0631\u0648\u062D\u064A
        \u064A\u0633\u0628\u062D \u0628\u0623\u0646\u0627\u0642\u0629 \u0643\u0639\u0627\u0631\u0636\u0629
        \u0623\u0632\u064A\u0627\u0621"
      hi: "\u092A\u0902\u0916\u0947 \u091C\u0948\u0938\u0940 \u092A\u0942\u0901\u091B
        \u0935\u093E\u0932\u0940 \u092E\u091B\u0932\u0940, \u0936\u094B \u092E\u0947\u0902
        \u092E\u0949\u0921\u0932 \u0915\u0940 \u0924\u0930\u0939 \u0924\u0948\u0930\u0924\u0940
        \u0939\u0948"
      ur: "\u067E\u0646\u06A9\u06BE\u06D2 \u062C\u06CC\u0633\u06CC \u062F\u0645 \u0648\u0627\u0644\u06CC
        \u0645\u0686\u06BE\u0644\u06CC\u060C \u0634\u0648 \u0645\u06CC\u06BA \u0645\u0627\u0688\u0644
        \u06A9\u06CC \u0637\u0631\u062D \u062A\u06CC\u0631\u062A\u06CC \u06C1\u06D2"
      ms: Ikan berekor kipas seperti model di catwalk
      id: Ikan berekor kipas seperti model di catwalk
    - cn: "\u8EAB\u5F62\u4FEE\u957F\uFF0C\u6E38\u65F6\u6C14\u52BF\u78C5\u7934\uFF0C\u4EFF\u82E5\u94F6\u8272\u86DF\u9F99\u9A70\u9A8B\u6CA7\u6D77\u3002"
      en: Long and majestic, like a silver dragon swimming through the seas
      tw: "\u4FEE\u9577\u8EAB\u5F62\u6E38\u52D5\u6642\u6C23\u52E2\u78C5\u7934\uFF0C\u5982\u9280\u8272\u86DF\u9F8D\u99B3\u9A01\u6EC4\u6D77"
      ja: "\u9280\u306E\u9F8D\u304C\u6D77\u3092\u6CF3\u3050\u3088\u3046\u306A\u9577\u304F\u96C4\u5927\u306A\u9B5A"
      ko: "\uC740\uBE5B \uC6A9\uC774 \uBC14\uB2E4\uB97C \uB204\uBE44\uB294 \uB4EF\uD55C
        \uAE38\uACE0 \uC704\uC5C4 \uC788\uB294 \uBB3C\uACE0\uAE30"
      fr: Poisson long et majestueux tel un dragon d'argent
      de: "Langer majest\xE4tischer Fisch wie ein silberner Drache"
      ru: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0432\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
        \u0440\u044B\u0431\u0430, \u0441\u043B\u043E\u0432\u043D\u043E \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439
        \u0434\u0440\u0430\u043A\u043E\u043D"
      es: "Pez largo y majestuoso como drag\xF3n plateado"
      pt: "Peixe longo e majestoso como drag\xE3o prateado"
      it: Pesce lungo e maestoso come un drago d'argento
      tr: "G\xFCm\xFC\u015F bir ejderha gibi uzun ve g\xF6rkemli"
      vi: "C\xE1 d\xE0i uy nghi nh\u01B0 r\u1ED3ng b\u1EA1c l\u01B0\u1EDBt tr\xEAn
        bi\u1EC3n"
      th: "\u0E1B\u0E25\u0E32\u0E40\u0E23\u0E35\u0E22\u0E27\u0E22\u0E32\u0E27 \u0E27\u0E48\u0E32\u0E22\u0E14\u0E38\u0E08\u0E21\u0E31\u0E07\u0E01\u0E23\u0E40\u0E07\u0E34\u0E19\u0E23\u0E48\u0E2D\u0E19\u0E17\u0E30\u0E40\u0E25"
      pl: "D\u0142uga, majestatyczna ryba jak srebrny smok"
      nl: Lange majestueuze vis als zilveren draak
      el: "\u039C\u03B5\u03B3\u03AC\u03BB\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03BF\u03C0\u03C1\u03B5\u03C0\u03AD\u03C2
        \u03C8\u03AC\u03C1\u03B9 \u03C3\u03B1 \u03B1\u03C3\u03B7\u03BC\u03AD\u03BD\u03B9\u03BF
        \u03B4\u03C1\u03AC\u03BA\u03BF"
      ar: "\u0633\u0645\u0643 \u0637\u0648\u064A\u0644 \u0645\u0647\u064A\u0628 \u0643\u062A\u0646\u064A\u0646
        \u0641\u0636\u064A \u064A\u0633\u0628\u062D \u0641\u064A \u0627\u0644\u0628\u062D\u0627\u0631"
      hi: "\u0932\u0902\u092C\u0940 \u0914\u0930 \u0930\u093E\u091C\u0938\u0940 \u092E\u091B\u0932\u0940,
        \u091A\u093E\u0902\u0926\u0940 \u0915\u0947 \u0905\u091C\u0917\u0930 \u0915\u0940
        \u0924\u0930\u0939"
      ur: "\u0644\u0645\u0628\u06CC \u0627\u0648\u0631 \u0634\u0627\u06C1\u06CC \u0645\u0686\u06BE\u0644\u06CC\u060C
        \u0686\u0627\u0646\u062F\u06CC \u06A9\u06D2 \u0627\u0698\u062F\u06C1\u06D2
        \u06A9\u06CC \u0637\u0631\u062D"
      ms: Ikan panjang gagah seperti naga perak
      id: Ikan panjang megah seperti naga perak
    - cn: "\u5CA9\u7A74\u6697\u5F71\u6816\u606F\uFF0C\u52A8\u4F5C\u8F7B\u67D4\uFF0C\u4F3C\u5E7D\u6697\u4E2D\u7684\u795E\u79D8\u821E\u8005\u3002"
      en: Moves softly and gracefully, a mysterious dancer in the shadows
