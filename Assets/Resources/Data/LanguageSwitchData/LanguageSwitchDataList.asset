      en: Confession
      tw: "\u544A\u767D"
      ja: "\u544A\u767D"
      ko: "\uACE0\uBC31"
      fr: Aveu
      de: "Gest\xE4ndnis"
      ru: "\u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435"
      es: "Confesi\xF3n"
      pt: "Confiss\xE3o"
      it: Confessione
      tr: "\u0130tiraf"
      vi: "Th\u1ED5 l\u1ED9"
      th: "\u0E01\u0E32\u0E23\u0E2A\u0E32\u0E23\u0E20\u0E32\u0E1E\u0E23\u0E31\u0E01"
      pl: Wyznanie
      nl: Bekentnis
      el: "\u039F\u03BC\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1"
