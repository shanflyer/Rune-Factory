    - cn: "\u5473\u9053\u9C9C\u7F8E\u72EC\u7279\uFF0C\u662F\u5371\u9669\u4E0E\u7F8E\u5473\u5E76\u5B58\u7684\u7CBE\u7075\u3002"
      en: Huge fish, tender and fresh, a legendary delicacy from the deep sea
      tw: "\u7368\u7279\u9BAE\u7F8E\u6ECB\u5473\uFF0C\u5371\u96AA\u8207\u7F8E\u5473\u4E26\u5B58\u7684\u6DF1\u6D77\u7CBE\u9748"
      ja: "\u6DF1\u6DF5\u304B\u3089\u306E\u4F1D\u8AAC\u306E\u73CD\u5473\u3001\u5371\u967A\u3068\u7F8E\u5473\u304C\u5171\u5B58\u3059\u308B\u5DE8\u5927\u9B5A"
      ko: "\uAE4A\uC740 \uBC14\uB2E4\uC5D0\uC11C \uC628 \uC804\uC124\uC801\uC778
        \uC9C4\uBBF8, \uC704\uD5D8\uACFC \uB9DB\uC774 \uACF5\uC874\uD558\uB294 \uAC70\uB300\uD55C
        \uBB3C\uACE0\uAE30"
      fr: "Poisson g\xE9ant tendre et l\xE9gendaire des abysses"
      de: "Legend\xE4rer zarter Tiefseefisch"
      ru: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0430\u044F \u043D\u0435\u0436\u043D\u0430\u044F
        \u0440\u044B\u0431\u0430 \u0433\u043B\u0443\u0431\u0438\u043D"
      es: Pez gigante tierno de aguas profundas
      pt: Peixe gigante macio das profundezas
      it: Pesce gigante leggendario degli abissi
      tr: "Derin denizlerin efsanevi lezzeti dev bal\u0131k"
      vi: "C\xE1 kh\u1ED5ng l\u1ED3 m\u1EC1m t\u01B0\u01A1i ngon t\u1EEB bi\u1EC3n
        s\xE2u"
      th: "\u0E1B\u0E25\u0E32\u0E22\u0E31\u0E01\u0E29\u0E4C\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E19\u0E38\u0E48\u0E21\u0E08\u0E32\u0E01\u0E17\u0E30\u0E40\u0E25\u0E25\u0E36\u0E01"
      pl: "Legendarny przysmak z g\u0142\u0119bin"
      nl: Gigantische zachte diepzeevis
      el: "\u0398\u03C1\u03C5\u03BB\u03B9\u03BA\u03CC \u03C8\u03AC\u03C1\u03B9 \u03B1\u03C0\u03CC
        \u03C4\u03B1 \u03B2\u03AC\u03B8\u03B7 \u03C4\u03BF\u03C5 \u03C9\u03BA\u03B5\u03B1\u03BD\u03BF\u03CD"
      ar: "\u0633\u0645\u0643 \u0639\u0645\u0644\u0627\u0642 \u0637\u0631\u064A \u0645\u0646
        \u0623\u0639\u0645\u0627\u0642 \u0627\u0644\u0628\u062D\u0631"
      hi: "\u0935\u093F\u0936\u093E\u0932 \u092E\u091B\u0932\u0940, \u0928\u0930\u092E
        \u0914\u0930 \u0924\u093E\u091C\u093C\u093E, \u0917\u0939\u0930\u0947 \u0938\u092E\u0941\u0926\u094D\u0930
        \u0915\u0940 \u092A\u094C\u0930\u093E\u0923\u093F\u0915 \u0935\u0938\u094D\u0924\u0941"
      ur: "\u0628\u0691\u06CC \u0645\u0686\u06BE\u0644\u06CC\u060C \u0646\u0631\u0645
        \u0627\u0648\u0631 \u062A\u0627\u0632\u06C1\u060C \u06AF\u06C1\u0631\u06D2
        \u0633\u0645\u0646\u062F\u0631 \u06A9\u06CC \u0627\u0641\u0633\u0627\u0646\u0648\u06CC
        \u0686\u06CC\u0632"
      ms: Ikan besar lembut dari laut dalam
      id: Ikan besar lembut dari laut dalam
      he: "\u05D8\u05E2\u05DD \u05D9\u05D9\u05D7\u05D5\u05D3\u05D9 \u05D5\u05DE\u05D4\u05DE\u05DD,
        \u05E9\u05D9\u05DC\u05D5\u05D1 \u05E9\u05DC \u05E1\u05DB\u05E0\u05D4 \u05D5\u05D8\u05E2\u05DD"
      sv: "Unik och l\xE4cker smak, kombination av fara och smak"
      cs: "Jedine\u010Dn\xE1 a lahodn\xE1 chu\u0165, kombinace nebezpe\u010D\xED
