      hu: Rum
      sw: Ramu
      sr: Rum
      fi: "Sukker\xF8rss\xF8d smag"
      da: Sokeriruokoisen makea maku
    - cn: "\u6709\u72EC\u7279\u98CE\u5473\uFF0C\u4F3C\u6709\u91CE\u8702\u7684\u7075\u52A8\u4E0E\u81EA\u7136\u7684\u6E05\u65B0\u3002"
