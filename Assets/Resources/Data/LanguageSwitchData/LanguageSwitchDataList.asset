      fr: "Douceur parfum\xE9e et fra\xEEche"
      de: "S\xFC\xDFlich-frische M\xE4dchentr\xE4ume"
      ru: "\u0421\u043B\u0430\u0434\u043A\u0438\u0439 \u0438 \u043D\u0435\u0436\u043D\u044B\u0439
        \u0434\u0435\u0441\u0435\u0440\u0442"
