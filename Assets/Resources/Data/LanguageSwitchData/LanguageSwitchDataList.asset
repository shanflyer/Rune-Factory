      it: Minerale Infiammabile
      tr: "Yan\u0131c\u0131 Mineral"
      vi: "Kho\xE1ng ch\u1EA5t d\u1EC5 ch\xE1y"
      th: "\u0E41\u0E23\u0E48\u0E15\u0E34\u0E14\u0E44\u0E1F"
      pl: "\u0141atwopalny Minera\u0142"
      nl: Ontvlambaar Mineraal
      el: "\u0395\u03CD\u03C6\u03BB\u03B5\u03BA\u03C4\u03BF \u03BF\u03C1\u03C5\u03BA\u03C4\u03CC"
      ar: "\u0645\u0639\u062F\u0646 \u0642\u0627\u0628\u0644 \u0644\u0644\u0627\u0634\u062A\u0639\u0627\u0644"
      hi: "\u091C\u094D\u0935\u0932\u0928\u0936\u0940\u0932 \u0916\u0928\u093F\u091C"
      ur: "\u0622\u062A\u0634 \u06AF\u06CC\u0631 \u0645\u0639\u062F\u0646\u06CC\u0627\u062A"
      ms: Mineral mudah terbakar
      id: Mineral mudah terbakar
    - cn: "\u5C01\u5B58\u7740\u9633\u5149\u7684\u7ED3\u6676\u77FF\u7269"
      en: Crystal that stores sunlight
      tw: "\u5C01\u5B58\u8457\u967D\u5149\u7684\u7D50\u6676\u7926\u7269"
      ja: "\u592A\u967D\u5149\u3092\u5C01\u3058\u305F\u7D50\u6676\u9271\u7269"
      ko: "\uD587\uBE5B\uC744 \uC800\uC7A5\uD558\uB294 \uACB0\uC815 \uAD11\uBB3C"
      fr: "Cristal emprisonnant la lumi\xE8re du soleil"
      de: Kristall, der Sonnenlicht speichert
      ru: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B, \u0445\u0440\u0430\u043D\u044F\u0449\u0438\u0439
        \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442"
      es: Cristal que Almacena Luz Solar
      pt: Cristal que Armazena Luz Solar
      it: Cristallo che Immagazzina Luce Solare
      tr: "G\xFCne\u015F I\u015F\u0131\u011F\u0131 Depolayan Kristal"
      vi: "Kho\xE1ng ch\u1EA5t k\u1EBFt tinh \xE1nh n\u1EAFng"
      th: "\u0E41\u0E23\u0E48\u0E04\u0E23\u0E34\u0E2A\u0E15\u0E31\u0E25\u0E40\u0E01\u0E47\u0E1A\u0E41\u0E2A\u0E07\u0E2D\u0E32\u0E17\u0E34\u0E15\u0E22\u0E4C"
      pl: "Kryszta\u0142 Przechowuj\u0105cy \u015Awiat\u0142o"
      nl: Kristal die Zonlicht Opslaat
      el: "\u039A\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\u03BF\u03C2 \u03C0\u03BF\u03C5
        \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03B5\u03B9 \u03B7\u03BB\u03B9\u03B1\u03BA\u03CC
        \u03C6\u03C9\u03C2"
      ar: "\u0645\u0639\u062F\u0646 \u0628\u0644\u0648\u0631\u064A \u064A\u062E\u0632\u0646
        \u0636\u0648\u0621 \u0627\u0644\u0634\u0645\u0633"
      hi: "\u0938\u0942\u0930\u094D\u092F \u0915\u0947 \u092A\u094D\u0930\u0915\u093E\u0936
        \u0915\u094B \u0938\u0902\u0917\u094D\u0930\u0939\u093F\u0924 \u0915\u0930\u0928\u0947
        \u0935\u093E\u0932\u093E \u0915\u094D\u0930\u093F\u0938\u094D\u091F\u0932"
      ur: "\u0633\u0648\u0631\u062C \u06A9\u06CC \u0631\u0648\u0634\u0646\u06CC \u06A9\u0648
        \u0630\u062E\u06CC\u0631\u06C1 \u06A9\u0631\u0646\u06D2 \u0648\u0627\u0644\u0627
        \u06A9\u0631\u0633\u0679\u0644"
      ms: Kristal yang menyimpan cahaya matahari
      id: Kristal yang menyimpan sinar matahari
    - cn: "\u5BCC\u542B\u9B54\u529B\u7684\u571F\u58E4"
      en: Magical soil full of energy
      tw: "\u5BCC\u542B\u9B54\u529B\u7684\u571F\u58E4"
