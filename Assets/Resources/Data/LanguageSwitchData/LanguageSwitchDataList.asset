      pl: "Wywa\u017Cona s\u0142ono-kwa\u015Bna chrupko\u015B\u0107"
      nl: Gebalanceerd zoutzuur met crunch
      el: "\u0399\u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03B7\u03BC\u03AD\u03BD\u03BF
        \u03B1\u03BB\u03BC\u03C5\u03C1\u03CC-\u03BE\u03B9\u03BD\u03CC \u03BC\u03B5
        \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1"
      ar: "\u0645\u0627\u0644\u062D \u0648\u062D\u0627\u0645\u0636 \u0645\u0639 \u062A\u0648\u0627\u0632\u0646
        \u0648\u0645\u0642\u0631\u0645\u0634"
      hi: "\u0928\u092E\u0915\u0940\u0928 \u0914\u0930 \u0916\u091F\u094D\u091F\u0947
        \u0915\u093E \u0938\u0902\u0924\u0941\u0932\u0928, \u0915\u0941\u0930\u0915\u0941\u0930\u093E
        \u0914\u0930 \u092D\u0942\u0916 \u092C\u0922\u093C\u093E\u0928\u0947 \u0935\u093E\u0932\u093E,
        \u0905\u0928\u094B\u0916\u093E \u0938\u094D\u0935\u093E\u0926 \u091C\u094B\u0921\u093C\u0924\u093E
        \u0939\u0948"
      ur: "\u0646\u0645\u06A9\u06CC\u0646 \u0627\u0648\u0631 \u062A\u0631\u0634\u06CC
        \u06A9\u0627 \u062A\u0648\u0627\u0632\u0646\u060C \u06A9\u0631\u06A9\u0631\u0627
        \u0627\u0648\u0631 \u0628\u06BE\u0648\u06A9 \u0628\u0691\u06BE\u0627\u0646\u06D2
        \u0648\u0627\u0644\u0627\u060C \u0627\u0646\u0648\u06A9\u06BE\u0627 \u0630\u0627\u0626\u0642\u06C1
        \u062F\u06CC\u062A\u0627 \u06C1\u06D2\u06D4"
