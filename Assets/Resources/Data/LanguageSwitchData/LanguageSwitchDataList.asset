      tw: "\u6241\u5E73\u8EAB\u8EC0\u5145\u6EFF\u6D3B\u529B\uFF0C\u9BAE\u7F8E\u5982\u6D77\u98A8\u994B\u8D08"
      ja: "\u5E73\u305F\u3044\u4F53\u306B\u6D3B\u529B\u6E80\u3061\u3001\u6D77\u98A8\u304C\u904B\u3093\u3060\u65B0\u9BAE\u306A\u5473\u308F\u3044"
      ko: "\uB0A9\uC791\uD55C \uBAB8\uC5D0 \uD65C\uB825\uC774 \uB118\uCE58\uBA70
