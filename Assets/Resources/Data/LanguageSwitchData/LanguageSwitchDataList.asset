      el: "\u03A4\u03C1\u03C5\u03C6\u03B5\u03C1\u03CC \u03C8\u03AC\u03C1\u03B9 \u03BC\u03B5
        \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03CC \u03B4\u03AD\u03C1\u03BC\u03B1"
      ar: "\u0633\u0645\u0643 \u0642\u0627\u0631\u0648\u0635 \u0637\u0631\u064A \u0628\u0642\u0634\u0631\u0629
        \u0645\u0642\u0631\u0645\u0634\u0629"
      hi: "\u0928\u0930\u092E \u092E\u091B\u0932\u0940, \u0915\u0930\u093E\u0930\u093E
        \u092C\u093E\u0939\u0930\u0940 \u092A\u0930\u0924 \u0914\u0930 \u0928\u0930\u092E
