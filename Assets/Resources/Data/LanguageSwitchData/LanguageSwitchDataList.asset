      th: "\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E15\u0E38\u0E4B\u0E19\u0E19\u0E38\u0E48\u0E21\u0E14\u0E39\u0E14\u0E0B\u0E31\u0E1A\u0E19\u0E49\u0E33\u0E0B\u0E38\u0E1B"
