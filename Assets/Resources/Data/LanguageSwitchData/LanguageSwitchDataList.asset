        \u0924\u093E\u091C\u093C\u093E \u0938\u094D\u0935\u093E\u0926 \u0915\u0947
        \u0938\u093E\u0925 \u092D\u0941\u0928\u0940 \u0939\u0941\u0908"
      ur: "\u0686\u0645\u06A9\u062A\u06CC \u06C1\u0648\u0626\u06CC \u0645\u0686\u06BE\u0644\u06CC\u060C
        \u0645\u0636\u0628\u0648\u0637 \u0633\u0627\u062E\u062A\u060C \u0646\u0645\u06A9\u06CC\u0646
        \u0627\u0648\u0631 \u062A\u0627\u0632\u06C1 \u0630\u0627\u0626\u0642\u06D2
        \u06A9\u06D2 \u0633\u0627\u062A\u06BE \u0628\u06BE\u0646\u06CC \u06C1\u0648\u0626\u06CC\u06D4"
      ms: Ikan berkilat dengan tekstur padat, panggang dengan rasa masin dan segar.
      id: Ikan berkilau, tekstur padat, dipanggang dengan rasa asin-segar yang unik.
    - cn: "\u8089\u8D28\u7EC6\u817B\uFF0C\u5916\u76AE\u9999\u8106\uFF0C\u5185\u90E8\u8F6F\u5AE9\uFF0C\u4FDD\u7559\u9CB7\u9C7C\u7684\u4F18\u96C5\u98CE\u5473\u3002"
