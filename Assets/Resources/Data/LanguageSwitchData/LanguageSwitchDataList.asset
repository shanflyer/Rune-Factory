      cs: "Sladk\xE1 a sv\u011B\u017E\xED, pln\xE1 sladkosti"
      uk: "\u0421\u043E\u043B\u043E\u0434\u043A\u0438\u0439 \u0442\u0430 \u0441\u0432\u0456\u0436\u0438\u0439,
        \u0441\u043F\u043E\u0432\u043D\u0435\u043D\u0438\u0439 \u0441\u043E\u043B\u043E\u0434\u043E\u0449\u0456\u0432"
      ro: "Dulce \u0219i proasp\u0103t, plin de dulcea\u021B\u0103"
