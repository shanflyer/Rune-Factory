      th: "\u0E41\u0E2A\u0E49\u0E41\u0E2B\u0E48\u0E07\u0E04\u0E27\u0E32\u0E21\u0E15\u0E32\u0E22\u0E17\u0E35\u0E48\u0E43\u0E0A\u0E49\u0E17\u0E31\u0E01\u0E29\u0E30
