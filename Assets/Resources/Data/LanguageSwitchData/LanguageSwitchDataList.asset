      el: "\u039A\u03BF\u03B9\u03BD\u03CC \u03C0\u03BF\u03C5\u03BB\u03B5\u03C1\u03B9\u03BA\u03CC
        \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 [\u03B1\u03C5\u03B3\u03AC]"
