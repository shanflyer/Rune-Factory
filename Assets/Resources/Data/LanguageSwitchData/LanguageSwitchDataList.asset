        \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F \u092A\u0947\u092F"
      ur: "\u06AF\u06C1\u0631\u0627 \u062C\u0627\u0645\u0646\u06CC-\u0646\u06CC\u0644\u0627\u060C
        \u0645\u06CC\u0679\u06BE\u0627-\u06A9\u06BE\u0679\u0627\u060C \u0635\u062D\u062A
