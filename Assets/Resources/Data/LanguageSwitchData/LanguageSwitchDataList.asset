    - cn: "\u8BE5\u52A8\u7269\u6CA1\u6709\u5206\u914D\u7267\u573A\uFF0C\u79FB\u9664\u540E\u5C06\u6D88\u5931\uFF0C\u662F\u5426\u786E\u5B9A\u79FB\u9664\uFF1F"
      en: This animal is not assigned to a pasture. It will disappear if removed.
        Confirm?
      tw: "\u8A72\u52D5\u7269\u6C92\u6709\u5206\u914D\u7267\u5834\uFF0C\u79FB\u9664\u5F8C\u5C07\u6D88\u5931\uFF0C\u662F\u5426\u78BA\u5B9A\u79FB\u9664\uFF1F"
      ja: "\u3053\u306E\u52D5\u7269\u306F\u7267\u5834\u306B\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u307E\u305B\u3093\u3002\u524A\u9664\u3059\u308B\u3068\u6D88\u6EC5\u3057\u307E\u3059\u3002\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F"
      ko: "\uC774 \uB3D9\uBB3C\uC740 \uBAA9\uC7A5\uC5D0 \uBC30\uC815\uB418\uC9C0
        \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC81C\uAC70\uD558\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.
        \uACC4\uC18D\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
      fr: "Cet animal n'est pas assign\xE9 \xE0 un p\xE2turage. Il dispara\xEEtra
        si retir\xE9. Confirmer ?"
      de: "Dieses Tier ist keiner Weide zugewiesen. Es verschwindet bei Entfernung.
        Best\xE4tigen?"
      ru: "\u042D\u0442\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043D\u0435
        \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043E \u043A \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0443.
        \u041E\u043D\u043E \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442 \u043F\u0440\u0438
        \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0438. \u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C?"
      es: "Este animal no est\xE1 asignado a un pastizal. Desaparecer\xE1 si lo quitas.
        \xBFConfirmar?"
      pt: "Este animal n\xE3o est\xE1 designado a um pasto. Ele desaparecer\xE1 se
        removido. Confirmar?"
      it: "Questo animale non \xE8 assegnato a un pascolo. Scomparir\xE0 se rimosso.
        Confermi?"
      tr: "Bu hayvan bir meral\u0131\u011Fa atanmam\u0131\u015F. Kald\u0131r\u0131l\u0131rsa
        kaybolacak. Onayl\u0131yor musunuz?"
      vi: "Con v\u1EADt n\xE0y ch\u01B0a \u0111\u01B0\u1EE3c ph\xE2n b\u1ED5 \u0111\u1EBFn
        \u0111\u1ED3ng c\u1ECF. N\xF3 s\u1EBD bi\u1EBFn m\u1EA5t n\u1EBFu lo\u1EA1i
        b\u1ECF. X\xE1c nh\u1EADn?"
      th: "\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E15\u0E31\u0E27\u0E19\u0E35\u0E49\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E16\u0E39\u0E01\u0E21\u0E2D\u0E1A\u0E2B\u0E21\u0E32\u0E22\u0E43\u0E2B\u0E49\u0E17\u0E38\u0E48\u0E07\u0E2B\u0E0D\u0E49\u0E32
        \u0E2B\u0E32\u0E01\u0E19\u0E33\u0E2D\u0E2D\u0E01\u0E08\u0E30\u0E2B\u0E32\u0E22\u0E44\u0E1B
        \u0E22\u0E37\u0E19\u0E22\u0E31\u0E19\u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E21\u0E48?"
      pl: "To zwierz\u0119 nie jest przypisane do pastwiska. Zniknie po usuni\u0119ciu.
        Potwierdzi\u0107?"
      nl: Dit dier is niet toegewezen aan een weiland. Het verdwijnt bij verwijdering.
        Doorgaan?
      el: "\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u03B6\u03CE\u03BF \u03B4\u03B5\u03BD
        \u03AD\u03C7\u03B5\u03B9 \u03B1\u03BD\u03B1\u03C4\u03B5\u03B8\u03B5\u03AF
        \u03C3\u03B5 \u03B2\u03BF\u03C3\u03BA\u03CC\u03C4\u03BF\u03C0\u03BF. \u0398\u03B1
        \u03B5\u03BE\u03B1\u03C6\u03B1\u03BD\u03B9\u03C3\u03C4\u03B5\u03AF \u03B1\u03BD
        \u03B1\u03C6\u03B1\u03B9\u03C1\u03B5\u03B8\u03B5\u03AF. \u0395\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7;"
      ar: "\u0647\u0630\u0627 \u0627\u0644\u062D\u064A\u0648\u0627\u0646 \u063A\u064A\u0631
        \u0645\u064F\u062E\u0635\u0635 \u0644\u0645\u0631\u0639\u0649. \u0633\u064A\u062E\u062A\u0641\u064A
        \u0639\u0646\u062F \u0627\u0644\u0625\u0632\u0627\u0644\u0629. \u0647\u0644
        \u062A\u0631\u064A\u062F \u0627\u0644\u0645\u062A\u0627\u0628\u0639\u0629\u061F"
      hi: "\u092F\u0939 \u091C\u093E\u0928\u0935\u0930 \u0915\u093F\u0938\u0940 \u091A\u093E\u0930\u093E\u0917\u093E\u0939
        \u092E\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0939\u091F\u093E\u0928\u0947
        \u092A\u0930 \u092F\u0939 \u0917\u093E\u092F\u092C \u0939\u094B \u091C\u093E\u090F\u0917\u093E\u0964
        \u092A\u0941\u0937\u094D\u091F\u093F \u0915\u0930\u0947\u0902?"
      ur: "\u06CC\u06C1 \u062C\u0627\u0646\u0648\u0631 \u06A9\u0633\u06CC \u0686\u0631\u0627\u06AF\u0627\u06C1
        \u0645\u06CC\u06BA \u0645\u062E\u062A\u0635 \u0646\u06C1\u06CC\u06BA \u06C1\u06D2\u06D4
        \u06C1\u0679\u0627\u0646\u06D2 \u067E\u0631 \u063A\u0627\u0626\u0628 \u06C1\u0648
        \u062C\u0627\u0626\u06D2 \u06AF\u0627\u06D4 \u062A\u0635\u062F\u06CC\u0642
        \u06A9\u0631\u06CC\u06BA\u061F"
      ms: Haiwan ini tidak ditugaskan ke padang rumput. Ia akan hilang jika dikeluarkan.
        Sahkan?
      id: Hewan ini tidak ditugaskan ke padang rumput. Akan hilang jika dihapus.
        Konfirmasi?
      he: "\u05D4\u05D7\u05D9\u05D4 \u05DC\u05D0 \u05D4\u05D5\u05E7\u05E6\u05EA\u05D4
        \u05DC\u05D7\u05D5\u05D5\u05D4, \u05D4\u05E1\u05E8\u05D4 \u05EA\u05D2\u05E8\u05D5\u05DD
        \u05DC\u05D4\u05D9\u05E2\u05DC\u05DE\u05D5\u05EA, \u05D4\u05D0\u05DD \u05DC\u05D0\u05E9\u05E8
        \u05D4\u05E1\u05E8\u05D4?"
      sv: "Djuret \xE4r inte tilldelat till ranch, borttagning kommer att leda till
        f\xF6rlust, bekr\xE4fta borttagning?"
      cs: "Zv\xED\u0159e nen\xED p\u0159id\u011Bleno k ran\u010Di, odstran\u011Bn\xED
        povede ke ztr\xE1t\u011B, potvrdit odstran\u011Bn\xED?"
      uk: "\u0422\u0432\u0430\u0440\u0438\u043D\u0443 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E
        \u043D\u0430 \u0444\u0435\u0440\u043C\u0443, \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F
        \u043F\u0440\u0438\u0437\u0432\u0435\u0434\u0435 \u0434\u043E \u0432\u0442\u0440\u0430\u0442\u0438,
        \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F?"
      ro: "Animalul nu este alocat la ferm\u0103, eliminarea va duce la pierdere,
        confirma\u021Bi eliminarea?"
      no: "Dyret er ikke tildelt g\xE5rd, fjerning vil f\xF8re til tap, bekrefte
        fjerning?"
      hu: "Az \xE1llat nincs farmhoz rendelve, elt\u0171nik, biztosan elt\xE1vol\xEDtod?"
      sw: Mnyama hajawekwi shambani, itatoweka, una uhakika kuondoa?
      sr: "\u017Divotinja nije dodeljena farmi, nesta\u0107e ako je uklonite. Da
        li ste sigurni?"
      fi: "T\xE4m\xE4 el\xE4in ei ole m\xE4\xE4ritetty laitumelle. Se katoaa, jos
        poistetaan. Vahvista?"
      da: "Dette dyr er ikke tildelt en gr\xE6smark. Det vil forsvinde, hvis det
        fjernes. Bekr\xE6ft?"
