    - cn: "\u666E\u901A\u7684\u517D\u7C7B\uFF0C\u53EF\u4EE5\u4EA7\u51FA[\u9A6C\u5C3E]"
      en: 'Common beast, produces [Horse Tail]'
      tw: "\u666E\u901A\u7684\u7378\u985E\uFF0C\u53EF\u4EE5\u7522\u51FA[\u99AC\u5C3E]"
      ja: "\u4E00\u822C\u7684\u306A\u7363\u985E\u3001[\u99AC\u306E\u5C3E]\u3092\u7523\u51FA"
      ko: "\uC77C\uBC18\uC801\uC778 \uC9D0\uC2B9, [\uB9D0\uAF2C\uB9AC] \uC0DD\uC0B0"
      fr: "B\xEAte commune, produit [Queue de cheval]"
      de: "Gew\xF6hnliche Bestie, produziert [Pferdeschwanz]"
      ru: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0437\u0432\u0435\u0440\u044C,
        \u0434\u0430\u0451\u0442 [\u041A\u043E\u043D\u0441\u043A\u0438\u0439 \u0445\u0432\u043E\u0441\u0442]"
      es: "Bestia com\xFAn, produce [Cola de caballo]"
      pt: 'Fera comum, produz [Cauda de cavalo]'
      it: 'Bestia comune, produce [Coda di cavallo]'
      tr: "S\u0131radan canavar, [At kuyru\u011Fu] \xFCretir"
      vi: "Th\xFA th\u01B0\u1EDDng, s\u1EA3n xu\u1EA5t [\u0110u\xF4i ng\u1EF1a]"
      th: "\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B \u0E1C\u0E25\u0E34\u0E15
        [\u0E2B\u0E32\u0E07\u0E21\u0E49\u0E32]"
      pl: "Zwyk\u0142a bestia, wytwarza [Ko\u0144ski ogon]"
      nl: 'Gewoon beest, produceert [Paardenstaart]'
      el: "\u03A3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03B8\u03B7\u03C1\u03AF\u03BF,
        \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9 [\u039A\u03AD\u03C1\u03B1\u03C2
        \u03B8\u03B7\u03C1\u03AF\u03BF\u03C5]"
      ar: "\u0648\u062D\u0634 \u0639\u0627\u062F\u064A\u060C \u064A\u0646\u062A\u062C
        [\u0630\u064A\u0644 \u0627\u0644\u062D\u0635\u0627\u0646]"
      hi: "\u0938\u093E\u0927\u093E\u0930\u0923 \u091C\u093E\u0928\u0935\u0930, [\u0918\u094B\u0921\u093C\u0947
        \u0915\u0940 \u092A\u0942\u0901\u091B] \u0909\u0924\u094D\u092A\u0928\u094D\u0928
        \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0639\u0627\u0645 \u062C\u0627\u0646\u0648\u0631\u060C [\u06AF\u06BE\u0648\u0691\u06D2
        \u06A9\u06CC \u062F\u0645] \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062A\u0627
        \u06C1\u06D2"
      ms: 'Binatang biasa, hasilkan [Ekor kuda]'
      id: 'Hewan biasa, menghasilkan [Ekor kuda]'
    - cn: "\u666E\u901A\u7684\u517D\u7C7B\uFF0C\u53EF\u4EE5\u4EA7\u51FA[\u517D\u89D2]"
      en: 'Common beast, produces [Beast Horn]'
      tw: "\u666E\u901A\u7684\u7378\u985E\uFF0C\u53EF\u4EE5\u7522\u51FA[\u7378\u89D2]"
      ja: "\u4E00\u822C\u7684\u306A\u7363\u985E\u3001[\u7363\u306E\u89D2]\u3092\u7523\u51FA"
      ko: "\uC77C\uBC18\uC801\uC778 \uC9D0\uC2B9, [\uC9D0\uC2B9 \uBFD4] \uC0DD\uC0B0"
      fr: "B\xEAte commune, produit [Corne de b\xEAte]"
