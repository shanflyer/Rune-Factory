      vi: "V\u0169 kh\xED v\u1EE1 \u0111\u01B0\u1EE3c r\xE8n l\u1EA1i"
      th: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E41\u0E15\u0E01\u0E19\u0E33\u0E21\u0E32\u0E40\u0E1C\u0E32\u0E43\u0E2B\u0E21\u0E48"
      pl: "Z\u0142om do Przetopienia"
      nl: Gebroken Wapens Hergebruikt
      el: "\u03A3\u03C0\u03B1\u03C3\u03BC\u03AD\u03BD\u03B1 \u03CC\u03C0\u03BB\u03B1
        \u03C0\u03BF\u03C5 \u03BE\u03B1\u03BD\u03B1\u03C7\u03CD\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9"
      ar: "\u0623\u0633\u0644\u062D\u0629 \u0645\u0643\u0633\u0648\u0631\u0629 \u064A\u0639\u0627\u062F
        \u0635\u0647\u0631\u0647\u0627"
      hi: "\u091F\u0942\u091F\u0940 \u0939\u0941\u0908 \u0924\u0932\u0935\u093E\u0930\u0947\u0902,
