      ur: "\u0679\u0648\u0679\u06CC \u06C1\u0648\u0626\u06CC \u062A\u0644\u0648\u0627\u0631\u06CC\u06BA\u060C
        \u062F\u0648\u0628\u0627\u0631\u06C1 \u0628\u0646\u0627\u0626\u06CC \u062C\u0627
