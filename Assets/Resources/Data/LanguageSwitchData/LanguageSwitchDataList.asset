      id: Pedang rusak bisa ditempa kembali menjadi senjata
    - cn: "\u4E00\u4E2A\u6765\u81EA\u53E4\u8001\u9A91\u58EB\u5BB6\u65CF\u7684\u5FBD\u7AE0"
