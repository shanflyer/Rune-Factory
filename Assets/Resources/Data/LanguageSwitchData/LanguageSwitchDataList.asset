      th: "\u0E1C\u0E07\u0E27\u0E34\u0E40\u0E28\u0E29\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E40\u0E2A\u0E19\u0E48\u0E2B\u0E4C\u0E43\u0E2B\u0E49\u0E01\u0E32\u0E23\u0E2B\u0E21\u0E31\u0E01"
