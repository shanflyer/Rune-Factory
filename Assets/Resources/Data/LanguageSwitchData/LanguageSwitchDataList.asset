      de: "Bunte vitaminreiche Gem\xFCsemischung"
      ru: "\u041A\u0440\u0430\u0441\u043E\u0447\u043D\u044B\u0435 \u043E\u0432\u043E\u0449\u0438
        \u0441 \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u0430\u043C\u0438"
      es: Mezcla de vegetales nutritivos
      pt: Mistura de vegetais nutritivos
      it: Mix di verdure nutrienti
      tr: Renkli sebzelerle dolu besleyici yemek
      vi: "M\xF3n rau c\u1EE7 \u0111\u1EA7y m\xE0u s\u1EAFc, t\u01B0\u01A1i ngon"
      th: "\u0E1C\u0E31\u0E01\u0E2B\u0E25\u0E32\u0E01\u0E2A\u0E35\u0E04\u0E38\u0E13\u0E04\u0E48\u0E32\u0E2A\u0E39\u0E07"
      pl: "Kolorowe warzywa pe\u0142ne sk\u0142adnik\xF3w"
      nl: Kleurrijke groenteschotel
      el: "\u03A7\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03C3\u03C4\u03AC \u03BB\u03B1\u03C7\u03B1\u03BD\u03B9\u03BA\u03AC
        \u03BC\u03B5 \u03B8\u03C1\u03B5\u03C0\u03C4\u03B9\u03BA\u03AC"
      ar: "\u062E\u0644\u064A\u0637 \u062E\u0636\u0631\u0648\u0627\u062A \u0645\u0644\u0648\u0646
        \u0648\u063A\u0646\u064A"
      hi: "\u0930\u0902\u0917\u0940\u0928 \u0938\u092C\u094D\u091C\u093C\u093F\u092F\u093E\u0902,
        \u0924\u093E\u091C\u093C\u093E, \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F,
        \u0914\u0930 \u092A\u094C\u0937\u094D\u091F\u093F\u0915"
      ur: "\u0631\u0646\u06AF \u0628\u0631\u0646\u06AF\u06D2 \u0633\u0628\u0632\u06CC\u0627\u06BA\u060C
        \u062A\u0627\u0632\u06C1\u060C \u0644\u0630\u06CC\u0630\u060C \u0627\u0648\u0631
