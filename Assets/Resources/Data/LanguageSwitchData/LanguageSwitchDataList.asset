      ja: "\u5C0F\u9B5A\u306E\u5869\u713C\u304D\u306F\u9999\u3070\u3057\u304F\u565B\u3080\u307B\u3069\u306B\u65E8\u5473\u304C\u5E83\u304C\u308B"
      ko: "\uC791\uC740 \uC0DD\uC120\uC758 \uC18C\uAE08\uAD6C\uC774\uB294 \uC539\uC744\uC218\uB85D
