      th: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E17\u0E23\u0E07\u0E1E\u0E25\u0E31\u0E07\u0E17\u0E35\u0E48\u0E43\u0E0A\u0E49\u0E17\u0E31\u0E01\u0E29\u0E30
