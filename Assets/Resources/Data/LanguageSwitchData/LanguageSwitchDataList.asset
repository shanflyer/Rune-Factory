      tw: "\u5728\u8FD1\u5CB8\u7901\u77F3\u5340\u5DE1\u6E38\uFF0C\u5916\u578B\u786C\u6717\uFF0C\u6E38\u59FF\u6C89\u7A69\uFF0C\u6ECB\u5473\u9BAE\u7F8E"
      ja: "\u6CBF\u5CB8\u306E\u5CA9\u7901\u57DF\u3092\u529B\u5F37\u304F\u6CF3\u3050\u3001\u304C\u3063\u3057\u308A\u3068\u3057\u305F\u8EAB\u306E\u7DE0\u307E\u3063\u305F\u9B5A"
      ko: "\uC5F0\uC548 \uC554\uCD08 \uC9C0\uC5ED\uC744 \uB2E8\uB2E8\uD55C \uBAB8\uC73C\uB85C
