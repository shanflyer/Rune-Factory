        \u0441\u043E\u043B\u043E\u0434\u043A\u0438\u0439 \u0430\u0440\u043E\u043C\u0430\u0442"
      ro: "Auriu \u0219i plin, arom\u0103 dulce"
      no: "Gylden og rund, s\xF8t lukt"
      hu: Grillezett kukorica
      sw: Mahindi ya kukaanga
      sr: "Pr\u017Eeni kukuruz"
      fi: Gyldenbrun og fyldig
      da: "Kullanruskea ja t\xE4ytel\xE4inen"
    - cn: "\u878D\u5408\u591A\u79CD\u852C\u83DC\u8425\u517B\uFF0C\u8272\u6CFD\u9C9C\u8273\uFF0C\u6E05\u723D\u53EF\u53E3\u3002"
