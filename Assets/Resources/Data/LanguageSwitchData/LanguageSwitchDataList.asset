      ko: "\uC778\uD654\uC131 \uAD11\uBB3C"
      fr: "Min\xE9ral inflammable"
      de: "Entz\xFCndliches Mineral"
      ru: "\u0413\u043E\u0440\u044E\u0447\u0438\u0439 \u043C\u0438\u043D\u0435\u0440\u0430\u043B"
      es: Mineral Inflamable
