      nl: 'Krachtig en Hardnekkig, Activeert [Sneeuwstorm]'
      el: "\u0399\u03C3\u03C7\u03C5\u03C1\u03CC \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B1\u03BB\u03C5\u03C4\u03B9\u03BA\u03CC,
        \u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF [\u03A7\u03B9\u03BF\u03BD\u03BF\u03B8\u03CD\u03B5\u03BB\u03BB\u03B1]"
      ar: "\u0647\u062C\u0648\u0645 \u0642\u0648\u064A \u0648\u064A\u0641\u0639\u0651\u0644
        \u0645\u0647\u0627\u0631\u0629 [\u0639\u0627\u0635\u0641\u0629 \u062B\u0644\u062C\u064A\u0629]"
      hi: "[\u0939\u093F\u092E\u092A\u093E\u0924] \u0915\u094C\u0936\u0932 \u0938\u0915\u094D\u0930\u093F\u092F
        \u0915\u0930\u0928\u0947 \u0935\u093E\u0932\u093E \u0936\u0915\u094D\u0924\u093F\u0936\u093E\u0932\u0940
        \u092A\u094D\u0930\u0939\u093E\u0930"
      ur: "[\u0628\u0631\u0641\u0627\u0646\u06CC \u0637\u0648\u0641\u0627\u0646]
        \u0645\u06C1\u0627\u0631\u062A \u06A9\u0648 \u0686\u0627\u0644\u0648 \u06A9\u0631\u0646\u06D2
        \u0648\u0627\u0644\u0627 \u0637\u0627\u0642\u062A\u0648\u0631 \u062D\u0645\u0644\u06C1"
      ms: 'Pukulan berkuasa yang boleh mengaktifkan skill [Blizzard]'
      id: 'Pukulan kuat yang bisa mengaktifkan skill [Blizzard]'
    - cn: "\u4F7F\u7528\u79D8\u94F6\u5236\u4F5C\u7684\u5B9D\u5251,\u53EF\u4EE5\u53D1\u52A8[\u5947\u8FF9\u65A9]\u6280\u80FD"
      en: Mithril sword, can activate [Miracle Slash] skill
      tw: "\u4F7F\u7528\u79D8\u9280\u88FD\u4F5C\u7684\u5BF6\u528D\uFF0C\u53EF\u4EE5\u767C\u52D5[\u5947\u8E5F\u65AC]\u6280\u80FD"
      ja: "\u30DF\u30B9\u30EA\u30EB\u88FD\u306E\u5263\u3001[\u30DF\u30E9\u30AF\u30EB\u30B9\u30E9\u30C3\u30B7\u30E5]\u30B9\u30AD\u30EB\u3092\u767A\u52D5\u53EF\u80FD"
      ko: "\uBBF8\uC2A4\uB9B4\uB85C \uB9CC\uB4E0 \uAC80, [\uAE30\uC801\uC758 \uBCA0\uAE30]
