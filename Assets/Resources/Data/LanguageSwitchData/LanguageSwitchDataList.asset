      el: "\u03A3\u03BA\u03BB\u03B7\u03C1\u03AD\u03C2 \u03BB\u03AD\u03C0\u03B9\u03B5\u03C2
        \u03B5\u03C1\u03C0\u03B5\u03C4\u03CE\u03BD"
