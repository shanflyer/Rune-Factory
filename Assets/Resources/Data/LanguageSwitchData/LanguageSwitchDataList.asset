      el: "\u0393\u03BB\u03C5\u03BA\u03CC \u03C0\u03BF\u03C4\u03CC \u03BC\u03B5 \u03B3\u03AE\u03B9\u03BD\u03B7
        \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u062D\u0644\u0648 \u0645\u0639 \u0637\u0639\u0645
        \u062A\u0631\u0627\u0628\u064A"
      hi: "\u092E\u093F\u0920\u093E\u0938 \u092E\u0947\u0902 \u092E\u093F\u091F\u094D\u091F\u0940
