      no: "Spr\xF8 utenp\xE5, saftig inni, kj\xF8ttig lukt"
      hu: "Grillezett h\xFAspog\xE1csa"
      sw: Keki ya nyama ya kukaanga
      sr: Pljeskavica
      fi: "Stegt spr\xF8dt"
      da: Paistettu rapeaksi
    - cn: "\u5C42\u5C42\u53E0\u53E0\uFF0C\u5927\u53E3\u54AC\u4E0B\uFF0C\u591A\u79CD\u53E3\u611F\u5728\u820C\u5C16\u78B0\u649E\u3002"
