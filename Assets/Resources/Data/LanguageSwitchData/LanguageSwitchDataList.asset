      nl: Gebalanceerde vissoep
      el: "\u0399\u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03B7\u03BC\u03AD\u03BD\u03B7
        \u03C3\u03BF\u03CD\u03C0\u03B1 \u03BC\u03B5 \u03C8\u03AC\u03C1\u03B9"
