      th: "\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B\u0E43\u0E2B\u0E49
        [\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E2B\u0E21\u0E39]"
