      hi: "\u092E\u091F\u0930 \u0915\u0940 \u0924\u093E\u091C\u093C\u0940 \u0916\u0941\u0936\u092C\u0942
        \u0914\u0930 \u092E\u0932\u093E\u0908\u0926\u093E\u0930 \u092C\u0928\u093E\u0935\u091F,
        \u092A\u094C\u0937\u094D\u091F\u093F\u0915, \u0917\u0930\u094D\u092E\u091C\u094B\u0936\u0940
        \u0914\u0930 \u092D\u0930\u092A\u0942\u0930"
      ur: "\u0645\u0679\u0631 \u06A9\u06CC \u062A\u0627\u0632\u06C1 \u062E\u0648\u0634\u0628\u0648
