        \u0441\u043E\u043B\u043E\u043D\u043E-\u0441\u0432\u0456\u0436\u0438\u0439
        \u0441\u043C\u0430\u043A"
      ro: "Pe\u0219te str\u0103lucitor, arom\u0103 s\u0103rat\u0103-proasp\u0103t\u0103"
