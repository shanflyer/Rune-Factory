        \u092C\u0928\u093E\u0935\u091F \u0936\u094B\u0930\u092C\u0947 \u0915\u0940
        \u0938\u092E\u0943\u0926\u094D\u0927\u093F \u0915\u094B \u0938\u094B\u0916
        \u0932\u0947\u0924\u0940 \u0939\u0948"
      ur: "\u0688\u06BE\u0644\u06A9\u0627\u0646\u06D2 \u0633\u06D2 \u0646\u0631\u0645
