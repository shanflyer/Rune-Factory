      tw: "\u7DCA\u8CBC\u6D77\u5E95\u7DE9\u7DE9\u79FB\u52D5\uFF0C\u9BAE\u5AE9\u8089\u8CEA\u5982\u6D77\u6D0B\u994B\u8D08"
      ja: "\u6D77\u5E95\u3092\u3086\u3063\u304F\u308A\u9019\u3044\u3001\u67D4\u3089\u304B\u304F\u30B8\u30E5\u30FC\u30B7\u30FC\u306A\u30A8\u30D3"
      ko: "\uBC14\uB2E5\uC5D0 \uBD99\uC5B4 \uCC9C\uCC9C\uD788 \uC6C0\uC9C1\uC774\uBA70
