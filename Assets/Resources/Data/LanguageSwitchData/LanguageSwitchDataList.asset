      pt: Bebida doce e terrosa
      it: Bevanda dolce e terrosa
      tr: "Topraks\u0131 tatl\u0131 besleyici i\xE7ecek"
      vi: "Th\u1EE9c u\u1ED1ng ng\u1ECDt c\xF3 m\xF9i \u0111\u1EA5t \u0111\u1ED9c
        \u0111\xE1o"
      th: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E14\u0E37\u0E48\u0E21\u0E23\u0E2A\u0E2B\u0E27\u0E32\u0E19\u0E21\u0E35\u0E01\u0E25\u0E34\u0E48\u0E19\u0E14\u0E34\u0E19"
