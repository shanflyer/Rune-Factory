      el: "\u03A3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03B8\u03B7\u03C1\u03AF\u03BF,
        \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9 [\u0394\u03AD\u03C1\u03BC\u03B1
        \u03B8\u03B7\u03C1\u03AF\u03BF\u03C5]"
      ar: "\u0648\u062D\u0634 \u0639\u0627\u062F\u064A\u060C \u064A\u0646\u062A\u062C
        [\u0643\u0631\u064A\u0633\u062A\u0627\u0644 \u0627\u0644\u0646\u0627\u0631]"
      hi: "\u0938\u093E\u0927\u093E\u0930\u0923 \u091C\u093E\u0928\u0935\u0930, [\u0906\u0917
        \u0915\u093E \u0915\u094D\u0930\u093F\u0938\u094D\u091F\u0932] \u0909\u0924\u094D\u092A\u0928\u094D\u0928
        \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0639\u0627\u0645 \u062C\u0627\u0646\u0648\u0631\u060C [\u0622\u06AF
        \u06A9\u0627 \u06A9\u0631\u0633\u0679\u0644] \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062A\u0627
