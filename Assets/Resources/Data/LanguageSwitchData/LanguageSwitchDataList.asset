    - "\u7761\u77206\u5C0F\u65F6"
    - "\u7761\u5230\u65E9\u4E0A7\u70B9"
    - "\u7761\u5230\u665A\u4E0A7\u70B9"
    - "\u6211\u6765\u4E70\u4E1C\u897F\uFF01"
    - "\u4F60\u597D,\u4F60\u7684\u623F\u5B50\u597D\u5927\u5440\uFF01"
    - "\u6211\u6765\u901B\u901B\u4F60\u7684\u5546\u5E97,\\n\u4ECA\u5929\u6709\u4EC0\u4E48\u597D\u4E1C\u897F\u5440\uFF1F"
    - "\u4F60\u597D\uFF01\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F"
    - "\u55EF..\u4F60,\u8981\u5E72\u561B\uFF1F"
    - "\u563F,\u4F60\u4ECA\u5929\u662F\u6765\u7EA6\u6211\u4E00\u8D77\u53BB\u5192\u9669\u5417\uFF1F"
    - "\u5662,\u4F60\u53C8\u53D1\u73B0\u4EC0\u4E48\u4E86\u5417\uFF1F"
    - "\u98CE\u5E26\u6765\u4E86\u4F60\u7684\u8BAF\u606F.."
    - "\u51C6\u5907\u597D\u63A5\u53D7\u4F60\u7684\u547D\u8FD0\u4E86\u5417\uFF1F"
    - "\u4F60\u77E5\u9053\u5417\uFF1F\u5F53\u5E74\u6211\u4E00\u4E2A\u4EBA\u5728\u6218\u573A\u4E0A\u2026"
    - "\u6B22\u8FCE\u5149\u4E34\u3002"
    - "\u55E8,\u4ECA\u5929\u5929\u6C14\u4E0D\u9519,\u9002\u5408\u6311\u9009\u5BB6\u5177\u54E6\u3002"
    - "\u5BF9\u52A8\u7269\u4E00\u5B9A\u8981\u6E29\u67D4\u554A\u3002"
    - "\u5BA2\u4EBA,\u4F60\u60F3\u8981\u70B9\u4EC0\u4E48\uFF1F"
    - "\u60F3\u548C\u6211\u6765\u4E00\u6B21\u547D\u8FD0\u7684\u9082\u9005\u2026"
    - "\u55EF,\u4ECA\u5929\u4E00\u5B9A\u4E0D\u8981\u518D\u72AF\u9519\u3002"
    - "\u826F\u597D\u7684\u5DE5\u5177\u53EF\u4EE5\u4F7F\u5DE5\u4F5C\u66F4\u6709\u6548\u7387\u3002"
    - "\u4F60\u662F\u6765\u53C2\u89C2\u6211\u7684\u5546\u5E97\u7684\u5417\uFF1F\u8BF7\u5C3D\u60C5\u53C2\u89C2\u5427\u3002"
    - "\u5E74\u8F7B\u771F\u597D\u554A,\u5982\u679C\u53EF\u4EE5,\u6211\u60F3\u2026"
    - "\u5C0F\u5BB6\u4F19\u4EEC,\u6765\u6311\u70B9\u4E1C\u897F\u5427\uFF1F"
    - "\u592A\u597D\u4E86,\u7EC8\u4E8E\u6709\u4EBA\u6765\u966A\u6211\u4E86\u3002"
    - "\u804C\u8D23\u3001\u8363\u8000...\u62B1\u6B49,\u6CA1\u770B\u5230\u4F60\u3002"
    - "\u60F3\u8981\u6599\u7406\u7684\u8BDD,\u53EF\u4EE5\u548C\u9EDB\u8299\u59AE\u8BF4\u3002"
    - "\u554A\uFF01\u4F60\u662F\u5728\u5F00\u73A9\u7B11\u5427,\u4E0D\u8FC7\u8FD9\u4E2A\u4E0D\u597D\u7B11\u54E6\u3002"
    - "\u4F60,\u4F60\u600E\u4E48\u80FD\u8FD9\u4E48\u8F7B\u6613,\u8BF4\u51FA,\u8FD9\u79CD\u8BDD\u2026"
    - "\u5982\u679C\u4F60\u662F\u4E00\u4E2A\u5927\u82F1\u96C4\u5C31\u597D\u4E86\u2026"
    - "\u62B1\u6B49,\u6211\u53EA\u5BF9\u8003\u53E4\u611F\u5174\u8DA3\u2026"
    - "\u5C31\u8BA9\u8FD9\u4EFD\u60C5\u7EEA\u968F\u98CE\u800C\u901D\u5427\u2026"
    - "\u5C0F\u5BB6\u4F19,\u4F60\u80FD\u9A7E\u9A6D\u6211\u5417?"
    - "\u6211\u7684\u6FC0\u60C5\u5DF2\u7ECF\u7559\u5728\u6218\u573A\u4E0A\u4E86\u3002"
    - "\u597D\u9AD8\u5174\u54E6,\u4E0D\u8FC7\u6211\u8FD8\u5F97\u52AA\u529B\u957F\u5927\u624D\u884C\u5462\u3002"
    - "\u8C22\u8C22,\u5982\u679C\u53EF\u4EE5\u8BF7\u5728\u5E97\u91CC\u4E70\u70B9\u4E1C\u897F\u5427\u3002"
    - "\u62B1\u6B49,\u4EBA\u7C7B\u7684\u5FC3\u662F\u4F1A\u8BF4\u8C0E\u7684\u3002"
    - "\u771F\u7684\u5417,\u8C22\u8C22\u4F60\u7ED9\u6211\u6253\u6C14\u3002"
    - "\u6211\u5BF9\u957F\u671F\u7684\u611F\u60C5\u6CA1\u6709\u5174\u8DA3\u3002"
    - "\u4F60\u8BF4\u7684\u662F\u4EC0\u4E48\u610F\u601D,\u6211\u542C\u4E0D\u61C2\u54CE\u2026"
    - "\u6211\u5DF2\u7ECF\u5BF9\u5927\u54E5\u53D1\u8FC7\u8A93\u4E86,\u65E0\u6CD5\u63A5\u53D7\u4F60\u7684\u5FC3\u610F\u3002"
    - "\u554A,\u4F60\u96BE\u9053\u770B\u4E0A\u6211\u7684\u8EAB\u5BB6\u4E86\u5417\uFF1F"
    - "\u54CE\u5440,\u6211\u8FD9\u53EF\u8870\u8001\u7684\u5FC3\u53EF\u7ECF\u4E0D\u8D77\u4F60\u7684\u6311\u62E8\u2026"
    - "\u5982\u679C\u6211\u8FD8\u5E74\u8F7B\u7684\u8BDD\u2026"
    - "\u5BF9\u4E0D\u8D77,\u4EBA\u9C7C\u548C\u4EBA\u7C7B\u662F\u4E0D\u4F1A\u6709\u7ED3\u679C\u7684\u2026"
    - "\u6211\u8FD8\u662F\u60F3\u4EE5\u6211\u7684\u4E8B\u4E1A\u4E3A\u91CD\u2026"
    - "\u867D\u7136\u6211\u662F\u60F3\u7ED9\u9EDB\u8299\u59AE\u5979\u4EEC\u627E\u4E2A\u7236\u4EB2,\u4F46\u4F60\u5C31\u2026"
    - "\u62B1\u6B49,\u4ECE\u4E0A\u6B21\u53D7\u4F24\u540E,\u6211\u8FD8\u5728\u4FEE\u517B\u4E2D,\u8FC7\u6BB5\u65F6\u95F4\u518D\u6765\u627E\u6211\u5427\u3002"
    - "\u6211\u8FD8\u662F\u60F3\u548C\u66F4\u719F\u6089\u7684\u4EBA\u4E00\u8D77\u5192\u9669..."
    - "OK,\u90A3\u4E48\u6211\u4EEC\u5C31\u4E00\u8D77\u53BB\u5192\u9669\u5427."
    - "\u55EF,\u4F60\u8FD9\u4E48\u8BF7\u6C42\u7684\u8BDD,\u6211\u53EA\u597D\u7B54\u5E94\u4E86."
    - "\u6211\u65E9\u5C31\u7B49\u7740\u8FD9\u4E00\u5929\u4E86."
    - "\u5E0C\u671B\u8FD9\u6B21\u4F1A\u53D1\u73B0\u4E00\u4E9B\u53E4\u4EE3\u9057\u8FF9\u7EBF\u7D22."
    - "\u597D\u5566,\u597D\u5566,\u6E05\u98CE\u544A\u8BC9\u6211\u5E94\u8BE5\u548C\u4F60\u4E00\u8D77\u51FA\u52A8\u2026"
    - "\u4F60\u53EF\u8981\u673A\u7075\u70B9\u5440,\u6211\u53EF\u4E0D\u60F3\u8BA9\u4F60\u62D6\u540E\u817F\u3002"
    - "\u90A3\u4E48\u5C31\u8BA9\u4F60\u89C1\u8BC6\u4E00\u4E0B\u6211\u82F1\u52C7\u7684\u8EAB\u59FF\u5427\u3002"
    - "\u90A3\u4E48,\u8BF7\u591A\u6307\u6559\u4E86\u3002"
    - "\u597D\u5427,\u5E0C\u671B\u4F1A\u6709\u4E00\u4E2A\u7F8E\u597D\u7684\u65C5\u7A0B\u3002"
    - "\u8981\u7D27\u7D27\u8DDF\u7740\u59D0\u59D0\u540E\u9762,\u59D0\u59D0\u4F1A\u4FDD\u62A4\u4F60\u7684\u3002"
    - "\u55EF,\u5F88\u4E45\u6CA1\u6709\u51FA\u53BB\u4E86,\u51FA\u53BB\u8D70\u8D70\u4E5F\u4E0D\u9519\u3002"
    - "\u65E2\u7136\u4F60\u8FD9\u4E48\u6709\u8BDA\u610F,\u5C31\u7B54\u5E94\u4F60\u5427\u3002"
    - "\u6B63\u597D\u6211\u4E5F\u60F3\u7EC3\u4E60\u4E00\u4E0B\u6211\u7684\u6280\u80FD\u3002"
    - "\u4E5F\u5E94\u8BE5\u6D3B\u52A8\u6D3B\u52A8\u624B\u811A\u4E86\u3002"
    - "\u4F60\u7EC8\u4E8E\u8BA4\u8BC6\u5230\u6211\u7684\u5389\u5BB3\u4E86\u554A\u3002"
    - "\u5982\u679C\u4F60\u4E0D\u5ACC\u5F03\u6211\u8FD9\u628A\u8001\u9AA8\u5934\u7684\u8BDD\u2026"
    - "\u5076\u5C14\u4E5F\u8BE5\u8BA9\u5E03\u83B1\u5179\u72EC\u81EA\u770B\u5E97\u4E86\u3002"
    - "\u5176\u5B9E\u6211\u65E9\u5C31\u60F3\u51FA\u53BB\u770B\u770B\u4E86\u3002"
    - "\u653E\u5FC3\u5427,\u6218\u58EB\u7684\u804C\u8D23\u5C31\u662F\u4FDD\u62A4\u5E73\u6C11\u3002"
    - "\u6211\u4E5F\u8BE5\u51FA\u53BB\u5BFB\u627E\u4E00\u4E0B\u65B0\u98DF\u6750\u4E86\u3002"
    - "\u5662..\u4F60\u60F3\u804A\u4EC0\u4E48..\u771F\u65E0\u804A\u554A"
    - "\u6211\u77E5\u9053\u4E86,\u4F60\u4E00\u5B9A\u662F\u6765\u5077\u770B\u6211\u59D0\u59D0\u7684\u3002"
    - "\u4F60\u6709\u7559\u610F\u65C5\u9014\u4E2D\u672A\u77E5\u7684\u9057\u8FF9\u5417\uFF1F\u4E0D\u77E5\u9053\u90A3\u4E9B\u5230\u5E95\u4EE3\u8868\u7740\u4EC0\u4E48\uFF1F"
    - "\u554A,\u98CE\u4E2D\u4F20\u6765\u4F60\u7684\u6C14\u606F,\u8BA9\u6211\u5C06\u601D\u5FF5\u5BC4\u6258\u4E8E\u4F60\u2026"
    - "\u73B0\u5728\u7684\u4EBA\u7C7B\u771F\u662F\u592A\u7FB8\u5F31\u4E86,\u5982\u679C\u662F\u53E4\u4EE3\u90A3\u4E9B\u5F3A\u608D\u7684\u6218\u58EB,\u5468\u56F4\u5C31\u4E0D\u4F1A\u6709\u602A\u7269\u5B58\u5728\u4E86\u3002"
    - "\u5728\u90A3\u573A\u6218\u4E89\u4E2D,\u672C\u6765\u738B\u56FD\u519B\u5904\u4E8E\u52A3\u52BF,\u4F46\u662F\u51ED\u7740\u6211\u7684\u6D3B\u8DC3\u8868\u73B0,\u624D\u9006\u8F6C\u83B7\u5F97\u80DC\u5229\u3002"
    - "\u4F60\u559C\u6B22\u5403\u4EC0\u4E48\u6599\u7406\u5462\uFF1F\u5965\u8482\u8389\u4E9A\u559C\u6B22\u70E4\u6D77\u9C9C\u5662\u3002"
    - "\u771F\u9AD8\u5174\u4F60\u80FD\u6765\u627E\u6211\u73A9,\u660E\u5929\u4F60\u8FD8\u4F1A\u6765\u5417\uFF1F"
    - "\u52A8\u7269\u662F\u6211\u4EEC\u7684\u597D\u4F19\u4F34,\u4E0D\u4EC5\u6709\u4F18\u826F\u7684\u4EA7\u51FA\u8FD8\u80FD\u8DDF\u968F\u6211\u4EEC\u6218\u6597\u5462\u3002"
    - "\u771F\u7684\u5F88\u611F\u8C22\u5BA2\u4EBA\u5BF9\u672C\u5E97\u7684\u5149\u987E,\u80FD\u5E2E\u4E0A\u5988\u5988\u6211\u4E5F\u5F88\u9AD8\u5174\u3002"
    - "\u5728\u8FD9\u4E2A\u5B81\u9759\u7684\u5C0F\u9547,\u6211\u627E\u5230\u4E86\u4E45\u8FDD\u7684\u5B89\u5FC3,\u6211\u60F3\u6211\u8FD8\u4F1A\u518D\u4F4F\u4E00\u9635\u5B50\u5427\u3002"
    - "\u7A76\u7ADF\u600E\u6837\u624D\u80FD\u548C\u662F\u5426\u4E00\u6837\u4F18\u79C0\u5462\uFF1F\u8FD9\u771F\u8BA9\u6211\u56F0\u6270\u3002"
    - "\u6211\u4E00\u5B9A\u8981\u628A\u5E03\u62C9\u5FB7\u5229\u57F9\u517B\u6210\u4E00\u4E2A\u4F18\u79C0\u7684\u7537\u4EBA,\u8FD9\u5C31\u662F\u6211\u751F\u6D3B\u7684\u610F\u4E49\u3002"
    - "\u6211\u66FE\u7ECF\u8D70\u8FC7\u5927\u5C71\u548C\u5927\u6D77,\u8FFD\u5BFB\u8D22\u5BCC\u7684\u811A\u6B65\u6C38\u4E0D\u505C\u606F,\u4F60\u80FD\u7406\u89E3\u5417\uFF1F"
    - "\u5509,\u8FC7\u53BB\u8FD9\u4E48\u591A\u5E74\u6765,\u739B\u5FB7\u7433\u8FD8\u4E0D\u80AF\u539F\u8C05\u6211\u5417\u2026"
    - "\u53EF\u7231\u7684\u5C0F\u5BB6\u4F19\u4EEC,\u4ECA\u5929\u53C8\u6765\u95EE\u5019\u6211\u554A,\u771F\u7684\u8C22\u8C22\u4F60\u4EEC\u4E86\u3002"
    - "\u89C1\u5230\u4F60,\u591A\u8389\u4E1D\u771F\u9AD8\u5174,\u771F\u50CF\u80FD\u548C\u4F60\u4E00\u6837\u5230\u5904\u53BB\u73A9\u3002"
    - "\u6211\u4E00\u5B9A\u8981\u6210\u4E3A\u5C06\u519B\u90A3\u6837\u5F3A\u5927\u7684\u519B\u4EBA,\u4E3A\u6B64\u6211\u5F97\u575A\u6301\u953B\u70BC\u3002"
    - "\u5236\u4F5C\u6599\u7406\u4E00\u5B9A\u8981\u6709\u60F3\u8C61\u529B,\u53EA\u6709\u8FD9\u6837\u624D\u80FD\u5C06\u7F8E\u5473\u878D\u5165\u5176\u4E2D\u3002"
    - "\u50CF\u6211\u8FD9\u6837\u7684\u5929\u624D\u679C\u7136\u4E0D\u5E94\u8BE5\u56F0\u5728\u8FD9\u79CD\u5C0F\u5E97\u91CC\u5427\u3002"
    - "\u6211\u5176\u5B9E\u4E00\u76F4\u5728\u953B\u70BC,\u56E0\u4E3A\u6211\u77E5\u9053\u6709\u4E00\u5929\u547D\u8FD0\u4F1A\u5B89\u6392\u6211\u6210\u4E3A\u6551\u4E16\u4E3B\u3002"
    - "\u7ECF\u8FC7\u6211\u7684\u7814\u7A76,\u6211\u63A8\u65AD\u5728\u8FDC\u53E4\u65F6\u4EE3\u6709\u4E00\u4E2A\u4F1F\u5927\u7684\u6587\u660E,\u4F46\u662F\u4E0D\u77E5\u4E3A\u4F55\u6D88\u5931\u4E86\u3002"
    - "\u6CA1\u5FC5\u8981\u6D3B\u5F97\u592A\u7D2F,\u5076\u5C14\u505C\u4E0B\u811A\u6B65\u6B23\u8D4F\u4E00\u4E0B\u81EA\u7136\u4E5F\u662F\u5F88\u597D\u7684\u3002"
    - "\u9B54\u6CD5=\u767E\u5206\u4E4B\u4E5D\u4E5D\u7684\u5929\u8D4B+\u767E\u5206\u4E4B\u4E00\u7684\u52AA\u529B,\u6240\u4EE5\u4F60\u4F3C\u4E4E\u65E0\u6CD5\u6210\u4E3A\u9B54\u6CD5\u5E08\u4E86\u3002"
    - "\u5982\u679C\u4E0D\u662F\u90A3\u4EF6\u4E8B,\u738B\u56FD\u7684\u519B\u961F\u7684\u603B\u53F8\u4EE4\u5B98\u975E\u6211\u83AB\u5C5E\u4E86\u3002"
    - "\u4E0D\u7BA1\u4E0B\u96E8\u8FD8\u662F\u6674\u5929,\u6211\u89C9\u5F97\u6BCF\u4E00\u5929\u7684\u5929\u6C14\u90FD\u5F88\u597D,\u4F60\u89C9\u5F97\u5462\uFF1F"
    - "\u5176\u5B9E\u73ED\u5C3C\u8FEA\u514B\u5148\u751F\u4E0D\u662F\u4F60\u770B\u5230\u7684\u90A3\u6837,\u4ED6\u4E5F\u6709\u6E29\u67D4\u7684\u4E00\u9762\u3002"
    - "\u6BCF\u5929\u90FD\u8981\u8BB0\u5F97\u5582\u517B\u52A8\u7269\u554A,\u4E0D\u8981\u8BA9\u4ED6\u4EEC\u6328\u997F\u3002"
    - "\u548C\u4F60\u8BF4\u4E00\u4F1A\u8BDD,\u771F\u7684\u5F88\u8F7B\u677E,\u53EF\u662F\u6211\u8FD8\u6709\u5DE5\u4F5C,\u4E0D\u80FD\u5728\u548C\u4F60\u518D\u804A\u4E86\u3002"
    - "\u6F02\u6CCA\u4E86\u591A\u5E74,\u6CA1\u60F3\u5230\u6211\u8FD8\u662F\u611F\u5230\u5F88\u5BC2\u5BDE,\u4E0D\u77E5\u9053\u6211\u7684\u5F52\u5BBF\u5728\u54EA\u91CC\u3002"
    - "\u5E08\u7236\u662F\u4E2A\u5927\u7F8E\u4EBA\u5427,\u4E0D\u8FC7\u4F60\u53EF\u4E0D\u8981\u6253\u5979\u7684\u4E3B\u610F\u54E6,\u5E08\u7236\u53EF\u4E0D\u662F\u4F60\u80FD\u9A7E\u9A6D\u7684\u3002"
    - "\u5982\u679C\u4F60\u5B66\u4F1A\u4E86\u5236\u4F5C\u7684\u8BDD,\u4F60\u5C31\u53EF\u4EE5\u81EA\u5DF1\u5236\u4F5C\u88C5\u5907\u4E86\u3002"
    - "\u5728\u8FD9\u4E2A\u4E16\u754C\u4E0A\u9664\u4E86\u4EBA\u7C7B\u8FD8\u6709\u4E00\u4E9B\u5947\u602A\u7684\u79CD\u65CF,\u53EF\u662F\u4E3A\u4EC0\u4E48\u662F\u4EBA\u7C7B\u5360\u636E\u4E86\u5927\u9646\u5462\uFF1F"
    - "\u4F60\u542C\u5230\u4E86\u4EC0\u4E48\uFF1F\u53EF\u4E0D\u8981\u5230\u5904\u4E71\u8BF4\u554A,\u8FD9\u90FD\u662F\u6211\u4EEC\u5E74\u8F7B\u65F6\u53D1\u751F\u7684\u4E8B\u3002"
    - "\u4F20\u8BF4\u6211\u4EEC\u4EBA\u9C7C\u65CF\u6709\u4E00\u4F4D\u5973\u5B69\u7684\u9C7C\u5C3E\u53D8\u6210\u4E86\u53CC\u811A,\u8D70\u4E0A\u4E86\u9646\u5730\u5462\u2026"
    - "\u5176\u5B9E\u4E00\u4E2A\u4EBA\u7AD9\u5C97\u4E5F\u633A\u65E0\u804A\u7684,\u5982\u679C\u6709\u4EBA\u6765\u548C\u6211\u804A\u804A\u7684\u8BDD,\u6211\u4F1A\u5F88\u9AD8\u5174\u3002"
    - "\u5982\u679C\u4F60\u53D1\u73B0\u4E86\u5947\u602A\u7684\u98DF\u6750,\u8BF7\u4E00\u5B9A\u8981\u544A\u8BC9\u6211\u3002"
    - "\u5982\u679C\u6CA1\u4EC0\u4E48\u4E8B,\u53EF\u4EE5\u8BF7\u4F60\u79BB\u5F00\u5417\uFF1F"
    - "\u4ECA\u5929\u6211\u8FD8\u5F97\u770B\u5E97,\u4E0D\u80FD\u5C55\u793A\u6211\u7684\u96C4\u59FF\u7ED9\u4F60\u770B,\u6539\u5929\u518D\u6765\u5427\u3002"
    - "\u8FD9\u4E2A\u5C0F\u9547\u91CC\u5E94\u8BE5\u6709\u4E00\u4E2A\u53E4\u4EE3\u9057\u8FF9\u7684,\u4F46\u662F\u6211\u600E\u4E48\u4E5F\u627E\u4E0D\u5230\u3002"
    - "\u8FD9\u91CC\u771F\u662F\u4E00\u4E2A\u795E\u5947\u7684\u5730\u65B9,\u4F60\u77E5\u9053\u5417,\u5728\u5C0F\u9547\u7684\u56DB\u5468\u7ADF\u7136\u5206\u5E03\u7740\u56DB\u5B63\u3002"
    - "\u9B54\u6CD5\u836F\u5242\u73B0\u5728\u8FD8\u5728\u914D\u7F6E,\u6682\u65F6\u8FD8\u65E0\u6CD5\u4F9B\u5E94\u3002"
    - "\u6CE8\u610F,\u4E0D\u8981\u8D70\u5F97\u592A\u8FDC,\u5916\u9762\u53EF\u662F\u6709\u5F88\u591A\u53EF\u6015\u7684\u602A\u7269\u3002"
    - "\u597D\u5B69\u5B50\u996E\u98DF\u8981\u5747\u8861\u54E6,\u4E0D\u8BBA\u662F\u852C\u83DC\u8FD8\u662F\u8089\u7C7B\u90FD\u4E0D\u80FD\u6311\u98DF\u3002"
    - "\u5982\u679C\u6709\u4E00\u5929\u4F60\u8981\u7EC4\u6210\u5BB6\u5EAD,\u90A3\u4E48\u4F60\u4E00\u5B9A\u8981\u5230\u8FD9\u91CC\u8D2D\u4E70\u5BB6\u5177\u554A\u3002"
    - "\u5982\u679C\u53EF\u4EE5\u7684\u8BDD,\u5E0C\u671B\u4F60\u80FD\u591A\u6765\u627E\u683C\u5409\u5C14\u73A9\u3002"
    - "\u6211\u7684\u5988\u5988\u597D\u5389\u5BB3\u7684,\u5F88\u591A\u6599\u7406\u90FD\u662F\u5979\u81EA\u5DF1\u53D1\u660E\u7684\u3002"
    - "\u5475\u5475,\u548C\u4F60\u8BF4\u8FD9\u4E48\u591A,\u4F60\u4E5F\u4E0D\u61C2\u5427,\u50CF\u4F60\u8FD9\u79CD\u5C0F\u5B69\u5B50\u8FD8\u8981\u591A\u591A\u8FDB\u884C\u4EBA\u751F\u5386\u7EC3\u554A\u3002"
    - "\u6700\u8FD1\u5E08\u7236\u83B7\u5F97\u4E86\u4E00\u4E9B\u9B54\u6CD5\u836F\u5242\u7684\u914D\u65B9,\u6211\u4EEC\u6B63\u5728\u6536\u96C6\u6750\u6599\u8C03\u914D\u3002"
    - "\u4E00\u5B9A\u4E0D\u8981\u541D\u556C\u88C5\u5907\u54E6,\u5373\u4F7F\u4E0D\u7528\u7684\u88C5\u5907\u4E5F\u53EF\u4EE5\u552E\u5356\u83B7\u5F97\u91D1\u5E01\u3002"
    - "\u4F20\u8BF4\u4E2D\u8FD9\u4E2A\u4E16\u754C\u66FE\u7ECF\u88AB\u9B54\u65CF\u7EDF\u6CBB,\u4E0D\u77E5\u9053\u662F\u4E0D\u662F\u771F\u7684\u3002"
    - "\u60F3\u4E0D\u5230\u8FD8\u4F1A\u6709\u5E74\u8F7B\u4EBA\u6765\u627E\u6211\u8FD9\u4E2A\u8001\u5934\u5B50\u804A\u5929,\u771F\u4EE4\u4EBA\u9AD8\u5174\u3002"
    - "\u867D\u7136\u6211\u7684\u9053\u5177\u5C4B\u91CC\u90FD\u662F\u4E9B\u8FC7\u65F6\u7684\u8001\u4E1C\u897F,\u4F46\u662F\u5F88\u7528\u54E6\u3002"
    - "\u5176\u5B9E\u6C34\u91CC\u4E5F\u6709\u5F88\u591A\u6709\u610F\u601D\u7684\u5730\u65B9,\u5982\u679C\u4F60\u80FD\u5728\u6C34\u91CC\u751F\u5B58\u7684\u8BDD\u2026\u2026"
    - "\u5982\u679C\u9047\u5230\u4E86\u5371\u9669,\u4E00\u5B9A\u8981\u5411\u6211\u6C42\u52A9,\u6211\u53EF\u662F\u65F6\u523B\u51C6\u5907\u7740\u3002"
    - "\u6211\u7684\u5973\u513F\u53EF\u662F\u6211\u7684\u5FC3\u809D\u5B9D\u8D1D,\u4F60\u53EF\u4E0D\u8981\u60F3\u8F7B\u6613\u5C31\u5C06\u4ED6\u4EEC\u6B3A\u9A97\u5230\u624B\u3002"
    - "\u4ECA\u5929\u662F\u4F60\u7684\u751F\u65E5\u5427,\u8FD9\u662F\u6211\u9001\u4F60\u7684\u751F\u65E5\u793C\u7269\u3002"
    - "\u6B63\u597D\u8FD9\u4E2A\u7528\u4E0D\u5230\u4E86,\u5C31\u9001\u4F60\u5427\u3002"
    - "\u4E00\u76F4\u90FD\u6536\u4F60\u7684\u793C\u7269,\u8FD9\u4E2A\u5C31\u8868\u8FBE\u4E00\u4E0B\u6211\u7684\u5FC3\u610F\u5427\u3002"
    - "\u8FD9\u4E9B\u4E1C\u897F,\u5E0C\u671B\u4F60\u80FD\u7528\u7684\u4E0A\u3002"
    - "\u751F\u65E5\u5FEB\u4E50\u54DF,\u5E0C\u671B\u4F60\u559C\u6B22\u6211\u7684\u793C\u7269\u3002"
    - "\u4F60\u662F\u6765\u5411\u6211\u8BA8\u793C\u7269\u7684\u5417\uFF1F\u597D\u5427,\u8FD9\u4E2A\u5C31\u7ED9\u4F60\u5427\u3002"
    - "\u5B69\u5B50,\u606D\u559C\u4F60\u53C8\u957F\u5927\u4E00\u5C81\u4E86,\u7ED9\u4F60\u6211\u7684\u793C\u7269\u3002"
    - "\u751F\u65E5\u5FEB\u4E50\uFF01"
    - "\u5E0C\u671B\u4F60\u80FD\u559C\u6B22\u6211\u9001\u4F60\u7684\u793C\u7269\u3002"
    - "\u6211\u8BB0\u5F97\u4ECA\u5929\u662F\u4F60\u7684\u751F\u65E5,\u7ED9\u4F60\u7684\u793C\u7269\u3002"
    - "\u5E0C\u671B\u5E78\u8FD0\u4E4B\u795E\u80FD\u65E5\u65E5\u964D\u4E34\u4E8E\u4F60\u3002"
    - "\u54A6,\u4ECA\u5929\u662F\u4F60\u7684\u751F\u65E5\u5417\uFF1F\u90A3\u8FD9\u4E2A\u53EF\u4EE5\u4F5C\u4E3A\u751F\u65E5\u793C\u7269\u5417\uFF1F"
    - "\u6211\u8FD9\u91CC\u6709\u4E00\u4E9B\u57FA\u7840\u6750\u6599,\u9001\u4F60\u4E00\u4E9B\u4F5C\u4E3A\u751F\u65E5\u793C\u7269\u5427\u3002"
    - "\u4ECA\u5929\u5BF9\u4F60\u662F\u91CD\u8981\u7684\u4E00\u5929,\u6536\u4E0B\u6211\u7684\u793C\u7269\u5427\u3002"
    - "\u8FD9\u662F\u6211\u7684\u4E00\u70B9\u5FC3\u610F,\u867D\u7136\u6211\u6CA1\u6709\u4EC0\u4E48\u5176\u4ED6\u4E1C\u897F\u3002"
    - "\u6211\u53EA\u6709\u8FD9\u4E9B\u4E1C\u897F,\u5E94\u8BE5\u80FD\u6709\u70B9\u7528\u3002"
    - "\u9A6C\u8F66\u600E\u4E48\u505C\u4E0B\u4E86\uFF1F"
    - "\u770B\u6765\u6709\u602A\u7269\u903C\u8FD1\u4E86\u3002"
    - "\u90A3\u53EF\u600E\u4E48\u529E\uFF1F"
    - "\u4E0D\u5FC5\u62C5\u5FC3,\u51ED\u7740\u6211\u4EEC\u7684\u51E0\u4E2A\u5B9E\u529B,\u4E00\u822C\u602A\u7269\u90FD\u4E0D\u96BE\u5BF9\u4ED8\uFF01"
    - "\u602A\u7269\u6765\u4E86,\u51C6\u5907\u6218\u6597\uFF01"
    - "\u521A\u624D\u771F\u662F\u5371\u9669\u554A\uFF01"
    - "\u597D,\u8D81\u73B0\u5728\u5FEB\u70B9\u8D76\u5230\u9547\u5B50\u5427\u3002"
    - "\u6211\u4EE3\u8868\u5C0F\u9547\u6B22\u8FCE\u4F60,\u5C0F\u670B\u53CB\u3002"
    - "\u4F60\u7684\u5916\u516C\u5DF2\u7ECF\u79BB\u5F00\u4E86,\u5C31\u7531\u6211\u6765\u6307\u5BFC\u4F60\u5728\u5C0F\u9547\u7684\u751F\u6D3B\u5427\u3002"
    - "\u90A3\u4E48,\u6211\u8BE5\u505A\u4EC0\u4E48\uFF1F"
    - "\u4ECA\u5929\u4F60\u5DF2\u7ECF\u5F88\u7D2F\u4E86,\u8D70\u5427,\u6211\u5E26\u4F60\u56DE\u5BB6\u3002"
    - "\u4EE5\u540E\u8FD9\u5C31\u662F\u4F60\u7684\u5BB6\u4E86\uFF0C\u65E9\u70B9\u4F11\u606F\u5427\uFF0C\u660E\u5929\u6211\u4F1A\u6765\u53EB\u9192\u4F60\u7684\u3002"
    - "\u6211\u5148\u8D70\u4E86\uFF0C\u665A\u5B89"
    - "\u54CE\u5440,\u4F60\u5DF2\u7ECF\u8D77\u5E8A\u4E86\u554A,\u90A3\u4E48\u6211\u4EEC\u5C31\u5148\u5230\u4F60\u5916\u516C\u7559\u4E0B\u7684\u5546\u5E97\u53BB\u770B\u770B\u5427\u3002"
    - "\u6309\u7167\u4F60\u5916\u516C\u7684\u5631\u6258,\u6211\u4EEC\u7ED9\u4F60\u5F00\u653E\u4E86\u5546\u8D38\u3001\u793E\u4EA4\u8BB8\u53EF,\u5176\u4ED6\u7684\u8BB8\u53EF\u8FD8\u9700\u8981\u4F60\u81EA\u5DF1\u52AA\u529B\u8FBE\u6210\u3002"
    - "\u8BB8\u53EF\u6E05\u5355\u4F60\u53EF\u4EE5\u968F\u65F6\u53BB\u770B\u770B\u3002"
    - "\u90A3\u4E48\uFF0C\u73B0\u5728\u6211\u5E94\u8BE5\u505A\u4E9B\u4EC0\u4E48\u5462\uFF1F"
    - "\u4ECE\u6700\u7B80\u5355\u7684\u552E\u5356\u5F00\u59CB\u5427\uFF0C\u770B\u5230\u524D\u9762\u7684\u67DC\u53F0\u4E86\u4E48,\u5C06\u4E1C\u897F\u653E\u5230\u4E0A\u9762\u5C31\u884C\u4E86\u3002"
    - "\u5BF9\u4E86\uFF0C\u6709\u4E9B\u5546\u54C1\u53EA\u80FD\u653E\u5728\u7279\u5B9A\u67DC\u53F0\u4E0A\uFF0C\u4F60\u53EF\u4EE5\u4ED4\u7EC6\u89C2\u5BDF\u4E00\u4E0B\u3002"
    - "\u5F88\u597D\uFF0C\u73B0\u5728\u53BB\u628A\u5546\u5E97\u7684\u62DB\u724C\u6362\u6210\u8425\u4E1A\u5427\uFF0C\u53EA\u6709\u8425\u4E1A\u72B6\u6001\u65F6\u624D\u4F1A\u6709\u5BA2\u4EBA\u4E0A\u95E8\u3002"
    - "\u505A\u7684\u4E0D\u9519\uFF0C\u4F60\u53EF\u4EE5\u518D\u719F\u6089\u4E00\u4E0B\u552E\u5356\u5546\u54C1\uFF0C\u6211\u5728\u5916\u9762\u7B49\u4F60\u3002"
    - "\u770B\u6765\u4F60\u5DF2\u7ECF\u638C\u63E1\u4E86\u552E\u5356\u7269\u54C1\u7684\u65B9\u6CD5\u4E86,\u5982\u6B64\u4E00\u6765,\u4F60\u7684\u79CD\u690D\u8BB8\u53EF\u4E5F\u5F00\u653E\u4E86,\u90A3\u4E48\u73B0\u5728\u53BB\u4E70\u4E00\u4E9B\u79CD\u5B50\u56DE\u6765\u5427\u3002"
    - "\u54EA\u91CC\u6709\u79CD\u5B50\u51FA\u552E\uFF1F"
    - "\u690D\u7269\u5E97\u91CC\u62E5\u6709\u5404\u79CD\u690D\u7269\u79CD\u5B50,\u6765\u8DDF\u6211\u53BB\u719F\u6089\u719F\u6089\u5427\u3002"
    - "\u8FD9\u5C31\u662F\u65B0\u6765\u5C0F\u9547\u7684\u5B69\u5B50\u5427\uFF0C\u6B22\u8FCE\u4F60\u54DF\uFF0C\u60F3\u6765\u70B9\u4EC0\u4E48\uFF1F"
    - "\u4E70\u597D\u4E86\u79CD\u5B50\u4E86\uFF0C\u6211\u4EEC\u56DE\u519C\u573A\u79CD\u690D\u5427\u3002"
    - "\u7B49\u4E00\u4E0B\uFF0C\u6211\u8FD9\u91CC\u6709\u4E00\u4E9B\u79CD\u690D\u5DE5\u5177\uFF0C\u9001\u7ED9\u4F60\u3002"
    - "\u8C22\u8C22\uFF0C\u6211\u4F1A\u597D\u597D\u4F7F\u7528\u7684\u3002"
    - "\u8FD9\u91CC\u5C31\u662F\u519C\u573A\uFF0C\u4EE5\u540E\u5C31\u5F52\u4F60\u7BA1\u7406\u4E86,\u73B0\u5728\u51C6\u5907\u79CD\u690D\u5427\u3002"
    - "\u7B2C\u4E00\u6B65,\u5148\u5C06\u519C\u5177\u4ECE\u80CC\u5305\u91CC\u62FF\u51FA\u6765\u3002"
    - "\u73B0\u5728\u8D70\u5230\u519C\u7530\u4E0A\uFF0C\u4F7F\u7528\u9504\u5934\u5C06\u7530\u5730\u9504\u677E\u5427\u3002"
    - "\u5F88\u597D,\u5C31\u662F\u8FD9\u6837,\u73B0\u5728\u9009\u62E9\u79CD\u5B50\u8FDB\u884C\u64AD\u79CD\u5427\u3002"
    - "\u597D\u4E86,\u7EC8\u4E8E\u5B8C\u6210\u79CD\u690D\u4E86\u3002"
    - "\u522B\u6025,\u8FD8\u5DEE\u6700\u540E\u4E00\u6B65\u5462,\u79CD\u4E0B\u7684\u690D\u7269\u9700\u8981\u6D47\u6C34,\u73B0\u5728\u53BB\u6CB3\u8FB9\u6253\u6C34\u56DE\u6765\u3002"
    - "\u8BB0\u4F4F\u6BCF\u5929\u90FD\u5F97\u6765\u6D47\u6C34\u554A,\u4E0D\u7136\u690D\u7269\u4F1A\u67AF\u6B7B\u7684\u3002"
    - "\u690D\u7269\u751F\u957F\u9700\u8981\u51E0\u5929\u65F6\u95F4,\u5728\u6B64\u671F\u95F4,\u4E0D\u5982\u53BB\u91CE\u5916\u63A2\u9669\u4E00\u4E0B,\u4E5F\u8BB8\u4F1A\u83B7\u5F97\u60F3\u4E0D\u5230\u7684\u6536\u83B7\u54E6\u3002"
    - "\u524D\u9762\u5C31\u662F\u6625\u4E4B\u5C71\u8109\u7684\u5165\u53E3\uFF0C\u4ECA\u5929\u5C31\u8BA9\u6211\u8FD9\u4E2A\u8001\u5934\u5B50\u966A\u4F60\u95EF\u4E00\u4E0B\u5427\u3002"
    - "\u73B0\u5728\u524D\u8FDB\u8D70\u5230\u5149\u5708\u4E2D\uFF0C\u5F00\u59CB\u4ECA\u5929\u7684\u63A2\u7D22\u3002"
    - "\u6253\u8D77\u7CBE\u795E\u6765\uFF0C\u73B0\u5728\u524D\u8FDB\u5427\u3002"
    - "\u6211\u7684\u4F24\u52BF\u9700\u8981\u4F11\u517B\u51E0\u5929,\u63A5\u4E0B\u6765\u7684\u4E8B\u60C5\u5C31\u8981\u9760\u4F60\u81EA\u5DF1\u52AA\u529B\u4E86\u3002"
    - "\u591A\u4E48\u7F8E\u4E3D\u7684\u82B1\u513F\u554A,\u771F\u7684\u662F\u9001\u7ED9\u6211\u7684\u5417\uFF1F"
    - "\u60F3\u7528\u9C9C\u82B1\u4FD8\u864F\u6211\u7684\u5FC3\u5417\uFF1F"
    - "\u54E6,\u592A\u7F8E\u4E86,\u6211\u4E00\u76F4\u5E7B\u60F3\u7740\u6709\u4EBA\u80FD\u9001\u6211\u9C9C\u82B1\u5462\u3002"
    - "\u4F60..\u4F60\u662F\u4EC0\u4E48\u610F\u601D\uFF1F,\u4E0D..\u4E0D\u7BA1\u600E\u6837,\u8C22\u8C22\u4E86\u3002"
    - "\u597D\u9AD8\u5174\uFF01\u7ADF\u7136\u53EF\u4EE5\u6536\u5230\u9C9C\u82B1\uFF01"
    - "\u6CA1\u60F3\u5230\u50CF\u6211\u8FD9\u79CD\u8001\u5934\u5B50\u4E5F\u53EF\u4EE5\u6536\u5230\u5E74\u8F7B\u5B69\u5B50\u7684\u9C9C\u82B1\uFF01"
    - "\u8C22\u8C22,\u8FD9\u675F\u9C9C\u82B1\u6211\u4F1A\u94ED\u8BB0\u5728\u5FC3\u3002"
    - "\u4F60\u7684\u5FC3\u610F,\u6211\u5DF2\u77E5\u6653\u3002"
    - "\u7F8E\u4E3D\u7684\u9C9C\u82B1\u4EE3\u8868\u7740\u7F8E\u4E3D\u7684\u5FC3\u7075,\u4F60\u662F\u6211\u503C\u5F97\u4FE1\u8D56\u7684\u4EBA\u2026"
    - "\u9C9C\u82B1\u662F\u82F1\u96C4\u7684\u7EDD\u914D,\u4F60\u771F\u662F\u6211\u7684\u77E5\u5DF1\u2026"
    - "\u8C22\u8C22\u4F60,\u5982\u679C\u53EF\u4EE5,\u80FD\u591A\u6765\u966A\u966A\u6211\u5417\uFF1F"
    - "\u9C9C\u82B1\u662F\u7231\u60C5\u7684\u9B54\u6CD5,\u73B0\u5728\u6211\u8FD8\u6CA1\u529E\u6CD5\u514D\u75AB\u2026"
    - "\u6536\u5230\u82B1\u513F\u540E,\u6211\u4E5F\u611F\u5230\u5E74\u8F7B\u4E86\u5462\uFF01"
    - "\u751F\u547D\u5982\u82B1,\u6211\u7684\u5FC3\u53C8\u53D8\u5F97\u6709\u6D3B\u529B\u4E86\u3002"
    - "\u613F\u8FD9\u4EFD\u7F8E\u4E3D\u80FD\u957F\u5B58\u5E38\u5728\uFF01"
    - "\u539F\u6765,\u4F60\u5BF9\u6211\u2026"
    - "\u55EF,\u5BF9\u6211\u6765\u8BF4,\u4F60\u5F88\u7279\u522B\u3002"
    - "\u770B\u6765,\u6211\u4E5F\u8BE5\u6709\u81EA\u5DF1\u7684\u751F\u6D3B\u4E86\u3002"
    - "\u6211\u7684\u5C11\u5973\u5FC3\u88AB\u4F60\u52FE\u8D77\u4E86\u5462\u3002"
    - "\u4EE4\u4EBA\u6000\u5FF5\u554A,\u6211\u7684\u6FC0\u60C5\u5C81\u6708\u3002"
    - "\u4ECA\u5929\u7684\u9C9C\u82B1\u5DF2\u7ECF\u6536\u5230,\u8FD9\u4EFD\u7F8E\u4E3D\u8BF7\u7559\u5230\u660E\u5929\u3002"
    - "\u597D\u9AD8\u5174\uFF01\u5176\u5B9E\u6211\u4E5F\u559C\u6B22\u4F60\uFF01"
    - "\u4F60..\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u65E2\u7136,\u4F60..\u575A\u6301\u7684\u8BDD,\u6211..\u5C31\u52C9\u5F3A\u7B54\u5E94\u4F60\u5427\u3002"
    - "\u90A3\u4E48,\u4ECA\u540E\u6211\u4EEC\u5C31\u4E00\u8D77\u52AA\u529B\u5427\u3002"
    - "\u55EF,\u6211\u4E5F\u8BE5\u7559\u610F\u4E00\u4E0B\u8EAB\u8FB9\u7684\u7F8E\u4E3D\u4E86,\u6211\u7F8E\u4E3D\u7684\u5973\u5B69\u3002"
    - "\u6052\u4E45\u7684\u7B49\u5F85,\u53EA\u4E3A\u4E86\u4F60\u7684\u5230\u6765,\u8BA9\u6211\u4EEC\u643A\u624B\u5411\u524D\u2026"
    - "\u867D\u7136\u5E76\u4E0D\u5B8C\u7F8E,\u4E0D\u8FC7\u4F60\u8FD8\u662F\u4E0D\u9519\u7684,\u90A3\u5C31\u7B54\u5E94\u4F60\u5427\u3002"
    - "\u6211,\u771F\u7684\u53EF\u4EE5\u5417\uFF1F\u5176\u5B9E\u6211\u4E00\u76F4\u90FD\u559C\u6B22\u4F60\uFF01"
    - "\u76EF\u2026\u5176\u5B9E\u6211\u65E9\u5C31\u77E5\u9053\u4E86,\u6CA1\u60F3\u5230\u4F60\u8FD9\u4E48\u665A\u624D\u6765,\u4F60\u8BF4\u6211\u8BE5\u600E\u4E48\u529E\uFF1F\u4EB2\u7231\u7684\u3002"
    - "\u4F60\u4E5F\u662F\u6211\u6B23\u8D4F\u7684\u4EBA,\u4ECA\u540E\u5C31\u8BF7\u591A\u591A\u5173\u7167\u4E86\u3002"
    - "\u54C7,\u597D\u7F9E\u4EBA,\u4E0D\u8FC7\u6211\u771F\u7684\u597D\u9AD8\u5174,\u4ECA\u540E\u5E0C\u671B\u80FD\u548C\u4F60\u4E00\u8D77\u8D70\u4E0B\u53BB\u3002"
    - "\u4F60\u662F\u8BA4\u771F\u7684\u5417\uFF1F\u5450,\u5C31\u5148\u76F8\u4FE1\u4F60\u5427,\u5982\u679C\u4F60\u6B3A\u9A97\u6211\u7684\u8BDD\u2026"
    - "\u6CA1\u60F3\u5230\u4F60\u4F1A\u9009\u62E9\u6211,\u6211\u4E5F\u4F1A\u5F97\u5230\u5E78\u798F\u5462\u3002"
    - "\u8DE8\u79CD\u65CF\u7684\u7231\u604B\u662F\u5F88\u56F0\u96BE\u7684,\u4F60\u8981\u505A\u597D\u89C9\u609F\u54E6\u3002"
    - "\u4EB2\u7231\u7684,\u4F60\u6765\u4E86,\u521A\u624D\u6211\u8FD8\u5728\u60F3\u4F60\u5462,\u563F\u563F\u3002"
    - "\u4EB2..\u4EB2\u7231\u7684,\u4F60\u6765\u8FD9\u91CC,\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F"
    - "\u751C\u5FC3,\u770B\u5230\u4F60,\u6211\u7684\u5FC3\u60C5\u5C31\u53D8\u597D\u4E86,\u5982\u679C\u53EF\u4EE5,\u5E0C\u671B\u4F60\u80FD\u591A\u966A\u6211\u4E00\u4F1A\u2026"
    - "\u8FD9\u79CD\u67AF\u71E5\u7684\u5DE5\u4F5C,\u679C\u7136\u8FD8\u662F\u9700\u8981\u4F60\u7684\u966A\u4F34,\u4ECA\u5929\u8FC7\u6765\u662F\u60F3\u5E72\u4EC0\u4E48\u5462\uFF1F"
    - "\u543E\u7231,\u4F60\u5982\u98CE\u4E2D\u7684\u7CBE\u7075,\u771F\u60F3\u4E3A\u4F60\u732E\u4E0A\u4E00\u9996\u8D5E\u7F8E\u8BD7.."
    - "\u5662,\u4F60\u6765\u4E86\u5440,\u662F\u60F3\u6211\u4E86\u5417\uFF1F"
    - "\u521A\u521A\u6211\u8FD8\u5728\u60F3\u4F60,\u6CA1\u60F3\u5230\u4F60\u7ADF\u7136\u9A6C\u4E0A\u5C31\u6765\u4E86,\u6211\u597D\u5E78\u798F\u2026"
    - "\u662F\u4F60\u554A,\u4EB2\u7231\u7684,\u89C1\u5230\u4F60\u771F\u9AD8\u5174,\u4F60\u662F\u6765\u770B\u6211\u7684\u5417\uFF1F"
    - "\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48,\u5728\u89C1\u5230\u4F60\u4E4B\u540E,\u5FC3\u60C5\u53D8\u5F97\u8F7B\u677E\u4E86\u3002"
    - "\u5450\u5450,\u4EE5\u540E\u7B49\u6211\u4EEC\u7EC4\u6210\u5BB6\u5EAD,\u6211\u6BCF\u5929\u7ED9\u4F60\u505A\u4FBF\u5F53\u5403\u597D\u5417\uFF1F"
    - "\u4EB2\u7231\u7684,\u6211\u51B3\u5B9A\u4E86,\u4EE5\u540E,\u6211\u7684\u821E\u59FF\u53EA\u4F1A\u4E3A\u4F60\u800C\u7EFD\u653E\u3002"
    - "\u81EA\u4ECE\u89C1\u5230\u4E86\u4F60,\u6211\u5C31\u4E2D\u4E86\u4E00\u79CD\u53EB\u7231\u60C5\u7684\u9B54\u6CD5\u3002"
    - "\u5B88\u62A4\u8FD9\u91CC\u662F\u6211\u7684\u804C\u8D23,\u90A3\u4E48,\u5B88\u62A4\u6211\u7684\u5C31\u662F\u4F60\u4E86\u5417\uFF1F"
    - "\u539F\u6765\u50CF\u6211\u8FD9\u79CD\u65E0\u540D\u5C0F\u5352\u4E5F\u53EF\u4EE5\u62E5\u6709\u7231\u60C5\u554A,\u6211\u4F1A\u73CD\u60DC\u4F60\u7684\u3002"
    - "\u6211\u8981\u66F4\u52A0\u52AA\u529B,\u6211\u4F1A\u4E0E\u4F60\u76F8\u914D\u7684\u3002"
    - "\u6CA1\u60F3\u5230\u2026"
    - "\u522B\u4EE5\u4E3A,\u6211\u4F1A\u633D\u7559.."
    - "\u54FC\u2026"
    - "\u8BF7\u4F60\u4EE5\u540E\u4E0D\u8981\u6765\u6253\u6270\u6211"
    - "\u7231\u60C5\u603B\u4EE5\u60B2\u5267\u800C\u544A\u7EC8\u2026"
    - "\u8FD9\u8FD8\u4E0D\u503C\u5F97\u6211\u6124\u6012\u2026"
    - "\u4E3A\u4EC0\u4E48\uFF1F\u662F\u6211\u54EA\u91CC\u505A\u7684\u4E0D\u597D\u5417\uFF1F"
    - "\u4F60\u8FD9\u4E2A\u6E23\u7537\u2026"
    - "\u4EBA\u5FC3\u603B\u662F\u4E11\u964B\u7684\u2026"
    - "\u5509,\u600E\u4E48\u4F1A\u8FD9\u6837\u2026"
    - "\u4F60\u80C6\u5B50\u5F88\u5927\u554A,\u7ADF\u6562\u8FD9\u6837\u73A9\u5F04\u6211\uFF01"
    - "\u6211\u518D\u4E5F\u4E0D\u4F1A\u76F8\u4FE1\u4F60\u4E86\uFF01"
    - "\u679C\u7136,\u79CD\u65CF\u662F\u65E0\u6CD5\u8DE8\u8D8A\u7684\u2026"
    - "\u8FD9\u91CC\u7684\u98CE\u666F\u771F\u662F\u7F8E\u4E3D\u554A\u3002"
    - "\u771F\u60F3\u5728\u8FD9\u91CC\u591A\u5446\u4E00\u4F1A\u3002"
    - "\u8FD9\u91CC\u98CE\u666F\u4E5F\u4E0D\u8FC7\u5982\u6B64\u5417\uFF1F"
    - "\u6211\u4EEC\u5C31\u968F\u4FBF\u770B\u770B\u5427\u3002"
    - "\u8BA9\u6211\u4EEC\u4EAB\u53D7\u8FD9\u7F8E\u597D\u7684\u65F6\u5149\u5427\u3002"
    - "\u6211\u7684\u5FC3\u7075\u53D7\u5230\u629A\u6170\u4E86\u3002"
    - "\u6211\u771F\u7684\u6709\u8FD9\u4E48\u597D\u5417\uFF1F"
    - "\u53EA\u662F\u5C71\u98CE\u6709\u4E9B\u51B7\u554A\u3002"
    - "\u5450,\u6211\u4EEC\u53EA\u662F\u6765\u770B\u98CE\u666F\u5417\uFF1F"
    - "\u597D\u554A,\u5927\u5BB6\u4E00\u8D77"
    - "\u5509,\u4F60\u5728\u505A\u4EC0\u4E48\uFF1F"
    - "\u5514,\u4E0B\u6B21\u53EF\u4EE5\u5148\u544A\u8BC9\u6211\u5417\uFF1F"
    - "\u597D\u5427,\u6211\u4EEC\u4E5F\u8BE5\u8FCE\u6765\u4E00\u6BB5\u65B0\u751F\u6D3B\u4E86\u3002"
    - "\u82B1\u5FC3\u53EF\u662F\u4E0D\u597D\u7684\u884C\u4E3A\u3002"
    - "\u55EF,\u6211\u4E5F\u662F\u3002"
    - "\u597D\u5427,\u90A3\u4E48\u6211\u4EEC\u5C31\u51FA\u53D1\u5427\u3002"
    - "\u4ECA\u5929\u5DF2\u7ECF\u7EA6\u8FC7\u4E86,\u660E\u5929\u5728\u6765\u5427\u3002"
    - "\u597D\u8212\u670D,\u75B2\u52B3\u90FD\u6D88\u9664\u4E86\uFF01\u8F9B\u82E6\u4F60\u4E86,\u4EB2\u7231\u7684\u3002"
    - "\u4ECA\u5929\u6211\u5DF2\u7ECF\u7D2F\u4E86,\u660E\u5929\u6211\u5728\u4E3A\u4F60\u670D\u52A1\uFF01"
    - "\u4EB2\u7231\u7684,\u4F60\u5DF2\u7ECF\u62FF\u4E0D\u4E0B\u4E86,\u5148\u628A\u80CC\u5305\u817E\u51FA\u4E00\u4E2A\u683C\u5B50\u6765\u5427\u3002"
    - "\u4ECA\u5929\u5DF2\u7ECF\u6CA1\u6709\u4E86,\u660E\u5929\u6211\u4F1A\u65E9\u70B9\u51C6\u5907\u597D\u7684\u3002"
    - "\u4ECA\u5929\u8F9B\u82E6\u4E86,\u6709\u4EC0\u4E48\u9700\u8981\u6211\u670D\u52A1\u7684\u5417\uFF1F"
    - "\u4EB2\u7231\u7684,\u4ECA\u5929,\u6211\u7684\u8EAB\u4F53\u6709\u70B9\u4E0D\u8212\u670D\u3002"
    - "\u600E\u4E48\u4E86\u5417\uFF1F\u6211\u53BB\u627E\u4EBA\u6765\u7ED9\u4F60\u770B\u770B\u3002"
    - "\u606D\u559C\u4F60\u4EEC\u4E86,\u4F60\u4EEC\u8981\u6709\u5C0F\u5B9D\u5B9D\u4E86\u3002"
    - "\u8FD9\u4E48\u8BF4,\u6211.."
    - "\u592A\u597D\u4E86,\u4EB2\u7231\u7684,\u6211\u4EEC\u8981\u6709\u5B69\u5B50\u4E86\u3002"
    - "\u6211\u5148\u8D70\u4E86,\u8FC7\u6BB5\u65F6\u95F4\u5B69\u5B50\u51FA\u751F\u65F6\u6211\u5728\u6765\u3002"
    - "\u5C0F\u5B9D\u5B9D\u7EC8\u4E8E\u51FA\u751F\u4E86,\u606D\u559C\u4F60\u4EEC\u4E86\u3002"
    - "\u8FD9\u5C31\u662F\u6211\u7684\u5B69\u5B50\uFF01\u4EB2\u7231\u7684,\u8C22\u8C22\u4F60\uFF01"
    - "\u597D\u4E86,\u6211\u4EEC\u8BE5\u7ED9\u4ED6\u53D6\u4E00\u4E2A\u540D\u5B57\u4E86\uFF01"
    - "\u771F\u662F\u4E2A\u597D\u540D\u5B57,\u4F60\u4EEC\u53EF\u8981\u7167\u987E\u597D\u8FD9\u4E2A\u5C0F\u5BB6\u4F19\u5440\u3002"
    - "\u8FD9\u662F\u6211\u4EEC\u7684\u8D23\u4EFB\u3002"
    - "\u591A\u8C22\u4F60\u7684\u836F,\u6211\u7684\u8EAB\u4F53\u5DF2\u7ECF\u75CA\u6108\u4E86,\u968F\u65F6\u6765\u627E\u6211\u7EC4\u961F\u554A\uFF01"
    - "\u8C22\u8C22"
    - "\u6211\u5F88\u7D2F\u4E86,\u5E94\u8BE5\u5148\u4F11\u606F\u4E00\u4E0B\u624D\u884C"
    - "\u6211\u6CA1\u6709\u9504\u5934\uFF0C\u6CA1\u529E\u6CD5\u9504\u5730"
    - "\u8FD9\u5757\u5730\u5DF2\u7ECF\u5E73\u6574\u8FC7\u4E86\uFF0C\\n\u4E0D\u9700\u8981\u518D\u9504\u5730\u4E86"
    - "\u5982\u679C\u4E0D\u9009\u62E9\u79CD\u5B50\uFF0C\\n\u662F\u6CA1\u529E\u6CD5\u79CD\u5730\u7684"
    - "\u8FD9\u5757\u5730\u65E0\u6CD5\u79CD\u690D"
    - "\u4E0D\u4F7F\u7528\u6C34\u58F6\u7684\u8BDD,\\n\u6211\u6CA1\u529E\u6CD5\u6D47\u6C34"
    - "\u8FD9\u5757\u5730\u5DF2\u7ECF\u4E0D\u9700\u8981\u6D47\u6C34\u4E86"
    - "\u6C34\u58F6\u91CC\u6CA1\u6709\u6C34\u4E86"
    - "\u6C34\u58F6\u5DF2\u7ECF\u6EE1\u4E86,\\n\u4E0D\u9700\u8981\u518D\u88C5\u6C34\u4E86"
    - "\u55EF\uFF0C\u8FD8\u662F\u5148\u7559\u7740\u4E3A\u597D"
    - "\u6211\u7684\u80CC\u5305\u6CA1\u6709\u7A7A\u95F4\u4E86,\\n\u6211\u5E94\u8BE5\u81F3\u5C11\u5728\u80CC\u5305\u4E2D\u7559\u4E00\u4E2A\u7A7A\u4F4D\u7F6E"
    - "\u6211\u7D2F\u4E86,\u8FD8\u662F\u5148\u4F11\u606F,\u660E\u5929\u518D\u51FA\u53BB"
    - "\u6211\u7F3A\u5C11\u5EFA\u9020\u6750\u6599\uFF0C\u6211\u5F97\u5148\u6536\u96C6\u4E00\u4E9B\u624D\u884C"
    - "\u592A\u597D\u4E86,\u8FD9\u4E0B\u53EF\u4EE5\u9972\u517B\u52A8\u7269\u4E86\uFF01"
    - "\u6211\u6CA1\u6709\u9570\u5200\uFF0C\u6CA1\u529E\u6CD5\u6536\u5272"
    - "\u6211\u9700\u8981\u5148\u88C5\u5907\u65A7\u5934"
    - "\u6211\u6CA1\u6709\u9C7C\u7AFF\uFF0C\u6CA1\u6CD5\u9493\u9C7C\uFF01"
    - "\u6211\u9700\u8981\u88C5\u5907\u9C7C\u9975\uFF0C\u5426\u5219\u4E0D\u80FD\u9493\u9C7C\uFF01"
    - "\u6B22\u8FCE\u5149\u4E34\uFF0C\u6709\u4EC0\u4E48\u9700\u8981\u7684\u5417"
    - "\u5982\u679C\u6BCF\u5929\u90FD\u80FD\u4E0B\u96E8\u5C31\u597D\u4E86\uFF0C\u8FD9\u6837\u5C31\u4E0D\u9700\u8981\u4E3A\u690D\u7269\u6D47\u6C34\u4E86\u3002"
    - "\u4F60\u77E5\u9053\u5417,\u5176\u5B9E\u852C\u83DC\u91CC\u4E5F\u6709\u5F88\u591A\u8425\u517B\u54E6\u3002"
    - "\u79CD\u690D\u662F\u5F88\u6709\u5B66\u95EE\u7684,\u4E00\u5B9A\u8981\u5728\u5408\u9002\u7684\u5B63\u8282\u79CD\u690D\u4F5C\u7269\u54E6,\\n\u5426\u5219\u4F5C\u7269\u7684\u751F\u957F\u65F6\u95F4\u4F1A\u53D8\u7684\u5F88\u957F\u3002"
    - "\u6211\u8981\u597D\u597D\u5E2E\u52A9\u739B\u5FB7\u7433\u5976\u5976\u3002"
    - "\u4F60\u597D\u5440\uFF0C\u5C0F\u5BB6\u4F19\uFF0C\u9700\u8981\u6211\u7684\u5E2E\u52A9\u5417\uFF1F"
    - "\u5E15\u7279\u91CC\u514B\u90A3\u4E2A\u8001\u56FA\u6267\u5728\u5E72\u4EC0\u4E48\u5462\uFF1F..\u660E\u660E\u8FC7\u53BB\u90A3\u4E48\u4E45\u4E86\u2026"
    - "\u5E03\u83B1\u5179\u662F\u4E2A\u597D\u5B69\u5B50\uFF0C\u5982\u679C\u4ED6\u7684\u7236\u6BCD\u8FD8\u5728\u7684\u8BDD\u2026"
    - "\u5E74\u8F7B\u771F\u597D\u5440\uFF0C\u8981\u597D\u597D\u4EAB\u53D7\u751F\u6D3B\u54DF.."
    - "\u6709\u70E6\u5FC3\u4E8B\u7684\u8BDD\uFF0C\u6765\u548C\u5976\u5976\u8BF4\uFF0C\u6211\u4F1A\u5E2E\u52A9\u4F60\u7684\u3002"
    - "\u505A\u4E00\u4E2A\u597D\u519C\u592B\u4E5F\u4E0D\u5BB9\u6613\u5462\uFF0C\u8981\u52A0\u6CB9\u54E6\uFF01"
    - "\u4F60\u597D\uFF0C\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F"
    - "\u683C\u5409\u5C14\u603B\u662F\u60F3\u7740\u53BB\u5192\u9669\uFF0C\u6211\u8FD8\u662F\u5E0C\u671B\u4ED6\u80FD\u5728\u5C0F\u9547\u5B89\u7A33\u7684\u751F\u6D3B\u3002"
    - "\u5E73\u9759\u7684\u751F\u6D3B\u5C31\u662F\u6700\u5927\u7684\u5E78\u798F\uFF0C\u4F60\u89C9\u5F97\u7684\u5462\uFF1F"
    - "\u6211\u5F88\u559C\u6B22\u548C\u52A8\u7269\u4EEC\u76F8\u5904\uFF0C\u5B83\u4EEC\u65E2\u5355\u7EAF\u53C8\u53EF\u7231\u3002"
    - "\u51C6\u5907\u5E72\u4E9B\u4EC0\u4E48\uFF1F"
    - "\u76F8\u6BD4\u6E29\u987A\u7684\u52A8\u7269\uFF0C\u6211\u66F4\u559C\u6B22\u80FD\u548C\u6211\u4E00\u8D77\u6218\u6597\u7684\u4F19\u4F34\u3002"
    - "\u4F60\u5982\u679C\u8981\u53BB\u5192\u9669\u7684\u8BDD\uFF0C\u4E00\u5B9A\u8981\u5E26\u4E0A\u6211\u5440\u3002"
    - "\u6709\u7684\u4EBA\u5929\u751F\u5C31\u662F\u4E3B\u89D2\uFF0C\u4F60\u770B\u6211\u50CF\u4E0D\u50CF\uFF0C\u54C8\u54C8\u3002"
    - "\u98CE\u513F\u5E26\u6765\u4E86\u4F60\u7684\u8BAF\u606F\uFF0C\u4F60\u6709\u4EC0\u4E48\u60F3\u8981\u503E\u8BC9\uFF1F"
    - "\u4EBA\u7684\u751F\u547D\u5982\u6B64\u77ED\u6682\uFF0C\u4F60\u662F\u5426\u5DF2\u7ECF\u51C6\u5907\u597D\u63A5\u53D7\u81EA\u5DF1\u7684\u547D\u8FD0\u2026"
    - "\u9AD8\u5C71\u4E4B\u540E\u662F\u5927\u6D77\uFF0C\u5927\u6D77\u4E4B\u8FB9\u662F\u9AD8\u5C71\uFF0C\u4E0D\u77E5\u5C71\u6D77\u76F8\u8FDE\u4F55\u5904\u662F\u5C3D\u5934\u2026"
    - "\u4EBA\u65E0\u6CD5\u8DE8\u8FC7\u4E24\u6B21\u540C\u4E00\u6761\u6CB3\u6D41\uFF0C\u90A3\u4E48\u6CB3\u91CC\u7684\u9C7C\u662F\u5426\u76F8\u540C\u2026"
    - "\u7F8E\u4E3D\u7684\u4EBA\u554A\uFF0C\u504E\u4F9D\u5728\u6CB3\u5CB8\uFF0C\u6211\u53EA\u6562\u8FDC\u8FDC\u6B23\u8D4F\u4E0D\u6562\u9760\u8FD1\uFF0C\u5BB3\u6015\uFF0C\u4F60\u90A3\u7F8E\u4E3D\u7684\u9762\u5E9E\u5C06\u6211\u7684\u773C\u775B\u707C\u4F24\u2026"
    - "\u613F\u4E3B\u4FDD\u4F51\u4F60\uFF0C\u60F3\u8981\u7948\u7977\u4EC0\u4E48\uFF1F"
    - "\u4E00\u5207\u5B58\u5728\u90FD\u6E90\u81EA\u5185\u5FC3\uFF0C\u5982\u679C\u5E0C\u671B\u4E16\u754C\u66F4\u597D\uFF0C\u90A3\u4E48\u5C31\u8BA9\u81EA\u5DF1\u7684\u5185\u5FC3\u66F4\u7EAF\u51C0\u5427\u3002"
    - "\u73B0\u5728\u7684\u5E74\u8F7B\u4EBA\u90FD\u4E0D\u77E5\u9053\u656C\u754F\u4E0A\u5E1D\u4E86\uFF0C\u5E73\u65F6\u90FD\u4E0D\u6765\u793C\u62DC\u4E86\u3002"
    - "\u613F\u4E3B\u7684\u8363\u5149\u7167\u8000\u5728\u4F60\u8EAB\u4E0A\u3002"
    - "\u5E0C\u671B\u6BCF\u4E00\u4E2A\u8FDC\u884C\u7684\u4EBA\u90FD\u80FD\u5E73\u5B89\u7684\u5F52\u6765\u2026"
    - "\u547D\u8FD0\u8FD8\u662F\u8981\u628A\u63E1\u5728\u81EA\u5DF1\u624B\u91CC\uFF0C\u60F3\u77E5\u9053\u4EC0\u4E48\uFF1F"
    - "\u6211\u77E5\u9053\u5F88\u591A\uFF0C\u4F46\u6211\u4E0D\u80FD\u90FD\u544A\u8BC9\u4F60\u3002"
    - "\u4ECE\u8FDC\u65B9\u800C\u6765\u7684\u4EBA\u554A\uFF0C\u4F60\u7684\u6545\u4E61\u5728\u4F55\u5904\uFF0C\u4F60\u53EF\u77E5\u4F60\u7684\u771F\u540D\uFF0C\u6211\u5728\u6B64\u7B49\u5019\u4F60\u7684\u503E\u8BC9.."
    - "\u5E74\u8F7B\u4EBA\uFF0C\u63A2\u7D22\u7CBE\u795E\u56FA\u7136\u53EF\u8D35\uFF0C\u4F46\u4E0D\u8981\u76F2\u76EE\u5192\u9669\u5450\u3002"
    - "\u5373\u4F7F\u77E5\u9053\u4E86\u547D\u8FD0\uFF0C\u4F9D\u7136\u80FD\u591F\u7B11\u7740\u9762\u5BF9\u7684\u4EBA\u624D\u662F\u771F\u6B63\u7684\u52C7\u58EB\u3002"
    - "\u4F60\u597D\u5440\uFF0C\u60F3\u8981\u70B9\u4EC0\u4E48\u5417\uFF1F"
    - "\u5C3D\u7BA1\u6BCF\u5929\u90FD\u5F88\u5FD9\uFF0C\u4F46\u6211\u4EEC\u90FD\u5F88\u5FEB\u4E50\u3002"
    - "\u7F8E\u98DF\u548C\u7F8E\u666F\u90FD\u4E0D\u80FD\u9519\u8FC7\u3002"
    - "\u4F60\u7B11\u8D77\u6765\u771F\u597D\u770B\uFF0C\u591A\u7B11\u7B11\u561B\u3002"
    - "\u5E73\u65F6\u591A\u51FA\u6765\u548C\u6211\u4EEC\u4E00\u8D77\u73A9\u5427\uFF0C\u4E0D\u8981\u8001\u5446\u5728\u5BB6\u91CC\u561B\u3002"
    - "\u4F60\u597D\uFF0C\u4ECA\u5929\u4E5F\u5F88\u7CBE\u795E\u5440\uFF0C\u9700\u8981\u6211\u505A\u4EC0\u4E48\u5417\uFF1F"
    - "\u73ED\u5C3C\u8FEA\u514B\u5148\u751F\u662F\u4E2A\u597D\u4EBA\u3002"
    - "\u4E00\u5207\u5B89\u597D\uFF0C\u4E5F\u5E0C\u671B\u4F60\u4E5F\u80FD\u5F00\u5F00\u5FC3\u5FC3\u3002"
    - "\u6709\u4EC0\u4E48\u53EF\u4EE5\u4E3A\u4F60\u670D\u52A1\u7684\u5417\uFF1F"
    - "\u4ECA\u5929\u4E5F\u662F\u5E73\u9759\u800C\u7F8E\u597D\u7684\u3002"
    - "\u770B\u7740\u73AF\u5883\u53D8\u5F97\u5E72\u51C0\u536B\u751F\uFF0C\u6211\u4F1A\u5F88\u8212\u5FC3\u3002"
    - "\u662F\u4F60\u554A\uFF0C\u6709\u4E8B\u7684\u8BDD\uFF0C\u8BF7\u5C3D\u7BA1\u5429\u5490\u3002"
    - "\u5982\u679C\u80FD\u53D1\u6325\u6211\u7684\u7279\u957F\u7684\u8BDD\u5C31\u592A\u597D\u4E86\u3002"
    - "\u8FD9\u4E2A\u5C0F\u9547\u80FD\u5982\u6B64\u5B89\u5B81\u662F\u5F88\u591A\u4EBA\u4ED8\u51FA\u7684\u7ED3\u679C\u3002"
    - "\u5B88\u62A4\u5BB6\u4EBA\u662F\u6211\u7684\u804C\u8D23\u3002"
    - "\u5176\u5B9E\u56DE\u5230\u8FD9\u4E2A\u517B\u80B2\u6211\u7684\u5C0F\u9547\uFF0C\u6211\u5F88\u5F00\u5FC3\u3002"
    - "\u54DF\uFF0C\u627E\u6211\u6709\u4E8B\uFF1F"
    - "\u771F\u662F\u65E0\u804A\uFF0C\u8FD9\u6837\u7684\u65E5\u5B50\u4F55\u65F6\u624D\u80FD\u7ED3\u675F\u3002"
    - "\u770B\u7740\u522B\u4EBA\u56DB\u5904\u65C5\u884C\uFF0C\u6211\u5374\u53EA\u80FD\u5728\u8FD9\u91CC\uFF0C\u771F\u7FA1\u6155\u554A\u3002"
    - "\u5982\u679C\u4EE5\u540E\u4F60\u8981\u51FA\u53BB\u65C5\u884C\u7684\u8BDD\uFF0C\u5E0C\u671B\u6211\u4EEC\u53EF\u4EE5\u540C\u884C\u3002"
    - "\u6211\u5DF2\u7ECF\u51C6\u5907\u4E86\u5F88\u4E45\u884C\u56CA\uFF0C\u5C31\u662F\u6CA1\u6709\u673A\u4F1A\u51FA\u53D1\u3002"
    - "\u4F60\u662F\u6765\u627E\u6211\u7684\u5417\uFF1F\u4E0D\u77E5\u9053\u80FD\u4E3A\u4F60\u505A\u4E9B\u4EC0\u4E48\uFF1F"
    - "\u6211\u6709\u4E00\u4E2A\u611F\u89C9\uFF0C\u8FD9\u4E2A\u5C0F\u9547\u662F\u6211\u7684\u5F52\u5BBF\u3002"
    - "\u7E41\u534E\u7EC8\u5F52\u4F1A\u892A\u53BB\uFF0C\u56DE\u5F52\u5E73\u6DE1\u624D\u662F\u771F\u6B63\u7684\u4EBA\u751F\u3002"
    - "\u867D\u7136\u6211\u7684\u9B54\u529B\u8FD8\u4E0D\u591F\uFF0C\u4F46\u6211\u4F1A\u52AA\u529B\u7684\uFF0C\u4F60\u6709\u4EC0\u4E48\u9700\u8981\u6211\u7684\uFF1F"
    - "\u7A76\u7ADF\u600E\u6837\u624D\u80FD\u548C\u5E08\u7236\u4E00\u6837\u4F18\u79C0\u5462\uFF1F\u8FD9\u771F\u8BA9\u6211\u56F0\u6270\u3002"
    - "\u6211\u7684\u68A6\u60F3\u662F\u6210\u4E3A\u4E00\u4E2A\u5927\u9B54\u5BFC\u5E08\u3002"
    - "\u662F\u9047\u5230\u4EC0\u4E48\u7591\u96BE\u4E86\u5417\uFF1F"
    - "\u522B\u770B\u6211\u5355\u8EAB\u4E00\u4EBA\uFF0C\u5E74\u8F7B\u65F6\u5019\u7684\u6211\u4E5F\u662F\u5F88\u53D7\u6B22\u8FCE\u7684\u3002"
    - "\u770B\u89C1\u4F60\uFF0C\u5C31\u60F3\u8BA9\u6211\u60F3\u5230\u4E86\u5E74\u8F7B\u65F6\u5019\u7684\u6211\uFF0C\u771F\u6000\u5FF5\u5450\u3002"
    - "\u6211\u4E0D\u4F1A\u62D2\u7EDD\u5BF9\u5F31\u8005\u7684\u601C\u60AF\uFF0C\u6240\u4EE5\u4F60\u6709\u4EC0\u4E48\u4E8B\uFF1F"
    - "\u8FD9\u4E2A\u5C0F\u9547\u867D\u7136\u4E0D\u662F\u5F88\u7E41\u534E\uFF0C\u4F46\u6211\u5374\u5F88\u559C\u6B22\u3002"
    - "\u4F60\u60F3\u6765\u627E\u6211\u5B66\u4E60\u8D35\u65CF\u793C\u4EEA\u5417?"
    - "\u4F60\u613F\u610F\u6765\u627E\u6211\uFF0C\u6211\u5FC3\u91CC\u8FD8\u662F\u6709\u4E00\u70B9\u9AD8\u5174\u7684\u3002"
    - "\u53EF\u4E0D\u8981\u8BEF\u4F1A\uFF0C\u8FD9\u53EA\u662F\u57FA\u672C\u7684\u8D35\u65CF\u793C\u4EEA\u3002"
    - "\u4F60\u60F3\u8981\u4E86\u89E3\u9B54\u6CD5\u7684\u529B\u91CF\u5417\uFF1F"
    - "\u9B54\u6CD5\u7684\u529B\u91CF\u8FDC\u8D85\u4F60\u7684\u60F3\u8C61\uFF0C"
    - "\u55E8\uFF0C\u6709\u5565\u4E8B\uFF1F"
    - "\u8981\u60F3\u83B7\u5F97\u4E30\u539A\u7684\u6E14\u83B7\uFF0C\u5FC5\u987B\u8981\u6253\u7406\u597D\u7F51\u5177\u3002"
    - "\u8FD9\u4E2A\u5C0F\u9547\u9760\u8FD1\u5927\u6D77\uFF0C\u53EF\u4EE5\u65F6\u5E38\u5403\u5230\u4E00\u4E9B\u6D77\u9C9C\u83DC\u80B4\u3002"
    - "\u636E\u8BF4\u5927\u6D77\u7684\u6DF1\u5904\u6709\u7F8E\u4EBA\u9C7C\uFF0C\u4E0D\u77E5\u9053\u662F\u4E0D\u662F\u771F\u7684\u3002"
    - "\u5982\u679C\u4F60\u6709\u65F6\u95F4\u7684\u8BDD\uFF0C\u5B66\u4E60\u4E00\u4E0B\u9493\u9C7C\u5427\uFF0C\u4F60\u4F1A\u5F88\u6709\u6536\u83B7\u3002"
    - "\u4F60\u627E\u6211\u662F\u6709\u4EC0\u4E48\u4E8B\uFF1F"
    - "\u8FD9\u4E2A\u9547\u5B50\u867D\u5C0F\uFF0C\u5374\u62E5\u6709\u5B8C\u5584\u7684\u6D77\u6E2F\uFF0C\u5E38\u6709\u8230\u8239\u822A\u884C\u5F80\u6765\u4E8E\u5404\u5927\u9646\u4E4B\u95F4\u3002"
    - "\u7ECF\u5386\u4E86\u957F\u65F6\u95F4\u7684\u6D77\u4E0A\u6F02\u6CCA\uFF0C\u6211\u9700\u8981\u5728\u5CB8\u4E0A\u597D\u597D\u4F11\u606F\u4E00\u4E0B\u3002"
    - "\u5927\u6D77\u91CC\u6709\u5F88\u591A\u8D22\u5BCC\uFF0C\u4E5F\u6709\u5F88\u591A\u98CE\u9669\u3002"
    - "\u4F60\u5982\u679C\u60F3\u53BB\u6D77\u90A3\u8FB9\uFF0C\u53EF\u4EE5\u4E58\u5750\u6211\u7684\u8239\u3002"
    - "\u627E\u6211\u5417\uFF1F\u6211\u4E5F\u53EF\u4EE5\u4E3A\u4F60\u505A\u4E8B\u5417\uFF1F"
    - "\u4E58\u8239\u51FA\u6D77\u6E38\u904D\u4E16\u754C\u4E00\u76F4\u662F\u6211\u7684\u613F\u671B\u3002"
    - "\u867D\u7136\u6D77\u4E0A\u7684\u751F\u6D3B\u4EE4\u4EBA\u795E\u5F80\uFF0C\u4F46\u5728\u8FD9\u4E2A\u5C0F\u9547\u4E5F\u8FD8\u4E0D\u9519\u3002"
    - "\u5927\u5BB6\u90FD\u5F88\u52AA\u529B\u554A\uFF0C\u6211\u4E5F\u4E0D\u80FD\u61C8\u6020\u3002"
    - "\u5982\u679C\u6211\u4E5F\u6709\u81EA\u5DF1\u7684\u8239\u5C31\u597D\u4E86\u3002"
    - "\u9759\u5F85\u4F60\u7684\u59D4\u6258"
    - "\u522B\u4EBA\u7684\u79D8\u5BC6\uFF0C\u4F55\u5FC5\u8981\u63A2\u7A76\u5230\u5E95\u5462\uFF0C\u53EA\u8981\u4E0D\u5371\u5BB3\u5927\u5BB6\u5C31\u597D\u4E86\u3002"
    - "\u4F60\u597D\uFF0C\u4F60\u60F3\u77E5\u9053\u4EC0\u4E48\u5417\uFF1F"
    - "\u5982\u679C\u56DB\u5B63\u53EF\u4EE5\u540C\u65F6\u5B58\u5728\uFF0C\u4F1A\u53D1\u751F\u4EC0\u4E48\u5462\u2026"
    - "\u9700\u8981\u6211\u7684\u5E2E\u5FD9\u5417\uFF1F"
    - "\u867D\u7136\u6211\u5BF9\u795E\u4F9D\u7136\u5F88\u5D07\u656C\uFF0C\u4F46\u6211\u8FD8\u662F\u60F3\u5E72\u4E9B\u5176\u4ED6\u7684\u4E8B\u60C5\u3002"
    - "\u5728\u6218\u6597\u4E2D\u7948\u6C42\u4E0A\u5E1D\u662F\u6CA1\u6709\u7528\u4E86\uFF0C\u6211\u4EEC\u53EA\u80FD\u4F9D\u9760\u81EA\u5DF1\u3002"
    - "\u4E0D\u77E5\u9053\u4E0A\u5E1D\u80FD\u4E0D\u80FD\u542C\u5230\u6211\u7684\u5FC3\u58F0\uFF0C\u8BA9\u6211\u65E9\u65E5\u5F97\u507F\u6240\u613F\u3002"
    - "\u65E0\u8BBA\u4FE1\u4E0D\u4FE1\u4E0A\u5E1D\uFF0C\u90FD\u8981\u575A\u5B88\u7231\u4E0E\u548C\u5E73\u3002"
    - "\u6211\u53EF\u4EE5\u4E3A\u4F60\u505A\u4E9B\u4EC0\u4E48\uFF1F"
    - "\u5176\u5B9E\u4E00\u4E2A\u4EBA\u5DE1\u903B\u4E5F\u633A\u65E0\u804A\u7684,\u5982\u679C\u6709\u4EBA\u6765\u548C\u6211\u804A\u804A\u7684\u8BDD,\u6211\u4F1A\u5F88\u9AD8\u5174\u3002"
    - "\u5F88\u9AD8\u5174\u80FD\u4E3A\u4F60\u670D\u52A1\u3002"
    - "\u5B88\u62A4\u5C0F\u59D0\u662F\u6211\u7684\u804C\u8D23\u3002"
    - "\u5728\u8FD9\u4E2A\u9547\u5B50\u91CC\uFF0C\u6211\u7ECF\u5E38\u4F1A\u60F3\u8D77\u5173\u4E8E\u8001\u4E3B\u4EBA\u7684\u4E8B\u3002"
    - "\u56DE\u60F3\u8FC7\u53BB\uFF0C\u597D\u50CF\u521A\u521A\u53D1\u751F\u5728\u6628\u5929\uFF0C\u90A3\u65F6\u5C0F\u59D0\u8FD8\u662F\u4E2A\u5B69\u5B50\u2026"
    - "\u5982\u679C\u6709\u66F4\u591A\u7684\u4EBA\u966A\u4F34\u5C0F\u59D0\uFF0C\u5C0F\u59D0\u5E94\u8BE5\u4F1A\u66F4\u5F00\u5FC3\u5427"
    - "\u5982\u679C\u6709\u4EC0\u4E48\u4E8B\u60C5\uFF0C\u6211\u4F1A\u5C3D\u529B\u800C\u4E3A\u3002"
    - "\u4E00\u4E2A\u6599\u7406\u5982\u679C\u7F3A\u5C11\u8C03\u5473\u6599\uFF0C\u5C31\u4F1A\u5BE1\u6DE1\u65E0\u5473\uFF0C\u4E0D\u8981\u5FD8\u8BB0\u8D2D\u4E70\u5440\u3002"
    - "\u597D\u7684\u88C5\u5907\u53EF\u4EE5\u5927\u5927\u4FC3\u8FDB\u52B3\u52A8\u6548\u7387\uFF0C\u6211\u9700\u8981\u505A\u4EC0\u4E48\uFF1F"
    - "\u6211\u4E00\u5B9A\u8981\u628A\u5E03\u62C9\u5FB7\u5229\u57F9\u517B\u6210\u4E00\u4E2A\u4F18\u79C0\u7684\u4EBA,\u8FD9\u5C31\u662F\u6211\u751F\u6D3B\u7684\u610F\u4E49\u3002"
    - "\u5E03\u62C9\u5FB7\u5229\u518D\u957F\u5927\u4E00\u4E9B\u7684\u8BDD\uFF0C\u6211\u4F1A\u8BA9\u4ED6\u81EA\u5DF1\u9009\u62E9\u81EA\u5DF1\u7684\u9053\u8DEF\u3002"
    - "\u4F60\u597D\uFF0C\u9700\u8981\u4EC0\u4E48\u670D\u52A1\u5417\uFF1F"
    - "\u59D0\u59D0\u5E94\u8BE5\u6709\u66F4\u5E7F\u9614\u7684\u524D\u666F\u7684\uFF0C\u73B0\u5728\u5374\u88AB\u56F0\u4F4F\u8FD9\u4E2A\u5C0F\u9547\u2026"
    - "\u5982\u679C\u6211\u80FD\u66F4\u5F3A\u5927\u4E00\u4E9B\u7684\u8BDD\uFF0C\u59D0\u59D0\u5C31\u53EF\u4EE5\u53BB\u8FFD\u6C42\u81EA\u5DF1\u7684\u68A6\u60F3\u4E86\u3002"
    - "\u4F60\u53EF\u4EE5\u5E2E\u52A9\u6211\uFF0C\u9F13\u52B1\u6211\u4E00\u76F4\u575A\u5F3A\u5417\uFF1F"
    - "\u5982\u679C\u4F60\u613F\u610F\u7684\u8BDD\uFF0C\u53EF\u4EE5\u968F\u65F6\u6765\u627E\u6211\u548C\u6211\u7684\u59D0\u59D0\u3002"
    - "\u6709\u4EC0\u4E48\u641E\u4E0D\u5B9A\u7684\u4E8B\u60C5\uFF1F"
    - "\u6CE8\u610F,\u4E0D\u8981\u8D70\u5F97\u592A\u8FDC,\u5916\u9762\u53EF\u662F\u6709\u5F88\u591A\u602A\u7269\u3002"
    - "\u542C\u8BF4\u4F60\u5728\u5F81\u8BA8\u5C0F\u9547\u5468\u8FB9\u7684\u602A\u7269\uFF0C\u505A\u7684\u4E0D\u9519\u3002"
    - "\u62DB\u5F85\u4E0D\u5468\u4E86\uFF0C\u6709\u4EC0\u4E48\u4E8B\u60C5\u5417\uFF1F"
    - "\u6709\u59B9\u59B9\u548C\u5988\u5988\u966A\u7740\u6211\uFF0C\u6211\u89C9\u5F97\u5F88\u5E78\u798F\u3002"
    - "\u5982\u679C\u7238\u7238\u8FD8\u5728\u7684\u8BDD\u2026"
    - "\u6211\u8981\u52AA\u529B\u652F\u6491\u6211\u7684\u5BB6\uFF0C\u53EF\u4EE5\u4E3A\u6211\u52A0\u6CB9\u5417\uFF1F"
    - "\u53EF\u6709\u4EC0\u4E48\u4E8B\u60C5\u9700\u8981\u6211\u4E3A\u4F60\u800C\u505A\u7684\uFF1F"
    - "\u7EBA\u7EC7\u53EF\u662F\u5316\u8150\u673D\u4E3A\u795E\u5947\u7684\u6280\u672F\u3002"
    - "\u5982\u679C\u4F60\u60F3\u5B66\u4E60\u7EBA\u7EC7\u6280\u672F\u7684\u8BDD\uFF0C\u6211\u53EF\u4EE5\u6559\u4F60\u3002"
    - "\u6211\u6709\u65F6\u4E5F\u4F1A\u4E3A\u7F3A\u5C11\u4F20\u627F\u800C\u70E6\u607C\u5462\u3002"
    - "\u76F8\u6BD4\u80FD\u8D5A\u5230\u94B1\uFF0C\u6211\u66F4\u5E0C\u671B\u6709\u4EBA\u53EF\u4EE5\u5C06\u6211\u7684\u6280\u672F\u4F20\u627F\u4E0B\u53BB\u3002"
    - "\u6211\u62E5\u6709\u7684\u6BD4\u4F60\u77E5\u9053\u7684\u8FD8\u591A\uFF0C\u4F60\u6709\u4EC0\u4E48\u9700\u8981\u7684\u5417\uFF1F"
    - "\u56FA\u5B88\u6210\u89C1\u662F\u4E0D\u884C\u7684\uFF0C\u53EA\u6709\u53D8\u9769\u624D\u80FD\u5E26\u6765\u65B0\u7684\u673A\u9047\u3002"
    - "\u653E\u5FC3\u5427\uFF0C\u4F60\u7684\u5916\u516C\u53EA\u662F\u53BB\u4E86\u4ED6\u60F3\u53BB\u7684\u5730\u65B9\u3002"
    - "\u597D\u597D\u5728\u8FD9\u91CC\u751F\u6D3B\u5427\uFF0C\u4F60\u7684\u5916\u516C\u4E5F\u4F1A\u5F88\u6B23\u6170\u7684\u3002"
    - "\u6CA1\u6709\u4E70\u5230\u60F3\u8981\u7684\u4E1C\u897F\uFF0C\u6211\u6709\u70B9\u4E0D\u5F00\u5FC3\u3002"
    - "\u4F60\u7684\u961F\u4F0D\u5DF2\u7ECF\u6EE1\u5458\u4E86\uFF0C\u8FD8\u662F\u4E0B\u6B21\u518D\u8BF4\u5427\u3002"
    - "\u6211\u7684\u8EAB\u4F53\u8FD8\u6CA1\u6709\u6062\u590D\uFF0C\u6539\u5929\u5427\u3002"
    - "\u6211\u5148\u56DE\u5BB6\u4FEE\u517B\u8EAB\u4F53\u4E86\uFF0C\u4F60\u81EA\u5DF1\u4FDD\u91CD\u3002"
    - "\u9020\u7269\u4E3B\u8FD8\u6CA1\u6765\u5F97\u53CA\u521B\u9020\u8FD9\u79CD\u611F\u60C5\uFF0C\u8BF7\u8010\u5FC3\u7B49\u5F85\u5427\u3002"
    - "\u62B1\u6B49\uFF0C\u6211\u4EEC\u7684\u5173\u7CFB\u8FD8\u6CA1\u4EB2\u5BC6\u5230\u73B0\u5728\u4E00\u8D77\u7EC4\u961F\u7684\u7A0B\u5EA6\u3002"
    - "\u73B0\u5728\u8FD8\u4E0D\u884C\u54E6\uFF0C\u60F3\u548C\u6211\u4E00\u8D77\u7EC4\u961F\uFF0C\u4F60\u8FD8\u5F97\u52A0\u500D\u52AA\u529B\u5440\u3002"
    - "\u6211\u8FD8\u6709\u4E8B\u60C5\u8981\u505A\uFF0C\u4E0D\u80FD\u548C\u4F60\u7EC4\u961F\u3002"
    - "\u5982\u679C\u6211\u4EEC\u66F4\u4EB2\u5BC6\u4E00\u4E9B\u7684\u8BDD\uFF0C\u6211\u4F1A\u540C\u610F\u7684\u3002"
    - "\u5BF9\u4E0D\u8D77\uFF0C\u6211\u73B0\u5728\u4E0D\u80FD\u548C\u4F60\u4E00\u8D77\u5916\u51FA\u3002"
    - "\u6211\u8FD8\u9700\u8981\u78E8\u7EC3\u610F\u5FD7\uFF0C\u5982\u679C\u4F60\u80FD\u611F\u5316\u6211\u7684\u8BDD\u4E5F\u8BB8\u53EF\u884C\u3002"
    - "\u6211\u73B0\u5728\u8FD8\u4E0D\u80FD\u5B8C\u5168\u4FE1\u4EFB\u4F60\u3002"
    - "\u4F60\u53EF\u4EE5\u8BA9\u6211\u5B89\u5FC3\u5C06\u540E\u80CC\u7ED9\u4F60\u5417\uFF1F\u505A\u4E0D\u5230\u5427\u3002"
    - "\u4F5C\u4E3A\u4E00\u4E2A\u597D\u8239\u957F\uFF0C\u5FC5\u987B\u61C2\u5F97\u6311\u9009\u81EA\u5DF1\u7684\u56E2\u961F\uFF0C\u4F60\u73B0\u5728\u8FD8\u4E0D\u884C\u3002"
    - "\u5BF9\u4E0D\u8D77\uFF0C\u6211\u4E0D\u662F\u5F88\u4E60\u60EF\u548C\u4E0D\u719F\u6089\u7684\u4EBA\u4E00\u8D77\u884C\u52A8\u3002"
    - "\u62B1\u6B49\u4E86\uFF0C\u6211\u7684\u65F6\u95F4\u5F88\u5B9D\u8D35\uFF0C\u4F60\u5F97\u5148\u53D6\u5F97\u6211\u7684\u4FE1\u4EFB\u624D\u884C\u3002"
    - "\u6211\u9700\u8981\u7167\u987E\u5927\u5C0F\u59D0\uFF0C\u9664\u975E\u6211\u4EEC\u66F4\u52A0\u4EB2\u5BC6\u3002"
