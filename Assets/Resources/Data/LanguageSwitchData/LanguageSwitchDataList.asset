      da: Rapea ja raikas
    - cn: "\u751C\u83DC\u6839\u8D4B\u4E88\u72EC\u7279\u989C\u8272\u4E0E\u98CE\u5473\uFF0C\u9178\u751C\u5F00\u80C3\u3002"
