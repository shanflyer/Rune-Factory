      id: Rasa asam menyegarkan
    - cn: "\u6D41\u6DCC\u7740\u81EA\u7136\u751C\u9999\uFF0C\u751C\u871C\u6ECB\u5473\u4EE4\u4EBA\u5FC3\u9189\u3002"
