        \u06AF\u0627\u0691\u06BE\u0627 \u06A9\u06CC\u06A9\u0691\u0627 \u0630\u0627\u0626\u0642\u06C1
        \u0627\u0648\u0631 \u06AF\u0627\u0691\u06BE\u0627 \u0634\u0648\u0631\u0628\u06C1\u06D4"
      ms: Dipadankan pelbagai bahan untuk rebusan, rasa ketam pekat dan kuah pekat.
      id: Dipadukan dengan berbagai bahan untuk rebusan, rasa kepiting pekat dan
        kaldu kental.
    - cn: "\u8089\u8D28\u7D27\u5B9E\uFF0C\u8102\u80AA\u7EB9\u7406\u6E05\u6670\uFF0C\u9876\u7EA7\u7684\u523A\u8EAB\u4EAB\u53D7\u3002"
      en: Firm texture with clear marbling, a top-notch sashimi experience.
      tw: "\u8089\u8CEA\u7DCA\u5BE6\uFF0C\u8102\u80AA\u7D0B\u7406\u6E05\u6670\uFF0C\u9802\u7D1A\u7684\u523A\u8EAB\u4EAB\u53D7"
      ja: "\u971C\u964D\u308A\u304C\u7F8E\u3057\u3044\u6700\u9AD8\u7D1A\u306E\u523A\u8EAB"
      ko: "\uC0B4\uCF54\uAE30\uAC00 \uB2E8\uB2E8\uD558\uACE0 \uC9C0\uBC29 \uACB0\uC774
        \uC120\uBA85\uD55C \uCD5C\uC0C1\uAE09 \uC0AC\uC2DC\uBBF8"
      fr: "Sashimi sup\xE9rieur avec marbrure"
      de: Erstklassiges marmoriertes Sashimi
      ru: "\u041C\u0440\u0430\u043C\u043E\u0440\u043D\u043E\u0435 \u0441\u0430\u0448\u0438\u043C\u0438
        \u0432\u044B\u0441\u0448\u0435\u0433\u043E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430"
      es: Sashimi de primera con vetas
      pt: Sashimi de primeira com marmoreio
      it: Sashimi di prima scelta con marezzatura
      tr: "Damarl\u0131 \xFCst\xFCn sashimi deneyimi"
      vi: "Sashimi th\u01B0\u1EE3ng h\u1EA1ng v\xE2n m\u1EE1 r\xF5"
      th: "\u0E0B\u0E32\u0E0A\u0E34\u0E21\u0E34\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E0A\u0E31\u0E49\u0E19\u0E22\u0E2D\u0E14"
      pl: "Najwy\u017Cszej jako\u015Bci marmurkowe sashimi"
      nl: Topkwaliteit gemarmerd sashimi
      el: "\u0386\u03C1\u03B9\u03C3\u03C4\u03B7\u03C2 \u03C0\u03BF\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
        \u03C3\u03B1\u03C3\u03AF\u03BC\u03B9 \u03BC\u03B5 \u03BC\u03B1\u03C1\u03BC\u03AC\u03C1\u03C9\u03C3\u03B7"
      ar: "\u0633\u0627\u0634\u064A\u0645\u064A \u0628\u0631\u064A\u0627\u0646\u064A
        \u0645\u0639 \u062A\u0648\u0632\u064A\u0639 \u062F\u0647\u0646\u064A"
      hi: "\u0926\u0943\u0922\u093C \u092C\u0928\u093E\u0935\u091F \u0914\u0930 \u0938\u094D\u092A\u0937\u094D\u091F
        \u092E\u093E\u0930\u094D\u092C\u0932\u093F\u0902\u0917, \u0909\u091A\u094D\u091A
        \u0915\u094B\u091F\u093F \u0915\u093E \u0938\u093E\u0936\u093F\u092E\u0940
        \u0905\u0928\u0941\u092D\u0935"
      ur: "\u0645\u0636\u0628\u0648\u0637 \u0633\u0627\u062E\u062A \u0627\u0648\u0631
        \u0648\u0627\u0636\u062D \u0633\u0646\u06AF \u0645\u0631\u0645\u0631\u060C
        \u0627\u0639\u0644\u06CC\u0670 \u0645\u0639\u06CC\u0627\u0631 \u06A9\u0627
        \u0633\u0634\u06CC\u0645\u06CC \u062A\u062C\u0631\u0628\u06C1\u06D4"
      ms: Tekstur padat dengan marbling jelas, pengalaman sashimi terbaik.
      id: Tekstur padat dengan marmer jelas, pengalaman sashimi kelas atas.
    - cn: "\u5962\u534E\u7EC4\u5408\uFF0C\u53E3\u611F\u4E30\u5BCC\uFF0C\u6781\u81F4\u7F8E\u5473\u3002"
      en: A luxurious mix of rich flavors for an ultimate delicacy.
      tw: "\u5962\u83EF\u7D44\u5408\uFF0C\u53E3\u611F\u8C50\u5BCC\uFF0C\u6975\u81F4\u7F8E\u5473"
      ja: "\u6975\u4E0A\u306E\u7D44\u307F\u5408\u308F\u305B\u3067\u5473\u308F\u3044\u5C3D\u304F\u3059"
      ko: "\uACE0\uAE09\uC2A4\uB7EC\uC6B4 \uC870\uD569\uACFC \uD48D\uBD80\uD55C \uB9DB\uC758
        \uADF9\uCE58"
      fr: "M\xE9lange luxueux aux saveurs complexes"
      de: "\xDCppige Geschmackskombination"
      ru: "\u0420\u043E\u0441\u043A\u043E\u0448\u043D\u043E\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435
        \u0432\u043A\u0443\u0441\u043E\u0432"
      es: "Combinaci\xF3n lujosa de sabores"
      pt: "Combina\xE7\xE3o luxuosa de sabores"
      it: Miscela lussuosa di sapori
      tr: "L\xFCks lezzet kombinasyonu"
      vi: "S\u1EF1 k\u1EBFt h\u1EE3p xa x\u1EC9, h\u01B0\u01A1ng v\u1ECB phong ph\xFA"
      th: "\u0E23\u0E27\u0E21\u0E04\u0E27\u0E32\u0E21\u0E1F\u0E38\u0E48\u0E21\u0E40\u0E1F\u0E37\u0E2D\u0E22\u0E02\u0E2D\u0E07\u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E34"
      pl: "Luksusowa mieszanka smak\xF3w"
      nl: Luxe smaakcombinatie
      el: "\u03A0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03C2 \u03C3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CC\u03C2
        \u03B3\u03B5\u03CD\u03C3\u03B5\u03C9\u03BD"
      ar: "\u0645\u0632\u064A\u062C \u0641\u0627\u062E\u0631 \u0645\u0646 \u0627\u0644\u0646\u0643\u0647\u0627\u062A"
      hi: "\u0938\u092E\u0943\u0926\u094D\u0927 \u0938\u094D\u0935\u093E\u0926\u094B\u0902
        \u0915\u093E \u0935\u093F\u0932\u093E\u0938\u0940 \u092E\u093F\u0936\u094D\u0930\u0923,
        \u0905\u0902\u0924\u093F\u092E \u0935\u094D\u092F\u0902\u091C\u0928"
      ur: "\u06AF\u0627\u0691\u06BE\u06D2 \u0630\u0627\u0626\u0642\u0648\u06BA \u06A9\u0627
        \u0634\u0627\u0646\u062F\u0627\u0631 \u0645\u0631\u06A9\u0628\u060C \u0622\u062E\u0631\u06CC
        \u067E\u06A9\u0648\u0627\u0646\u06D4"
      ms: Campuran mewah rasa kaya, hidangan istimewa terhebat.
      id: Kombinasi mewah dengan rasa kaya, hidangan istimewa.
    - cn: "\u5473\u9053\u5FAE\u82E6\u56DE\u7518\uFF0C\u6E05\u70ED\u53BB\u706B\uFF0C\u662F\u4F20\u7EDF\u7684\u5065\u5EB7\u996E\u54C1\u3002"
      en: Slight bitterness with a sweet aftertaste, a traditional healthy drink.
      tw: "\u5473\u9053\u5FAE\u82E6\u56DE\u7518\uFF0C\u6E05\u71B1\u53BB\u706B\uFF0C\u662F\u50B3\u7D71\u7684\u5065\u5EB7\u98F2\u54C1"
      ja: "\u307B\u308D\u82E6\u304F\u5F8C\u5473\u723D\u3084\u304B\u306A\u4F1D\u7D71\u7684\u5065\u5EB7\u98F2\u6599"
      ko: "\uC57D\uAC04\uC758 \uC4F4\uB9DB\uACFC \uB2EC\uCF64\uD55C \uB4B7\uB9DB\uC758
        \uC804\uD1B5 \uAC74\uAC15 \uC74C\uB8CC"
      fr: Boisson traditionnelle apaisante
      de: "Bitter-s\xFC\xDFes Traditionsgetr\xE4nk"
      ru: "\u0422\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0439
        \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0441 \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u043C
        \u043F\u043E\u0441\u043B\u0435\u0432\u043A\u0443\u0441\u0438\u0435\u043C"
      es: Bebida tradicional amarga-dulce
      pt: Bebida tradicional amargo-doce
      it: Bevanda tradizionale amaro-dolce
      tr: "Hafif ac\u0131l\u0131 geleneksel i\xE7ecek"
      vi: "V\u1ECB \u0111\u1EAFng nh\u1EB9 h\u1EADu ng\u1ECDt, gi\u1EA3i nhi\u1EC7t"
      th: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E14\u0E37\u0E48\u0E21\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E23\u0E2A\u0E02\u0E21\u0E2B\u0E27\u0E32\u0E19"
      pl: "Tradycyjny gorzko-s\u0142odki nap\xF3j"
      nl: Traditionele bitterzoete drank
      el: "\u03A0\u03B1\u03C1\u03B1\u03B4\u03BF\u03C3\u03B9\u03B1\u03BA\u03CC \u03C0\u03B9\u03BA\u03C1\u03CC\u03B3\u03BB\u03C5\u03BA\u03BF
        \u03C0\u03BF\u03C4\u03CC"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u062A\u0642\u0644\u064A\u062F\u064A \u0645\u0631\u064A\u0631
        \u0648\u062D\u0644\u0648"
      hi: "\u0939\u0932\u094D\u0915\u0940 \u0915\u0921\u093C\u0935\u093E\u0939\u091F
        \u0914\u0930 \u092E\u0940\u0920\u093E \u0905\u092B\u094D\u091F\u0930\u091F\u0947\u0938\u094D\u091F,
        \u092A\u093E\u0930\u0902\u092A\u0930\u093F\u0915 \u0938\u094D\u0935\u093E\u0938\u094D\u0925\u094D\u092F\u0935\u0930\u094D\u0927\u0915
        \u092A\u0947\u092F"
      ur: "\u06C1\u0644\u06A9\u06CC \u06A9\u0691\u0648\u0627\u06C1\u0679 \u0627\u0648\u0631
        \u0645\u06CC\u0679\u06BE\u0627 \u0627\u0641\u0679\u0631 \u0679\u06CC\u0633\u0679\u060C
        \u0631\u0648\u0627\u06CC\u062A\u06CC \u0635\u062D\u062A \u0628\u062E\u0634
        \u0645\u0634\u0631\u0648\u0628\u06D4"
      ms: Sedikit pahit dengan aftertaste manis, minuman sihat tradisional.
      id: Sedikit pahit dengan aftertaste manis, minuman sehat tradisional.
    - cn: "\u666E\u901A\u7684\u79BD\u7C7B\uFF0C\u53EF\u4EE5\u4EA7\u51FA[\u9E21\u86CB]"
      en: 'Common poultry that can produce [Eggs]'
      tw: "\u666E\u901A\u79BD\u985E\uFF0C\u53EF\u4EE5\u7522\u51FA[\u96DE\u86CB]"
      ja: "\u4E00\u822C\u7684\u306A\u5BB6\u79BD\u304C[\u5375]\u3092\u7523\u3080"
      ko: "\uC77C\uBC18 \uAC00\uAE08\uB958\uAC00 [\uB2EC\uAC40]\uC744 \uC0DD\uC0B0"
      fr: "Volaille commune pondant des [\u0153ufs]"
      de: "Normales Gefl\xFCgel legt [Eier]"
      ru: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u0442\u0438\u0446\u0430,
