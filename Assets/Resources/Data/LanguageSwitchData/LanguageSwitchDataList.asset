      tr: "K\xFC\xE7\xFCk bal\u0131k b\xFCy\xFCk lezzet"
      vi: "C\xE1 nh\u1ECF n\u01B0\u1EDBng mu\u1ED1i th\u01A1m ngon"
      th: "\u0E1B\u0E25\u0E32\u0E40\u0E25\u0E47\u0E01\u0E17\u0E2D\u0E14\u0E40\u0E01\u0E25\u0E37\u0E2D\u0E23\u0E2A\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19"
