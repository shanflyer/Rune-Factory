      id: Bijih kaya zat besi
      he: "\u05E2\u05E4\u05E8\u05D4 \u05E2\u05E9\u05D9\u05E8\u05D4 \u05D1\u05D1\u05E8\u05D6\u05DC"
      sv: "J\xE4rnrik malm"
      cs: "\u017Delezn\xE1 ruda bohat\xE1 na \u017Eelezo"
      uk: "\u0417\u0430\u043B\u0456\u0437\u043D\u0430 \u0440\u0443\u0434\u0430, \u0431\u0430\u0433\u0430\u0442\u0430
        \u043D\u0430 \u0437\u0430\u043B\u0456\u0437\u043E"
      ro: "Minereu bogat \xEEn fier"
      no: Jernrik malm
      hu: "Vas\xE9rc"
      sw: Chuma cha madini
      sr: Gvozdena ruda
      fi: Rautapitoinen malmi
      da: Jernrig malm
    - cn: "\u5BCC\u542B\u98DF\u76D0\u7684\u7ED3\u6676\u4F53"
      en: Salt-laden crystals
      tw: "\u5BCC\u542B\u98DF\u9E7D\u7684\u7D50\u6676\u9AD4"
