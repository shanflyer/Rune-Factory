        \u06AF\u06CC"
      ms: 3 hadiah pertama setiap hari boleh tingkatkan kasih sayang
      id: 3 hadiah pertama setiap hari bisa tingkatkan afeksi
      he: "3 \u05D4\u05DE\u05EA\u05E0\u05D5\u05EA \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D5\u05EA
        \u05D1\u05DB\u05DC \u05D9\u05D5\u05DD \u05D9\u05DB\u05D5\u05DC\u05D5\u05EA
        \u05DC\u05D4\u05E2\u05DC\u05D5\u05EA \u05D0\u05EA \u05E8\u05DE\u05EA \u05D4\u05D7\u05D9\u05D1\u05D4"
