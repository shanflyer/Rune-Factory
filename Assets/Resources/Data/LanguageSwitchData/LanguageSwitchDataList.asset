        \u0915\u0940 \u091C\u0940\u0935\u0902\u0924\u0924\u093E \u0914\u0930 \u092A\u094D\u0930\u093E\u0915\u0943\u0924\u093F\u0915
        \u0924\u093E\u091C\u0917\u0940 \u0915\u0940 \u0924\u0930\u0939"
      ur: "\u0627\u0646\u0648\u06A9\u06BE\u0627 \u0630\u0627\u0626\u0642\u06C1\u060C
