    - cn: "\u4E3A\u6E38\u620F\u505A\u51FA\u8D21\u732E\u7684\u5C0F\u4F19\u4F34\u4EEC\uFF1A"
      en: 'To all contributors who helped shape this game:'
      tw: "\u70BA\u904A\u6232\u505A\u51FA\u8CA2\u737B\u7684\u5C0F\u5925\u4F34\u5011\uFF1A"
      ja: "\u3053\u306E\u30B2\u30FC\u30E0\u306B\u8CA2\u732E\u3057\u305F\u4EF2\u9593\u305F\u3061\uFF1A"
      ko: "\uC774 \uAC8C\uC784\uC5D0 \uAE30\uC5EC\uD55C \uBD84\uB4E4:"
      fr: "\xC0 tous ceux qui ont contribu\xE9 au jeu :"
      de: 'An alle Mitwirkenden dieses Spiels:'
      ru: "\u0412\u0441\u0435\u043C, \u043A\u0442\u043E \u043F\u043E\u043C\u043E\u0433
        \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u044D\u0442\u0443 \u0438\u0433\u0440\u0443:"
      es: 'A todos los contribuyentes del juego:'
      pt: "A todos que contribu\xEDram para o jogo:"
      it: 'A tutti i collaboratori del gioco:'
      tr: "Oyuna katk\u0131da bulunan herkese:"
      vi: "G\u1EEDi \u0111\u1EBFn nh\u1EEFng ng\u01B0\u1EDDi \u0111\xE3 \u0111\xF3ng
        g\xF3p cho tr\xF2 ch\u01A1i:"
      th: "\u0E1C\u0E39\u0E49\u0E21\u0E35\u0E2A\u0E48\u0E27\u0E19\u0E23\u0E48\u0E27\u0E21\u0E43\u0E19\u0E40\u0E01\u0E21:"
      pl: "Do wszystkich wsp\xF3\u0142tw\xF3rc\xF3w gry:"
      nl: 'Aan alle bijdragers van dit spel:'
      el: "\u03A3\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03AD\u03B2\u03B1\u03BB\u03B1\u03BD
        \u03C3\u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9:"
      ar: "\u0625\u0644\u0649 \u0643\u0644 \u0645\u0646 \u0633\u0627\u0647\u0645
        \u0641\u064A \u0635\u0646\u0639 \u0627\u0644\u0644\u0639\u0628\u0629:"
      hi: "\u0907\u0938 \u0917\u0947\u092E \u092E\u0947\u0902 \u092F\u094B\u0917\u0926\u093E\u0928
        \u0926\u0947\u0928\u0947 \u0935\u093E\u0932\u094B\u0902 \u0915\u094B:"
      ur: "\u0627\u0633 \u06AF\u06CC\u0645 \u0645\u06CC\u06BA \u062D\u0635\u06C1
        \u0688\u0627\u0644\u0646\u06D2 \u0648\u0627\u0644\u0648\u06BA \u06A9\u0648:"
      ms: 'Kepada semua penyumbang yang membantu membentuk permainan ini:'
      id: 'Untuk semua kontributor yang membantu membentuk game ini:'
