      el: "\u039F\u03B9\u03BA\u03CC\u03C3\u03B7\u03BC\u03BF \u03C0\u03B1\u03C1\u03B1\u03BA\u03BC\u03B9\u03B1\u03BA\u03AE\u03C2
        \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B1\u03C2"
