    - cn: "\u4EBA\u5FC3\u603B\u662F\u4E11\u964B\u7684\u2026"
      en: "The human heart is always ugly\u2026"
      tw: "\u4EBA\u5FC3\u7E3D\u662F\u919C\u964B\u7684\u2026"
      ja: "\u4EBA\u306E\u5FC3\u306F\u919C\u3044\u2026"
      ko: "\uC778\uAC04\uC758 \uB9C8\uC74C\uC740 \uCD94\uC545\uD574\u2026"
