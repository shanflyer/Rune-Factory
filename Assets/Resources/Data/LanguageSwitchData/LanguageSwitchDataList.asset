      tw: "\u9BAD\u9B5A\u80A5\u5AE9\u7D93\u9E7D\u70E4\u6FC0\u767C\uFF0C\u9E79\u9999\u8207\u9BAE\u5AE9\u878D\u5408\uFF0C\u56DE\u5473\u7121\u7AAE"
      ja: "\u5869\u713C\u304D\u30B5\u30FC\u30E2\u30F3\u306E\u8102\u306E\u4E57\u308A\u3068\u65B0\u9BAE\u3055\u304C\u5F8C\u3092\u5F15\u304F"
      ko: "\uC18C\uAE08\uAD6C\uC774 \uC5F0\uC5B4\uC758 \uAE30\uB984\uAE30\uC640 \uC2E0\uC120\uD568\uC774
        \uC870\uD654\uB41C \uC5EC\uC6B4"
      fr: "Saumon gras grill\xE9 au sel"
      de: Lachs mit Salz gebraten
