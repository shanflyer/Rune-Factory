      es: Carne de cangrejo pura
      pt: Carne de caranguejo pura
      it: Polpa di granchio pura
      tr: "Taze beyaz yenge\xE7 eti"
      vi: "Th\u1ECBt cua t\u01B0\u01A1i tr\u1EAFng ng\u1EA7n"
      th: "\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E1B\u0E39\u0E02\u0E32\u0E27\u0E2A\u0E30\u0E2D\u0E32\u0E14"
      pl: "Czyste mi\u0119so kraba"
      nl: Pure krabsmaak
      el: "\u039A\u03B1\u03B8\u03B1\u03C1\u03CC \u03BA\u03C1\u03AD\u03B1\u03C2 \u03BA\u03B1\u03B2\u03BF\u03C5\u03C1\u03B9\u03BF\u03CD"
      ar: "\u0644\u062D\u0645 \u0643\u0627\u0628\u0648\u0631\u064A\u0627 \u0646\u0642\u064A"
      hi: "\u0915\u094B\u092E\u0932\u0924\u093E \u0938\u0947 \u0924\u094B\u0921\u093C\u0928\u0947
        \u092A\u0930 \u0936\u0941\u0926\u094D\u0927 \u0915\u0947\u0915\u0921\u093C\u0947
        \u0915\u093E \u092E\u093E\u0902\u0938 \u092A\u094D\u0930\u0915\u091F \u0939\u094B\u0924\u093E
        \u0939\u0948, \u0924\u093E\u091C\u093C\u093E \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F"
      ur: "\u0646\u0631\u0645\u06CC \u0633\u06D2 \u062A\u0648\u0691\u0646\u06D2 \u067E\u0631
