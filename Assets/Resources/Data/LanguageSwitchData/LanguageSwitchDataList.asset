      vi: "H\u01B0\u01A1ng v\u1ECB \u0111\u1ED9c \u0111\xE1o nh\u01B0 ong r\u1EEBng"
      th: "\u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E34\u0E1E\u0E34\u0E40\u0E28\u0E29\u0E14\u0E38\u0E08\u0E1C\u0E36\u0E49\u0E07\u0E1B\u0E48\u0E32"
