      vi: "V\u1ECB \u0111\u1EAFng thu\u1EA7n khi\u1EBFt gi\xFAp t\u1EC9nh t\xE1o"
      th: "\u0E01\u0E32\u0E41\u0E1F\u0E02\u0E21\u0E40\u0E02\u0E49\u0E21\u0E02\u0E49\u0E19\u0E0A\u0E48\u0E27\u0E22\u0E01\u0E23\u0E30\u0E15\u0E38\u0E49\u0E19"
      pl: "Gorzka kawa pobudzaj\u0105ca"
      nl: Pure bittere opkikker
      el: "\u03A0\u03B9\u03BA\u03C1\u03CC\u03C2 \u03BA\u03B1\u03C6\u03AD\u03C2 \u03B3\u03B9\u03B1
        \u03BE\u03CD\u03C0\u03BD\u03B7\u03BC\u03B1"
