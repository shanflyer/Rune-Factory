      pt: "Do\xE7ura fresca e jovial"
      it: Dolcezza fresca e femminile
      tr: "Tatl\u0131 ve ferah k\u0131z aromas\u0131"
      vi: "V\u1ECB ng\u1ECDt ng\xE0o t\u01B0\u01A1i m\xE1t \u0111\u1EA7y n\u1EEF
        t\xEDnh"
      th: "\u0E2B\u0E27\u0E32\u0E19\u0E2B\u0E2D\u0E21\u0E2A\u0E14\u0E0A\u0E37\u0E48\u0E19\u0E41\u0E1A\u0E1A\u0E2A\u0E32\u0E27\u0E46"
      pl: "S\u0142odki deser o \u015Bwie\u017Cym smaku"
      nl: Zoete frisse meidendrank
      el: "\u0393\u03BB\u03C5\u03BA\u03CC \u03BA\u03B1\u03B9 \u03C6\u03C1\u03B5\u03C3\u03BA\u03BF\u03AC\u03C1\u03C9\u03BC\u03BF"
      ar: "\u062D\u0644\u0627\u0648\u0629 \u0639\u0637\u0631\u064A\u0629 \u0645\u0644\u064A\u0626\u0629
        \u0628\u0627\u0644\u0623\u0646\u0648\u062B\u0629"
      hi: "\u092E\u0940\u0920\u093E \u0914\u0930 \u0938\u0941\u0917\u0902\u0927\u093F\u0924,
        \u0924\u093E\u091C\u093C\u093E \u0914\u0930 \u0939\u0932\u094D\u0915\u093E,
        \u090F\u0915 \u092E\u093E\u0938\u0942\u092E \u092E\u093F\u0920\u093E\u0938"
      ur: "\u0645\u06CC\u0679\u06BE\u0627 \u0627\u0648\u0631 \u062E\u0648\u0634\u0628\u0648
        \u062F\u0627\u0631\u060C \u062A\u0627\u0632\u06C1 \u0627\u0648\u0631 \u06C1\u0644\u06A9\u0627\u060C
        \u0645\u0639\u0635\u0648\u0645 \u0645\u06CC\u0679\u06BE\u0627\u0633 \u0633\u06D2
        \u0628\u06BE\u0631\u067E\u0648\u0631\u06D4"
      ms: Manis dan wangi, segar dan ringan, penuh kemanisan girlish.
      id: Manis dan harum, segar dan ringan, penuh rasa manis girlish.
      he: "\u05DE\u05EA\u05D5\u05E7 \u05D5\u05E8\u05E2\u05E0\u05DF, \u05D8\u05E2\u05DD
        \u05DE\u05DC\u05D0 \u05DE\u05EA\u05D9\u05E7\u05D5\u05EA"
