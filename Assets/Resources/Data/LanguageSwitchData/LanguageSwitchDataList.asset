      sv: Obearbetat virke
      cs: "Neopracovan\xE9 d\u0159evo"
      uk: "\u041D\u0435\u043E\u0431\u0440\u043E\u0431\u043B\u0435\u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u0438\u043D\u0430"
      ro: Lemn brut neprelucrat
