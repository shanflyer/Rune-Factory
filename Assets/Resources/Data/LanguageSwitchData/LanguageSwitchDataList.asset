      vi: "Sashimi t\u01B0\u01A1i m\u1EC1m tan trong mi\u1EC7ng"
      th: "\u0E0B\u0E32\u0E0A\u0E34\u0E21\u0E34\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E19\u0E38\u0E48\u0E21\u0E25\u0E30\u0E25\u0E32\u0E22\u0E43\u0E19\u0E1B\u0E32\u0E01"
      pl: Klasyczne delikatne sashimi
      nl: Klassieke zachte sashimi
      el: "\u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03CC \u03C4\u03C1\u03C5\u03C6\u03B5\u03C1\u03CC
        \u03C3\u03B1\u03C3\u03AF\u03BC\u03B9"
      ar: "\u0633\u0627\u0634\u064A\u0645\u064A \u0637\u0631\u064A \u064A\u0630\u0648\u0628
