      ja: "\u304D\u3089\u3081\u304F\u9B5A\u4F53\u306F\u5869\u713C\u304D\u3067\u8EAB\u304C\u7DE0\u307E\u308A\u78EF\u306E\u9999\u308A"
      ko: "\uBC18\uC9DD\uC774\uB294 \uC0DD\uC120\uC744 \uC18C\uAE08\uAD6C\uC774\uD574
