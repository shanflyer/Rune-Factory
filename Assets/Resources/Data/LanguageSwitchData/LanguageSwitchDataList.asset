    - cn: "\u666E\u901A\u7684\u517D\u7C7B\uFF0C\u53EF\u4EE5\u4EA7\u51FA[\u9E21\u86CB]"
      en: 'Common beasts that can produce [Eggs]'
      tw: "\u666E\u901A\u7378\u985E\uFF0C\u53EF\u4EE5\u7522\u51FA[\u96DE\u86CB]"
      ja: "\u4E00\u822C\u7684\u306A\u52D5\u7269\u304C[\u5375]\u3092\u7523\u3080"
      ko: "\uC77C\uBC18 \uB3D9\uBB3C\uC774 [\uB2EC\uAC40]\uC744 \uC0DD\uC0B0"
      fr: "B\xEAtes communes pondant des [\u0153ufs]"
      de: 'Normale Tiere legen [Eier]'
      ru: "\u041E\u0431\u044B\u0447\u043D\u044B\u0435 \u0437\u0432\u0435\u0440\u0438,
        \u043D\u0435\u0441\u0443\u0449\u0438\u0435 [\u044F\u0439\u0446\u0430]"
      es: 'Bestias comunes que ponen [huevos]'
      pt: 'Animais comuns que botam [ovos]'
      it: 'Bestiame comune che depone [uova]'
      tr: "Yumurta \xFCreten hayvanlar"
      vi: "Th\xFA th\u01B0\u1EDDng \u0111\u1EBB [tr\u1EE9ng]"
      th: "\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B\u0E43\u0E2B\u0E49
        [\u0E44\u0E02\u0E48]"
      pl: "Zwierz\u0119ta znosz\u0105ce [jajka]"
      nl: Gewone dieren die [eieren] leggen
      el: "\u039A\u03BF\u03B9\u03BD\u03AC \u03B6\u03CE\u03B1 \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AC\u03B3\u03BF\u03C5\u03BD
        [\u03B1\u03C5\u03B3\u03AC]"
      ar: "\u062D\u064A\u0648\u0627\u0646\u0627\u062A \u0639\u0627\u062F\u064A\u0629
        \u062A\u0646\u062A\u062C [\u0628\u064A\u0636]"
      hi: "\u0938\u093E\u092E\u093E\u0928\u094D\u092F \u091C\u093E\u0928\u0935\u0930
        \u091C\u094B [\u0905\u0902\u0921\u0947] \u0926\u0947 \u0938\u0915\u0924\u0947
        \u0939\u0948\u0902"
      ur: "\u0639\u0627\u0645 \u062C\u0627\u0646\u0648\u0631 \u062C\u0648 [\u0627\u0646\u0688\u06D2]
        \u062F\u06D2 \u0633\u06A9\u062A\u06D2 \u06C1\u06CC\u06BA\u06D4"
      ms: Binatang biasa yang boleh hasilkan [Telur].
      id: Hewan biasa yang dapat menghasilkan [Telur].
      he: "\u05D7\u05D9\u05D4 \u05E8\u05D2\u05D9\u05DC\u05D4, \u05DE\u05E4\u05D9\u05E7\u05D4
        [\u05D1\u05D9\u05E6\u05D9\u05DD]"
      sv: "Vanligt djur, producerar [\xE4gg]"
      cs: "B\u011B\u017En\xE9 zv\xED\u0159e, produkuje [vejce]"
      uk: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430 \u0442\u0432\u0430\u0440\u0438\u043D\u0430,
        \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u0454 [\u044F\u0439\u0446\u044F]"
      ro: "Animale obi\u0219nuite, produc [ou\u0103]"
      no: 'Vanlig dyr, produserer [egg]'
      hu: "\xC1ltal\xE1nos h\xE1zi\xE1llat, toj\xE1st termel"
