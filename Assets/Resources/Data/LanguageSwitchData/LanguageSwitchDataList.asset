      da: Tasapainoinen suola-happamuus
    - cn: "\u65B0\u9C9C\u8106\u723D\uFF0C\u591A\u79CD\u852C\u83DC\u6C47\u805A\uFF0C\u5065\u5EB7\u4E0E\u7F8E\u5473\u5E76\u5B58\u3002"
