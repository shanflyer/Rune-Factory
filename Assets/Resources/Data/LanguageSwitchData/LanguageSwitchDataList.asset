      ja: "\u5869\u5473\u3068\u9178\u5473\u306E\u30D0\u30E9\u30F3\u30B9\u304C\u826F\u304F\u98DF\u5353\u306B\u30A2\u30AF\u30BB\u30F3\u30C8"
