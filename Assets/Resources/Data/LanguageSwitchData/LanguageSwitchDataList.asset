        \u0938\u094D\u0935\u093E\u0926, \u090F\u0915 \u0935\u093F\u0936\u0947\u0937
        \u092A\u094C\u0937\u094D\u091F\u093F\u0915 \u092A\u0947\u092F"
      ur: "\u0645\u06CC\u0679\u06BE\u0627\u0633 \u0645\u06CC\u06BA \u0645\u0679\u06CC
