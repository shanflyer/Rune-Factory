      fr: "Sol magique riche en \xE9nergie"
      de: Magischer Boden voller Energie
      ru: "\u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0430\u044F \u043F\u043E\u0447\u0432\u0430,
        \u043F\u043E\u043B\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u0438"
      es: "Tierra M\xE1gica Llena de Energ\xEDa"
      pt: "Solo M\xE1gico Cheio de Energia"
      it: Terreno Magico Ricco di Energia
      tr: "B\xFCy\xFCl\xFC Enerji Dolu Toprak"
      vi: "\u0110\u1EA5t gi\xE0u ma l\u1EF1c"
      th: "\u0E14\u0E34\u0E19\u0E2D\u0E38\u0E14\u0E21\u0E14\u0E49\u0E27\u0E22\u0E40\u0E27\u0E17\u0E21\u0E19\u0E15\u0E23\u0E4C"
      pl: "Magiczna Gleba Pe\u0142na Energii"
      nl: Magische Grond Vol Energie
      el: "\u039C\u03B1\u03B3\u03B9\u03BA\u03CC \u03AD\u03B4\u03B1\u03C6\u03BF\u03C2
        \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1"
      ar: "\u062A\u0631\u0628\u0629 \u063A\u0646\u064A\u0629 \u0628\u0627\u0644\u0637\u0627\u0642\u0629
        \u0627\u0644\u0633\u062D\u0631\u064A\u0629"
      hi: "\u090A\u0930\u094D\u091C\u093E \u0938\u0947 \u092D\u0930\u092A\u0942\u0930
        \u091C\u093E\u0926\u0941\u0908 \u092E\u093F\u091F\u094D\u091F\u0940"
      ur: "\u062A\u0648\u0627\u0646\u0627\u0626\u06CC \u0633\u06D2 \u0628\u06BE\u0631\u067E\u0648\u0631
        \u062C\u0627\u062F\u0648\u0626\u06CC \u0645\u0679\u06CC"
      ms: Tanah ajaib penuh tenaga
      id: Tanah ajaib penuh energi
    - cn: "\u8FF7\u5E7B\u8611\u83C7\u7684\u5B62\u5B50"
      en: Hallucinogenic mushroom spores
      tw: "\u8FF7\u5E7B\u8611\u83C7\u7684\u5B62\u5B50"
