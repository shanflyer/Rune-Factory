      ko: "\uB2E4\uCC44\uB85C\uC6B4 \uCC44\uC18C\uC758 \uC601\uC591\uC774 \uAC00\uB4DD\uD55C
        \uC0C1\uD07C\uD55C \uC694\uB9AC"
