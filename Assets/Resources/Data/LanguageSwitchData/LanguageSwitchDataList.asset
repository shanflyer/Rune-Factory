      ru: "\u0421\u0432\u0435\u0440\u043A\u0430\u044E\u0449\u0430\u044F \u0440\u044B\u0431\u0430
        \u0441 \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u043C\u044F\u043A\u043E\u0442\u044C\u044E"
