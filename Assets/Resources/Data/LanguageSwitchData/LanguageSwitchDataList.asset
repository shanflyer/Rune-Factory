      tw: "\u5976\u9999\u6FC3\u90C1\uFF0C\u53EF\u642D\u914D\u591A\u7A2E\u98DF\u7269\u589E\u6DFB\u98A8\u5473"
      ja: "\u6FC3\u539A\u306A\u4E73\u9999\u304C\u69D8\u3005\u306A\u6599\u7406\u306E\u5473\u3092\u5F15\u304D\u7ACB\u3066\u308B"
