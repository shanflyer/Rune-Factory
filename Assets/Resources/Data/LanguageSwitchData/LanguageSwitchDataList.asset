      ja: "\u96F7\u306E\u529B\u3092\u6301\u3064\u97AD\u3001[\u96F7\u96E8]\u30B9\u30AD\u30EB\u3092\u767A\u52D5\u53EF\u80FD"
      ko: "\uBC88\uAC1C\uC758 \uD798\uC744 \uAC00\uC9C4 \uCC44\uCC0D, [\uB1CC\uC6B0]
