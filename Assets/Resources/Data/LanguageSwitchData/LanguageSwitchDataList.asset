        \u03C8\u03AC\u03C1\u03B9"
      ar: "\u0633\u0645\u0643 \u0635\u063A\u064A\u0631 \u0645\u0634\u0648\u064A \u0645\u0645\u0644\u062D"
      hi: "\u091B\u094B\u091F\u0940 \u092E\u091B\u0932\u0940 \u092E\u0947\u0902 \u092C\u0921\u093C\u093E
