    - cn: "\uFF08\u690D\u7269\u5728\u9002\u5B9C\u5B63\u8282\u751F\u957F\u901F\u5EA6\u7FFB\u500D\uFF0C\u5728\u4E0D\u9002\u5B9C\u5B63\u8282\u751F\u957F\u901F\u5EA6\u51CF\u534A\uFF09"
      en: (Plant growth speed doubles in suitable seasons and halves in unsuitable
        seasons)
      tw: "\uFF08\u690D\u7269\u5728\u9069\u5B9C\u5B63\u7BC0\u751F\u9577\u901F\u5EA6\u7FFB\u500D\uFF0C\u5728\u4E0D\u9069\u5B9C\u5B63\u7BC0\u751F\u9577\u901F\u5EA6\u6E1B\u534A\uFF09"
      ja: "\uFF08\u690D\u7269\u306F\u9069\u5207\u306A\u5B63\u7BC0\u3067\u6210\u9577\u901F\u5EA62\u500D\u3001\u4E0D\u9069\u5207\u306A\u5B63\u7BC0\u3067\u534A\u6E1B\uFF09"
      ko: "(\uC801\uC808\uD55C \uACC4\uC808\uC5D0 \uC2DD\uBB3C \uC131\uC7A5 \uC18D\uB3C4
        2\uBC30, \uBD80\uC801\uC808\uD55C \uACC4\uC808\uC5D0 \uBC18\uAC10)"
      fr: "(La croissance des plantes double en saison favorable et est r\xE9duite
        de moiti\xE9 en saison d\xE9favorable)"
      de: (Pflanzenwachstum verdoppelt sich in passenden Jahreszeiten und halbiert
        sich in unpassenden)
      ru: "(\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0440\u043E\u0441\u0442\u0430
        \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439 \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0432 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0441\u0435\u0437\u043E\u043D
        \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F
        \u0432\u0434\u0432\u043E\u0435 \u0432 \u043D\u0435\u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439)"
      es: (Velocidad de crecimiento de plantas se duplica en temporadas adecuadas
        y se reduce a la mitad en temporadas inadecuadas)
      pt: "(Velocidade de crescimento das plantas dobra em esta\xE7\xF5es adequadas
        e reduz \xE0 metade em esta\xE7\xF5es inadequadas)"
      it: (La crescita delle piante raddoppia nelle stagioni adatte e si dimezza
        in quelle inadatte)
      tr: "(Bitki b\xFCy\xFCme h\u0131z\u0131 uygun mevsimde iki kat\u0131na \xE7\u0131kar,
        uygun olmayanda yar\u0131ya d\xFC\u015Fer)"
      vi: "(T\u1ED1c \u0111\u1ED9 ph\xE1t tri\u1EC3n c\u1EE7a c\xE2y t\u0103ng g\u1EA5p
        \u0111\xF4i v\xE0o m\xF9a th\xEDch h\u1EE3p v\xE0 gi\u1EA3m m\u1ED9t n\u1EEDa
        v\xE0o m\xF9a kh\xF4ng th\xEDch h\u1EE3p)"
      th: "(\u0E1E\u0E37\u0E0A\u0E40\u0E15\u0E34\u0E1A\u0E42\u0E15\u0E40\u0E23\u0E47\u0E27\u0E02\u0E36\u0E49\u0E19\u0E2A\u0E2D\u0E07\u0E40\u0E17\u0E48\u0E32\u0E43\u0E19\u0E24\u0E14\u0E39\u0E17\u0E35\u0E48\u0E40\u0E2B\u0E21\u0E32\u0E30\u0E2A\u0E21
        \u0E41\u0E25\u0E30\u0E0A\u0E49\u0E32\u0E25\u0E07\u0E04\u0E23\u0E36\u0E48\u0E07\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E43\u0E19\u0E24\u0E14\u0E39\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E40\u0E2B\u0E21\u0E32\u0E30\u0E2A\u0E21)"
      pl: "(Ro\u015Bliny rosn\u0105 2x szybciej w odpowiednich porach roku i 2x wolniej
        w nieodpowiednich)"
      nl: (Plantengroei verdubbelt in geschikte seizoenen en halveert in ongeschikte)
      el: "(\u0397 \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7 \u03C6\u03C5\u03C4\u03CE\u03BD
        \u03B4\u03B9\u03C0\u03BB\u03B1\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
        \u03C3\u03B5 \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03B5\u03C2
        \u03B5\u03C0\u03BF\u03C7\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B4\u03B9\u03C0\u03BB\u03B1\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
        \u03C3\u03B5 \u03B1\u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03B5\u03C2)"
      ar: "(\u062A\u062A\u0636\u0627\u0639\u0641 \u0633\u0631\u0639\u0629 \u0646\u0645\u0648
        \u0627\u0644\u0646\u0628\u0627\u062A \u0641\u064A \u0627\u0644\u0645\u0648\u0627\u0633\u0645
        \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u062A\u0646\u062E\u0641\u0636
        \u0644\u0644\u0646\u0635\u0641 \u0641\u064A \u063A\u064A\u0631 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629)"
      hi: "(\u092A\u094C\u0927\u0947 \u0909\u092A\u092F\u0941\u0915\u094D\u0924 \u092E\u094C\u0938\u092E
        \u092E\u0947\u0902 \u0926\u094B\u0917\u0941\u0928\u0940 \u0917\u0924\u093F
        \u0938\u0947 \u092C\u0922\u093C\u0924\u0947 \u0939\u0948\u0902, \u0905\u0928\u0941\u092A\u092F\u0941\u0915\u094D\u0924
        \u092E\u0947\u0902 \u0906\u0927\u0940)"
      ur: "(\u067E\u0648\u062F\u06D2 \u0645\u0648\u0627\u0641\u0642 \u0645\u0648\u0633\u0645
        \u0645\u06CC\u06BA \u062F\u0648\u06AF\u0646\u06CC \u0631\u0641\u062A\u0627\u0631
        \u0633\u06D2 \u0628\u0691\u06BE\u062A\u06D2 \u06C1\u06CC\u06BA\u060C \u0646\u0627\u0645\u0648\u0627\u0641\u0642
        \u0645\u06CC\u06BA \u0622\u062F\u06BE\u06CC)"
      ms: (Tumbuhan tumbuh 2x pantas dalam musim sesuai, separuh dalam musim tak
        sesuai)
      id: (Tanaman tumbuh 2x cepat di musim tepat, setengah di musim tidak tepat)
      he: "(\u05E6\u05DE\u05D7\u05D9\u05DD \u05D2\u05D3\u05DC\u05D9\u05DD \u05E4\u05D9
        \u05E9\u05E0\u05D9\u05D9\u05DD \u05DE\u05D4\u05E8 \u05D1\u05E2\u05D5\u05E0\u05D4
        \u05D4\u05DE\u05EA\u05D0\u05D9\u05DE\u05D4, \u05D5\u05D7\u05E6\u05D9 \u05DE\u05D4\u05E8
        \u05D1\u05E2\u05D5\u05E0\u05D4 \u05D4\u05DC\u05D0 \u05DE\u05EA\u05D0\u05D9\u05DE\u05D4)"
      sv: "(V\xE4xter v\xE4xer dubbelt s\xE5 fort i r\xE4tt s\xE4song, halva hastigheten
        i fel s\xE4song)"
      cs: "(Rostliny rostou dvakr\xE1t rychleji ve vhodn\xE9m obdob\xED, polovi\u010Dn\xED
        rychlost\xED v nevhodn\xE9m)"
      uk: "(\u0420\u043E\u0441\u043B\u0438\u043D\u0438 \u0440\u043E\u0441\u0442\u0443\u0442\u044C
        \u0432\u0434\u0432\u0456\u0447\u0456 \u0448\u0432\u0438\u0434\u0448\u0435
        \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0439
        \u0441\u0435\u0437\u043E\u043D, \u0443\u0434\u0432\u0456\u0447\u0456 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0435
        \u0443 \u043D\u0435\u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0439)"
      ro: "(Plantele cresc de dou\u0103 ori mai repede \xEEn sezonul potrivit, jum\u0103tate
        \xEEn cel nepotrivit)"
      no: "(Planter vokser dobbelt s\xE5 fort i riktig sesong, halvparten i feil
        sesong)"
      hu: "(N\xF6v\xE9nyek k\xE9tszer gyorsabban n\u0151nek megfelel\u0151 \xE9vszakban)"
      sw: (Mimea hukua mara mbili kwa msimu)
      sr: "(Biljke rastu br\u017Ee u sezoni)"
      fi: (Kasvien kasvunopeus kaksinkertaistuu sopivina vuodenaikoina ja puolittuu
        sopimattomina vuodenaikoina)
      da: "(Plantev\xE6kst fordobles i passende \xE5rstider og halveres i upassende
        \xE5rstider)"
    - cn: "\u4E0E+ \u739B\u5FB7\u7433 +\u6216+ \u5E03\u83B1\u5179 +\u7684\u53CB\u597D\u5EA6\u5230\u8FBE"
      en: Reach friendship level with?Madeleine?or?Blaze
      tw: "\u8207+ \u746A\u5FB7\u7433 +\u6216+ \u5E03\u840A\u8332 +\u7684\u53CB\u597D\u5EA6\u5230\u9054"
      ja: "\u30DE\u30C9\u30EC\u30FC\u30CC\u307E\u305F\u306F\u30D6\u30EC\u30A4\u30BA\u3068\u306E\u53CB\u597D\u5EA6\u304C\u5230\u9054"
      ko: "\uBA54\uB4E4\uB9B0 \uB610\uB294 \uBE14\uB808\uC774\uC988\uC640\uC758 \uC6B0\uD638\uB3C4
        \uB2EC\uC131"
      fr: "Atteindre le niveau d'amiti\xE9 avec ?Madeleine? ou ?Blaze?"
      de: Freundschaftsstufe mit ?Madeleine? oder ?Blaze? erreichen
      ru: "\u0414\u043E\u0441\u0442\u0438\u0447\u044C \u0443\u0440\u043E\u0432\u043D\u044F
        \u0434\u0440\u0443\u0436\u0431\u044B \u0441 ?\u041C\u0430\u0434\u043B\u0435\u043D?
        \u0438\u043B\u0438 ?\u0411\u043B\u0435\u0439\u0437?"
      es: Alcanzar nivel de amistad con ?Madeleine? o ?Blaze?
      pt: "Alcan\xE7ar n\xEDvel de amizade com ?Madeleine? ou ?Blaze?"
      it: Raggiungi il livello di amicizia con ?Madeleine? o ?Blaze?
      tr: "?Madeleine? veya ?Blaze? ile dostluk seviyesine ula\u015F"
      vi: "\u0110\u1EA1t m\u1EE9c \u0111\u1ED9 th\xE2n thi\u1EBFt v\u1EDBi ?Madeleine?
        ho\u1EB7c ?Blaze?"
      th: "\u0E16\u0E36\u0E07\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E21\u0E34\u0E15\u0E23\u0E20\u0E32\u0E1E\u0E01\u0E31\u0E1A
        ?\u0E40\u0E21\u0E40\u0E14\u0E40\u0E25\u0E19? \u0E2B\u0E23\u0E37\u0E2D ?\u0E40\u0E1A\u0E25\u0E0B?"
      pl: "Osi\u0105gnij poziom przyja\u017Ani z ?Madeleine? lub ?Blaze?"
      nl: Vriendschapsniveau bereiken met ?Madeleine? of ?Blaze?
      el: "\u03A6\u03C4\u03AC\u03C3\u03C4\u03B5 \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03BF
        \u03C6\u03B9\u03BB\u03AF\u03B1\u03C2 \u03BC\u03B5 ?Madeleine? \u03AE ?Blaze?"
      ar: "\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0633\u062A\u0648\u0649
        \u0635\u062F\u0627\u0642\u0629 \u0645\u0639 ?\u0645\u0627\u062F\u0644\u064A\u0646?
        \u0623\u0648 ?\u0628\u0644\u064A\u0632?"
      hi: "\u092E\u0947\u0921\u0932\u0940\u0928 \u092F\u093E \u092C\u094D\u0932\u0947\u091C\u093C
        \u0915\u0947 \u0938\u093E\u0925 \u092E\u093F\u0924\u094D\u0930\u0924\u093E
        \u0938\u094D\u0924\u0930 \u092A\u0939\u0941\u0901\u091A\u0947\u0902"
      ur: "\u0645\u06CC\u0688\u0644\u06CC\u0646 \u06CC\u0627 \u0628\u0644\u06CC\u0632
        \u06A9\u06D2 \u0633\u0627\u062A\u06BE \u062F\u0648\u0633\u062A\u06CC \u06A9\u06CC
        \u0633\u0637\u062D \u062A\u06A9 \u067E\u06C1\u0646\u0686\u06CC\u06BA"
      ms: Capai tahap persahabatan dengan Madeleine atau Blaze
      id: Capai tingkat persahabatan dengan Madeleine atau Blaze
      he: "\u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC\u05E8\u05DE\u05EA \u05D9\u05D3\u05D9\u05D3\u05D5\u05EA
        \u05E2\u05DD \u05DE\u05D3\u05DC\u05DF \u05D0\u05D5 \u05D1\u05DC\u05D6"
      sv: "Uppn\xE5 v\xE4nskapsniv\xE5 med Madeleine eller Blaise"
      cs: "Dos\xE1hnout \xFArovn\u011B p\u0159\xE1telstv\xED s Madeleine nebo Blazem"
      uk: "\u0414\u043E\u0441\u044F\u0433\u0442\u0438 \u0440\u0456\u0432\u043D\u044F
        \u0434\u0440\u0443\u0436\u0431\u0438 \u0437 \u041C\u0430\u0434\u043B\u0435\u043D
        \u0430\u0431\u043E \u0411\u043B\u0435\u0439\u0437\u043E\u043C"
      ro: Atinge nivelul de prietenie cu Madeleine sau Blaise
      no: "Oppn\xE5 vennskapsniv\xE5 med Madeleine eller Blaise"
      hu: "Kedvelts\xE9g el\xE9r\xE9se + Madeleine + vagy + Blaise +"
      sw: Fikia urafiki na + Madeleine + au + Blaise +
      sr: "Dosti\u0107i naklonost sa + Madeleine + ili + Blaise +"
      fi: "Saavuta yst\xE4vyystaso?Madeleine?tai?Blaze?"
      da: "Opn\xE5 venskabsniveau med?Madeleine?eller?Blaze"
