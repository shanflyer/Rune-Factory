      ja: "\u8868\u9762\u306F\u9999\u3070\u3057\u304F\u4E2D\u306F\u307B\u304F\u307B\u304F\u306E\u713C\u304D\u828B"
      ko: "\uAC89\uC740 \uC0B4\uC9DD \uADF8\uC744\uB9AC\uACE0 \uC18D\uC740 \uB2EC\uCF64\uD55C
