      ar: "\u0633\u0648\u0637 \u0627\u0644\u0631\u0639\u062F \u064A\u0645\u0643\u0646\u0647
        \u062A\u0641\u0639\u064A\u0644 \u0645\u0647\u0627\u0631\u0629 [\u0639\u0627\u0635\u0641\u0629
        \u0631\u0639\u062F\u064A\u0629]"
      hi: "[\u0935\u091C\u094D\u0930\u092A\u093E\u0924] \u0915\u094C\u0936\u0932
