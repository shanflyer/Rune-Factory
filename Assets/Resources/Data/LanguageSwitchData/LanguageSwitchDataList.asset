      it: Cristalli ricchi di sale
      tr: "Tuz y\xFCkl\xFC kristaller"
      vi: "Tinh th\u1EC3 ch\u1EE9a nhi\u1EC1u mu\u1ED1i"
      th: "\u0E1C\u0E25\u0E36\u0E01\u0E17\u0E35\u0E48\u0E21\u0E35\u0E40\u0E01\u0E25\u0E37\u0E2D\u0E2A\u0E39\u0E07"
      pl: "Kryszta\u0142y bogate w s\xF3l"
      nl: Zoutkristallen
      el: "\u039A\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\u03B1 \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03B1
        \u03C3\u03B5 \u03B1\u03BB\u03AC\u03C4\u03B9"
      ar: "\u0628\u0644\u0648\u0631\u0627\u062A \u063A\u0646\u064A\u0629 \u0628\u0627\u0644\u0645\u0644\u062D"
      hi: "\u0928\u092E\u0915 \u0938\u0947 \u092D\u0930\u092A\u0942\u0930 \u0915\u094D\u0930\u093F\u0938\u094D\u091F\u0932"
