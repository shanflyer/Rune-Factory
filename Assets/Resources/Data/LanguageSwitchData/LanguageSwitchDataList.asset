      no: Kaffe og melk i perfekt balanse
      hu: Latte
      sw: Latte
      sr: Latte
      fi: "Kaffe og m\xE6lks balance"
      da: Kahvin ja maidon tasapaino
    - cn: "\u7EAF\u7CB9\u82E6\u6DA9\uFF0C\u9999\u6C14\u6D53\u90C1\uFF0C\u63D0\u795E\u9192\u8111\u3002"
