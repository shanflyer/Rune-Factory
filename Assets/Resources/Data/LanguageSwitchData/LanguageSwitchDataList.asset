      ur: "\u0627\u062C\u0632\u0627\u0621 \u06A9\u06CC \u062A\u06C1\u0648\u06BA \u0648\u0627\u0644\u0627\u060C
        \u062C\u0644\u062F\u06CC \u062A\u06CC\u0627\u0631 \u06C1\u0648\u0646\u06D2
