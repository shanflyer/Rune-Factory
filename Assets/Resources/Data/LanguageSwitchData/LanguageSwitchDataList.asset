      pl: "Ruda bogata w \u017Celazo"
      nl: IJzerrijk erts
      el: "\u039C\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03CD\u03BC\u03B1\u03C4\u03B1
