      ru: "\u042D\u043C\u0431\u043B\u0435\u043C\u0430 \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
        \u0440\u044B\u0446\u0430\u0440\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430"
      es: Emblema de Familia Caballeresca Antigua
      pt: "Emblema de Fam\xEDlia de Cavaleiros Antiga"
      it: Emblema di Famiglia Cavalleresca Antica
      tr: "Eski Bir \u015E\xF6valye Ailesinin Amblemi"
      vi: "Huy hi\u1EC7u d\xF2ng h\u1ECD hi\u1EC7p s\u0129 c\u1ED5"
      th: "\u0E15\u0E23\u0E32\u0E2A\u0E31\u0E0D\u0E25\u0E31\u0E01\u0E29\u0E13\u0E4C\u0E15\u0E23\u0E30\u0E01\u0E39\u0E25\u0E2D\u0E31\u0E28\u0E27\u0E34\u0E19\u0E42\u0E1A\u0E23\u0E32\u0E13"
      pl: "Emblemat Staro\u017Cytnego Rycerskiego Rodu"
      nl: Embleem van Oude Ridderfamilie
      el: "\u0388\u03BC\u03B2\u03BB\u03B7\u03BC\u03B1 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1\u03C2
        \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B1\u03C2 \u03B9\u03C0\u03C0\u03BF\u03C4\u03CE\u03BD"
      ar: "\u0634\u0639\u0627\u0631 \u0639\u0627\u0626\u0644\u0629 \u0641\u0631\u0633\u0627\u0646
        \u0642\u062F\u064A\u0645\u0629"
      hi: "\u092A\u094D\u0930\u093E\u091A\u0940\u0928 \u0936\u0942\u0930\u0935\u0940\u0930
        \u092A\u0930\u093F\u0935\u093E\u0930 \u0915\u093E \u092A\u094D\u0930\u0924\u0940\u0915"
      ur: "\u0642\u062F\u06CC\u0645 \u0646\u0627\u0626\u0679 \u062E\u0627\u0646\u062F\u0627\u0646
