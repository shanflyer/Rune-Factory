      cs: "M\u011Bkk\xFD b\xEDlek, kr\xE9mov\xFD \u017Eloutek, jednoduch\xE9 a dobr\xE9"
      uk: "\u041D\u0456\u0436\u043D\u0438\u0439 \u0431\u0456\u043B\u043E\u043A, \u043A\u0440\u0435\u043C\u043E\u0432\u0438\u0439
        \u0436\u043E\u0432\u0442\u043E\u043A, \u043F\u0440\u043E\u0441\u0442\u0438\u0439
        \u0456 \u0441\u043C\u0430\u0447\u043D\u0438\u0439"
      ro: "Albus\u0103 moale, g\u0103lbenu\u0219 cremos, simplu \u0219i bun"
      no: Mykt eggehvite, kremet eggeplomme, enkelt og godt
      hu: "F\u0151tt toj\xE1s"
      sw: Yai lililochemka
      sr: Kuvano jaje
      fi: "Bl\xF8dt \xE6ggehvide og t\xE6t blomme"
      da: "Valkuaisen pehme\xE4 ja keltuaisen tihe\xE4"
    - cn: "\u8089\u9999\u56DB\u6EA2\uFF0C\u9999\u6599\u52A0\u6301\uFF0C\u611F\u53D7\u70ED\u8FA3\u9C9C\u9999\u7684\u8BF1\u60D1\u3002"
      en: Fragrant with meat and spices, rich and spicy.
      tw: "\u8089\u9999\u56DB\u6EA2\uFF0C\u9999\u6599\u52A0\u6301\uFF0C\u71B1\u8FA3\u9BAE\u9999\u7684\u8A98\u60D1"
      ja: "\u8089\u306E\u9999\u308A\u3068\u30B9\u30D1\u30A4\u30B9\u304C\u7D61\u307F\u5408\u3046\u523A\u6FC0\u7684\u306A\u5473\u308F\u3044"
      ko: "\uACE0\uAE30 \uD5A5\uACFC \uD5A5\uC2E0\uB8CC\uAC00 \uC5B4\uC6B0\uB7EC\uC9C4
        \uB9E4\uCF64\uD55C \uC720\uD639"
      fr: "Plat \xE9pic\xE9 aux ar\xF4mes de viande intenses"
      de: "W\xFCrziges Fleischgericht mit Kr\xE4utern"
      ru: "\u0410\u0440\u043E\u043C\u0430\u0442\u043D\u043E\u0435 \u043C\u044F\u0441\u043E
        \u0441 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438"
      es: Carne especiada y fragante
      pt: "Carne temperada e arom\xE1tica"
      it: Carne speziata e profumata
      tr: "Et ve baharat kokulu cay\u0131r cay\u0131r yemek"
      vi: "M\xF3n th\u1ECBt th\u01A1m n\u1ED3ng gia v\u1ECB"
      th: "\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E2B\u0E2D\u0E21\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E17\u0E28\u0E23\u0E2A\u0E40\u0E1C\u0E47\u0E14"
      pl: "Mi\u0119sna potrawa z aromatycznymi przyprawami"
      nl: "Kruidig vleesgerecht \u03BC\u03B5 \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03B1
        \u03B3\u03B5\u03CD\u03C3\u03B7"
      el: "\u03A0\u03B9\u03BA\u03AC\u03BD\u03C4\u03B9\u03BA\u03BF \u03BA\u03C1\u03AD\u03B1\u03C2
        \u03BC\u03B5 \u03BC\u03C0\u03B1\u03C7\u03B1\u03C1\u03B9\u03BA\u03AC"
      ar: "\u0644\u062D\u0645 \u0645\u0639\u0637\u0631 \u0628\u0627\u0644\u0628\u0647\u0627\u0631\u0627\u062A
        \u0627\u0644\u062D\u0627\u0631\u0629"
      hi: "\u092E\u093E\u0902\u0938 \u0914\u0930 \u092E\u0938\u093E\u0932\u094B\u0902
        \u0915\u0940 \u0916\u0941\u0936\u092C\u0942, \u0938\u092E\u0943\u0926\u094D\u0927
        \u0914\u0930 \u092E\u0938\u093E\u0932\u0947\u0926\u093E\u0930"
      ur: "\u06AF\u0648\u0634\u062A \u0627\u0648\u0631 \u0645\u0635\u0627\u0644\u062D\u0648\u06BA
        \u06A9\u06CC \u062E\u0648\u0634\u0628\u0648\u060C \u06AF\u0627\u0691\u06BE\u0627
        \u0627\u0648\u0631 \u0645\u0635\u0627\u0644\u062D\u06C1 \u062F\u0627\u0631\u06D4"
      ms: Wangi daging dan rempah, kaya dan pedas.
      id: Harum daging dan rempah, kaya dan pedas.
      he: "\u05E8\u05D9\u05D7 \u05D1\u05E9\u05E8 \u05D5\u05E2\u05E9\u05D1\u05D9 \u05EA\u05D9\u05D1\u05D5\u05DC,
        \u05DE\u05E4\u05EA\u05D4"
      sv: "K\xF6ttigt och kryddigt, frestande"
      cs: "Masov\xE1 v\u016Fn\u011B, ko\u0159en\u011Bn\xE1, l\xE1kav\xE1"
      uk: "\u041C'\u044F\u0441\u043D\u0438\u0439 \u0430\u0440\u043E\u043C\u0430\u0442,
        \u043F\u0440\u044F\u043D\u0438\u0439, \u043F\u0440\u0438\u0432\u0430\u0431\u043B\u0438\u0432\u0438\u0439"
      ro: "Arom\u0103 de carne \u0219i mirodenii, ispititor"
      no: "Kj\xF8ttig og krydret, fristende"
      hu: "F\u0171szeres ny\xE1rs"
      sw: Mishikaki yenye viungo
      sr: "Ra\u017Enji\u0107i sa za\u010Dinima"
      fi: "K\xF8dets duft"
      da: Lihan tuoksu
    - cn: "\u4FBF\u643A\u9971\u8179\uFF0C\u5E26\u7740\u5BB6\u7684\u6E29\u6696\u4E0E\u624B\u4F5C\u7684\u5FC3\u610F\u3002"
      en: Portable and filling, offering warmth and homemade care.
      tw: "\u4FBF\u651C\u98FD\u8179\uFF0C\u5E36\u8457\u5BB6\u7684\u6EAB\u6696\u8207\u624B\u4F5C\u5FC3\u610F"
      ja: "\u643A\u5E2F\u53EF\u80FD\u3067\u6E29\u304B\u307F\u306E\u3042\u308B\u624B\u4F5C\u308A\u611F"
      ko: "\uD734\uB300\uD558\uAE30 \uC88B\uACE0 \uC9D1\uC5D0\uC11C \uB9CC\uB4E0
        \uB4EF\uD55C \uC815\uC131 \uAC00\uB4DD\uD55C \uC2DD\uC0AC"
      fr: "En-cas r\xE9confortant fait maison"
      de: "Tragbares Gericht mit hausgemachter W\xE4rme"
      ru: "\u041F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u0430\u044F \u0435\u0434\u0430
        \u0441 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u043C \u0442\u0435\u043F\u043B\u043E\u043C"
      es: "Comida casera port\xE1til"
      pt: "Lanche port\xE1til caseiro"
      it: Spuntino portatile fatto in casa
      tr: "Ta\u015F\u0131nabilir doyurucu ev yap\u0131m\u0131 lezzet"
      vi: "M\xF3n \u0103n mang \u0111i no b\u1EE5ng, \u1EA5m \xE1p t\xECnh nh\xE0"
      th: "\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E1E\u0E01\u0E1E\u0E32\u0E2D\u0E1A\u0E2D\u0E38\u0E48\u0E19\u0E43\u0E08"
      pl: "Przeno\u015Bne danie z domowym ciep\u0142em"
      nl: Draagbare maaltijd met huiselijke zorg
      el: "\u03A6\u03BF\u03C1\u03B7\u03C4\u03CC \u03C0\u03B9\u03AC\u03C4\u03BF \u03BC\u03B5
        \u03C3\u03C0\u03B9\u03C4\u03B9\u03BA\u03AE \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B4\u03B1"
      ar: "\u0648\u062C\u0628\u0629 \u0645\u062D\u0645\u0648\u0644\u0629 \u0645\u0639
        \u062F\u0641\u0621 \u0627\u0644\u0645\u0646\u0632\u0644"
      hi: "\u092A\u094B\u0930\u094D\u091F\u0947\u092C\u0932 \u0914\u0930 \u092D\u0930\u092A\u0942\u0930,
        \u0917\u0930\u094D\u092E\u091C\u094B\u0936\u0940 \u0914\u0930 \u0918\u0930
        \u0915\u093E \u092C\u0928\u093E \u092A\u094D\u092F\u093E\u0930"
      ur: "\u067E\u0648\u0631\u0679\u06CC\u0628\u0644 \u0627\u0648\u0631 \u0628\u06BE\u0631\u067E\u0648\u0631\u060C
        \u06AF\u0631\u0645\u062C\u0648\u0634\u06CC \u0627\u0648\u0631 \u06AF\u06BE\u0631
