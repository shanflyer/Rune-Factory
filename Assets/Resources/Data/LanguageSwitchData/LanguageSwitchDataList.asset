      th: "\u0E40\u0E17\u0E1E\u0E21\u0E23\u0E13\u0E30"
      pl: "\u017Bniwiarz"
      nl: Magere Hein
      el: "\u03A7\u03AC\u03C1\u03BF\u03C2"
      ar: "\u0645\u0644\u0643 \u0627\u0644\u0645\u0648\u062A"
      hi: "\u092E\u0943\u0924\u094D\u092F\u0941 \u0926\u0947\u0935\u0924\u093E"
      ur: "\u0645\u0648\u062A \u06A9\u0627 \u062F\u06CC\u0648\u062A\u0627"
