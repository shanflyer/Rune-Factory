        \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u060C \u0686\u0679\u067E\u0679\u0627
        \u0627\u0648\u0631 \u062A\u0627\u0632\u06AF\u06CC \u062F\u06CC\u0646\u06D2
        \u0648\u0627\u0644\u0627\u06D4"
