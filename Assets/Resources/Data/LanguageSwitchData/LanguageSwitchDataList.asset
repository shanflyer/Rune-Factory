      nl: Verfijnde vorm met huiselijke vulling
      el: "\u0395\u03BE\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC \u03C3\u03C7\u03AE\u03BC\u03B1
        \u03BC\u03B5 \u03C3\u03C0\u03B9\u03C4\u03B9\u03BA\u03CC \u03B3\u03AD\u03BC\u03B9\u03C3\u03BC\u03B1"
      ar: "\u0623\u0634\u0643\u0627\u0644 \u062C\u0645\u064A\u0644\u0629 \u0645\u0639
        \u062D\u0634\u0648\u0629 \u0645\u0646\u0632\u0644\u064A\u0629"
      hi: "\u0938\u0941\u0902\u0926\u0930 \u0906\u0915\u093E\u0930 \u0914\u0930 \u092D\u0930\u092A\u0942\u0930
        \u092D\u0930\u093E\u0908, \u0918\u0930 \u0915\u0947 \u0938\u094D\u0935\u093E\u0926
        \u0915\u094B \u0938\u092E\u0947\u091F\u0947 \u0939\u0941\u090F"
      ur: "\u062E\u0648\u0628\u0635\u0648\u0631\u062A \u0634\u06A9\u0644 \u0627\u0648\u0631
        \u0628\u06BE\u0631\u067E\u0648\u0631 \u0628\u06BE\u0631\u0627\u0626\u06CC\u060C
        \u06AF\u06BE\u0631 \u06A9\u06D2 \u0630\u0627\u0626\u0642\u06D2 \u06A9\u0648
