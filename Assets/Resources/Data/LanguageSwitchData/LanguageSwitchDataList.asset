      en: Notice
      tw: "\u6CE8\u610F"
      ja: "\u6CE8\u610F"
      ko: "\uC548\uB0B4"
      fr: Attention
      de: Hinweis
      ru: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435"
      es: "Atenci\xF3n"
      pt: "Aten\xE7\xE3o"
      it: Attenzione
      tr: Dikkat
      vi: "L\u01B0u \xFD"
      th: "\u0E41\u0E08\u0E49\u0E07\u0E40\u0E15\u0E37\u0E2D\u0E19"
      pl: Uwaga
      nl: Let op
      el: "\u03A0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE"
      ar: "\u062A\u0646\u0628\u064A\u0647"
      hi: "\u0927\u094D\u092F\u093E\u0928 \u0926\u0947\u0902"
      ur: "\u062A\u0648\u062C\u06C1"
      ms: Perhatian
      id: Perhatian
      he: "\u05E9\u05D9\u05DD \u05DC\u05D1"
      sv: Observera
      cs: "Upozorn\u011Bn\xED"
      uk: "\u0423\u0432\u0430\u0433\u0430"
      ro: "Aten\u021Bie"
