      he: "\u05D7\u05D9\u05D4 \u05E8\u05D2\u05D9\u05DC\u05D4, \u05DE\u05E4\u05D9\u05E7\u05D4
        [\u05D1\u05E9\u05E8 \u05D7\u05D6\u05D9\u05E8]"
      sv: "Vanligt djur, producerar [fl\xE4skk\xF6tt]"
      cs: "B\u011B\u017En\xE9 zv\xED\u0159e, produkuje [vep\u0159ov\xE9 maso]"
      uk: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430 \u0442\u0432\u0430\u0440\u0438\u043D\u0430,
        \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u0454 [\u0441\u0432\u0438\u043D\u0438\u043D\u0430]"
