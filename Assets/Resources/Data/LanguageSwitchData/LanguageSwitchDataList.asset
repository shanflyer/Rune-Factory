        ch\xEDn"
      th: "\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E2A\u0E14\u0E19\u0E38\u0E48\u0E21\u0E17\u0E33\u0E08\u0E32\u0E01\u0E1E\u0E37\u0E0A\u0E17\u0E35\u0E48\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E2A\u0E38\u0E01"
      pl: "\u015Awie\u017Ca, delikatna pasza z niedojrza\u0142ych ro\u015Blin"
      nl: Vers voer van onrijpe planten
      el: "\u03A6\u03C1\u03AD\u03C3\u03BA\u03BF, \u03C4\u03C1\u03C5\u03C6\u03B5\u03C1\u03CC
        \u03B6\u03C9\u03BF\u03C4\u03C1\u03BF\u03C6\u03AE \u03B1\u03C0\u03CC \u03AC\u03B3\u03BF\u03C5\u03C1\u03B1
        \u03C6\u03C5\u03C4\u03AC"
      ar: "\u0639\u0644\u0641 \u0637\u0627\u0632\u062C \u0648\u0644\u064A\u0646 \u0645\u0635\u0646\u0648\u0639
        \u0645\u0646 \u0646\u0628\u0627\u062A\u0627\u062A \u063A\u064A\u0631 \u0646\u0627\u0636\u062C\u0629"
      hi: "\u0915\u091A\u094D\u091A\u0947 \u092A\u094C\u0927\u094B\u0902 \u0938\u0947
        \u092C\u0928\u093E \u0924\u093E\u091C\u093E, \u0928\u0930\u092E \u091A\u093E\u0930\u093E"
      ur: "\u06A9\u0686\u06D2 \u067E\u0648\u062F\u0648\u06BA \u0633\u06D2 \u0628\u0646\u0627
        \u062A\u0627\u0632\u06C1\u060C \u0646\u0631\u0645 \u0686\u0627\u0631\u0627"
      ms: Makanan segar dan lembut dari tumbuhan belum matang
      id: Pakan segar dan lembut dari tanaman belum matang
      he: "\u05DE\u05E1\u05E4\u05D5\u05D0 \u05D8\u05E8\u05D9 \u05D5\u05D8\u05E2\u05D9\u05DD
        \u05DE\u05E6\u05DE\u05D7\u05D9\u05DD \u05DC\u05D0 \u05D1\u05E9\u05DC\u05D9\u05DD"
      sv: "F\xE4rsk och smaklig foderv\xE4xt fr\xE5n omogna v\xE4xter"
      cs: "\u010Cerstv\xE9 a chutn\xE9 krmivo z nedozr\xE1l\xFDch rostlin"
      uk: "\u0421\u0432\u0456\u0436\u0438\u0439 \u0442\u0430 \u0441\u043C\u0430\u0447\u043D\u0438\u0439
        \u043A\u043E\u0440\u043C \u0456\u0437 \u043D\u0435\u0437\u0440\u0456\u043B\u0438\u0445
        \u0440\u043E\u0441\u043B\u0438\u043D"
      ro: "Furaj proasp\u0103t \u0219i gustos din plante immature"
      no: Friskt og velsmakende for fra umodne planter
      hu: "Friss, gyenge takarm\xE1ny \xE9retlen n\xF6v\xE9nyekb\u0151l"
      sw: Chakula cha mifugo kisichokomaa
      sr: "Sve\u017Ea hrana od nezrelih biljaka"
      fi: "Tuore, pehme\xE4 rehu kypsym\xE4tt\xF6mist\xE4 kasveista"
      da: "Frisk, bl\xF8d fodder lavet af umodne planter"
    - cn: "\u5E38\u89C1\u7684\u5EFA\u9020\u6750\u6599"
