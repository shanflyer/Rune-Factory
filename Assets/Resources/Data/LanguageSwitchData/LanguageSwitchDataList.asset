      th: "\u0E40\u0E15\u0E47\u0E21\u0E44\u0E1B\u0E14\u0E49\u0E27\u0E22\u0E1E\u0E25\u0E31\u0E07\u0E23\u0E2A\u0E2A\u0E14\u0E0A\u0E37\u0E48\u0E19"
      pl: "Pe\u0142en energii orze\u017Awiaj\u0105cy smak"
      nl: Energieke frisse smaak
      el: "\u0395\u03BD\u03B5\u03C1\u03B3\u03B7\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
        \u03C6\u03C1\u03B5\u03C3\u03BA\u03BF\u03AC\u03C1\u03C9\u03BC\u03B7 \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u0645\u0646\u0639\u0634 \u0645\u0644\u064A\u0621
        \u0628\u0627\u0644\u0637\u0627\u0642\u0629"
      hi: "\u090A\u0930\u094D\u091C\u093E \u0914\u0930 \u0924\u093E\u091C\u093C\u093E
        \u0938\u094D\u0935\u093E\u0926 \u0938\u0947 \u092D\u0930\u092A\u0942\u0930,
        \u0927\u0942\u092A \u091C\u0948\u0938\u0940 \u0917\u0930\u094D\u092E\u091C\u094B\u0936\u0940
        \u0914\u0930 \u0916\u0941\u0936\u0940 \u0932\u093E\u0924\u093E \u0939\u0948"
      ur: "\u062A\u0648\u0627\u0646\u0627\u0626\u06CC \u0627\u0648\u0631 \u062A\u0627\u0632\u06C1
        \u0630\u0627\u0626\u0642\u06D2 \u0633\u06D2 \u0628\u06BE\u0631\u067E\u0648\u0631\u060C
        \u062F\u06BE\u0648\u067E \u062C\u06CC\u0633\u06CC \u06AF\u0631\u0645\u062C\u0648\u0634\u06CC
        \u0627\u0648\u0631 \u062E\u0648\u0634\u06CC \u0644\u0627\u062A\u0627 \u06C1\u06D2\u06D4"
      ms: Penuh tenaga dan rasa segar, membawa kehangatan dan kegembiraan seperti
