      id: Merah cerah, manis, sempurna untuk musim panas.
    - cn: "\u9178\u6DA9\u4E2D\u5E26\u751C\uFF0C\u662F\u5065\u5EB7\u53C8\u72EC\u7279\u7684\u679C\u6C41\u9009\u62E9\u3002"
