      el: "\u039A\u03BF\u03B9\u03BD\u03AC \u03B6\u03CE\u03B1 \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AC\u03B3\u03BF\u03C5\u03BD
        [\u03BC\u03B1\u03BB\u03BB\u03AF]"
