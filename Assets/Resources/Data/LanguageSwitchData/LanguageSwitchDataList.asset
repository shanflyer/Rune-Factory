        \u06A9\u06CC \u062E\u0648\u0634\u0628\u0648\u060C \u0627\u0646\u0648\u06A9\u06BE\u0627
        \u0630\u0627\u0626\u0642\u06C1\u060C \u0627\u06CC\u06A9 \u062E\u0627\u0635
