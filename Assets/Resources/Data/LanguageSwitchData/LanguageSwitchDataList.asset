      vi: "H\u1ED7n h\u1EE3p rau c\u1EE7 t\u01B0\u01A1i gi\xF2n"
      th: "\u0E1C\u0E31\u0E01\u0E2A\u0E14\u0E01\u0E23\u0E2D\u0E1A\u0E2B\u0E25\u0E32\u0E01\u0E0A\u0E19\u0E34\u0E14\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E2A\u0E38\u0E02\u0E20\u0E32\u0E1E"
      pl: "\u015Awie\u017Ca chrupi\u0105ca mieszanka warzywna"
