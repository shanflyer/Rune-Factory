      ja: "\u53E4\u306E\u9A0E\u58EB\u5BB6\u7CFB\u306E\u7D0B\u7AE0"
      ko: "\uACE0\uB300 \uAE30\uC0AC \uAC00\uBB38\uC758 \uBB38\uC7A5"
