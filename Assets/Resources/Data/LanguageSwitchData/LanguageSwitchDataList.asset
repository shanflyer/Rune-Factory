      th: "\u0E23\u0E2A\u0E40\u0E04\u0E47\u0E21\u0E40\u0E1B\u0E23\u0E35\u0E49\u0E22\u0E27\u0E1E\u0E2D\u0E40\u0E2B\u0E21\u0E32\u0E30
