      ja: "\u6D77\u5E95\u3092\u3086\u3063\u304F\u308A\u9019\u3044\u3001\u67D4\u3089\u304B\u304F\u30B8\u30E5\u30FC\u30B7\u30FC\u306A\u30A8\u30D3"
