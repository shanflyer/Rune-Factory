      fi: "S\xF8d og frisk"
      da: Makea ja tuore
    - cn: "\u6DF1\u9083\u7D2B\u84DD\uFF0C\u9178\u751C\u9002\u5EA6\uFF0C\u662F\u5065\u5EB7\u7F8E\u5473\u7684\u996E\u54C1\u3002"
      en: Deep purple and blue, sweet and tangy, a healthy and tasty drink.
      tw: "\u6DF1\u9083\u7D2B\u85CD\uFF0C\u9178\u751C\u9069\u5EA6\uFF0C\u662F\u5065\u5EB7\u7F8E\u5473\u7684\u98F2\u54C1"
      ja: "\u6FC3\u3044\u7D2B\u9752\u8272\u306E\u7518\u9178\u3063\u3071\u3044\u5065\u5EB7\u30C9\u30EA\u30F3\u30AF"
      ko: "\uC9C4\uD55C \uBCF4\uB77C\uC0C9\uACFC \uD30C\uB780\uC0C9\uC758 \uC801\uB2F9\uD55C
        \uC2E0\uB9DB\uACFC \uB2E8\uB9DB\uC758 \uAC74\uAC15 \uC74C\uB8CC"
      fr: "Boisson saine violette acidul\xE9e"
      de: "Tiefviolettes Gesundheitsgetr\xE4nk"
      ru: "\u041D\u0430\u043F\u0438\u0442\u043E\u043A \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0433\u043E
        \u0446\u0432\u0435\u0442\u0430 \u0441 \u043A\u0438\u0441\u043B\u043E-\u0441\u043B\u0430\u0434\u043A\u0438\u043C
        \u0432\u043A\u0443\u0441\u043E\u043C"
      es: Bebida morada saludable
      pt: "Bebida roxa saud\xE1vel"
      it: Bevanda viola salutare
      tr: "Mor-ek\u015Fi sa\u011Fl\u0131kl\u0131 i\xE7ecek"
      vi: "Th\u1EE9c u\u1ED1ng t\xEDm \u0111\u1EADm chua ng\u1ECDt t\u1ED1t cho s\u1EE9c
        kh\u1ECFe"
      th: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E14\u0E37\u0E48\u0E21\u0E2A\u0E35\u0E21\u0E48\u0E27\u0E07\u0E40\u0E02\u0E49\u0E21\u0E23\u0E2A\u0E40\u0E1B\u0E23\u0E35\u0E49\u0E22\u0E27\u0E2B\u0E27\u0E32\u0E19"
      pl: "G\u0142\u0119boki fioletowo-niebieski nap\xF3j"
      nl: Diep paars-blauwe gezonde drank
      el: "\u0392\u03B9\u03BF\u03BB\u03B5\u03C4\u03AF \u03C5\u03B3\u03B9\u03B5\u03B9\u03BD\u03CC
        \u03C0\u03BF\u03C4\u03CC"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u0623\u0631\u062C\u0648\u0627\u0646\u064A
        \u0635\u062D\u064A \u0628\u0646\u0643\u0647\u0629 \u062D\u0644\u0648\u0629
        \u0648\u062D\u0627\u0645\u0636\u0629"
      hi: "\u0917\u0939\u0930\u093E \u092C\u0948\u0902\u0917\u0928\u0940-\u0928\u0940\u0932\u093E,
        \u092E\u0940\u0920\u093E-\u0916\u091F\u094D\u091F\u093E, \u0938\u094D\u0935\u093E\u0938\u094D\u0925\u094D\u092F\u0935\u0930\u094D\u0927\u0915
        \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F \u092A\u0947\u092F"
      ur: "\u06AF\u06C1\u0631\u0627 \u062C\u0627\u0645\u0646\u06CC-\u0646\u06CC\u0644\u0627\u060C
        \u0645\u06CC\u0679\u06BE\u0627-\u06A9\u06BE\u0679\u0627\u060C \u0635\u062D\u062A
        \u0628\u062E\u0634 \u0627\u0648\u0631 \u0644\u0630\u06CC\u0630 \u0645\u0634\u0631\u0648\u0628\u06D4"
      ms: Ungu-biru tua, manis-masam, minuman sihat dan sedap.
      id: Ungu-biru tua, manis-asam, minuman sehat dan lezat.
      he: "\u05DB\u05D7\u05D5\u05DC-\u05E1\u05D2\u05D5\u05DC, \u05DE\u05EA\u05D5\u05E7-\u05D7\u05DE\u05D5\u05E5,
        \u05DE\u05E9\u05E7\u05D4 \u05D8\u05E2\u05D9\u05DD"
      sv: "Djup lila-bl\xE5, balanserad sur-s\xF6t"
      cs: "Tmav\u011B modrofialov\xE1, vyv\xE1\u017Een\xE1 chu\u0165"
      uk: "\u0413\u043B\u0438\u0431\u043E\u043A\u0438\u0439 \u0444\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u043E-\u0441\u0438\u043D\u0456\u0439,
        \u0437\u0431\u0430\u043B\u0430\u043D\u0441\u043E\u0432\u0430\u043D\u0438\u0439
        \u043A\u0438\u0441\u043B\u043E-\u0441\u043E\u043B\u043E\u0434\u043A\u0438\u0439"
      ro: "Albastru-violet \xEEnchis, echilibrat acru-dulce"
      no: "Dyp lilla-bl\xE5, balansert sur-s\xF8t"
      hu: "\xC1fonyal\xE9"
      sw: Maji ya bluberi
      sr: Sok od borovnica
      fi: "Dyb lilla-bl\xE5"
      da: Syv lilla-sininen
    - cn: "\u91D1\u9EC4\u6D53\u7A20\uFF0C\u6E29\u6DA6\u987A\u6ED1\uFF0C\u6EE1\u6EE1\u90FD\u662F\u8C37\u7269\u7684\u81EA\u7136\u82AC\u82B3\u3002"
      en: Golden and thick, smooth and mellow, full of natural cereal fragrance.
      tw: "\u91D1\u9EC3\u6FC3\u7A20\uFF0C\u6EAB\u6F64\u9806\u6ED1\uFF0C\u5145\u6EFF\u7A40\u7269\u81EA\u7136\u82AC\u82B3"
      ja: "\u9EC4\u91D1\u8272\u3067\u6FC3\u539A\u3001\u7A40\u7269\u306E\u81EA\u7136\u306A\u9999\u308A"
      ko: "\uD669\uAE08\uBE5B \uAC78\uCB49\uD55C \uACE1\uBB3C\uC758 \uC790\uC5F0
        \uD5A5\uAE30\uAC00 \uAC00\uB4DD\uD55C"
      fr: "Boisson c\xE9r\xE9ali\xE8re onctueuse"
      de: Goldene Getreidedicke mit Naturaroma
      ru: "\u0417\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0439 \u0433\u0443\u0441\u0442\u043E\u0439
        \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0441 \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C
        \u0437\u043B\u0430\u043A\u043E\u0432"
      es: Bebida de cereal espesa y suave
      pt: Bebida de cereais espessa
      it: Bevanda ai cereali densa e liscia
      tr: "Alt\u0131n renkli k\u0131vaml\u0131 tah\u0131l i\xE7ece\u011Fi"
      vi: "Th\u1EE9c u\u1ED1ng \u0111\u1EB7c s\xE1nh v\xE0ng \u01B0\u01A1m th\u01A1m
        ng\u0169 c\u1ED1c"
      th: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E14\u0E37\u0E48\u0E21\u0E18\u0E31\u0E0D\u0E1E\u0E37\u0E0A\u0E02\u0E49\u0E19\u0E2A\u0E35\u0E17\u0E2D\u0E07"
      pl: "Z\u0142oty g\u0119sty nap\xF3j zbo\u017Cowy"
      nl: Gouden dikke graandrank
      el: "\u03A7\u03C1\u03C5\u03C3\u03CC \u03C0\u03C5\u03BA\u03BD\u03CC \u03B4\u03B7\u03BC\u03B7\u03C4\u03C1\u03B9\u03B1\u03BA\u03CC
        \u03C0\u03BF\u03C4\u03CC"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u0633\u0645\u064A\u0643 \u0630\u0647\u0628\u064A
        \u0628\u0631\u0627\u0626\u062D\u0629 \u0627\u0644\u062D\u0628\u0648\u0628"
      hi: "\u0938\u0941\u0928\u0939\u0930\u093E \u0914\u0930 \u0917\u093E\u0922\u093C\u093E,
        \u092E\u0941\u0932\u093E\u092F\u092E \u0914\u0930 \u092E\u0927\u0941\u0930,
        \u0905\u0928\u093E\u091C \u0915\u0940 \u092A\u094D\u0930\u093E\u0915\u0943\u0924\u093F\u0915
        \u0938\u0941\u0917\u0902\u0927 \u0938\u0947 \u092D\u0930\u092A\u0942\u0930"
      ur: "\u0633\u0646\u06C1\u0631\u06CC \u0627\u0648\u0631 \u06AF\u0627\u0691\u06BE\u0627\u060C
        \u06C1\u0645\u0648\u0627\u0631 \u0627\u0648\u0631 \u0646\u0631\u0645\u060C
        \u0627\u0646\u0627\u062C \u06A9\u06CC \u0642\u062F\u0631\u062A\u06CC \u062E\u0648\u0634\u0628\u0648
        \u0633\u06D2 \u0628\u06BE\u0631\u067E\u0648\u0631\u06D4"
      ms: Keemasan dan pekat, licin dan lembut, penuh wangi bijirin semula jadi.
      id: Emas dan kental, halus dan lembut, penuh aroma sereal alami.
      he: "\u05D6\u05D4\u05D5\u05D1 \u05D5\u05E1\u05DE\u05D9\u05DA, \u05E8\u05D9\u05D7
        \u05D3\u05D2\u05E0\u05D9\u05DD \u05D8\u05D1\u05E2\u05D9"
      sv: "Gyllene och tjock, med naturlig spannm\xE5lsarom"
      cs: "Zlat\xE1 a hust\xE1, s p\u0159\xEDrodn\xED v\u016Fn\xED"
      uk: "\u0417\u043E\u043B\u043E\u0442\u0438\u0439 \u0442\u0430 \u0433\u0443\u0441\u0442\u0438\u0439,
        \u0437 \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u0438\u043C
        \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C \u0437\u043B\u0430\u043A\u0456\u0432"
      ro: "Auriu \u0219i dens, cu arom\u0103 natural\u0103 de cereale"
      no: Gylden og tykk, med naturlig kornaroma
      hu: "Kukorical\xE9"
      sw: Maji ya mahindi
      sr: Sok od kukuruza
      fi: Gylden og velsmagende
      da: "Kullanv\xE4rinen ja maukas"
    - cn: "\u85AF\u8868\u76AE\u5FAE\u7126\uFF0C\u5185\u90E8\u8F6F\u7CEF\u9999\u751C\uFF0C\u70ED\u6C14\u817E\u817E\u3002"
      en: Slightly charred on the outside, soft and sweet inside, steaming hot and
        satisfying.
      tw: "\u85AF\u8868\u76AE\u5FAE\u7126\uFF0C\u5167\u90E8\u8EDF\u7CEF\u9999\u751C\uFF0C\u71B1\u6C23\u9A30\u9A30"
      ja: "\u8868\u9762\u306F\u9999\u3070\u3057\u304F\u4E2D\u306F\u307B\u304F\u307B\u304F\u306E\u713C\u304D\u828B"
      ko: "\uAC89\uC740 \uC0B4\uC9DD \uADF8\uC744\uB9AC\uACE0 \uC18D\uC740 \uB2EC\uCF64\uD55C
        \uB728\uAC70\uC6B4 \uACE0\uAD6C\uB9C8"
      fr: "Patate douce l\xE9g\xE8rement caram\xE9lis\xE9e"
      de: "S\xFC\xDFkartoffel mit knuspriger Schale"
      ru: "\u0421\u043B\u0430\u0434\u043A\u0438\u0439 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C
        \u0441 \u0445\u0440\u0443\u0441\u0442\u044F\u0449\u0435\u0439 \u043A\u043E\u0440\u043E\u0447\u043A\u043E\u0439"
      es: Batata ligeramente quemada
      pt: Batata-doce caramelizada
      it: Patata dolce leggermente bruciacchiata
      tr: "Hafif yan\u0131k kabuklu tatl\u0131 patates"
      vi: "Khoai lang n\u01B0\u1EDBng th\u01A1m l\u1EEBng"
      th: "\u0E21\u0E31\u0E19\u0E40\u0E17\u0E28\u0E2D\u0E1A\u0E01\u0E23\u0E2D\u0E1A\u0E19\u0E2D\u0E01\u0E19\u0E38\u0E48\u0E21\u0E43\u0E19"
      pl: "S\u0142odki ziemniak z chrupi\u0105c\u0105 sk\xF3rk\u0105"
      nl: Lichtgebakken zoete aardappel
      el: "\u0393\u03BB\u03C5\u03BA\u03BF\u03C0\u03B1\u03C4\u03AC\u03C4\u03B1 \u03BC\u03B5
        \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03CC \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03CC"
      ar: "\u0628\u0637\u0627\u0637\u0627 \u062D\u0644\u0648\u0629 \u0645\u0634\u0648\u064A\u0629
        \u0628\u0642\u0634\u0631\u0629 \u0645\u0642\u0631\u0645\u0634\u0629"
      hi: "\u092C\u093E\u0939\u0930 \u0938\u0947 \u0939\u0932\u094D\u0915\u093E \u091C\u0932\u093E,
        \u0905\u0902\u0926\u0930 \u0938\u0947 \u0928\u0930\u092E \u0914\u0930 \u092E\u0940\u0920\u093E,
        \u0917\u0930\u094D\u092E \u0914\u0930 \u0938\u0902\u0924\u094B\u0937\u091C\u0928\u0915"
      ur: "\u0628\u0627\u06C1\u0631 \u0633\u06D2 \u06C1\u0644\u06A9\u0627 \u062C\u0644\u0627\u060C
        \u0627\u0646\u062F\u0631 \u0633\u06D2 \u0646\u0631\u0645 \u0627\u0648\u0631
        \u0645\u06CC\u0679\u06BE\u0627\u060C \u06AF\u0631\u0645 \u0627\u0648\u0631
        \u0627\u0637\u0645\u06CC\u0646\u0627\u0646 \u0628\u062E\u0634\u06D4"
      ms: Luar sedikit hangus, dalam lembut dan manis, panas berwap dan memuaskan.
      id: Luar sedikit gosong, dalam lembut dan manis, panas mengepul dan memuaskan.
      he: "\u05E4\u05E8\u05D9\u05DA \u05DE\u05D1\u05D7\u05D5\u05E5, \u05E8\u05DA
        \u05DE\u05D1\u05E4\u05E0\u05D9\u05DD, \u05E8\u05D9\u05D7 \u05DE\u05EA\u05D5\u05E7"
