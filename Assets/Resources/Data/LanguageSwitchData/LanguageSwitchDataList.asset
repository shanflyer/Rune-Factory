        \u03B1\u03BD\u03B1\u03C1\u03C1\u03B9\u03C7\u03B7\u03C4\u03B9\u03BA\u03BF\u03CD
        \u03C6\u03C5\u03C4\u03BF\u03CD"
      ar: "\u0633\u0627\u0642 \u0646\u0628\u0627\u062A \u0645\u062A\u064A\u0646"
      hi: "\u092C\u0947\u0932 \u0935\u093E\u0932\u0947 \u092A\u094C\u0927\u0947 \u0915\u093E
