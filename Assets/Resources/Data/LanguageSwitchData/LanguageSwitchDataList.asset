        \u0916\u0941\u0936\u092C\u0942"
      ur: "\u0633\u0646\u06C1\u0631\u06CC\u060C \u0628\u06BE\u0631\u0627 \u06C1\u0648\u0627\u060C
        \u0628\u06BE\u0646\u06CC \u06C1\u0648\u0626\u06CC \u0627\u0648\u0631 \u0645\u06CC\u0679\u06BE\u06CC
        \u062E\u0648\u0634\u0628\u0648\u06D4"
