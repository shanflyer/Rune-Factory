      el: "\u03A0\u03BB\u03BF\u03CD\u03C3\u03B9\u03B1 \u03B3\u03B5\u03CD\u03C3\u03B7
        \u03B8\u03B1\u03BB\u03B1\u03C3\u03C3\u03B9\u03BD\u03CE\u03BD"
      ar: "\u0645\u0632\u064A\u062C \u0645\u0646 \u0627\u0644\u0645\u0623\u0643\u0648\u0644\u0627\u062A
        \u0627\u0644\u0628\u062D\u0631\u064A\u0629 \u0627\u0644\u063A\u0646\u064A\u0629"
      hi: "\u0938\u092E\u0941\u0926\u094D\u0930\u0940 \u092D\u094B\u091C\u0928 \u0915\u093E
        \u092E\u093F\u0936\u094D\u0930\u0923, \u0938\u092E\u0943\u0926\u094D\u0927,
        \u0938\u0941\u0917\u0902\u0927\u093F\u0924, \u0938\u092E\u0941\u0926\u094D\u0930\u0940
        \u0938\u094D\u0935\u093E\u0926"
      ur: "\u0633\u0645\u0646\u062F\u0631\u06CC \u06A9\u06BE\u0627\u0646\u06D2 \u06A9\u0627
        \u0645\u0631\u06A9\u0628\u060C \u06AF\u0627\u0691\u06BE\u0627\u060C \u062E\u0648\u0634\u0628\u0648
        \u062F\u0627\u0631\u060C \u0633\u0645\u0646\u062F\u0631\u06CC \u0630\u0627\u0626\u0642\u06C1\u06D4"
      ms: Campuran makanan laut, kaya, wangi, penuh rasa laut.
      id: Campuran makanan laut, kaya, harum, penuh rasa laut.
      he: "\u05DE\u05D2\u05D5\u05D5\u05DF \u05E4\u05D9\u05E8\u05D5\u05EA \u05D9\u05DD,
        \u05D8\u05E2\u05DD \u05E2\u05E9\u05D9\u05E8"
      sv: "En m\xE5ngfald av skaldjur, rik smak"
      cs: "R\u016Fzn\xE9 mo\u0159sk\xE9 plody, bohat\xE1 chu\u0165"
      uk: "\u0420\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456
        \u043C\u043E\u0440\u0435\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438,
        \u043D\u0430\u0441\u0438\u0447\u0435\u043D\u0438\u0439 \u0441\u043C\u0430\u043A"
