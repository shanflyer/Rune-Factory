        \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 [\u03A6\u03B1\u03BD\u03C4\u03B1\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
        \u0388\u03C6\u03BF\u03B4\u03BF\u03C2]"
      ar: "\u0631\u0645\u062D \u0633\u0631\u064A\u0639 \u064A\u0645\u0643\u0646\u0647
