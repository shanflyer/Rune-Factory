      ur: "\u0627\u0646\u0633\u0627\u0646 \u06A9\u0627 \u062F\u0644 \u06C1\u0645\u06CC\u0634\u06C1
        \u0628\u0631\u0627 \u06C1\u0648\u062A\u0627 \u06C1\u06D2\u2026"
      ms: "Hati manusia sentiasa hodoh\u2026"
      id: "Hati manusia selalu buruk\u2026"
    - cn: "\u5509,\u600E\u4E48\u4F1A\u8FD9\u6837\u2026"
