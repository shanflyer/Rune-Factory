      tw: "\u5145\u6EFF\u6D3B\u529B\uFF0C\u53E3\u5473\u6E05\u65B0\uFF0C\u5F77\u5F7F\u5E36\u4F86\u967D\u5149\u822C\u7684\u5FEB\u6A02\u8207\u6EAB\u6696"
      ja: "\u6D3B\u6C17\u306B\u6E80\u3061\u305F\u3055\u308F\u3084\u304B\u306A\u5473\u308F\u3044\u304C\u592A\u967D\u306E\u306C\u304F\u3082\u308A\u3092\u904B\u3076"
