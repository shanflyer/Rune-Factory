      tw: "\u672A\u52A0\u5DE5\u904E\u7684\u539F\u59CB\u6728\u6599"
      ja: "\u672A\u52A0\u5DE5\u306E\u539F\u6728"
      ko: "\uAC00\uACF5\uB418\uC9C0 \uC54A\uC740 \uC6D0\uBAA9"
      fr: "Bois brut non trait\xE9"
