      cs: "K\u0159upav\xFD venku, m\u011Bkk\xFD uvnit\u0159, sladk\xE1 v\u016Fn\u011B"
      uk: "\u0425\u0440\u0443\u0441\u0442\u043A\u0438\u0439 \u0437\u043E\u0432\u043D\u0456,
        \u043C'\u044F\u043A\u0438\u0439 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456,
        \u0441\u043E\u043B\u043E\u0434\u043A\u0438\u0439 \u0430\u0440\u043E\u043C\u0430\u0442"
      ro: "Crocant pe exterior, moale \xEEn interior, arom\u0103 dulce"
