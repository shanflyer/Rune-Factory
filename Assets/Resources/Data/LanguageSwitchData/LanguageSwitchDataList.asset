      vi: "B\xE0o t\u1EED n\u1EA5m \u1EA3o gi\xE1c"
      th: "\u0E2A\u0E1B\u0E2D\u0E23\u0E4C\u0E40\u0E2B\u0E47\u0E14\u0E2B\u0E25\u0E2D\u0E19"
      pl: "Zarodniki Halucynogennych Grzyb\xF3w"
      nl: Hallucinogene Paddenstoelsporen
      el: "\u03A3\u03C0\u03CC\u03C1\u03BF\u03B9 \u03C0\u03B1\u03C1\u03B1\u03B9\u03C3\u03B8\u03B7\u03C3\u03B9\u03BF\u03B3\u03CC\u03BD\u03C9\u03BD
        \u03BC\u03B1\u03BD\u03B9\u03C4\u03B1\u03C1\u03B9\u03CE\u03BD"
      ar: "\u062C\u0631\u0627\u062B\u064A\u0645 \u0641\u0637\u0631 \u0645\u0647\u0644\u0648\u0633"
      hi: "\u092E\u093E\u092F\u093E\u0935\u0940 \u092E\u0936\u0930\u0942\u092E \u0915\u0947
        \u092C\u0940\u091C\u093E\u0923\u0941"
      ur: "\u0645\u0627\u06CC\u0627\u0648\u06CC \u0645\u0634\u0631\u0648\u0645 \u06A9\u06D2
        \u0628\u06CC\u062C"
      ms: Spora cendawan halusinogen
