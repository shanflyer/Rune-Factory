      ar: "\u0627\u0643\u062A\u0633\u0627\u0628 \u0648\u0635\u0641\u0629 \u062C\u062F\u064A\u062F\u0629!"
      hi: "\u0928\u0908 \u0935\u093F\u0927\u093F \u092E\u093F\u0932\u0940!"
