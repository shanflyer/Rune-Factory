      th: "\u0E25\u0E33\u0E15\u0E49\u0E19\u0E40\u0E2B\u0E19\u0E35\u0E22\u0E27\u0E02\u0E2D\u0E07\u0E1E\u0E37\u0E0A\u0E44\u0E21\u0E49\u0E40\u0E25\u0E37\u0E49\u0E2D\u0E22"
      pl: "Wytrzyma\u0142a \u0142odyga pn\u0105cza"
      nl: Stevige stengel van een klimplant
