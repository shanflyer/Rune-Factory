        \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0633\u0646\u06C1\u0631\u06CC\u060C \u0646\u0631\u0645\u060C \u0627\u0648\u0631
        \u0634\u0627\u0646\u062F\u0627\u0631 \u0630\u0627\u0626\u0642\u06C1 \u062F\u06CC\u062A\u0627
        \u06C1\u06D2\u06D4"
      ms: Keemasan, lembut, dengan rasa mewah.
      id: Keemasan, lembut, memberikan rasa mewah pada makanan.
    - cn: "\u54B8\u9178\u9002\u5EA6\uFF0C\u723D\u8106\u5F00\u80C3\uFF0C\u4E3A\u9910\u684C\u589E\u6DFB\u4E00\u4EFD\u72EC\u7279\u7684\u98CE\u5473\u3002"
