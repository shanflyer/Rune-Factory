      tw: "\u53EF\u4EE5\u5FEB\u901F\u653B\u64CA\u7684\u9577\u69CD\uFF0C\u53EF\u4EE5\u767C\u52D5[\u5E7B\u5F71\u7A81\u523A]\u6280\u80FD"
      ja: "\u7D20\u65E9\u3044\u9577\u69CD\u3001[\u5E7B\u5F71\u7A81\u304D]\u30B9\u30AD\u30EB\u3092\u767A\u52D5\u53EF\u80FD"
      ko: "\uBE60\uB978 \uC7A5\uCC3D, [\uD658\uC601 \uCC0C\uB974\uAE30] \uC2A4\uD0AC
