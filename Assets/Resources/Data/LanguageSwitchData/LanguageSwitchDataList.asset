      ar: "\u0646\u0633\u064A\u062C \u0645\u0637\u0627\u0637\u064A \u0641\u064A \u0627\u0644\u0645\u0631\u0642"
      hi: "\u091A\u092C\u093E\u0928\u0947 \u092F\u094B\u0917\u094D\u092F \u092C\u0928\u093E\u0935\u091F
