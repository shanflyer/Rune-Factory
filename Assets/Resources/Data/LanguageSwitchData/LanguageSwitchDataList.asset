      ko: "\uD658\uAC01\uC131 \uBC84\uC12F \uD3EC\uC790"
      fr: "Spores de champignon hallucinog\xE8ne"
      de: Halluzinogene Pilzsporen
      ru: "\u0421\u043F\u043E\u0440\u044B \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u0445
