      uk: "\u041F\u0435\u0440\u0448\u0456 <color=red>3</color>\_\u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043A\u0438
        \u0449\u043E\u0434\u043D\u044F \u043C\u043E\u0436\u0443\u0442\u044C \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438
        \u0440\u0456\u0432\u0435\u043D\u044C \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0456"
