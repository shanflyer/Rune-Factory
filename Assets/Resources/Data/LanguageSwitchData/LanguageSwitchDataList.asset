      sv: "Bl\xE4ckfisk p\xE5 havsbotten, armar r\xF6r sig smidigt"
      cs: "Chobotnice na mo\u0159sk\xE9m dn\u011B, chapadla se pohybuj\xED pru\u017En\u011B"
      uk: "\u0412\u043E\u0441\u044C\u043C\u0438\u043D\u0456\u0433 \u043D\u0430 \u043C\u043E\u0440\u0441\u044C\u043A\u043E\u043C\u0443
        \u0434\u043D\u0456, \u0449\u0443\u043F\u0430\u043B\u044C\u0446\u044F \u0440\u0443\u0445\u0430\u044E\u0442\u044C\u0441\u044F
        \u0433\u043D\u0443\u0447\u043A\u043E"
      ro: "Caracati\u021B\u0103 pe fundul m\u0103rii, tentaculele se mi\u0219c\u0103
