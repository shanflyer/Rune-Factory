        \u0924\u093E\u091C\u093C\u0917\u0940\u0926\u093E\u092F\u0915"
      ur: "\u0686\u0642\u0646\u062F\u0631 \u0627\u06CC\u06A9 \u0627\u0646\u0648\u06A9\u06BE\u0627
