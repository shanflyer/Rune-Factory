      th: "\u0E1C\u0E31\u0E01\u0E2A\u0E14\u0E01\u0E23\u0E2D\u0E1A\u0E2B\u0E25\u0E32\u0E01\u0E0A\u0E19\u0E34\u0E14\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E2A\u0E38\u0E02\u0E20\u0E32\u0E1E"
      pl: "\u015Awie\u017Ca chrupi\u0105ca mieszanka warzywna"
      nl: Verse knapperige groentemix
      el: "\u03A6\u03C1\u03AD\u03C3\u03BA\u03B1 \u03C4\u03C1\u03B1\u03B3\u03B1\u03BD\u03AC
        \u03BB\u03B1\u03C7\u03B1\u03BD\u03B9\u03BA\u03AC"
      ar: "\u062E\u0644\u064A\u0637 \u062E\u0636\u0631\u0648\u0627\u062A \u0637\u0627\u0632\u062C\u0629
        \u0648\u0645\u0642\u0631\u0645\u0634\u0629"
      hi: "\u0924\u093E\u091C\u093C\u093E \u0914\u0930 \u0915\u0941\u0930\u0915\u0941\u0930\u093E,
        \u0938\u094D\u0935\u0938\u094D\u0925 \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F
        \u0938\u092C\u094D\u091C\u093C\u093F\u092F\u094B\u0902 \u0915\u093E \u092E\u093F\u0936\u094D\u0930\u0923"
      ur: "\u062A\u0627\u0632\u06C1 \u0627\u0648\u0631 \u06A9\u0631\u06A9\u0631\u0627\u060C
        \u0635\u062D\u062A \u0645\u0646\u062F \u0627\u0648\u0631 \u0644\u0630\u06CC\u0630
        \u0633\u0628\u0632\u06CC\u0648\u06BA \u06A9\u0627 \u0645\u0631\u06A9\u0628\u06D4"
      ms: Segar dan rangup, campuran sayuran sihat dan sedap.
      id: Segar dan renyah, campuran sayuran sehat dan lezat.
      he: "\u05D8\u05E8\u05D9 \u05D5\u05E4\u05E8\u05D9\u05DA, \u05D9\u05E8\u05E7\u05D5\u05EA
        \u05E8\u05D1\u05D9\u05DD, \u05D1\u05E8\u05D9\u05D0 \u05D5\u05D8\u05E2\u05D9\u05DD"
      sv: "F\xE4rsk och knaprig, m\xE5nga gr\xF6nsaker, nyttig och god"
      cs: "\u010Cerstv\xE9 a k\u0159upav\xE9, r\u016Fzn\xE9 zeleniny, zdrav\xE9 a
        chutn\xE9"
      uk: "\u0421\u0432\u0456\u0436\u0438\u0439 \u0456 \u0445\u0440\u0443\u0441\u0442\u043A\u0438\u0439,
        \u0440\u0456\u0437\u043D\u0456 \u043E\u0432\u043E\u0447\u0456, \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0439
        \u0456 \u0441\u043C\u0430\u0447\u043D\u0438\u0439"
