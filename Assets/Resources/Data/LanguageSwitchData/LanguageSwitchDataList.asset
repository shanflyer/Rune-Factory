      tw: "\u71DF\u990A\u8C50\u5BCC\uFF0C\u53E3\u611F\u9187\u539A\u7D72\u6ED1\uFF0C\u9069\u5408\u591A\u7A2E\u70F9\u98EA"
      ja: "\u6804\u990A\u8C4A\u5BCC\u3067\u30AF\u30EA\u30FC\u30DF\u30FC\u3001\u69D8\u3005\u306A\u6599\u7406\u306B\u6700\u9069"
      ko: "\uC601\uC591 \uAC00\uB4DD\uD558\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uC2DD\uAC10\uC73C\uB85C
        \uB2E4\uC591\uD55C \uC694\uB9AC\uC5D0 \uC801\uD569"
