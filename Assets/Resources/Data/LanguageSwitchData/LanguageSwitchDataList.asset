    - cn: "\u9009\u62E9\u5B58\u6863"
      en: Select Save File
      tw: "\u9078\u64C7\u5B58\u6A94"
      ja: "\u30BB\u30FC\u30D6\u30D5\u30A1\u30A4\u30EB\u3092\u9078\u629E"
      ko: "\uC800\uC7A5 \uD30C\uC77C \uC120\uD0DD"
      fr: "S\xE9lectionner un fichier de sauvegarde"
      de: "Speicherstand ausw\xE4hlen"
      ru: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
      es: Seleccionar archivo guardado
      pt: Selecionar arquivo salvo
      it: Seleziona file di salvataggio
      tr: "Kay\u0131t dosyas\u0131 se\xE7"
      vi: "Ch\u1ECDn t\u1EADp tin l\u01B0u"
      th: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E44\u0E1F\u0E25\u0E4C\u0E40\u0E0B\u0E1F"
      pl: Wybierz zapis
      nl: Selecteer opslagbestand
      el: "\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF\u03C5
        \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7\u03C2"
      ar: "\u062A\u062D\u062F\u064A\u062F \u0645\u0644\u0641 \u0627\u0644\u062D\u0641\u0638"
      hi: " \u0938\u0947\u0935 \u092B\u093C\u093E\u0907\u0932 \u091A\u0941\u0928\u0947\u0902 "
