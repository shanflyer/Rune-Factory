      ar: "\u062E\u0627\u0645 \u063A\u0646\u064A \u0628\u0627\u0644\u062D\u062F\u064A\u062F"
      hi: "\u0932\u094C\u0939 \u0924\u0924\u094D\u0935 \u0938\u0947 \u092D\u0930\u092A\u0942\u0930
        \u0905\u092F\u0938\u094D\u0915"
      ur: "\u0644\u0648\u06C1\u06D2 \u0633\u06D2 \u0628\u06BE\u0631\u067E\u0648\u0631
