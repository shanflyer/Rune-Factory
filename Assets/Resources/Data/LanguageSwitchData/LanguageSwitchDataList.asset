      th: "\u0E2D\u0E38\u0E14\u0E21\u0E2A\u0E32\u0E23\u0E2D\u0E32\u0E2B\u0E32\u0E23
        \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E04\u0E23\u0E35\u0E21\u0E40\u0E2B\u0E21\u0E32\u0E30\u0E01\u0E31\u0E1A\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E2B\u0E25\u0E32\u0E01\u0E2B\u0E25\u0E32\u0E22"
      pl: "Bogate w sk\u0142adniki od\u017Cywcze i kremowe"
      nl: Voedzaam en romig voor diverse gerechten
      el: "\u03A0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF \u03C3\u03B5 \u03B8\u03C1\u03B5\u03C0\u03C4\u03B9\u03BA\u03AC
        \u03C3\u03C5\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9
        \u03BA\u03C1\u03B5\u03BC\u03CE\u03B4\u03B5\u03C2"
      ar: "\u063A\u0646\u064A \u0628\u0627\u0644\u0645\u063A\u0630\u064A\u0627\u062A
        \u0648\u0643\u0631\u064A\u0645\u064A \u064A\u0646\u0627\u0633\u0628 \u0623\u0637\u0628\u0627\u0642
        \u0645\u062A\u0646\u0648\u0639\u0629"
      hi: "\u092A\u094B\u0937\u0915 \u0924\u0924\u094D\u0935\u094B\u0902 \u0938\u0947
        \u092D\u0930\u092A\u0942\u0930, \u092E\u0941\u0932\u093E\u092F\u092E \u0914\u0930
        \u0915\u094D\u0930\u0940\u092E\u0940"
      ur: "\u063A\u0630\u0627\u0626\u06CC\u062A \u0633\u06D2 \u0628\u06BE\u0631\u067E\u0648\u0631\u060C
        \u06C1\u0645\u0648\u0627\u0631 \u0627\u0648\u0631 \u06A9\u0631\u06CC\u0645\u06CC"
      ms: Kaya nutrisi dengan tekstur lembut
      id: Kaya nutrisi dengan tekstur lembut
    - cn: "\u5706\u6DA6\u6676\u83B9\uFF0C\u662F\u53A8\u623F\u4E2D\u4E07\u80FD\u7684\u7F8E\u5473\u62C5\u5F53\u3002"
      en: "Plump and glistening, it\u2019s a versatile staple of the kitchen."
      tw: "\u5713\u6F64\u6676\u7469\uFF0C\u662F\u5EDA\u623F\u4E2D\u7684\u842C\u80FD\u7F8E\u5473\u64D4\u7576"
      ja: "\u3077\u3063\u304F\u308A\u8F1D\u304F\u4E07\u80FD\u98DF\u6750"
      ko: "\uB3D9\uADF8\uB797\uACE0 \uBC18\uC9DD\uC774\uB294 \uC8FC\uBC29\uC758 \uB9CC\uB2A5
        \uC7AC\uB8CC"
      fr: Aliment polyvalent brillant et charnu
      de: "Vielseitiger K\xFCchenstar mit Glanz"
      ru: "\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
        \u043A\u0443\u0445\u043E\u043D\u043D\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442"
      es: "Alimento vers\xE1til y reluciente"
      pt: "Alimento vers\xE1til brilhante"
      it: Ingrediente lucido e versatile
      tr: "Dolgun ve parlak mutfak yard\u0131mc\u0131s\u0131"
      vi: "Tr\xF2n b\xF3ng, nguy\xEAn li\u1EC7u \u0111a n\u0103ng trong b\u1EBFp"
      th: "\u0E27\u0E31\u0E15\u0E16\u0E38\u0E14\u0E34\u0E1A\u0E2B\u0E25\u0E32\u0E01\u0E2B\u0E25\u0E32\u0E22\u0E23\u0E39\u0E1B\u0E17\u0E23\u0E07\u0E01\u0E25\u0E21\u0E41\u0E27\u0E27\u0E27\u0E32\u0E27"
      pl: "Uniwersalny b\u0142yszcz\u0105cy sk\u0142adnik"
      nl: "Veelzijdig glanzend keukeningredi\xEBnt"
      el: "\u039B\u03B1\u03BC\u03C0\u03B5\u03C1\u03CC \u03BA\u03B1\u03B9 \u03B5\u03C5\u03AD\u03BB\u03B9\u03BA\u03C4\u03BF
        \u03C3\u03C5\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC"
      ar: "\u0645\u0627\u062F\u0629 \u0644\u0627\u0645\u0639\u0629 \u0645\u062A\u0639\u062F\u062F\u0629
        \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0627\u062A \u0641\u064A
        \u0627\u0644\u0645\u0637\u0628\u062E"
      hi: "\u0917\u094B\u0932 \u0914\u0930 \u091A\u092E\u0915\u0926\u093E\u0930,
        \u0930\u0938\u094B\u0908 \u0915\u093E \u092C\u0939\u0941\u092E\u0941\u0916\u0940
        \u0938\u093E\u092E\u093E\u0928"
      ur: "\u06AF\u0648\u0644 \u0627\u0648\u0631 \u0686\u0645\u06A9\u062F\u0627\u0631\u060C
        \u0628\u0627\u0648\u0631\u0686\u06CC \u062E\u0627\u0646\u06D2 \u06A9\u0627
        \u06C1\u0631\u0637\u0631\u062D \u06A9\u0627 \u0633\u0627\u0645\u0627\u0646"
      ms: Bahan serbaguna berkilat dan bulat di dapur
      id: Bahan serbaguna mengkilap dan bulat di dapur
    - cn: "\u80FD\u53D8\u5E7B\u51FA\u591A\u6837\u98CE\u5473\uFF0C\u6EE1\u8DB3\u4F17\u591A\u98DF\u5BA2\u7684\u9700\u6C42\u3002"
      en: Capable of transforming into various flavors to satisfy many palates.
      tw: "\u80FD\u8B8A\u5E7B\u591A\u6A23\u98A8\u5473\uFF0C\u6EFF\u8DB3\u773E\u591A\u98DF\u5BA2\u9700\u6C42"
      ja: "\u591A\u5F69\u306A\u5473\u306B\u5909\u5316\u3057\u591A\u304F\u306E\u820C\u3092\u6E80\u8DB3\u3055\u305B\u308B"
      ko: "\uB2E4\uC591\uD55C \uB9DB\uC73C\uB85C \uBCC0\uC2E0\uD574 \uB9CE\uC740
        \uC2DD\uAC1D\uC744 \uB9CC\uC871\uC2DC\uD0A4\uB294"
      fr: "Multifonctionnel pour satisfaire tous les go\xFBts"
      de: Vielseitiger Geschmackswandler
      ru: "\u041F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u043A\u0443\u0441\u044B"
      es: "Transformador de sabores vers\xE1til"
      pt: "Transformador de sabores m\xFAltiplos"
      it: Trasformatore di sapori versatile
      tr: "\xC7e\u015Fitli lezzetlere d\xF6n\xFC\u015Febilen \xE7ok y\xF6nl\xFC"
      vi: "Bi\u1EBFn \u0111\u1ED5i \u0111a d\u1EA1ng h\u01B0\u01A1ng v\u1ECB \u0111\xE1p
        \u1EE9ng th\u1EF1c kh\xE1ch"
      th: "\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E23\u0E2A\u0E44\u0E14\u0E49\u0E2B\u0E25\u0E32\u0E01\u0E2B\u0E25\u0E32\u0E22"
      pl: "Uniwersalny zmieniacz smak\xF3w"
      nl: Veelzijdige smaaktransformatie
      el: "\u03A0\u03BF\u03BB\u03CD\u03C0\u03BB\u03B5\u03C5\u03C1\u03BF\u03C2 \u03BC\u03B5\u03C4\u03B1\u03C4\u03C1\u03BF\u03C0\u03AD\u03B1\u03C2
        \u03B3\u03B5\u03CD\u03C3\u03B7\u03C2"
      ar: "\u0642\u0627\u062F\u0631 \u0639\u0644\u0649 \u062A\u062D\u0648\u064A\u0644
        \u0627\u0644\u0646\u0643\u0647\u0627\u062A \u0644\u062A\u0644\u0628\u064A\u0629
        \u0627\u0644\u0623\u0630\u0648\u0627\u0642"
      hi: "\u0935\u093F\u0935\u093F\u0927 \u0938\u094D\u0935\u093E\u0926 \u092C\u0928\u093E\u0928\u0947
        \u092E\u0947\u0902 \u0938\u0915\u094D\u0937\u092E, \u0905\u0928\u0947\u0915
        \u092D\u094B\u091C\u0928 \u0915\u0930\u0928\u0947 \u0935\u093E\u0932\u094B\u0902
        \u0915\u0940 \u0906\u0935\u0936\u094D\u092F\u0915\u0924\u093E\u0913\u0902
        \u0915\u094B \u092A\u0942\u0930\u093E \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0645\u062E\u062A\u0644\u0641 \u0630\u0627\u0626\u0642\u0648\u06BA \u0645\u06CC\u06BA
        \u062A\u0628\u062F\u06CC\u0644 \u06C1\u0648\u0646\u06D2 \u06A9\u06CC \u0635\u0644\u0627\u062D\u06CC\u062A
        \u0631\u06A9\u06BE\u062A\u0627 \u06C1\u06D2\u060C \u06A9\u0626\u06CC \u06A9\u06BE\u0627\u0646\u06D2
        \u0648\u0627\u0644\u0648\u06BA \u06A9\u06CC \u0636\u0631\u0648\u0631\u06CC\u0627\u062A
        \u06A9\u0648 \u067E\u0648\u0631\u0627 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u06D4"
      ms: Mampu mencipta pelbagai rasa, memenuhi keperluan ramai pemakan.
      id: Mampu menciptakan berbagai rasa, memenuhi kebutuhan banyak penyantap.
    - cn: "\u9EA6\u7C7B\u7684\u7C89\u672B\uFF0C\u53EF\u6210\u4E3A\u5404\u79CD\u5F62\u72B6\uFF0C\u627F\u8F7D\u4E30\u5BCC\u53E3\u611F\u3002"
      en: Powdered grain, shaped into various forms, rich in flavor.
      tw: "\u9EA5\u985E\u7C89\u672B\uFF0C\u53EF\u5851\u591A\u7A2E\u5F62\u72C0\uFF0C\u98A8\u5473\u8C50\u5BCC"
      ja: "\u7A40\u7269\u306E\u7C89\u672B\u3067\u69D8\u3005\u306A\u5F62\u306B\u6210\u5F62\u53EF\u80FD\u3001\u5473\u308F\u3044\u6DF1\u3044"
      ko: "\uACE1\uBB3C \uAC00\uB8E8\uB85C \uB2E4\uC591\uD55C \uBAA8\uC591\uC744
        \uB9CC\uB4E4 \uC218 \uC788\uB294 \uD48D\uBBF8 \uAC00\uB4DD\uD55C \uC2DD\uD488"
      fr: "Farine c\xE9r\xE9ali\xE8re modelable et savoureuse"
      de: Getreidepulver in Formen mit vollem Geschmack
      ru: "\u0417\u0435\u0440\u043D\u043E\u0432\u0430\u044F \u043C\u0443\u043A\u0430
        \u0434\u043B\u044F \u0444\u043E\u0440\u043C\u043E\u0432\u043A\u0438"
      es: Harina de cereal con formas variadas
      pt: "Farinha de cereal mold\xE1vel"
      it: Farina cereale modellabile
      tr: "Tah\u0131l tozu \xE7e\u015Fitli \u015Fekillerde zengin lezzet"
      vi: "B\u1ED9t ng\u0169 c\u1ED1c t\u1EA1o h\xECnh \u0111a d\u1EA1ng, gi\xE0u
        h\u01B0\u01A1ng v\u1ECB"
      th: "\u0E41\u0E1B\u0E49\u0E07\u0E18\u0E31\u0E0D\u0E1E\u0E37\u0E0A\u0E2B\u0E25\u0E32\u0E01\u0E23\u0E39\u0E1B\u0E17\u0E23\u0E07
        \u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E34\u0E14\u0E35"
      pl: "M\u0105ka zbo\u017Cowa w r\xF3\u017Cnych kszta\u0142tach"
      nl: Graanpoeder in vormen met rijke smaak
      el: "\u03A3\u03BA\u03CC\u03BD\u03B7 \u03B4\u03B7\u03BC\u03B7\u03C4\u03C1\u03B9\u03B1\u03BA\u03CE\u03BD
        \u03BC\u03B5 \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03B1 \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u0645\u0633\u062D\u0648\u0642 \u0627\u0644\u062D\u0628\u0648\u0628 \u0642\u0627\u0628\u0644
        \u0644\u0644\u062A\u0634\u0643\u064A\u0644 \u0628\u0646\u0643\u0647\u0627\u062A
        \u063A\u0646\u064A\u0629"
      hi: "\u0905\u0928\u093E\u091C \u0915\u093E \u092A\u093E\u0909\u0921\u0930,
        \u0935\u093F\u092D\u093F\u0928\u094D\u0928 \u0906\u0915\u093E\u0930\u094B\u0902
        \u092E\u0947\u0902 \u0922\u093E\u0932\u093E \u091C\u093E \u0938\u0915\u0924\u093E
        \u0939\u0948, \u0938\u092E\u0943\u0926\u094D\u0927 \u0938\u094D\u0935\u093E\u0926
        \u092A\u094D\u0930\u0926\u093E\u0928 \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0627\u0646\u0627\u062C \u06A9\u0627 \u067E\u0627\u0624\u0688\u0631\u060C
        \u0645\u062E\u062A\u0644\u0641 \u0634\u06A9\u0644\u0648\u06BA \u0645\u06CC\u06BA
        \u0688\u06BE\u0627\u0644\u0627 \u062C\u0627 \u0633\u06A9\u062A\u0627 \u06C1\u06D2\u060C
        \u0630\u0627\u0626\u0642\u06D2 \u0633\u06D2 \u0628\u06BE\u0631\u067E\u0648\u0631\u06D4"
      ms: Serbuk bijirin, dibentuk menjadi pelbagai bentuk, kaya dengan rasa.
      id: Bubuk biji-bijian, dibentuk menjadi berbagai bentuk, kaya rasa.
    - cn: "\u5496\u5561\u7C89\u6563\u53D1\u6D53\u90C1\u9187\u9999\uFF0C\u51B2\u6CE1\u540E\u82E6\u6DA9\u4E0E\u9999\u9187\u4EA4\u7EC7\u3002"
      en: Coffee powder, rich and aromatic, blending bitterness and smoothness.
      tw: "\u5496\u5561\u7C89\u6563\u767C\u6FC3\u90C1\u9187\u9999\uFF0C\u6C96\u6CE1\u5F8C\u82E6\u6F80\u8207\u9999\u9187\u4EA4\u7E54"
      ja: "\u6DF1\u714E\u308A\u30B3\u30FC\u30D2\u30FC\u306E\u82E6\u307F\u3068\u9999\u308A\u304C\u8ABF\u548C"
      ko: "\uC9C4\uD55C \uD5A5\uACFC \uC4F4\uB9DB\uC774 \uC870\uD654\uB97C \uC774\uB8E8\uB294
        \uCEE4\uD53C \uAC00\uB8E8"
      fr: "Caf\xE9 moulu riche en ar\xF4mes complexes"
      de: Kaffeepulver mit Bitterkeit und Aroma
      ru: "\u041A\u043E\u0444\u0435\u0439\u043D\u044B\u0439 \u043F\u043E\u0440\u043E\u0448\u043E\u043A
        \u0441 \u0433\u043E\u0440\u044C\u043A\u043E-\u0430\u0440\u043E\u043C\u0430\u0442\u043D\u044B\u043C
        \u0432\u043A\u0443\u0441\u043E\u043C"
      es: "Caf\xE9 molido de sabor intenso"
      pt: "Caf\xE9 em p\xF3 rico e arom\xE1tico"
      it: "Caff\xE8 in polvere intenso"
      tr: "Ac\u0131 ve aromay\u0131 harmanlayan kahve tozu"
      vi: "B\u1ED9t c\xE0 ph\xEA th\u01A1m n\u1ED3ng, \u0111\u1EAFng v\xE0 h\u01B0\u01A1ng
        h\xF2a quy\u1EC7n"
      th: "\u0E1C\u0E07\u0E01\u0E32\u0E41\u0E1F\u0E23\u0E2A\u0E02\u0E21\u0E2B\u0E2D\u0E21\u0E01\u0E23\u0E38\u0E48\u0E19"
      pl: "Mielony kawa o g\u0142\u0119bokim aromacie"
      nl: Koffiepoeder met bitterzoete smaak
      el: "\u03A3\u03BA\u03CC\u03BD\u03B7 \u03BA\u03B1\u03C6\u03AD \u03BC\u03B5 \u03C0\u03B9\u03BA\u03C1\u03AE
        \u03BA\u03B1\u03B9 \u03B1\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
        \u03B3\u03B5\u03CD\u03C3\u03B7"
      ar: "\u0645\u0633\u062D\u0648\u0642 \u0642\u0647\u0648\u0629 \u063A\u0646\u064A
        \u0648\u0631\u0627\u0626\u062D\u062A\u0647 \u0645\u0631\u064A\u0631\u0629
        \u0648\u0639\u0637\u0631\u064A\u0629"
      hi: "\u0915\u0949\u092B\u093C\u0940 \u092A\u093E\u0909\u0921\u0930, \u0917\u0939\u0928
        \u0938\u0941\u0917\u0902\u0927\u093F\u0924, \u0915\u0921\u093C\u0935\u093E\u0939\u091F
        \u0914\u0930 \u092E\u093F\u0920\u093E\u0938 \u0915\u093E \u092E\u093F\u0936\u094D\u0930\u0923"
      ur: "\u06A9\u0627\u0641\u06CC \u067E\u0627\u0624\u0688\u0631\u060C \u06AF\u06C1\u0631\u06CC
        \u062E\u0648\u0634\u0628\u0648\u060C \u06A9\u0691\u0648\u0627\u06C1\u0679
        \u0627\u0648\u0631 \u0646\u0631\u0645\u06CC \u06A9\u0627 \u0627\u0645\u062A\u0632\u0627\u062C\u06D4"
      ms: Serbuk kopi, wangi pekat, gabungan pahit dan lembut.
      id: Bubuk kopi, harum pekat, perpaduan pahit dan lembut.
    - cn: "\u9165\u8106\u53EF\u53E3\uFF0C\u5E38\u4F5C\u96F6\u98DF\u6216\u5305\u88F9\u98DF\u6750\uFF0C\u589E\u6DFB\u522B\u6837\u98CE\u5473\u3002"
      en: Crisp and tasty, often a snack or wrapped around ingredients for extra
        flavor.
      tw: "\u9165\u8106\u53EF\u53E3\uFF0C\u5E38\u4F5C\u96F6\u98DF\u6216\u5305\u88F9\u98DF\u6750\u589E\u6DFB\u98A8\u5473"
      ja: "\u30B5\u30AF\u30B5\u30AF\u98DF\u611F\u306E\u30B9\u30CA\u30C3\u30AF\u3084\u98DF\u6750\u5305\u307F\u306B\u6700\u9069"
      ko: "\uBC14\uC0AD\uD55C \uC2DD\uAC10\uC758 \uAC04\uC2DD\uC774\uB098 \uC7AC\uB8CC
        \uAC10\uC2F8\uAE30\uC5D0 \uC88B\uC740"
      fr: Produit croustillant pour snacks ou enrobage
      de: "Knuspriger Snack oder Umh\xFCllung"
      ru: "\u0425\u0440\u0443\u0441\u0442\u044F\u0449\u0430\u044F \u0437\u0430\u043A\u0443\u0441\u043A\u0430
        \u0438\u043B\u0438 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430"
      es: Snack crujiente o envoltura
      pt: "Lanche crocante ou envolt\xF3rio"
      it: Snack croccante o rivestimento
      tr: "\xC7\u0131t\u0131r \xE7\u0131t\u0131r at\u0131\u015Ft\u0131rmal\u0131k
        veya sar\u0131c\u0131"
      vi: "Gi\xF2n ngon th\u01B0\u1EDDng d\xF9ng l\xE0m snack ho\u1EB7c g\xF3i nguy\xEAn
        li\u1EC7u"
      th: "\u0E02\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E07\u0E01\u0E23\u0E2D\u0E1A\u0E2B\u0E23\u0E37\u0E2D\u0E2B\u0E48\u0E2D\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E23\u0E2A"
      pl: "Chrupi\u0105ca przek\u0105ska lub otoczka"
      nl: Knapperige snack of omhulsel
      el: "\u03A4\u03C1\u03B1\u03B3\u03B1\u03BD\u03CC \u03C3\u03BD\u03B1\u03BA \u03AE
        \u03C0\u03B5\u03C1\u03B9\u03C4\u03CD\u03BB\u03B9\u03B3\u03BC\u03B1"
      ar: "\u0645\u0642\u0631\u0645\u0634 \u0643\u0648\u062C\u0628\u0629 \u062E\u0641\u064A\u0641\u0629
        \u0623\u0648 \u0644\u062A\u063A\u0644\u064A\u0641 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062A"
      hi: "\u0915\u0941\u0930\u0915\u0941\u0930\u093E \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F,
        \u0905\u0915\u094D\u0938\u0930 \u0928\u093E\u0936\u094D\u0924\u093E \u092F\u093E
        \u0938\u093E\u092E\u0917\u094D\u0930\u0940 \u0915\u094B \u0932\u092A\u0947\u091F\u0915\u0930
        \u0905\u0924\u093F\u0930\u093F\u0915\u094D\u0924 \u0938\u094D\u0935\u093E\u0926
        \u091C\u094B\u0921\u093C\u0924\u093E \u0939\u0948"
      ur: "\u06A9\u0631\u06A9\u0631\u0627 \u0627\u0648\u0631 \u0644\u0630\u06CC\u0630\u060C
        \u0627\u06A9\u062B\u0631 \u0646\u0627\u0634\u062A\u06D2 \u06CC\u0627 \u0627\u062C\u0632\u0627\u0621
        \u06A9\u0648 \u0644\u067E\u06CC\u0679 \u06A9\u0631 \u0627\u0636\u0627\u0641\u06CC
        \u0630\u0627\u0626\u0642\u06C1 \u062F\u06CC\u062A\u0627 \u06C1\u06D2\u06D4"
      ms: Rangup dan sedap, sering sebagai snek atau membalut bahan untuk rasa tambahan.
      id: Renyah dan lezat, sering sebagai camilan atau membungkus bahan untuk rasa
        unik.
    - cn: "\u9EC4\u6CB9\u8272\u6CFD\u91D1\u9EC4\uFF0C\u8D28\u5730\u67D4\u8F6F\uFF0C\u8D4B\u4E88\u98DF\u7269\u5962\u534E\u53E3\u611F\u3002"
