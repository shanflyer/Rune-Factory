      pl: "Powszechne materia\u0142y budowlane"
      nl: Algemene bouwmaterialen
      el: "\u039A\u03BF\u03B9\u03BD\u03AC \u03BF\u03B9\u03BA\u03BF\u03B4\u03BF\u03BC\u03B9\u03BA\u03AC
        \u03C5\u03BB\u03B9\u03BA\u03AC"
      ar: "\u0645\u0648\u0627\u062F \u0628\u0646\u0627\u0621 \u0634\u0627\u0626\u0639\u0629"
      hi: "\u0906\u092E \u0928\u093F\u0930\u094D\u092E\u093E\u0923 \u0938\u093E\u092E\u0917\u094D\u0930\u0940"
