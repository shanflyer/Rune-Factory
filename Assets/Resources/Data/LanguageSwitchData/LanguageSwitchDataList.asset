      ms: Manis alami yang memikat
      id: Manis alami yang memikat
    - cn: "\u5BCC\u542B\u8425\u517B\uFF0C\u53E3\u611F\u9187\u539A\u4E1D\u6ED1\uFF0C\u9002\u5408\u591A\u79CD\u70F9\u996A\u3002"
