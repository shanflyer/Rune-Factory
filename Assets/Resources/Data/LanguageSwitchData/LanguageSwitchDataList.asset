      tr: "S\u0131radan canavar, [Canavar Derisi] \xFCretir"
      vi: "Th\xFA th\u01B0\u1EDDng, s\u1EA3n xu\u1EA5t [Da th\xFA]"
      th: "\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B \u0E1C\u0E25\u0E34\u0E15
        [\u0E2B\u0E19\u0E31\u0E07\u0E2A\u0E31\u0E15\u0E27\u0E4C]"
      pl: "Zwyk\u0142a bestia, wytwarza [Bestiarsk\u0105 sk\xF3r\u0119]"
      nl: 'Gewoon beest, produceert [Beestenhuid]'
      el: "\u03A3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03B8\u03B7\u03C1\u03AF\u03BF,
        \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9 [\u0394\u03AD\u03C1\u03BC\u03B1
        \u03B8\u03B7\u03C1\u03AF\u03BF\u03C5]"
      ar: "\u0648\u062D\u0634 \u0639\u0627\u062F\u064A\u060C \u064A\u0646\u062A\u062C
        [\u062C\u0644\u062F \u0627\u0644\u0648\u062D\u0634]"
      hi: "\u0938\u093E\u0927\u093E\u0930\u0923 \u091C\u093E\u0928\u0935\u0930, [\u091C\u093E\u0928\u0935\u0930
        \u0915\u0940 \u0916\u093E\u0932] \u0909\u0924\u094D\u092A\u0928\u094D\u0928
        \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u0639\u0627\u0645 \u062C\u0627\u0646\u0648\u0631\u060C [\u062C\u0627\u0646\u0648\u0631
        \u06A9\u06CC \u06A9\u06BE\u0627\u0644] \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062A\u0627
        \u06C1\u06D2"
      ms: 'Binatang biasa, hasilkan [Kulit binatang]'
      id: 'Hewan biasa, menghasilkan [Kulit hewan]'
      he: "\u05D7\u05D9\u05D4 \u05E8\u05D2\u05D9\u05DC\u05D4, \u05D9\u05DB\u05D5\u05DC\u05D4
        \u05DC\u05D4\u05E4\u05D9\u05E7 [\u05E2\u05D5\u05E8 \u05D7\u05D9\u05D4]"
      sv: 'Vanligt djur, kan producera [djurskinn]'
      cs: "B\u011B\u017En\xE9 zv\xED\u0159e, m\u016F\u017Ee produkovat [zv\xED\u0159ec\xED
        k\u016F\u017Ee]"
      uk: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430 \u0442\u0432\u0430\u0440\u0438\u043D\u0430,
        \u043C\u043E\u0436\u0435 \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u0442\u0438
        [\u0448\u043A\u0456\u0440\u0430 \u0442\u0432\u0430\u0440\u0438\u043D\u0438]"
      ro: "Animal obi\u0219nuit, poate produce [piele de animal]"
      no: 'Vanlig dyreart, kan produsere [dyreskinn]'
      hu: "\xC1tlagos \xE1llat, termel [\xE1llatb\u0151r]"
      sw: 'Mnyama wa kawaida, hutoa [ngozi ya mnyama]'
      sr: "Obi\u010Dna \u017Eivotinja, proizvodi [ko\u017Eu]"
      fi: 'Tavallinen peto, tuottaa [Pedonnahka]'
      da: "Almindelig b\xE6st, producerer [B\xE6steskind]"
