      sv: "F\xF6rs\xE4ljningspris:"
      cs: "Prodejn\xED cena:"
      uk: "\u0426\u0456\u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0443:"
      ro: "Pre\u021B de v\xE2nzare:"
      no: 'Salgspris:'
