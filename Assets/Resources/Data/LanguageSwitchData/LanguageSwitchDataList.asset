      sw: Samaki wa pango
      sr: "Pe\u0107inska riba"
      fi: Beboer af stenhuler
      da: Kiviluolien asukas
    - cn: "\u94F6\u5149\u95EA\u95EA\uFF0C\u6E38\u901F\u98DE\u5FEB\u5982\u7BAD\uFF0C\u662F\u5927\u6D77\u8868\u9762\u7075\u52A8\u7684\u94F6\u8272\u98CE\u66B4\u3002"
      en: Flashes like silver lightning, fast as an arrow
      tw: "\u9280\u5149\u9583\u720D\uFF0C\u6E38\u901F\u5982\u7BAD\uFF0C\u4F3C\u6D77\u9762\u9280\u8272\u98A8\u66B4"
      ja: "\u9280\u306E\u7A32\u59BB\u306E\u3088\u3046\u306B\u901F\u304F\u6CF3\u304E\u56DE\u308B\u6D77\u306E\u9280\u8272\u5D50"
      ko: "\uC740\uBE5B \uBC88\uAC1C\uCC98\uB7FC \uBE60\uB974\uAC8C \uD5E4\uC5C4\uCE58\uB294
        \uBC14\uB2E4\uC758 \uC740\uC0C9 \uD3ED\uD48D"
      fr: "\xC9clair argent\xE9 fendant les flots \xE0 toute vitesse"
      de: Silberner Blitzschnellschwimmer
      ru: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0430\u044F \u043C\u043E\u043B\u043D\u0438\u044F,
        \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u043A\u0430\u043A \u0441\u0442\u0440\u0435\u043B\u0430"
      es: Pez plateado veloz como flecha
      pt: "Peixe prateado r\xE1pido como flecha"
      it: Pesce argenteo veloce come freccia
      tr: "G\xFCm\xFC\u015F \u015Fim\u015Fek gibi h\u0131zl\u0131 y\xFCzen bal\u0131k"
      vi: "C\xE1 b\u1EA1c l\u1EA5p l\xE1nh b\u01A1i nhanh nh\u01B0 t\xEAn"
      th: "\u0E1B\u0E25\u0E32\u0E40\u0E07\u0E34\u0E19\u0E41\u0E27\u0E27\u0E27\u0E32\u0E27
        \u0E27\u0E48\u0E32\u0E14\u0E38\u0E08\u0E2A\u0E32\u0E22\u0E1F\u0E49\u0E32"
      pl: "Srebrna b\u0142yskawica pruj\u0105ca przez morze"
      nl: Zilveren bliksemsnelle vis
      el: "\u0391\u03C1\u03B3\u03C5\u03C1\u03CC \u03C8\u03AC\u03C1\u03B9-\u03BA\u03B5\u03C1\u03B1\u03C5\u03BD\u03CC\u03C2
        \u03C0\u03BF\u03C5 \u03B3\u03BB\u03B9\u03C3\u03C4\u03C1\u03AC \u03C3\u03C4\u03BF
        \u03BD\u03B5\u03C1\u03CC"
      ar: "\u0633\u0645\u0643 \u0641\u0636\u064A \u0633\u0631\u064A\u0639 \u0643\u0627\u0644\u0633\u0647\u0645
        \u0641\u064A \u0627\u0644\u0628\u062D\u0631"
      hi: "\u091A\u093E\u0902\u0926\u0940 \u0915\u0940 \u092C\u093F\u091C\u0932\u0940
        \u0915\u0940 \u0924\u0930\u0939 \u091A\u092E\u0915\u0924\u0940 \u0924\u0940\u0935\u094D\u0930\u0917\u093E\u092E\u0940
        \u092E\u091B\u0932\u0940"
      ur: "\u0686\u0627\u0646\u062F\u06CC \u06A9\u06CC \u0628\u062C\u0644\u06CC \u06A9\u06CC
        \u0637\u0631\u062D \u0686\u0645\u06A9\u062A\u06CC \u062A\u06CC\u0632 \u0631\u0641\u062A\u0627\u0631
        \u0645\u0686\u06BE\u0644\u06CC"
      ms: Ikan perak laju seperti panah
      id: Ikan perak cepat seperti panah
      he: "\u05E0\u05D5\u05E6\u05E5 \u05D1\u05DB\u05E1\u05E3, \u05E9\u05D5\u05D7\u05D4
        \u05D1\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05DB\u05DE\u05D5 \u05D7\u05E5"
      sv: "Gl\xE4nser silver, simmar snabbt som en pil"
      cs: "Leskl\xE9 st\u0159\xEDbro, plave rychle jako \u0161\xEDp"
      uk: "\u0421\u0440\u0456\u0431\u043B\u044F\u0441\u0442\u0438\u0439, \u043F\u043B\u0430\u0432\u0430\u0454
        \u0448\u0432\u0438\u0434\u043A\u043E, \u044F\u043A \u0441\u0442\u0440\u0456\u043B\u0430"
      ro: "Str\u0103luce\u0219te argintiu, \xEEnoat\u0103 rapid ca o s\u0103geat\u0103"
      no: "Glitrer s\xF8lv, sv\xF8mmer raskt som en pil"
      hu: "Ez\xFCst tengeri hal, gyors"
      sw: Samaki wa bahari wa kasi
      sr: Srebrna morska riba
      fi: "S\xF8lvglinsende pilekaster"
      da: Hopeinen salamajuoksija
    - cn: "\u8EAB\u4F53\u6241\u5E73\uFF0C\u6D3B\u529B\u6EE1\u6EE1\uFF0C\u5176\u5473\u9C9C\u7F8E\u50CF\u6D77\u98CE\u643A\u6765\u7684\u6D77\u5473\u9988\u8D60\u3002"
