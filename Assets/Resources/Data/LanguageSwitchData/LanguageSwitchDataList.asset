      ja: "\u30D0\u30C3\u30B0\u306B\u3053\u308C\u4EE5\u4E0A\u5165\u308A\u307E\u305B\u3093"
      ko: "\uAC00\uBC29\uC5D0 \uB354 \uC774\uC0C1 \uB123\uC744 \uC218 \uC5C6\uC74C"
      fr: Trop d'objets pour le sac
      de: "Zu viele Gegenst\xE4nde f\xFCr den Rucksack"
      ru: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0434\u043B\u044F
        \u0440\u044E\u043A\u0437\u0430\u043A\u0430"
      es: Demasiados objetos para la mochila
      pt: Itens demais para a bolsa
      it: Troppi oggetti per la borsa
      tr: "\xC7anta i\xE7in \xE7ok fazla e\u015Fya"
      vi: "Qu\xE1 nhi\u1EC1u v\u1EADt ph\u1EA9m cho t\xFAi"
      th: "\u0E01\u0E23\u0E30\u0E40\u0E1B\u0E4B\u0E32\u0E43\u0E2A\u0E48\u0E44\u0E21\u0E48\u0E44\u0E2B\u0E27"
      pl: "Za du\u017Co przedmiot\xF3w do plecaka"
      nl: Te veel items voor de rugzak
      el: "\u03A0\u03AC\u03C1\u03B1 \u03C0\u03BF\u03BB\u03BB\u03AC \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1
        \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C4\u03C3\u03AC\u03BD\u03C4\u03B1"
      ar: "\u0644\u0627 \u064A\u0645\u0643\u0646 \u0648\u0636\u0639 \u0643\u0644
        \u0647\u0630\u0647 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0641\u064A
        \u0627\u0644\u062D\u0642\u064A\u0628\u0629"
      hi: "\u092C\u0948\u0917 \u092E\u0947\u0902 \u0907\u0924\u0928\u0940 \u091A\u0940\u091C\u093C\u0947\u0902
        \u0928\u0939\u0940\u0902 \u0906\u090F\u0902\u0917\u0940"
      ur: "\u0628\u06CC\u06AF \u0645\u06CC\u06BA \u0627\u062A\u0646\u06CC \u0686\u06CC\u0632\u06CC\u06BA
        \u0646\u06C1\u06CC\u06BA \u0622\u0626\u06CC\u06BA \u06AF\u06CC"
      ms: Beg Tak Muat Banyak Barang
      id: Tas Tak Muat Banyak Barang
      he: "\u05D4\u05EA\u05D9\u05E7 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05DB\u05D9\u05DC
        \u05DB\u05DC \u05DB\u05DA \u05D4\u05E8\u05D1\u05D4 \u05E4\u05E8\u05D9\u05D8\u05D9\u05DD"
      sv: "Ryggs\xE4cken kan inte rymma s\xE5 m\xE5nga saker"
      cs: "Batoh nem\u016F\u017Ee pojmout tolik v\u011Bc\xED"
      uk: "\u0420\u044E\u043A\u0437\u0430\u043A \u043D\u0435 \u043C\u043E\u0436\u0435
        \u0432\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
        \u0440\u0435\u0447\u0435\u0439"
