      pl: "Kolorowe warzywa pe\u0142ne sk\u0142adnik\xF3w"
      nl: Kleurrijke groenteschotel
      el: "\u03A7\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03C3\u03C4\u03AC \u03BB\u03B1\u03C7\u03B1\u03BD\u03B9\u03BA\u03AC
