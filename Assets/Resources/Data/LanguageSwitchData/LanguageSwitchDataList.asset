        \u0938\u092C\u094D\u091C\u093C\u093F\u092F\u094B\u0902 \u0915\u093E \u092E\u093F\u0936\u094D\u0930\u0923"
      ur: "\u062A\u0627\u0632\u06C1 \u0627\u0648\u0631 \u06A9\u0631\u06A9\u0631\u0627\u060C
