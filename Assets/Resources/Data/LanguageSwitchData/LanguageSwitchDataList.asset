      el: "\u0391\u03C0\u03B1\u03BB\u03CC \u03B1\u03C3\u03C0\u03C1\u03AC\u03B4\u03B9
        \u03BA\u03B1\u03B9 \u03BA\u03C1\u03B5\u03BC\u03CE\u03B4\u03B5\u03C2 \u03BA\u03C1\u03CC\u03BA\u03BF"
      ar: "\u0628\u064A\u0636 \u0628\u0628\u064A\u0627\u0636 \u0646\u0627\u0639\u0645
        \u0648\u0635\u0641\u0627\u0631 \u0643\u0631\u064A\u0645\u064A"
      hi: "\u0928\u0930\u092E \u0938\u092B\u0947\u0926\u0940, \u092E\u0932\u093E\u0908\u0926\u093E\u0930
        \u092A\u0940\u0932\u093E \u092D\u093E\u0917, \u0938\u0930\u0932 \u092A\u0930\u0902\u0924\u0941
        \u0936\u0941\u0926\u094D\u0927"
      ur: "\u0646\u0631\u0645 \u0633\u0641\u06CC\u062F\u06CC\u060C \u06A9\u0631\u06CC\u0645\u06CC
        \u067E\u06CC\u0644\u06D2 \u062D\u0635\u06D2\u060C \u0633\u0627\u062F\u06C1
        \u0644\u06CC\u06A9\u0646 \u062E\u0627\u0644\u0635\u06D4"
      ms: Putih lembut, kuning telur berkrim, sederhana namun murni.
      id: Putih lembut, kuning telur kental, sederhana namun murni.
      he: "\u05D7\u05DC\u05D1\u05D5\u05DF \u05E8\u05DA, \u05D7\u05DC\u05DE\u05D5\u05DF
