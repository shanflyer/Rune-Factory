      da: Mustekala hiekkapohjalla
    - cn: "\u8D34\u4E8E\u6D77\u5E95\u7F13\u7F13\u632A\uFF0C\u8089\u8D28\u9C9C\u5AE9\u662F\u6D77\u5E95\u751F\u6D3B\u7684\u7F8E\u5473\u6C89\u6DC0\u3002"
