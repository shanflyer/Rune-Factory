      es: "Licor tropical con dulzor de ca\xF1a"
      pt: "Licor tropical com do\xE7ura de cana"
      it: Liquore tropicale dolce di canna
      tr: "Tropikal kam\u0131\u015F tatl\u0131s\u0131 lik\xF6r"
      vi: "R\u01B0\u1EE3u m\u1EA1nh h\u01B0\u01A1ng m\xEDa nhi\u1EC7t \u0111\u1EDBi"
      th: "\u0E40\u0E2B\u0E25\u0E49\u0E32\u0E41\u0E23\u0E07\u0E23\u0E2A\u0E2D\u0E49\u0E2D\u0E22\u0E40\u0E02\u0E15\u0E23\u0E49\u0E2D\u0E19"
      pl: Likier tropikalny o smaku trzciny
      nl: Tropische rietsuikerdrank
      el: "\u03A4\u03C1\u03BF\u03C0\u03B9\u03BA\u03CC \u03C0\u03BF\u03C4\u03CC \u03BC\u03B5
        \u03B3\u03BB\u03C5\u03BA\u03B9\u03AC \u03AC\u03C1\u03C9\u03BC\u03B1"
      ar: "\u0645\u0634\u0631\u0648\u0628 \u0643\u062D\u0648\u0644\u064A \u0628\u0646\u0643\u0647\u0629
        \u0642\u0635\u0628 \u0627\u0644\u0633\u0643\u0631"
      hi: "\u0909\u0937\u094D\u0923\u0915\u091F\u093F\u092C\u0902\u0927\u0940\u092F
        \u0917\u0928\u094D\u0928\u0947 \u0915\u0940 \u092E\u093F\u0920\u093E\u0938,
        \u0935\u093F\u0926\u0947\u0936\u0940 \u0906\u0915\u0930\u094D\u0937\u0923
        \u092A\u094D\u0930\u0926\u093E\u0928 \u0915\u0930\u0924\u093E \u0939\u0948"
      ur: "\u06AF\u0631\u0645 \u062E\u0637\u06D2 \u06A9\u06D2 \u06AF\u0646\u06D2
        \u06A9\u06CC \u0645\u06CC\u0679\u06BE\u0627\u0633\u060C \u063A\u06CC\u0631
        \u0645\u0644\u06A9\u06CC \u062F\u0644\u06A9\u0634\u06CC \u067E\u06BE\u06CC\u0644\u0627\u062A\u06CC
        \u06C1\u06D2\u06D4"
      ms: Kemanisan tebu tropika, memancarkan daya tarikan eksotik.
      id: Manis tebu tropis, memancarkan pesona eksotis.
      he: "\u05DE\u05EA\u05D5\u05E7 \u05DB\u05DE\u05D5 \u05E7\u05E0\u05D4 \u05E1\u05D5\u05DB\u05E8,
        \u05D8\u05E2\u05DD \u05D8\u05E8\u05D5\u05E4\u05D9"
      sv: "S\xF6t som sockerr\xF6r, tropisk smak"
      cs: "Sladk\xE1 jako cukrov\xE1 t\u0159tina, tropick\xE1 chu\u0165"
      uk: "\u0421\u043E\u043B\u043E\u0434\u043A\u0438\u0439, \u044F\u043A \u0446\u0443\u043A\u0440\u043E\u0432\u0430
        \u0442\u0440\u043E\u0441\u0442\u0438\u043D\u0430, \u0442\u0440\u043E\u043F\u0456\u0447\u043D\u0438\u0439
        \u0441\u043C\u0430\u043A"
      ro: "Dulce ca trestia de zah\u0103r, arom\u0103 tropical\u0103"
